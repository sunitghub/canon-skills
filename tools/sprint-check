#!/usr/bin/env bash
# sprint-check — open the current project's board inside Canon Cockpit
# (t-4700). No longer starts a private per-project server on its own port —
# it delegates into the single canon-cockpit instance (starting it if none is
# running), registers the current project if needed, and deep-links into that
# project's tab. See tools/canon-cockpit for the single-instance shell itself.

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR always points to the real file location
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
SERVER="$SCRIPT_DIR/sprint-check-app/server.py"
# shellcheck source=cockpit-launch-lib.sh
source "$SCRIPT_DIR/cockpit-launch-lib.sh"

usage() {
  cat <<'EOF'
sprint-check — open the current project's board in Canon Cockpit

Usage:
  sprint-check        Open the dashboard for the current project
  sprint-check <port> Use a specific port for the shared Cockpit instance
  sprint-check --help Show this help

Reads .tickets/, HANDOFF.md, and git history from the current project.
Delegates into the single canon-cockpit instance (starting it if none is
running yet) rather than opening a private server of its own — this keeps
every project's board inside one shared window instead of scattered across
separate processes/ports. Set CANON_COCKPIT_PORT to change the default port
(8899).
EOF
}

# Opens the browser straight at this project's tab once the cockpit server on
# $1 is answering, registering the project first if needed. Best-effort: a
# failed register still opens the bare /cockpit landing rather than failing
# the whole command.
open_project_tab() {
  local port="$1" root="$2"
  local id
  id="$(cockpit_register_project "$port" "$root" 2>/dev/null || true)"
  if [[ -n "$id" ]]; then
    open_browser "http://127.0.0.1:$port/cockpit#open=$id"
  else
    echo "Could not register this project with Cockpit — opening the Projects list." >&2
    open_browser "http://127.0.0.1:$port/cockpit"
  fi
}

main() {
  PORT=""
  case "${1:-}" in
    help|--help|-h)
      usage
      exit 0
      ;;
    "")
      ;;
    [0-9]*)
      PORT="$1"
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac

  local port="${PORT:-${CANON_COCKPIT_PORT:-8899}}"
  local root
  root="${SPRINT_CHECK_ROOT:-$PWD}"
  # -P: resolve symlinks so this matches the registry's resolved path exactly
  # (Path.resolve() server-side, e.g. macOS /tmp -> /private/tmp) — a plain
  # `pwd` mismatch here would make the "already registered" lookup miss.
  root="$(cd -P "$root" && pwd -P)"

  if _port_in_use "$port"; then
    echo "Opening this project in the running Canon Cockpit (port $port)." >&2
    open_project_tab "$port" "$root"
    exit 0
  fi

  if [[ ! -f "$SERVER" ]]; then
    echo "Error: server.py not found at $SERVER" >&2
    exit 1
  fi

  # No cockpit instance running yet — start it (same foreground lifecycle as
  # running `canon-cockpit` directly: it lives as long as this shell).
  start_cockpit_server "$port" || exit 1
  trap 'kill "$SERVER_PID" 2>/dev/null; exit 0' INT TERM EXIT

  for _ in $(seq 1 50); do
    _port_in_use "$port" && break
    sleep 0.1
  done

  open_project_tab "$port" "$root"

  wait "$SERVER_PID"
}

main "$@"
