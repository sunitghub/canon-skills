#!/usr/bin/env bash
# sprint — CLI-backed orchestration spine for canon workflows

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/ticket-root.sh"
source "$SCRIPT_DIR/frontmatter-lib.sh"
TKT_BIN="$SCRIPT_DIR/tkt"

ticket_dir_for() {
  local id="$1"
  echo "$(tickets_dir)/$id"
}

ensure_context_files() {
  local root="$1"
  if [[ ! -f "$root/DECISIONS.md" ]]; then
    cat > "$root/DECISIONS.md" <<'EOF'
# Decisions

| Date | Decision | Reason |
|---|---|---|
EOF
  fi

  if [[ ! -f "$root/HANDOFF.md" ]]; then
    cat > "$root/HANDOFF.md" <<'EOF'
# Handoff

<!-- canon:handoff:BEGIN -->
## Current Focus

## In Progress

## Discoveries

## Next Steps
1.

<!-- canon:handoff:END -->
EOF
  fi
}

write_if_missing() {
  local file="$1" content="$2"
  [[ -f "$file" ]] && return 0
  printf "%s\n" "$content" > "$file"
}

cmd_start() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo "Usage: sprint start \"title\" | sprint start <ticket-id>" >&2; exit 1; }

  local current_output current_rc
  set +e
  current_output="$("$TKT_BIN" current 2>&1)"
  current_rc=$?
  set -e
  if [[ "$current_rc" -eq 0 ]]; then
    echo "Active sprint already exists:"
    echo "$current_output"
    echo "Run 'sprint complete' or close/reopen tickets before starting another."
    exit 1
  elif [[ "$current_rc" -gt 1 ]]; then
    echo "$current_output" >&2
    exit "$current_rc"
  fi

  local root dir id tdir
  root="$(project_root)"
  dir="$(tickets_dir)"
  mkdir -p "$dir"

  # Resolve arg as an existing ticket ID; fall back to creating a new ticket.
  local resolved_id
  resolved_id="$("$TKT_BIN" show "$arg" 2>/dev/null | awk '/^ID:/{print $2}' || true)"
  if [[ -n "$resolved_id" ]]; then
    id="$resolved_id"
  else
    id="$("$TKT_BIN" create "$arg" -t task -p 2)"
  fi
  "$TKT_BIN" start "$id" >/dev/null
  tdir="$(ticket_dir_for "$id")"
  mkdir -p "$tdir"

  [[ -f "$tdir/acceptance.md" ]] || cat > "$tdir/acceptance.md" <<EOF
# Acceptance

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`

## Criteria
The checklist of behavior that must be true before the sprint can close.
<!-- Add or edit checklist items below. Keep this heading unchanged. -->

- [ ]

## Test Plan
The commands or checks that prove the criteria work.
<!-- Add or edit test commands below. Keep this heading unchanged. -->

- [ ]

## QA
Edge cases and sign-off.
<!-- Add or edit QA items below. Keep this heading unchanged. -->

- [ ] Tested locally
EOF

  [[ -f "$tdir/plan.md" ]] || cat > "$tdir/plan.md" <<EOF
# Plan

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`
<!-- Keep this doc under ~500 words — it is injected at every session start. -->

## Sign-off
<!-- Fill in: Tier: <tier> | Risk: <blast radius / key risks, one line> -->
<!-- Optional, append: | Gate model: <value> -- forces the sprint-close reviewer/evaluator onto that model, overriding the automatic low-risk downgrade. Valid values (case-insensitive): a model id (e.g. haiku, sonnet, opus), or the literal "session" to force full session-model review. Omit entirely for automatic behavior -- there is no separate "auto" value; absence already means automatic. -->

- [ ] Plan approved — proceed to implementation

## Approach
<!-- Describe how you will implement this. Keep this heading unchanged. -->

## Files
<!-- List files to create or modify. -->

## Decisions
<!-- Record non-obvious tradeoffs and why. Keep this heading unchanged. -->
EOF

  ensure_context_files "$root"

  if [[ ! -x "$root/scripts/test.sh" ]]; then
    echo "[sprint] WARNING: no scripts/test.sh found — test gate will not run at commit."
  fi

  cat <<EOF
Sprint started: $id
Ticket: $tdir/ticket.md

Agent next steps:
1. Read DECISIONS.md, HANDOFF.md, and ticket.md.
2. Fill in acceptance.md — add criteria and test-plan checklist items.
3. Fill in plan.md — write the approach, then wait for explicit approval before coding.
EOF
}

cmd_current() {
  "$TKT_BIN" current
}

cmd_status() {
  local id tdir
  local current_out current_rc
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  if [[ "$current_rc" -ne 0 ]]; then echo "No active sprint."; exit 1; fi
  id="$(awk '{print $1}' <<< "$current_out")"
  tdir="$(ticket_dir_for "$id")"
  "$TKT_BIN" show "$id"
  echo ""
  echo "Sprint files:"
  for f in ticket.md acceptance.md plan.md; do
    if [[ -f "$tdir/$f" ]]; then
      echo "  [ok]      $tdir/$f"
    else
      echo "  [missing] $tdir/$f"
    fi
  done
}

_acceptance_section() {
  awk -v h="$1" '$0 ~ "^##[[:space:]]+"h"[[:space:]]*$" { f=1; next } /^##[[:space:]]/ { f=0 } f' "$2"
}

_gate_sprint_files() {
  local id="$1" tdir="$2" acceptance="$3" missing=0
  for f in "$tdir/ticket.md" "$acceptance" "$tdir/plan.md" "$tdir/summary.md"; do
    [[ ! -f "$f" ]] && echo "Missing required sprint file: $f" && missing=1
  done
  return $missing
}

_gate_acceptance_sections() {
  local id="$1" acceptance="$2" missing=0
  if ! _acceptance_section "Criteria" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Criteria has no checklist items."
    echo "Add done criteria to acceptance.md, then re-run."
    missing=1
  fi
  if ! _acceptance_section "Test Plan" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Test Plan has no checklist items."
    echo "Add test commands to acceptance.md, then re-run."
    missing=1
  fi
  return $missing
}

_gate_wrapup_gates() {
  local id="$1" acceptance="$2"
  if ! grep -q "^## Wrapup Gates" "$acceptance"; then
    echo "Sprint $id cannot close: acceptance.md is missing ## Wrapup Gates section."
    echo "Run wrapup before closing."
    return 1
  fi

  local section data_rows
  section="$(_acceptance_section "Wrapup Gates" "$acceptance")"
  data_rows="$(printf '%s\n' "$section" | grep -E '^\|[[:space:]]*[a-zA-Z]' | grep -ivE '^\|[[:space:]]*gate[[:space:]]*\|')"

  if [[ -z "$data_rows" ]]; then
    echo "Sprint $id cannot close: ## Wrapup Gates table has no data rows."
    echo "Fill in the wrapup gates table before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | awk -F'|' '
    { r=$4; gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
      if (r == "" || r == "-" || r == "—") { exit 1 } }
  '; then
    echo "Sprint $id cannot close: ## Wrapup Gates has a row with empty or placeholder reason."
    echo "Add a reason for each gate before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | grep -qE '^\|[^|]+\|[[:space:]]*ran[[:space:]]*\|'; then
    echo "Sprint $id cannot close: ## Wrapup Gates has no 'ran' rows — at least one gate must run."
    return 1
  fi
}

_gate_no_unchecked() {
  local id="$1" acceptance="$2"
  if grep -qE '^[[:space:]]*[-*] \[ \]' "$acceptance"; then
    echo "Sprint $id is not complete. Unchecked acceptance/test items remain:"
    grep -E '^[[:space:]]*[-*] \[ \]' "$acceptance" || true
    return 1
  fi
}

_gate_plan_signoff() {
  local id="$1" plan="$2"
  # Trivial-tier sprints skip the sign-off gate — anchored to the Tier: field
  # itself (line-start match), so "tier: trivial" appearing in free text
  # elsewhere in ## Sign-off (e.g. a Risk: one-liner discussing the decision)
  # can't accidentally trigger the skip.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  if ! grep -q "^## Sign-off" "$plan"; then
    echo "Sprint $id cannot close: plan.md is missing ## Sign-off section."
    echo "Add the Sign-off section and check the approval box before closing."
    return 1
  fi
  if _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[ \]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has unchecked items."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
  if ! _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[[xX]\]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has no checked approval."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
}

_gate_plan_content() {
  local id="$1" plan="$2"
  # Extract ## Approach section, strip HTML comments and blank lines
  local content
  content="$(_acceptance_section "Approach" "$plan" \
    | sed 's/<!--[^>]*-->//g' \
    | sed '/^[[:space:]]*$/d')"
  if [[ -z "$content" ]]; then
    echo "Sprint $id cannot close: plan.md ## Approach has no content."
    echo "Describe the implementation approach in plan.md, then re-run."
    return 1
  fi
}

_gate_visual_embed() {
  local id="$1"
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  "$script_dir/validate-visuals.sh" "$id" "$2" "$3"
}

# _gate_eval_report_exists <id> <tdir> — report file present, evaluator-run-id
# field present. Fails closed: missing report or field blocks close.
_gate_eval_report_exists() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if [[ ! -f "$report" ]]; then
    echo "Sprint $id cannot close: eval-report.md is missing."
    echo "Run the evaluator (eval skill) before closing, or confirm trivial tier in plan.md."
    return 1
  fi
  if ! grep -qE '^evaluator-run-id:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: eval-report.md is missing evaluator-run-id field."
    echo "Ensure the evaluator subagent wrote the run-id before grading."
    return 1
  fi
}

# _gate_eval_report_authentic <id> <tdir> — the evaluator-run-id must have a
# valid timestamp prefix and a matching entry in .claude/subagent-runs.jsonl
# within a ±60 min window. Fail closed, not open: a missing jsonl or
# unparseable run-id must block close, not silently skip verification — an
# unlogged/hand-written eval would otherwise satisfy this gate by just
# containing "pass:" in the verdict check that follows.
_gate_eval_report_authentic() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  local run_id run_epoch jsonl
  run_id="$(grep -E '^evaluator-run-id:[[:space:]]+\S' "$report" | head -1 | sed 's/^evaluator-run-id:[[:space:]]*//')"
  run_epoch="$(echo "$run_id" | cut -d'-' -f1)"
  jsonl="$(project_root)/.claude/subagent-runs.jsonl"
  if [[ ! -f "$jsonl" ]]; then
    echo "Sprint $id cannot close: .claude/subagent-runs.jsonl not found — cannot verify evaluator-run-id '$run_id' against a real subagent run."
    echo "Log the evaluator subagent run with subagent-log.sh before closing."
    return 1
  fi
  if [[ ! "$run_epoch" =~ ^[0-9]+$ ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no valid timestamp prefix. See eval.md step 1: generate it with 'date +%s'/'\$RANDOM', never uuidgen/PowerShell."
    return 1
  fi
  local matched=0 line ts entry_epoch diff
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    ts="$(printf '%s' "$line" | grep -o '"ts"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/')"
    [[ -z "$ts" ]] && continue
    [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || continue
    entry_epoch="$(date -u -d "$ts" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null)" || continue
    [[ "$entry_epoch" =~ ^[0-9]+$ ]] || continue
    diff=$(( entry_epoch - run_epoch ))
    (( diff < 0 )) && diff=$(( -diff ))
    if (( diff <= 3600 )); then
      matched=1
      break
    fi
  done < "$jsonl"
  if [[ "$matched" != "1" ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no matching subagent entry in .claude/subagent-runs.jsonl (±60 min window)."
    echo "The eval must be run as a real subagent invocation — inline writes are not accepted."
    return 1
  fi
}

# _gate_eval_report_verdict <id> <tdir> — verdict must be pass:, or
# eval_override: true plus a dated waiver in acceptance.md (see
# _eval_override_has_dated_waiver's own header comment for why this check
# stays coarse rather than mechanically re-deriving per-item coverage).
_gate_eval_report_verdict() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if ! grep -qE '^pass:' "$report"; then
    local ticket_file="$tdir/ticket.md" override
    override="$(get_field "$ticket_file" eval_override 2>/dev/null)"
    if [[ "$override" == "true" ]]; then
      if _eval_override_has_dated_waiver "$tdir/acceptance.md"; then
        echo "Sprint $id: eval-report.md verdict is not pass, but eval_override: true is set and acceptance.md has a dated waiver on record — allowing close. Per-item waiver coverage was confirmed at the human close-gate (complete.md steps 4-5), not re-derived mechanically here (t-c0e6: per-item correlation between eval-report.md and acceptance.md cannot be made sound — see DECISIONS.md)." >&2
        return 0
      fi
      echo "Sprint $id cannot close: eval_override: true is set, but acceptance.md has no dated waiver on record." >&2
      return 1
    fi
    echo "Sprint $id cannot close: eval-report.md verdict is not pass."
    grep -E '^(pass|fail):' "$report" | head -1 || echo "(no verdict line found)"
    return 1
  fi
}

_gate_eval_report() {
  local id="$1" tdir="$2"
  local plan="$tdir/plan.md"
  # Trivial-tier sprints skip the evaluator — same field-anchored check as
  # _gate_plan_signoff, so this can't be skipped by a stray "tier: trivial"
  # mention in free text elsewhere in plan.md.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  _gate_eval_report_exists     "$id" "$tdir" || return 1
  _gate_eval_report_authentic  "$id" "$tdir" || return 1
  _gate_eval_report_verdict    "$id" "$tdir" || return 1
}

# eval_override (t-c0e6) is deliberately coarse: it checks only that a human set the
# flag and that acceptance.md records at least one dated waiver — it does NOT try to
# mechanically re-derive which specific eval-report.md items that waiver covers.
#
# A per-item mechanical check was built and abandoned across five rounds of live
# adversarial review (see DECISIONS.md): text-matching between eval-report.md's
# "verbatim" criterion text and its acceptance.md bullet cannot be made sound (loose
# matching collides across bullets; strict matching breaks on real evaluator output);
# position-based correlation (report row N = acceptance.md's Nth bullet) then failed
# the same way — nested bullets and malformed tables drift positions without tripping
# a row-count guard, and even a pipe-safe row-count guard can't detect an evaluator
# merging/splitting rows while preserving the total count. Every version shipped
# failed OPEN, never closed. There is no third correlation key.
#
# `eval_override` is human-only to set (no tkt command writes it) — a human is always
# in the loop when it's used, so per-item "is THIS failing item actually waived" is
# verified by that human at complete.md's steps 4-5 close-gate, not re-derived here.
# Mirrors t-d8a1's precedent: no CLI gate is bypass-proof; the win is making the
# override explicit, dated, and greppable — not building an unfoolable verifier.
_eval_override_has_dated_waiver() {
  local acceptance="$1"
  [[ -f "$acceptance" ]] || return 1
  grep -qi 'waived' "$acceptance" && grep -iE 'waived' "$acceptance" | grep -qE '[0-9]{4}-[0-9]{2}-[0-9]{2}'
}

cmd_complete() {
  local id tdir acceptance
  local current_out current_rc
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  if [[ "$current_rc" -ne 0 ]]; then echo "No active sprint."; exit 1; fi
  id="$(awk '{print $1}' <<< "$current_out")"

  tdir="$(ticket_dir_for "$id")"
  acceptance="$tdir/acceptance.md"

  _gate_sprint_files        "$id" "$tdir" "$acceptance"  || exit 1
  _gate_acceptance_sections "$id" "$acceptance"          || exit 1
  _gate_wrapup_gates        "$id" "$acceptance"          || exit 1
  _gate_no_unchecked        "$id" "$acceptance"          || exit 1
  _gate_plan_content        "$id" "$tdir/plan.md"        || exit 1
  _gate_visual_embed        "$id" "$tdir/plan.md" "$acceptance" || exit 1
  _gate_plan_signoff        "$id" "$tdir/plan.md"        || exit 1
  _gate_eval_report         "$id" "$tdir"                || exit 1

  TKT_SPRINT_GATE_PASSED=1 "$TKT_BIN" close "$id"
  echo "Sprint completed: $id"
}

# _set_field_or_append <file> <field> <value> — set_field only rewrites an
# existing "field: " line; tickets created before eval_fail_count existed have
# no such line, so this falls back to appending one just before the closing
# frontmatter "---" when the field is absent.
_set_field_or_append() {
  local file="$1" field="$2" value="$3"
  if grep -qE "^${field}: " "$file"; then
    set_field "$file" "$field" "$value"
  else
    awk -v f="$field" -v v="$value" '
      /^---$/ { c++; if (c == 2) { print f ": " v } print; next }
      { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
  fi
}

# cmd_eval_verdict <id> — records the evaluator's outcome into ticket.md's
# eval_fail_count field: increments on a fail (or missing/malformed verdict),
# resets to 0 on pass. Called explicitly by the agent right after reading
# eval-report.md (complete.md step 3), the same pattern as subagent-log.sh's
# explicit post-dispatch call — not a hook, so it works whether or not the
# orchestrating agent goes on to invoke `sprint complete` itself. Prints the
# resulting count and a retry-budget-exhausted notice at 3, but never blocks
# on its own — _gate_eval_report_verdict (cmd_complete) is the actual close gate.
cmd_eval_verdict() {
  local id="${1:-}"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local tdir report ticket_file
  tdir="$(ticket_dir_for "$id")"
  report="$tdir/eval-report.md"
  ticket_file="$tdir/ticket.md"
  [[ -f "$report" ]] || { echo "Sprint $id: eval-report.md not found." >&2; exit 1; }
  [[ -f "$ticket_file" ]] || { echo "Sprint $id: ticket.md not found." >&2; exit 1; }

  local current new
  current="$(get_field "$ticket_file" eval_fail_count 2>/dev/null)"
  [[ -z "$current" ]] && current=0

  if grep -qE '^pass:' "$report"; then
    new=0
  else
    new=$((current + 1))
  fi

  _set_field_or_append "$ticket_file" eval_fail_count "$new"
  echo "$id: eval_fail_count=$new"
  if (( new >= 3 )); then
    echo "Sprint $id: evaluator has failed $new times in a row — retry budget exhausted. Diagnose the root cause outside the automated loop, or set eval_override: true with a dated waiver to close anyway." >&2
  fi
}

cmd_help() {
  cat <<'EOF'
sprint — canon workflow spine

Usage:
  sprint start "title"      Create a new ticket and start the sprint
  sprint start <ticket-id>  Start the sprint on an existing ticket (no new ticket created)
  sprint current            Show the active sprint ticket
  sprint status             Show active ticket and required sprint files
  sprint complete           Validate acceptance checklist and close ticket
  sprint eval-verdict <id>  Record the evaluator's pass/fail into ticket.md's
                            eval_fail_count (internal — called by complete.md
                            step 3, not run directly)

The CLI owns deterministic workflow state. The agent still owns orientation,
gray-area resolution, impact analysis, implementation, review, and test judgment.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    start) cmd_start "$@" ;;
    current) cmd_current ;;
    status) cmd_status ;;
    complete) cmd_complete ;;
    eval-verdict) cmd_eval_verdict "$@" ;;
    help|--help|-h) cmd_help ;;
    *) echo "Unknown command: $cmd" >&2; cmd_help; exit 1 ;;
  esac
}

main "$@"
