#!/usr/bin/env bash
# sprint — CLI-backed orchestration spine for canon workflows

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real file location.
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
source "$SCRIPT_DIR/ticket-root.sh"
source "$SCRIPT_DIR/frontmatter-lib.sh"
source "$SCRIPT_DIR/platform-lib.sh"   # canon_event (t-f182)
TKT_BIN="$SCRIPT_DIR/tkt"

ticket_dir_for() {
  local id="$1"
  echo "$(tickets_dir)/$id"
}

ensure_context_files() {
  local root="$1"
  if [[ ! -f "$root/DECISIONS.md" ]]; then
    cat > "$root/DECISIONS.md" <<'EOF'
# Decisions

| Date | Decision | Reason |
|---|---|---|
EOF
  fi

  if [[ ! -f "$root/HANDOFF.md" ]]; then
    cat > "$root/HANDOFF.md" <<'EOF'
# Handoff

<!-- canon:handoff:BEGIN -->
## Current Focus

## In Progress

## Discoveries

## Next Steps
1.

<!-- canon:handoff:END -->
EOF
  fi
}

cmd_start() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo "Usage: sprint start \"title\" | sprint start <ticket-id>" >&2; exit 1; }

  local current_output current_rc
  set +e
  current_output="$("$TKT_BIN" current 2>&1)"
  current_rc=$?
  set -e
  if [[ "$current_rc" -eq 0 ]]; then
    echo "Active sprint already exists:"
    echo "$current_output"
    echo "Run 'sprint complete' or close/reopen tickets before starting another."
    exit 1
  elif [[ "$current_rc" -gt 1 ]]; then
    echo "$current_output" >&2
    exit "$current_rc"
  fi

  local root dir id tdir
  root="$(project_root)"
  dir="$(tickets_dir)"
  mkdir -p "$dir"

  # Resolve arg as an existing ticket ID; fall back to creating a new ticket.
  local resolved_id
  resolved_id="$("$TKT_BIN" show "$arg" 2>/dev/null | awk '/^ID:/{print $2}' || true)"
  if [[ -n "$resolved_id" ]]; then
    id="$resolved_id"
  else
    id="$("$TKT_BIN" create "$arg" -t task -p 2)"
  fi
  # t-01a4: "$TKT_BIN" start writes .tickets/<id>/.cockpit-cwd itself now
  # (moved into tkt's own cmd_set_status after review found bare `tkt start`,
  # bypassing this wrapper, never bound a ticket to its worktree) — no
  # separate write needed here.
  "$TKT_BIN" start "$id" >/dev/null
  tdir="$(ticket_dir_for "$id")"
  mkdir -p "$tdir"

  [[ -f "$tdir/acceptance.md" ]] || cat > "$tdir/acceptance.md" <<EOF
# Acceptance

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`

## Criteria
The checklist of behavior that must be true before the sprint can close.
<!-- Add or edit checklist items below. Keep this heading unchanged. -->

- [ ]

## Test Plan
The commands or checks that prove the criteria work.
<!-- Add or edit test commands below. Keep this heading unchanged. -->

- [ ]

## QA
Edge cases and sign-off.
<!-- Add or edit QA items below. Keep this heading unchanged. -->

- [ ] Tested locally
EOF

  [[ -f "$tdir/plan.md" ]] || cat > "$tdir/plan.md" <<EOF
# Plan

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`
<!-- Keep this doc under ~500 words — it is injected at every session start. -->

## Sign-off
<!-- Fill in: Tier: <tier> | Risk: <blast radius / key risks, one line> -->
<!-- Optional, append: | Gate model: <value> -- forces the sprint-close reviewer/evaluator onto that model, overriding the automatic Admin Review & Eval default. Valid values (case-insensitive): a model id (e.g. haiku, sonnet, opus), or the literal "session" to force full session-model review. Omit entirely for automatic behavior -- there is no separate "auto" value; absence already means automatic. -->

- [ ] Plan approved — proceed to implementation

## Approach
<!-- Describe how you will implement this. Keep this heading unchanged. -->

## Files
<!-- List files to create or modify. -->

## Decisions
<!-- Record non-obvious tradeoffs and why. Answer each item under the ticket's ## Open questions here, or write "carried forward: <question>". Keep this heading unchanged. -->
EOF

  ensure_context_files "$root"

  if [[ ! -x "$root/scripts/test.sh" ]]; then
    echo "[sprint] WARNING: no scripts/test.sh found — test gate will not run at commit."
  fi

  _gate_agents_check "$root"
  canon_event sprint.started sprint "$(project_root)" "ticket=$id" ${GATE_AGENTS:+"gate_agents=$GATE_AGENTS"}
  cat <<EOF
Sprint started: $id
Ticket: $tdir/ticket.md

Agent next steps:
1. Read DECISIONS.md, HANDOFF.md, and ticket.md.
2. Fill in acceptance.md — add criteria and test-plan checklist items.
3. Fill in plan.md — write the approach, then wait for explicit approval before coding.
EOF
}

# _gate_agents_check <root> — t-ff14: are canon's gate agents loaded in this Claude Code session? Claude Code loads agents
# once, from the folder the session started in (and the user's own agents folder), so a session started elsewhere, or
# before `skills.sh add` linked <project>/.claude/agents, closes without them and falls back. The session's transcript
# (<config>/projects/*/<CLAUDE_CODE_SESSION_ID>.jsonl) records that start folder as its first "cwd" and the start time
# as its first "timestamp" (the transcript's own folder follows the session's current folder, so it cannot be used).
# Warns, never blocks; silent outside Claude Code or when the transcript is not found (fails open, like the close check).
# Sets GATE_AGENTS to ok, missing, or empty when it could not tell.
_gate_agents_check() {
  GATE_AGENTS=""
  [[ -n "${CLAUDECODE:-}" && -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || return 0
  local root="$1" cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}" t start start_ts start_epoch ref why="" f fix=""
  # every lookup ends `|| true`: under set -e + pipefail an empty find/grep would end `sprint start` itself
  t="$(find "$cfg/projects/" -maxdepth 2 -name "$CLAUDE_CODE_SESSION_ID.jsonl" -type f 2>/dev/null | head -1 || true)"
  [[ -n "$t" ]] || return 0
  start="$(grep -m1 -o '"cwd":"[^"]*"' "$t" | sed 's/^"cwd":"//; s/"$//; s#\\\\#/#g' || true)"
  [[ -n "$start" ]] || return 0
  start_ts="$(grep -m1 -o '"timestamp":"[^"]*"' "$t" | sed 's/^"timestamp":"//; s/"$//; s/\.[0-9]*Z$/Z/' || true)"
  f=""
  for f in "$start/.claude/agents/canon-evaluator.md" "$cfg/agents/canon-evaluator.md"; do [[ -f "$f" ]] && break; f=""; done
  if [[ -z "$f" ]]; then
    why="it started in $start, where no canon-evaluator agent is found (nor in $cfg/agents)"
  elif [[ -n "$start_ts" ]]; then
    start_epoch="$(date -u -d "$start_ts" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$start_ts" +%s 2>/dev/null)" || start_epoch=""
    if [[ -n "$start_epoch" ]]; then
      ref="$(mktemp)"
      touch -t "$(date -r "$start_epoch" +%Y%m%d%H%M.%S 2>/dev/null || date -d "@$start_epoch" +%Y%m%d%H%M.%S)" "$ref" 2>/dev/null
      [[ -n "$(find "$(dirname "$f")" -maxdepth 0 -newer "$ref" 2>/dev/null || true)" ]] && why="canon's gate agents were added after it started"
      rm -f "$ref"
    fi
  fi
  if [[ -z "$why" ]]; then GATE_AGENTS=ok; return 0; fi
  GATE_AGENTS=missing
  [[ -f "$start/.claude/agents/canon-evaluator.md" ]] || fix=" (run 'skills.sh refresh' there first, so it links the agents)"
  echo "[sprint] WARNING: canon's gate agents are not loaded in this Claude Code session: $why."
  echo "  The close's reviewer and evaluator need them; without them it falls back to general-purpose agents."
  echo "  Fix: end this session and start Claude Code again in $start$fix."
}

cmd_continue() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo "Usage: sprint continue <ticket-id>" >&2; exit 1; }
  local id status tdir
  id="$("$TKT_BIN" show "$arg" 2>/dev/null | awk '/^ID:/{print $2}' || true)"
  [[ -z "$id" ]] && { echo "No ticket matches '$arg'." >&2; exit 1; }
  status="$("$TKT_BIN" show "$id" 2>/dev/null | awk '/^Status:/{print $2}' || true)"
  if [[ "$status" != "in_progress" ]]; then
    echo "$id is ${status:-unknown}, not in_progress. Use 'sprint start $id' to begin it." >&2
    exit 1
  fi
  tdir="$(ticket_dir_for "$id")"
  _gate_agents_check "$(project_root)"
  echo "Continuing sprint: $id"
  echo "Status: $status"
  echo "Ticket: $tdir/ticket.md"
  echo ""
  echo "Sprint files:"
  for f in ticket.md acceptance.md plan.md summary.md; do
    if [[ -f "$tdir/$f" ]]; then echo "  [ok]      $tdir/$f"; fi
  done
  cat <<EOF

Agent next steps:
1. Read DECISIONS.md, HANDOFF.md, and everything in $tdir/.
2. Find the first unchecked item in plan.md (approval) and acceptance.md.
3. Resume from there — do not restart orientation or re-ask for plan approval already recorded.
EOF
}

# cmd_import_issue <N> [--body-file F] [--force] — t-554c: in a cloud session, rebuilds the ticket a `tkt send-issue`
# issue carries and starts its sprint. `sprint start` keeps the imported acceptance.md and plan.md (it writes only
# missing ones), so an approved plan stays approved.
cmd_import_issue() {
  local id
  id="$("$TKT_BIN" import-issue "$@" | tail -1)" || exit 1
  [[ -n "$id" ]] || exit 1
  cmd_start "$id"
}

cmd_current() {
  "$TKT_BIN" current
}

cmd_status() {
  local id tdir json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local current_out current_rc
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  if [[ "$current_rc" -ne 0 ]]; then
    if [[ "$json" -eq 1 ]]; then echo '{"active":false}'; else echo "No active sprint."; fi
    exit 1
  fi
  id="$(awk '{print $1}' <<< "$current_out")"
  tdir="$(ticket_dir_for "$id")"
  if [[ "$json" -eq 1 ]]; then
    local f flags="" ticket_json
    ticket_json="$("$TKT_BIN" show "$id" --json)" # assigned first so a failure aborts with empty stdout, never half a document
    for f in ticket.md acceptance.md plan.md; do
      flags+="${flags:+,}\"$f\":$([[ -f "$tdir/$f" ]] && echo true || echo false)"
    done
    printf '{"active":true,"ticket":%s,"files":{%s}}\n' "$ticket_json" "$flags"
    return
  fi
  "$TKT_BIN" show "$id"
  echo ""
  echo "Sprint files:"
  for f in ticket.md acceptance.md plan.md; do
    if [[ -f "$tdir/$f" ]]; then
      echo "  [ok]      $tdir/$f"
    else
      echo "  [missing] $tdir/$f"
    fi
  done
}

_acceptance_section() {
  awk -v h="$1" '$0 ~ "^##[[:space:]]+"h"[[:space:]]*$" { f=1; next } /^##[[:space:]]/ { f=0 } f' "$2"
}

_gate_sprint_files() {
  local id="$1" tdir="$2" acceptance="$3" missing=0
  for f in "$tdir/ticket.md" "$acceptance" "$tdir/plan.md" "$tdir/summary.md"; do
    [[ ! -f "$f" ]] && echo "Missing required sprint file: $f" && missing=1
  done
  return $missing
}

_gate_acceptance_sections() {
  local id="$1" acceptance="$2" missing=0
  if ! _acceptance_section "Criteria" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Criteria has no checklist items."
    echo "Add done criteria to acceptance.md, then re-run."
    missing=1
  fi
  if ! _acceptance_section "Test Plan" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Test Plan has no checklist items."
    echo "Add test commands to acceptance.md, then re-run."
    missing=1
  fi
  return $missing
}

_gate_wrapup_gates() {
  local id="$1" acceptance="$2"
  if ! grep -q "^## Wrapup Gates" "$acceptance"; then
    echo "Sprint $id cannot close: acceptance.md is missing ## Wrapup Gates section."
    echo "Run wrapup before closing."
    return 1
  fi

  local section data_rows
  section="$(_acceptance_section "Wrapup Gates" "$acceptance")"
  data_rows="$(printf '%s\n' "$section" | grep -E '^\|[[:space:]]*[a-zA-Z]' | grep -ivE '^\|[[:space:]]*gate[[:space:]]*\|')"

  if [[ -z "$data_rows" ]]; then
    echo "Sprint $id cannot close: ## Wrapup Gates table has no data rows."
    echo "Fill in the wrapup gates table before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | awk -F'|' '
    { r=$4; gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
      if (r == "" || r == "-" || r == "—") { exit 1 } }
  '; then
    echo "Sprint $id cannot close: ## Wrapup Gates has a row with empty or placeholder reason."
    echo "Add a reason for each gate before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | grep -qE '^\|[^|]+\|[[:space:]]*ran[[:space:]]*\|'; then
    echo "Sprint $id cannot close: ## Wrapup Gates has no 'ran' rows — at least one gate must run."
    return 1
  fi
}

_gate_no_unchecked() {
  local id="$1" acceptance="$2"
  if grep -qE '^[[:space:]]*[-*] \[ \]' "$acceptance"; then
    echo "Sprint $id is not complete. Unchecked acceptance/test items remain:"
    grep -E '^[[:space:]]*[-*] \[ \]' "$acceptance" || true
    return 1
  fi
}

_gate_plan_signoff() {
  local id="$1" plan="$2"
  # Trivial-tier sprints skip the sign-off gate — anchored to the Tier: field
  # itself (line-start match), so "tier: trivial" appearing in free text
  # elsewhere in ## Sign-off (e.g. a Risk: one-liner discussing the decision)
  # can't accidentally trigger the skip.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  if ! grep -q "^## Sign-off" "$plan"; then
    echo "Sprint $id cannot close: plan.md is missing ## Sign-off section."
    echo "Add the Sign-off section and check the approval box before closing."
    return 1
  fi
  if _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[ \]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has unchecked items."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
  if ! _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[[xX]\]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has no checked approval."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
}

_gate_plan_content() {
  local id="$1" plan="$2"
  # Extract ## Approach section, strip HTML comments and blank lines
  local content
  content="$(_acceptance_section "Approach" "$plan" \
    | sed 's/<!--[^>]*-->//g' \
    | sed '/^[[:space:]]*$/d')"
  if [[ -z "$content" ]]; then
    echo "Sprint $id cannot close: plan.md ## Approach has no content."
    echo "Describe the implementation approach in plan.md, then re-run."
    return 1
  fi
}

_gate_visual_embed() {
  local id="$1"
  "$SCRIPT_DIR/validate-visuals.sh" "$id" "$2" "$3"
}

# _gate_dispatch_notice <evaluator|reviewer> <file> — the closing lines of every message about a gate report that is
# missing or cannot be verified. t-b2a9: a weak model read "eval-report.md is missing" as "create it" and hand-wrote the
# file, bypassing the gate; say who writes it and that it is never hand-made.
_gate_dispatch_notice() {
  local role="$1" file="$2" step=3
  [[ "$role" == reviewer ]] && step=2
  echo "$file is written ONLY by a fresh $role SUBAGENT: dispatch one (Agent tool, subagent_type \"canon-$role\"; skills/sprint/reference/complete.md step $step)."
  echo "Never create or edit $file yourself — a hand-made report is a bypassed gate."
}

# _gate_eval_report_exists <id> <tdir> — report file present, evaluator-run-id
# field present. Fails closed: missing report or field blocks close.
_gate_eval_report_exists() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if [[ ! -f "$report" ]]; then
    echo "Sprint $id cannot close: eval-report.md is missing."
    _gate_dispatch_notice evaluator eval-report.md
    echo "(Only if the work is genuinely trivial and none of SKILL.md's four not-trivial triggers applies: plan.md's Sign-off says Tier: trivial — complete.md step 3.)"
    return 1
  fi
  if ! grep -qE '^evaluator-run-id:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: eval-report.md is missing evaluator-run-id field."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_model <id> <tdir> — HARD RULE (t-072d): the report body must
# carry the templated `Model: <designation>` line so every close records which
# model graded it. Enforced here (inside _gate_eval_report, after the trivial-tier
# early return) so it never fires on a trivial sprint. Regressed silently across
# t-2c9e..t-3864 when subagents wrote free-form reports and dropped the line — the
# model still showed in the Wrapup Gates table (orchestrator-written), so nothing
# caught it. See eval.md's report template and shared-gate-protocol.md ## Inputs.
_gate_eval_report_model() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if ! grep -qE '^Model:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: eval-report.md is missing the 'Model:' line (HARD RULE)."
    echo "The evaluator must record the model it ran on, verbatim, per eval.md's report template (e.g. 'Model: claude-opus-4.8')."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_authentic <id> <tdir> — the evaluator-run-id must have a
# valid timestamp prefix and a matching entry in .claude/subagent-runs.jsonl
# within a ±60 min window. Fail closed, not open: a missing jsonl or
# unparseable run-id must block close, not silently skip verification — an
# unlogged/hand-written eval would otherwise satisfy this gate by just
# containing "pass:" in the verdict check that follows.
_gate_eval_report_authentic() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  local run_id run_epoch jsonl
  run_id="$(grep -E '^evaluator-run-id:[[:space:]]+\S' "$report" | head -1 | sed 's/^evaluator-run-id:[[:space:]]*//')"
  run_epoch="$(echo "$run_id" | cut -d'-' -f1)"
  jsonl="$(project_root)/.claude/subagent-runs.jsonl"
  if [[ ! -f "$jsonl" ]]; then
    echo "Sprint $id cannot close: .claude/subagent-runs.jsonl not found — cannot verify evaluator-run-id '$run_id' against a real subagent run."
    echo "After a real evaluator subagent run, log it with subagent-log.sh (it records a run that happened; it does not create one)."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  if [[ ! "$run_epoch" =~ ^[0-9]+$ ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no valid timestamp prefix. See eval.md step 1: generate it with 'date +%s'/'\$RANDOM', never uuidgen/PowerShell."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  # t-bdfb: some evaluators emit a JS Date.now() *millisecond* timestamp instead
  # of `date +%s` *seconds* (eval.md step 1). A seconds epoch is 10 digits (and
  # stays so until year 2286); a millisecond epoch is 13. Normalize a >=13-digit
  # prefix to seconds so the ±60 min match below still works. The run-id is a
  # correlation handle, not a security token (t-690a) — matched only by a time
  # window — so normalizing its units changes no authenticity property. Pure-bash
  # integer arithmetic, Git-Bash-safe (t-f04f). Force base-10 (10#) so a
  # pathological leading-zero prefix can't be misparsed as octal by $(( )) and
  # abort with an internal error instead of a clean fail-closed message.
  local run_len=${#run_epoch}
  run_epoch=$(( 10#$run_epoch ))
  if (( run_len >= 13 )); then
    run_epoch=$(( run_epoch / 1000 ))
  fi
  local matched=0 line ts entry_epoch diff malformed=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    ts="$(printf '%s' "$line" | grep -o '"ts"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/')"
    [[ -z "$ts" ]] && { malformed=$((malformed + 1)); continue; }
    [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || { malformed=$((malformed + 1)); continue; }
    entry_epoch="$(date -u -d "$ts" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null)" || continue
    [[ "$entry_epoch" =~ ^[0-9]+$ ]] || continue
    diff=$(( entry_epoch - run_epoch ))
    (( diff < 0 )) && diff=$(( -diff ))
    if (( diff <= 3600 )); then
      matched=1
      break
    fi
  done < "$jsonl"
  if [[ "$matched" != "1" ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no matching subagent entry in .claude/subagent-runs.jsonl (±60 min window)."
    echo "The eval must be run as a real subagent invocation — inline writes are not accepted."
    _gate_dispatch_notice evaluator eval-report.md
    # t-c94f: entries without an ISO "ts" (e.g. an integer "timestamp" from a hand-written or
    # non-canon writer) are skipped above. Say so, or the closer sees only the generic line.
    if (( malformed > 0 )); then
      echo "Note: $malformed entr$([[ $malformed -eq 1 ]] && echo y || echo ies) in .claude/subagent-runs.jsonl ha$([[ $malformed -eq 1 ]] && echo s || echo ve) no ISO \"ts\" field (e.g. an integer \"timestamp\") and $([[ $malformed -eq 1 ]] && echo is || echo are) ignored."
      echo "After a real evaluator subagent run, log it with subagent-log.sh --agent-type evaluator (it records a run that happened; it does not create one) — do not hand-edit the file."
    fi
    return 1
  fi
}

# _transcript_has_all <file> <newline-separated fixed strings> — every non-empty string occurs in the file.
_transcript_has_all() {
  local f="$1" needle
  while IFS= read -r needle; do
    [[ -n "$needle" ]] || continue
    grep -qF -e "$needle" "$f" || return 1
  done <<< "$2"
  return 0
}

# _gate_eval_report_transcript <id> <tdir> — t-0231: the report must be backed by the harness's own transcript of a real
# canon-evaluator dispatch. subagent-runs.jsonl cannot prove one (subagent-log.sh writes whatever --agent-id it is given,
# with empty session and transcript fields), but Claude Code keeps every subagent's transcript, which an agent cannot write:
#   <config>/projects/<slug>/<session>/subagents/agent-<id>.jsonl  +  agent-<id>.meta.json ("agentType": "canon-evaluator")
# The evaluator writes its report in one Bash call and prints its run-id, so the transcript holds the run-id, the ticket id
# (it works in .tickets/<id>) and the verdict line. Required, in one canon-evaluator transcript from ANY session or project
# (a sprint resumed in a new session must still verify) modified inside the run-id's window: the run-id, this ticket's id,
# and the report's verdict-line prefix (a hand-flipped fail: -> pass: no longer appears). It guards against a weak model
# re-creating the report, not against someone who unsets CLAUDECODE. Fails OPEN, with a Note, where the check cannot be
# made: not under Claude Code (Copilot, pi, Codex), or a config root with no subagent transcripts ever (layout unrecognised,
# e.g. a Windows install not yet confirmed). Fails CLOSED once Claude Code and its layout are recognised.
_gate_eval_report_transcript() {
  local id="$1" tdir="$2"
  local report="$tdir/eval-report.md"   # a separate `local`: under bash 3.2 + set -u one word cannot use the previous word's value
  local cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}"
  if [[ -z "${CLAUDECODE:-}" ]]; then
    echo "Note: transcript check skipped (not running under Claude Code): eval-report.md is not verified against a harness transcript here."
    return 0
  fi
  local d recognised=0
  for d in "$cfg"/projects/*/*/subagents; do
    [[ -d "$d" ]] && { recognised=1; break; }
  done
  if (( ! recognised )); then
    echo "Note: transcript check skipped (no Claude Code subagent transcripts under $cfg/projects, so the layout is not recognised): eval-report.md is not verified against a harness transcript here."
    return 0
  fi
  local run_id run_epoch run_len now start_min end_min
  run_id="$(grep -E '^evaluator-run-id:[[:space:]]+\S' "$report" | head -1 | sed 's/^evaluator-run-id:[[:space:]]*//; s/[[:space:]]*$//')"
  run_epoch="${run_id%%-*}"
  [[ "$run_epoch" =~ ^[0-9]+$ ]] || return 0   # _gate_eval_report_authentic already blocked a run-id with no timestamp prefix
  run_len=${#run_epoch}
  run_epoch=$(( 10#$run_epoch ))
  (( run_len >= 13 )) && run_epoch=$(( run_epoch / 1000 ))
  now="$(date +%s)"
  # window: from a minute before the run-id to an hour after it (find -mmin counts minutes AGO)
  start_min=$(( (now - run_epoch + 60) / 60 + 1 ))
  end_min=$(( (now - run_epoch - 3600) / 60 ))
  # EVERY verdict line must be backed, not just the first: the verdict gate accepts any `^pass:` line, so a `pass:` line appended
  # under a genuine `fail:` would otherwise ride on it. A short `pass:` line verifies nothing (bare `pass:` is a substring of every
  # evaluator transcript: the eval.md template reads `pass: <one sentence>`), so it is refused; a short `fail:` line cannot
  # pass the verdict gate by itself and is not checked here.
  local vline vprefix prefixes=""
  while IFS= read -r vline; do
    [[ -n "$vline" ]] || continue
    vprefix="$(printf '%s' "$vline" | LC_ALL=C sed -E 's/[^ -~].*$//; s/["\\].*$//' | cut -c1-60)"
    if (( ${#vprefix} < 8 )); then
      [[ "$vline" == pass:* ]] || continue
      echo "Sprint $id cannot close: eval-report.md's verdict line is too short to verify against a transcript (it should read 'pass: <one sentence>')."
      _gate_dispatch_notice evaluator eval-report.md
      return 1
    fi
    prefixes="$prefixes$vprefix"$'\n'
  done < <(grep -E '^(pass|fail):' "$report" | tr -d '\r')
  local needles="$run_id"$'\n'"$id"$'\n'"$prefixes"
  local f meta found=0
  local -a find_args=("$cfg/projects/" -path '*/subagents/agent-*.jsonl' -type f -mmin "-$start_min")
  (( end_min > 0 )) && find_args+=(! -mmin "-$end_min")
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    meta="${f%.jsonl}.meta.json"
    [[ -f "$meta" ]] || continue
    if ! grep -qE '"agentType"[[:space:]]*:[[:space:]]*"canon-evaluator"' "$meta"; then
      # The documented fallback (complete.md step 3) dispatches the evaluator as `Plan` when canon's agent files are not installed
      # (an unrefreshed project, Codex/Pi): accept it only when the transcript shows the evaluator protocol it was told to follow.
      # A canon-reviewer, a general-purpose agent, or a Plan agent doing something else still does not count.
      grep -qE '"agentType"[[:space:]]*:[[:space:]]*"Plan"' "$meta" && grep -qF -e "reference/eval.md" "$f" || continue
    fi
    _transcript_has_all "$f" "$needles" || continue
    found=1
    break
  done < <(find "${find_args[@]}" 2>/dev/null)
  if (( ! found )); then
    echo "Sprint $id cannot close: no canon-evaluator transcript backs evaluator-run-id '$run_id'."
    echo "Looked in $cfg/projects/*/*/subagents for a canon-evaluator transcript (or a Plan one that shows reference/eval.md), modified from a minute before the run-id to an hour after it, that contains the run-id, this ticket's id and the report's verdict line. A report no real evaluator run wrote — typed by hand, edited after the run, or copied from another ticket — has none. (Claude Code deletes old subagent transcripts after a while: for a long-finished evaluator run, dispatch the evaluator again.)"
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_verdict <id> <tdir> — verdict must be pass:, or
# eval_override: true plus a dated waiver in acceptance.md (see
# _eval_override_has_dated_waiver's own header comment for why this check
# stays coarse rather than mechanically re-deriving per-item coverage).
_gate_eval_report_verdict() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if ! grep -qE '^pass:' "$report"; then
    local ticket_file="$tdir/ticket.md" override
    override="$(get_field "$ticket_file" eval_override 2>/dev/null)"
    if [[ "$override" == "true" ]]; then
      if _eval_override_has_dated_waiver "$tdir/acceptance.md"; then
        echo "Sprint $id: eval-report.md verdict is not pass, but eval_override: true is set and acceptance.md has a dated waiver on record — allowing close. Per-item waiver coverage was confirmed at the human close-gate (complete.md steps 4-5), not re-derived mechanically here (t-c0e6: per-item correlation between eval-report.md and acceptance.md cannot be made sound — see DECISIONS.md)." >&2
        return 0
      fi
      echo "Sprint $id cannot close: eval_override: true is set, but acceptance.md has no dated waiver on record." >&2
      return 1
    fi
    echo "Sprint $id cannot close: eval-report.md verdict is not pass."
    grep -E '^(pass|fail):' "$report" | head -1 || echo "(no verdict line found)"
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_consistency <id> <tdir> — structural self-consistency backstop
# (t-eabb). Makes `not-run` a first-class, non-coercible verdict: a `pass:` verdict
# must not be contradicted by the report's own status tables. If any criterion or
# test-plan row is graded `not-run` (a load-bearing check that could NOT execute) or
# `partial` (incomplete), eval.md's verdict rule requires the verdict line to be
# `fail:` — a pass cannot stand while a check's result is unknown or incomplete. This
# catches the accidental coercion where an honest `not-run`/`partial` row sits under a
# `pass:` verdict; it does not claim to defeat deliberate forgery (an evaluator could
# omit the row) — honest path easy, dishonest path loud (t-277d/t-6098). Structural
# only: the report's own verdict token vs its own status tokens, never a semantic
# re-derivation of the work (t-c0e6). Runs only on the `pass:` path — a non-pass
# verdict is already handled by _gate_eval_report_verdict (block, or the eval_override
# dated-waiver path, which has no `pass:` line), so this never double-blocks the
# waiver. Pure-bash grep, Git-Bash/CRLF-safe: the status token is matched pipe-bounded
# mid-line so a trailing \r never breaks it, and no python3/uuidgen/PowerShell is used
# (t-f04f). `| pass / fail / partial |` template placeholders do NOT match — the cell
# must be whitespace + a single token + whitespace.
_gate_eval_report_consistency() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  grep -qE '^pass:' "$report" || return 0
  if grep -qE '\|[[:space:]]*(not-run|partial)[[:space:]]*\|' "$report"; then
    echo "Sprint $id cannot close: eval-report.md verdict is 'pass:' but a status row is graded 'not-run' or 'partial'."
    echo "Per eval.md's verdict rule, any not-run (a check that could not execute) or partial forces the verdict to 'fail:' — a pass cannot stand while a check's result is unknown or incomplete."
    grep -nE '\|[[:space:]]*(not-run|partial)[[:space:]]*\|' "$report" | head -3
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _canon_setup_edit_only <wroot> <graded> <path> — t-52f0: true when the project-root .gitignore or .gitattributes at <path> is exactly
# what canon's own skill setup makes of the graded file, so _gate_eval_report_fresh (below) can let registration's uncommitted edit
# through (without it a fresh project's first close was refused). It replays the real writers, never a copy of their lines: the graded
# file as git checks it out (`cat-file --filters`), in a scratch repo, through _ensure_mirror_gitignored alone (a project's own
# .claude/agents gets no line), then _ensure_agents_link_gitignored in either order (skills add: mirror first; link_worktree: agents
# first), or through ensure_gitattributes; the working-tree file must match one result byte for byte. Order, CRs and duplicates therefore count (break-it found a line-set check too loose). A
# symlink, a deleted file or a failed git call is false.
_canon_setup_edit_only() (   # a subshell, so its EXIT trap removes the scratch repo on any exit without touching the caller's traps
  wroot="$1" graded="$2" path="$3" name="${3##*/}"
  case "$name" in
    .gitignore) variants="m ma am" ;;
    .gitattributes) variants="g" ;;
    *) exit 1 ;;
  esac
  [[ -f "$wroot/$path" && ! -L "$wroot/$path" ]] || exit 1
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/canon-gate.XXXXXX")" || exit 1   # a template: macOS mktemp -d alone ignores TMPDIR
  trap 'rm -rf "$tmp"' EXIT
  git -C "$tmp" init -q >/dev/null 2>&1 || exit 1
  git -C "$wroot" cat-file --filters "$graded:$path" > "$tmp/prior" 2>/dev/null || exit 1
  for v in $variants; do
    cp "$tmp/prior" "$tmp/$name" || exit 1
    ( SKILLS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
      source "$SCRIPT_DIR/skills/lib.sh" && source "$SCRIPT_DIR/skills/project.sh" && source "$SCRIPT_DIR/skills/prompts.sh" || exit 1
      case "$v" in
        m) _ensure_mirror_gitignored "$tmp" ;;
        ma) _ensure_mirror_gitignored "$tmp" && _ensure_agents_link_gitignored "$tmp" ;;
        am) _ensure_agents_link_gitignored "$tmp" && _ensure_mirror_gitignored "$tmp" ;;
        g) ensure_gitattributes "$tmp" ;;
      esac ) >/dev/null 2>&1 || true   # the byte compare below is the check, not the writer's status
    cmp -s "$tmp/$name" "$wroot/$path" && exit 0
  done
  exit 1
)

# _gate_eval_report_fresh <id> <tdir> — t-1b74: the report must record the commit the evaluator graded (graded-head:,
# eval.md step 8), and no tracked file outside the late-doc/artifact paths below may differ from it. Without this a code change made
# after the binding verdict closes on stale evidence. The evaluator attests the commit (it is what that fresh run read), so this guards
# a forgotten re-grade, not a lying evaluator (same stance as _gate_eval_report_consistency). Fails closed on a missing, ambiguous or
# non-commit value; skipped where git cannot be asked (no repository or no commit yet). eval_override does not bypass it: the override
# covers a failing verdict, not stale evidence. Untracked files are ignored: a tree always has some, and sprint files are committed
# before grading (complete.md step 1). The paths below are written after grading by design (complete.md steps 6-8), or are dist/ from
# older checkouts (the post-commit hook commits nothing now, t-9383); anything else an agent touches after grading is stale.
_gate_eval_report_fresh() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md" heads graded changed n shown f
  local late_re="^(\\.tickets/|$MERGE_SAFE_LATE_ALT|DECISIONS\\.md\$|DECISIONS-archive\\.md\$|HANDOFF\\.md\$|PROMOTED\\.md\$|AGENTS\\.md\$|(.+/)?CLAUDE\\.md\$|\\.claude/subagent-runs\\.jsonl\$|dist/)"
  local wroot proot rel
  # The caller's OWN worktree, not project_root (which maps a linked worktree back to the main checkout): the graded commit and the
  # sprint's changes live in the worktree the sprint ran in. project_root only locates the project subtree inside its repository.
  wroot="$(worktree_root)"
  git -C "$wroot" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0
  proot="$(cd "$(project_root)" && pwd -P)"
  # The project's path inside its repository, asked of git itself: comparing `pwd -P` with --show-toplevel never matches on Windows
  # (/tmp/x vs C:/.../x), which built a bogus pathspec and passed every stale edit (t-7301).
  rel="$(git -C "$proot" rev-parse --show-prefix 2>/dev/null)" || rel=""
  rel="${rel%/}"
  heads="$(sed -n 's/^graded-head:[[:space:]]*//p' "$report" | tr -d '\r' | sort -u)"
  if [[ -z "$heads" ]]; then
    echo "Sprint $id cannot close: eval-report.md is missing graded-head: (the commit the evaluator graded, eval.md step 8)."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  if [[ "$(printf '%s\n' "$heads" | wc -l | tr -d ' ')" -gt 1 ]]; then
    echo "Sprint $id cannot close: eval-report.md has more than one graded-head value, so the graded commit is ambiguous."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  graded="$heads"
  if [[ ! "$graded" =~ ^[0-9a-f]{40,64}$ ]] || ! git -C "$wroot" cat-file -e "${graded}^{commit}" 2>/dev/null; then
    echo "Sprint $id cannot close: eval-report.md graded-head '$graded' is not a commit in this repository."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  # --no-renames: a rename's old path must count; quotepath off: non-ASCII paths come back verbatim so the allow-list matches them.
  if [[ -n "$rel" ]]; then
    changed="$(git -C "$wroot" -c core.quotepath=off diff --no-renames --name-only --relative="$rel" "$graded" -- "$rel" 2>/dev/null | grep -vE "$late_re" || true)"
  else
    changed="$(git -C "$wroot" -c core.quotepath=off diff --no-renames --name-only "$graded" -- . 2>/dev/null | grep -vE "$late_re" || true)"
  fi
  # canon's own setup edit to the project's .gitignore/.gitattributes is not a change after grading (t-52f0); exact lines only.
  for f in .gitignore .gitattributes; do
    if [[ $'\n'"$changed"$'\n' == *$'\n'"$f"$'\n'* ]] && _canon_setup_edit_only "$wroot" "$graded" "${rel:+$rel/}$f"; then
      changed="$(printf '%s\n' "$changed" | grep -vxF "$f" || true)"
    fi
  done
  [[ -n "$changed" ]] || return 0
  n="$(printf '%s\n' "$changed" | wc -l | tr -d ' ')"
  shown="$(printf '%s\n' "$changed" | sed -n '1,5p' | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
  echo "Sprint $id cannot close: tracked files changed after the evaluator graded (graded-head ${graded:0:7}; $n file(s): $shown)."
  echo "The verdict does not cover a change made after it: re-dispatch a fresh evaluator (complete.md step 3). Do not edit graded-head to match."
  _gate_dispatch_notice evaluator eval-report.md
  return 1
}

# _gate_reject <id> <ticket dir> <role> <reason> — a gate.rejected event (t-8854) for a refusal just printed. Observer-only.
_gate_reject() {
  canon_event gate.rejected sprint "$(dirname "$(dirname "$2")")" "ticket=$1" "role=$3" "reason=$4"
}

_gate_eval_report() {
  local id="$1" tdir="$2"
  local plan="$tdir/plan.md"
  # Trivial-tier sprints skip the evaluator — same field-anchored check as
  # _gate_plan_signoff, so this can't be skipped by a stray "tier: trivial"
  # mention in free text elsewhere in plan.md.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  _gate_eval_report_exists      "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator missing_report; return 1; }
  _gate_eval_report_authentic   "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator unverified_run; return 1; }
  _gate_eval_report_transcript  "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator missing_transcript; return 1; }
  _gate_eval_report_verdict     "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator verdict_not_pass; return 1; }
  _gate_eval_report_consistency "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator report_inconsistent; return 1; }
  _gate_eval_report_model       "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator report_model; return 1; }
  _gate_eval_report_fresh       "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator graded_head_stale; return 1; }
}

# _gate_review_notes_model <id> <tdir> — HARD RULE (t-072d): if the advisory
# reviewer ran, its report must record the model too. Fires ONLY when
# review-notes.md exists, so reviewer-skipped tiers (bugfix/demo/trivial, which
# write no review-notes.md) are unaffected — no tier detection needed here.
_gate_review_notes_model() {
  local id="$1" tdir="$2" report="$tdir/review-notes.md"
  [[ -f "$report" ]] || return 0
  if ! grep -qE '^Model:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: review-notes.md is missing the 'Model:' line (HARD RULE)."
    echo "The reviewer must record the model it ran on, verbatim, per review.md's report template (e.g. 'Model: claude-opus-4.8')."
    _gate_dispatch_notice reviewer review-notes.md
    return 1
  fi
}

# Concern labels the reviewer must show a pass for (t-de16). One owner: review.md's report
# template lists the same five, and tests/doc-mirror-parity.sh fails if they drift.
REVIEW_CONCERNS=("Scope creep" "Visual regression" "Dead code" "Unnecessary complexity" "Standards violations")
# Triage buckets every finding is sorted into (t-f13a); the verdict is YES exactly when Act On is none. Same one owner
# and parity check as REVIEW_CONCERNS.
REVIEW_BUCKETS=("Act On" "Consider" "Noted" "Dismissed")

# _review_notes_shape_problems <report> — t-de16, t-c38e: print one "  - <problem>" line per shape problem of a
# review-notes.md, nothing when it is well formed: a `Changed files:` line with at least one path, and one line per concern
# that is a finding or `none — checked <what>, <file:line>`. Rejects the bare "No findings. / YES" report (live defect t-294b:
# two runs wrote the same 111 bytes, one over an EMPTY diff). This checks shape, not truthfulness — a false
# `none — checked x.js:3` still passes. The one owner of the rule: `sprint complete` and `sprint check-review-notes` both call it.
_review_notes_shape_problems() {
  local report="$1" cf label vals val lower
  cf="$(grep -m1 -E '^Changed files:' "$report" | sed -E 's/^Changed files:[[:space:]]*//; s/\r$//')" || true
  lower="$(printf '%s' "$cf" | tr '[:upper:]' '[:lower:]')"
  if [[ -z "$cf" ]]; then
    echo '  - no `Changed files:` line'
  elif [[ "$lower" =~ ^(none|n/a|na|empty|-)([^[:alnum:]_./-]|$) ]] || ! [[ "$cf" =~ [[:alnum:]_-]+[./][[:alnum:]_.-]+ ]]; then
    echo '  - `Changed files:` lists no path (an empty diff usually means a wrong base ref)'
  fi
  for label in "${REVIEW_CONCERNS[@]}"; do
    vals="$(grep -E "^[[:space:]]*[-*]?[[:space:]]*${label}:" "$report" | sed -E "s/^[[:space:]]*[-*]?[[:space:]]*${label}:[[:space:]]*//; s/\r$//")" || true
    if ! printf '%s' "$vals" | grep -q '[^[:space:]]'; then
      echo "  - no line for the \"$label\" concern"
      continue
    fi
    while IFS= read -r val; do
      [[ -n "${val//[[:space:]]/}" ]] || continue
      lower="$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]')"
      if [[ "$lower" =~ ^none([^[:alnum:]_]|$) ]] && { ! [[ "$lower" =~ checked ]] || ! [[ "$val" =~ [^[:space:]]+:[0-9]+ ]]; }; then
        echo "  - the \"$label\" \`none\` line must say what was checked and cite a file:line"
      fi
    done <<< "$vals"
  done
  for label in "${REVIEW_BUCKETS[@]}"; do
    grep -qE "^[[:space:]]*[-*]?[[:space:]]*${label}:[[:space:]]*[^[:space:]]" "$report" || echo "  - no line for the \"$label\" triage bucket"
  done
  # The verdict (first word under `## Verdict`, bold stripped) must match Act On: YES exactly when every Act On line is `none`.
  local verdict act
  verdict="$(awk '/^##[[:space:]]+Verdict/ { f=1; next } f && /[^[:space:]]/ { sub(/\r$/, ""); gsub(/\*/, ""); print toupper($1); exit }' "$report")"
  act="$(grep -E "^[[:space:]]*[-*]?[[:space:]]*Act On:[[:space:]]*[^[:space:]]" "$report" | sed -E 's/^[[:space:]]*[-*]?[[:space:]]*Act On:[[:space:]]*//; s/\r$//' | tr '[:upper:]' '[:lower:]')" || true
  if [[ -n "$act" ]]; then
    if grep -qvE '^none([^[:alnum:]_]|$)' <<< "$act"; then
      [[ "$verdict" != YES ]] || echo '  - the verdict is YES but `Act On:` lists a finding (YES means `Act On: none`)'
    else
      [[ "$verdict" != NO ]] || echo '  - the verdict is NO but `Act On: none` (NO means at least one Act On finding)'
    fi
  fi
  return 0
}

# _gate_review_notes_shape <id> <tdir> — t-de16: a review-notes.md that exists must SHOW its passes
# (_review_notes_shape_problems). Fires only when the file exists, like _gate_review_notes_model, so reviewer-skipped
# tiers are unaffected.
_gate_review_notes_shape() {
  local id="$1" tdir="$2" report problems
  report="$tdir/review-notes.md"
  [[ -f "$report" ]] || return 0
  problems="$(_review_notes_shape_problems "$report")"
  if [[ -n "$problems" ]]; then
    echo "Sprint $id cannot close: review-notes.md does not show the reviewer's passes (t-de16):"
    printf '%s\n' "$problems"
    echo "Re-dispatch the reviewer per review.md's report template: 'Changed files:' with paths, then one line per concern — a finding, or 'none — checked <what>, <file:line>' — then one '## Triage' line per bucket, with a verdict that matches 'Act On'."
    _gate_dispatch_notice reviewer review-notes.md
    return 1
  fi
}

# eval_override (t-c0e6) is deliberately coarse: it checks only that a human set the
# flag and that acceptance.md records at least one dated waiver — it does NOT try to
# mechanically re-derive which specific eval-report.md items that waiver covers.
#
# A per-item mechanical check was built and abandoned across five rounds of live
# adversarial review (see DECISIONS.md): text-matching between eval-report.md's
# "verbatim" criterion text and its acceptance.md bullet cannot be made sound (loose
# matching collides across bullets; strict matching breaks on real evaluator output);
# position-based correlation (report row N = acceptance.md's Nth bullet) then failed
# the same way — nested bullets and malformed tables drift positions without tripping
# a row-count guard, and even a pipe-safe row-count guard can't detect an evaluator
# merging/splitting rows while preserving the total count. Every version shipped
# failed OPEN, never closed. There is no third correlation key.
#
# `eval_override` is human-only to set (no tkt command writes it) — a human is always
# in the loop when it's used, so per-item "is THIS failing item actually waived" is
# verified by that human at complete.md's steps 4-5 close-gate, not re-derived here.
# Mirrors t-d8a1's precedent: no CLI gate is bypass-proof; the win is making the
# override explicit, dated, and greppable — not building an unfoolable verifier.
_eval_override_has_dated_waiver() {
  local acceptance="$1"
  [[ -f "$acceptance" ]] || return 1
  grep -qi 'waived' "$acceptance" && grep -iE 'waived' "$acceptance" | grep -qE '[0-9]{4}-[0-9]{2}-[0-9]{2}'
}

cmd_complete() {
  local id tdir acceptance
  local current_out current_rc
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  if [[ "$current_rc" -ne 0 ]]; then echo "No active sprint."; exit 1; fi
  id="$(awk '{print $1}' <<< "$current_out")"

  tdir="$(ticket_dir_for "$id")"
  acceptance="$tdir/acceptance.md"

  _gate_sprint_files        "$id" "$tdir" "$acceptance"  || exit 1
  _gate_acceptance_sections "$id" "$acceptance"          || exit 1
  _gate_wrapup_gates        "$id" "$acceptance"          || exit 1
  _gate_no_unchecked        "$id" "$acceptance"          || exit 1
  _gate_plan_content        "$id" "$tdir/plan.md"        || exit 1
  _gate_visual_embed        "$id" "$tdir/plan.md" "$acceptance" || exit 1
  _gate_plan_signoff        "$id" "$tdir/plan.md"        || exit 1
  _gate_eval_report         "$id" "$tdir"                || exit 1
  _gate_review_notes_model  "$id" "$tdir"                || { _gate_reject "$id" "$tdir" reviewer review_model; exit 1; }
  _gate_review_notes_shape  "$id" "$tdir"                || { _gate_reject "$id" "$tdir" reviewer review_shape; exit 1; }

  TKT_SPRINT_GATE_PASSED=1 "$TKT_BIN" close "$id"
  canon_event sprint.completed sprint "$(project_root)" "ticket=$id"
  echo "Sprint completed: $id"

  # t-2fb6: shrink old closed tickets' evidence/ (never this one: it is younger than the cut-off). The close already
  # happened, so a compact failure only warns.
  local compact_out compact_rc=0
  compact_out="$("$TKT_BIN" compact 2>&1)" || compact_rc=$?
  printf '%s\n' "$compact_out" | grep -E '^compact: (total|WARNING|ERROR)' || true
  if (( compact_rc != 0 )); then
    echo "warning: tkt compact exited $compact_rc; the close stands. Run 'tkt compact --dry-run' to see why."
  fi
  return 0
}

# cmd_check_review_notes <id> — t-c38e: the close gate's review-notes.md shape check, run on demand (read-only). The
# reviewer runs it before returning and the orchestrator right after the dispatch, so a malformed report is rewritten at
# once instead of being refused at `sprint complete`.
cmd_check_review_notes() {
  local id="${1:-}"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local report problems
  report="$(ticket_dir_for "$id")/review-notes.md"
  [[ -f "$report" ]] || { echo "review-notes.md: not found for $id ($report)" >&2; exit 1; }
  problems="$(_review_notes_shape_problems "$report")"
  if [[ -n "$problems" ]]; then
    echo "review-notes.md: shape refused — the same check sprint complete runs (t-de16):"
    printf '%s\n' "$problems"
    echo "Fix the report per review.md's template: 'Changed files:' with paths, then one line per concern — a finding, or 'none — checked <what>, <path>:<line>' (the word 'checked' and a path:line on that same line) — then one '## Triage' line per bucket (Act On, Consider, Noted, Dismissed), with YES exactly when 'Act On: none'."
    _gate_reject "$id" "$(dirname "$report")" reviewer review_shape
    exit 1
  fi
  echo "review-notes.md: shape ok"
}

# cmd_check_evidence <id> — t-a3d7: the pre-flight complete.md step 3 runs before dispatching the evaluator. Reads `evidence.sh check`
# (the one owner of what fresh/covered mean) at HEAD and refuses unless every top-level evidence log is `fresh` with exit 0 or
# `covered`; logs kept for history or produced off-tree belong in a subfolder of evidence/, which check never scans. Read-only.
# Exit 0 ok, 1 refused (each log named with how to fix it), 2 usage or a failed check.
cmd_check_evidence() {
  local id="${1:-}" out line bad=0 n=0 edir f name
  [[ "$id" =~ ^t-[0-9a-f]{4}$ ]] || { echo "usage: sprint check-evidence <ticket-id>" >&2; exit 2; }
  out="$("$SCRIPT_DIR/evidence.sh" check "$id" 2>&1)" || { echo "check-evidence: evidence.sh check failed: $out" >&2; exit 2; }
  # A log name `evidence.sh stamp` can never write (a space, `;`, a control character) could carry a fake `exit=0` inside the
  # line check prints for it, so such a name is refused outright; every name left then holds no space, and the matches below are exact.
  edir="${CANON_TICKETS_DIR:-$(tickets_dir)}/$id/evidence"
  for f in "$edir"/*.log; do
    [[ -e "$f" || -L "$f" ]] || continue   # no evidence folder, or no log in it: the glob stays literal
    name="${f##*/}"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9._-]*\.log$ ]]; then
      bad=$((bad + 1)); n=$((n + 1))
      echo "  REFUSE  $(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '?'): a name evidence.sh stamp never writes; rename it, or move it into a subfolder"
    fi
  done
  if [[ -z "$out" ]] && (( ! bad )); then
    echo "check-evidence: no stamped logs in .tickets/$id/evidence/ (nothing to reuse: the evaluator runs every check itself)"
    exit 0
  fi
  while IFS= read -r line; do
    [[ "$line" =~ ^[a-z]+\ ([^\ ]+)\  ]] && [[ ! "${BASH_REMATCH[1]}" =~ ^[a-z0-9][a-z0-9._-]*\.log$ ]] && continue   # refused above by name
    n=$((n + 1))
    if [[ "$line" =~ ^fresh\ [a-z0-9][a-z0-9._-]*\.log\ exit=0\ \( || "$line" =~ ^covered\ [a-z0-9][a-z0-9._-]*\.log\ exit=[0-9?]+\ \( ]]; then echo "  ok      $line"
    else bad=$((bad + 1)); echo "  REFUSE  $line"; fi
  done <<< "$out"
  if (( bad )); then
    echo "check-evidence: $bad of $n log(s) would fail or mislead the evaluator; do not dispatch it yet."
    echo "  stale      re-stamp at HEAD (evidence.sh stamp, from a plain clone for the full suite)"
    echo "  exit=N     fix the failure and re-stamp; for a full board spec failing only on new flakes, list them, then stamp"
    echo "             \`node tests/board-spec-guard.js <the run's --out dir>/board-spec-*-run*.json\` at HEAD (the run log becomes covered)"
    echo "  unstamped  stamp it, or move a history or off-tree log into a subfolder of evidence/ (never scanned)"
    _gate_reject "$id" "$(dirname "$edir")" evaluator stale_evidence
    exit 1
  fi
  echo "check-evidence: ok ($n log(s) fresh with exit 0 or covered)"
}

# cmd_relay_report <id> [evaluator|reviewer] — t-ff14: a read-only `Plan` fallback gate cannot write its report, and the main
# session must not type one (Claude Code's auto mode refuses that as a bypassed gate). This copies the report, byte for
# byte, from the harness's own transcript of the newest matching dispatch (Plan, or the canon agent itself) into its file:
# the transcript's SubagentHandback message (else last text) from `evaluator-run-id:` / `# Review Notes` on. The close
# check still verifies the evaluator's report against that same transcript. Refuses when no transcript holds it.
cmd_relay_report() {
  local id="${1:-}" role="${2:-evaluator}" tdir cfg marker proto agents dest f meta report found=""
  [[ -n "$id" ]] || { echo "Usage: sprint relay-report <id> [evaluator|reviewer]" >&2; exit 1; }
  case "$role" in
    evaluator) marker="evaluator-run-id:" proto="reference/eval.md" agents="canon-evaluator|Plan" dest="eval-report.md" ;;
    reviewer)  marker="# Review Notes"    proto="reference/review.md" agents="canon-reviewer|Plan" dest="review-notes.md" ;;
    *) echo "Usage: sprint relay-report <id> [evaluator|reviewer]" >&2; exit 1 ;;
  esac
  tdir="$(ticket_dir_for "$id")"
  [[ -d "$tdir" ]] || { echo "relay-report: no ticket folder for $id" >&2; exit 1; }
  cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}"
  # An older board binary takes an unknown first word for a port and would start serving: ask --help first (board_helper_bin).
  local board; board="$(board_bin)"
  case "$("$board" --help 2>/dev/null || true)" in
    *transcript-report*) ;;
    *) echo "relay-report: the installed board binary predates relay-report; run 'canon update' (or build the board), then retry" >&2; exit 1 ;;
  esac
  # newest first, within the last 3 hours: the dispatch just finished
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    meta="${f%.jsonl}.meta.json"
    [[ -f "$meta" ]] && grep -qE "\"agentType\"[[:space:]]*:[[:space:]]*\"($agents)\"" "$meta" || continue
    grep -qF -e "$proto" "$f" && grep -qF -e "$id" "$f" || continue
    report="$("$board" transcript-report "$f" "$marker" 2>/dev/null)" || continue
    found="$f"; break
  done < <(find "$cfg/projects/" -path '*/subagents/agent-*.jsonl' -type f -mmin -180 -exec ls -t {} + 2>/dev/null)
  if [[ -z "$found" ]]; then
    echo "relay-report: no $role transcript for $id (a Plan or canon-$role dispatch in the last 3 hours that read $proto and returned a report starting '$marker'). Dispatch the $role again." >&2
    exit 1
  fi
  printf '%s\n' "$report" > "$tdir/$dest"
  echo "relay-report: wrote $tdir/$dest from $found ($(sed -nE 's/.*"agentType"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "${found%.jsonl}.meta.json" | head -1))"
}

# cmd_eval_verdict <id> — records the evaluator's outcome into ticket.md's
# eval_fail_count field: increments on a fail (or missing/malformed verdict),
# resets to 0 on pass. Called explicitly by the agent right after reading
# eval-report.md (complete.md step 3), the same pattern as subagent-log.sh's
# explicit post-dispatch call — not a hook, so it works whether or not the
# orchestrating agent goes on to invoke `sprint complete` itself. Prints the
# resulting count and a retry-budget-exhausted notice at 3, but never blocks
# on its own — _gate_eval_report_verdict (cmd_complete) is the actual close gate.
cmd_eval_verdict() {
  local id="${1:-}"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local tdir report ticket_file
  tdir="$(ticket_dir_for "$id")"
  report="$tdir/eval-report.md"
  ticket_file="$tdir/ticket.md"
  [[ -f "$report" ]] || { echo "Sprint $id: eval-report.md not found." >&2; exit 1; }
  [[ -f "$ticket_file" ]] || { echo "Sprint $id: ticket.md not found." >&2; exit 1; }

  local current new
  current="$(get_field "$ticket_file" eval_fail_count 2>/dev/null)"
  [[ -z "$current" ]] && current=0

  if grep -qE '^pass:' "$report"; then
    new=0
  else
    new=$((current + 1))
  fi

  set_or_add_field "$ticket_file" eval_fail_count "$new"
  echo "$id: eval_fail_count=$new"
  if (( new >= 3 )); then
    echo "Sprint $id: evaluator has failed $new times in a row — retry budget exhausted. Diagnose the root cause outside the automated loop, or set eval_override: true with a dated waiver to close anyway." >&2
  fi
}

# --- suggest-tier: propose-only structural bugfix-tier classifier (t-b6a3) ---
# Reads the diff ONLY (never plan prose — t-8c24) and PROPOSES a tier; writes
# nothing. The human/agent still hand-writes `Tier: bugfix` in plan.md ## Sign-off.
# Mirrors complete.md's model-tier posture: merge-base EXIT STATUS decides, not
# empty diff output (t-f04f); allowlist, not denylist — any doubt -> normal.

# test source file — allowed as the covering test
_st_is_test() {
  local p="$1" b="${1##*/}"
  case "$p" in
    tests/*|test/*|spec/*|*/tests/*|*/test/*|*/spec/*|__tests__/*|*/__tests__/*) return 0 ;;
  esac
  case "$b" in
    *.test.*|*.spec.*|*_test.*|test_*.*|*Test.*|*Tests.*|*_spec.rb) return 0 ;;
  esac
  return 1
}

# build / test-infrastructure file (not-trivial trigger 2)
_st_is_infra() {
  local p="$1" b="${1##*/}"
  case "$p" in
    scripts/*|*/scripts/*) return 0 ;;
  esac
  case "$b" in
    package.json|package-lock.json|yarn.lock|pnpm-lock.yaml|tsconfig.json|tsconfig.*.json|jest.config.*|vitest.config.*|babel.config.*|.babelrc|.eslintrc*|.prettierrc*|Makefile|makefile|GNUmakefile|*.mk|CMakeLists.txt|go.mod|go.sum|Cargo.toml|Cargo.lock|requirements.txt|setup.py|setup.cfg|pyproject.toml|tox.ini|pom.xml|build.gradle|build.gradle.kts|Gemfile|Gemfile.lock) return 0 ;;
  esac
  return 1
}

# hook / pipeline / post-commit file (not-trivial trigger 3)
_st_is_hookpipe() {
  local p="$1" b="${1##*/}"
  case "$p" in
    .github/workflows/*|.github/actions/*|.circleci/*|hooks/*|*/hooks/*|.git/hooks/*) return 0 ;;
  esac
  case "$b" in
    .gitlab-ci.yml|Jenkinsfile|.travis.yml|azure-pipelines.yml|azure-pipelines.yaml|*pre-commit*|*post-commit*|*pre-push*|commit-msg) return 0 ;;
  esac
  return 1
}

_st_emit() {
  # _st_emit <tier> <reason>
  echo "suggested tier: $1"
  echo "reason: $2"
  echo 'note: propose-only — this suggests, it does not apply. The agent/human still writes `Tier: bugfix` in plan.md ## Sign-off if it applies.'
  echo 'caveat: only the structural shape is checked here. Whether the covering test asserts an independent invariant (not a re-derivation of the code) is a judgment owned by the binding evaluator (and eventually the t-5220 mutation-test), never verified mechanically.'
}

# cmd_suggest_tier [<id>] [--base-ref <ref>] — structural, propose-only.
# <id> is accepted for interface parity with the ticket's proposed name but is
# not required (the diff is repo-relative, not ticket-scoped).
cmd_suggest_tier() {
  local base="" id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-ref) base="${2:-}"; shift 2 || { echo "Error: --base-ref requires a value" >&2; exit 1; } ;;
      --base-ref=*) base="${1#*=}"; shift ;;
      -h|--help) echo "Usage: sprint suggest-tier [<id>] [--base-ref <ref>]"; return 0 ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *) id="$1"; shift ;;
    esac
  done
  : "${id:-}"  # accepted, intentionally unused for classification

  # Base ref: explicit override, else merge-base HEAD origin/main. Decide on
  # EXIT STATUS, not empty output (t-f04f) — a failed substitution can leave the
  # outer git diff running against a different, non-empty baseline.
  if [[ -z "$base" ]]; then
    if ! base="$(git merge-base HEAD origin/main 2>/dev/null)"; then
      _st_emit normal "no git baseline (git merge-base HEAD origin/main failed — missing origin/main, detached/zero-commit HEAD, or not a git repo)"
      return 0
    fi
  fi

  local diff_out
  if ! diff_out="$(git diff --name-status "$base" HEAD 2>/dev/null)"; then
    _st_emit normal "could not compute diff against base ref '$base'"
    return 0
  fi
  if [[ -z "$diff_out" ]]; then
    _st_emit normal "empty diff against '$base' — nothing to classify"
    return 0
  fi

  local logic_count=0 logic_file="" test_seen=""
  local status path rest
  while IFS=$'\t' read -r status path rest; do
    [[ -z "$status" ]] && continue
    # renames/copies report old<TAB>new — the surviving path is in $rest
    case "$status" in
      R*|C*) path="${rest:-$path}" ;;
    esac
    [[ -z "$path" ]] && continue

    if _st_is_hookpipe "$path"; then
      _st_emit normal "not-trivial trigger: hook/pipeline/post-commit change ($path)"; return 0
    fi
    if _st_is_infra "$path"; then
      _st_emit normal "not-trivial trigger: test/build-infrastructure wiring ($path)"; return 0
    fi
    if _st_is_test "$path"; then
      test_seen="$path"; continue
    fi
    # non-test, non-infra, non-hook = logic file
    if [[ "${status:0:1}" == "A" ]]; then
      _st_emit normal "not-trivial trigger: new file beyond the test ($path added)"; return 0
    fi
    logic_count=$((logic_count + 1))
    logic_file="$path"
  done <<< "$diff_out"

  if (( logic_count == 1 )); then
    local why="single logic file ($logic_file)"
    [[ -n "$test_seen" ]] && why="$why + covering test ($test_seen)"
    why="$why; none of the four not-trivial triggers present"
    _st_emit bugfix "$why"
  elif (( logic_count == 0 )); then
    _st_emit normal "no non-test logic file changed — nothing a bugfix would fix"
  else
    _st_emit normal "not-trivial trigger: coordinated multi-file intent ($logic_count non-test logic files changed)"
  fi
}

# cmd_gate_cost [--last N] — t-5ef3: one screen of close-gate cost from .claude/subagent-runs.jsonl. Only rows that
# carry `tokens` (subagent-log.sh --tokens …) count; older rows have no numbers and are skipped, not read as zero.
# Groups the last N measured runs by gate type × tier × model (t-3a14; `-` when the row has none). Read-only; plain awk (no python, for Git Bash).
cmd_gate_cost() {
  local last=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --last) last="${2:-}"; shift 2 || { echo "Error: --last requires a value" >&2; exit 1; } ;;
      -h|--help) echo "Usage: sprint gate-cost [--last N]"; return 0 ;;
      *) echo "Error: unknown argument: $1" >&2; exit 1 ;;
    esac
  done
  [[ "$last" =~ ^[1-9][0-9]*$ ]] || { echo "Error: --last must be a positive whole number" >&2; exit 1; }
  local jsonl
  jsonl="$(project_root)/.claude/subagent-runs.jsonl"
  [[ -f "$jsonl" ]] || { echo "No gate runs logged: $jsonl not found."; return 0; }
  awk -v last="$last" '
    function field(name,   m) {
      if (match($0, "\"" name "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"")) { m = substr($0, RSTART, RLENGTH); sub(/^[^:]*:[[:space:]]*"/, "", m); sub(/"$/, "", m); return m }
      if (match($0, "\"" name "\"[[:space:]]*:[[:space:]]*[0-9.]+")) { m = substr($0, RSTART, RLENGTH); sub(/^[^:]*:[[:space:]]*/, "", m); return m }
      return ""
    }
    function median(list,   a, n, i, j, t) {
      n = split(list, a, " ")
      for (i = 2; i <= n; i++) { t = a[i] + 0; for (j = i - 1; j >= 1 && a[j] + 0 > t; j--) a[j + 1] = a[j]; a[j + 1] = t }
      return (n % 2) ? a[(n + 1) / 2] + 0 : (a[n / 2] + a[n / 2 + 1]) / 2
    }
    { tok = field("tokens"); if (tok == "") next
      n++; T[n] = tok; M[n] = field("minutes"); O[n] = field("outcome")
      ty = field("agent_type"); ti = field("tier"); mo = field("model")
      G[n] = (ty == "" ? "-" : ty) "\t" (ti == "" ? "-" : ti) "\t" (mo == "" ? "-" : mo) }
    END {
      if (n == 0) { print "No measured gate runs yet: log them with subagent-log.sh --tokens N --minutes M --tool-uses K."; exit }
      start = (n > last) ? n - last + 1 : 1
      for (i = start; i <= n; i++) {
        g = G[i]; if (!(g in C)) order[++ng] = g
        C[g]++; TL[g] = TL[g] " " T[i]; if (T[i] + 0 > TW[g]) TW[g] = T[i] + 0
        if (M[i] != "") { MC[g]++; ML[g] = ML[g] " " M[i]; if (M[i] + 0 > MW[g]) MW[g] = M[i] + 0 }
        if (O[i] == "fail" || O[i] == "budget") F[g]++
      }
      printf "Close-gate cost, last %d measured run(s):\n", n - start + 1
      printf "%-10s %-8s %-18s %4s %10s %10s %8s %9s %11s\n", "gate", "tier", "model", "runs", "tok-med", "tok-worst", "min-med", "min-worst", "fail/budget"
      for (k = 1; k <= ng; k++) {
        g = order[k]; split(g, p, "\t")
        mm = MC[g] ? sprintf("%.1f", median(ML[g])) : "-"; mw = MC[g] ? sprintf("%.1f", MW[g]) : "-"
        printf "%-10s %-8s %-18s %4d %10d %10d %8s %9s %10d%%\n", p[1], p[2], p[3], C[g], median(TL[g]), TW[g], mm, mw, int(100 * F[g] / C[g] + 0.5)
      }
    }' "$jsonl"
}

cmd_help() {
  cat <<'EOF'
sprint — canon workflow spine

Usage:
  sprint start "title"      Create a new ticket and start the sprint
  sprint start <ticket-id>  Start the sprint on an existing ticket (no new ticket created)
  sprint continue <ticket-id>  Resume an in_progress ticket (read-only; prints state)
  sprint import-issue <N> [--body-file F] [--force]
                            In a cloud session: rebuild the ticket a `tkt send-issue`
                            issue carries, then start its sprint
  sprint current            Show the active sprint ticket
  sprint status [--json]    Show active ticket and required sprint files; --json:
                            {"active":bool,"ticket":<tkt show --json>,"files":{name:bool}}
  sprint complete           Validate acceptance checklist and close ticket
  sprint suggest-tier [<id>]  Propose (never apply) a bugfix|normal tier from the
                            diff — structural, propose-only; the human still writes
                            `Tier: bugfix` in plan.md ## Sign-off
  sprint eval-verdict <id>  Record the evaluator's pass/fail into ticket.md's
                            eval_fail_count (internal — called by complete.md
                            step 3, not run directly)
  sprint relay-report <id> [evaluator|reviewer]  Copy a read-only (Plan) gate's report
                            from the harness transcript into its file, byte for byte
                            (the main session never types a gate report)
  sprint check-review-notes <id>  Check review-notes.md's shape with the same rule
                            sprint complete applies (read-only; exit 1 names each
                            problem) — the reviewer runs it before returning
  sprint gate-cost [--last N]  Close-gate cost from .claude/subagent-runs.jsonl: the
                            last N (30) measured runs by gate type × tier — median and
                            worst tokens and minutes, % fail or budget stop (read-only)
  sprint check-evidence <id>  Pre-flight before the evaluator: every stamped
                            evidence log is fresh with exit 0, or covered
                            (read-only; exit 1 names each log and the fix)

The CLI owns deterministic workflow state. The agent still owns orientation,
gray-area resolution, impact analysis, implementation, review, and test judgment.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    start) cmd_start "$@" ;;
    import-issue) cmd_import_issue "$@" ;;
    continue) cmd_continue "$@" ;;
    current) cmd_current ;;
    status) cmd_status "$@" ;;
    complete) cmd_complete ;;
    suggest-tier) cmd_suggest_tier "$@" ;;
    eval-verdict) cmd_eval_verdict "$@" ;;
    relay-report) cmd_relay_report "$@" ;;
    check-review-notes) cmd_check_review_notes "$@" ;;
    check-evidence) cmd_check_evidence "$@" ;;
    gate-cost) cmd_gate_cost "$@" ;;
    help|--help|-h) cmd_help ;;
    *) echo "Unknown command: $cmd" >&2; cmd_help; exit 1 ;;
  esac
}

main "$@"
