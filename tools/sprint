#!/usr/bin/env bash
# sprint — CLI-backed orchestration spine for canon workflows

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real file location.
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
source "$SCRIPT_DIR/ticket-root.sh"
source "$SCRIPT_DIR/frontmatter-lib.sh"
source "$SCRIPT_DIR/platform-lib.sh"   # canon_event (t-f182)
source "$SCRIPT_DIR/gate-model.sh"     # signoff_model_resolve (t-3425: the Build model line)
TKT_BIN="$SCRIPT_DIR/tkt"

ticket_dir_for() {
  local id="$1"
  echo "$(tickets_dir)/$id"
}

ensure_context_files() {
  local root="$1"
  if [[ ! -f "$root/DECISIONS.md" ]]; then
    decisions_seed_header > "$root/DECISIONS.md"   # t-00d3: one owner, also the header a cloud PR may create the file with
  fi

  if [[ ! -f "$root/HANDOFF.md" ]]; then
    cat > "$root/HANDOFF.md" <<'EOF'
# Handoff

<!-- canon:handoff:BEGIN -->
## Current Focus

## In Progress

## Discoveries

## Next Steps

<!-- canon:handoff:END -->
EOF
  fi
}

cmd_start() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo "Usage: sprint start \"title\" | sprint start <ticket-id>" >&2; exit 1; }

  local current_output current_rc
  set +e
  current_output="$("$TKT_BIN" current 2>&1)"
  current_rc=$?
  set -e
  if [[ "$current_rc" -eq 0 ]]; then
    echo "Active sprint already exists:"
    echo "$current_output"
    echo "Run 'sprint complete' or close/reopen tickets before starting another."
    exit 1
  elif [[ "$current_rc" -gt 1 ]]; then
    echo "$current_output" >&2
    exit "$current_rc"
  fi

  local root dir id tdir
  root="$(project_root)"
  dir="$(tickets_dir)"
  mkdir -p "$dir"

  # Resolve arg as an existing ticket ID; fall back to creating a new ticket.
  local resolved_id
  resolved_id="$("$TKT_BIN" show "$arg" 2>/dev/null | awk '/^ID:/{print $2}' || true)"
  if [[ -n "$resolved_id" ]]; then
    id="$resolved_id"
  else
    id="$("$TKT_BIN" create "$arg" -t task -p 2)"
  fi
  # t-01a4: "$TKT_BIN" start writes .tickets/<id>/.cockpit-cwd itself now
  # (moved into tkt's own cmd_set_status after review found bare `tkt start`,
  # bypassing this wrapper, never bound a ticket to its worktree) — no
  # separate write needed here.
  "$TKT_BIN" start "$id" >/dev/null
  tdir="$(ticket_dir_for "$id")"
  wt_write_ok "$tdir/acceptance.md" "$tdir/plan.md" || exit 1   # t-f7e6
  mkdir -p "$tdir"

  [[ -f "$tdir/acceptance.md" ]] || cat > "$tdir/acceptance.md" <<EOF
# Acceptance

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`

## Criteria
The checklist of behavior that must be true before the sprint can close.
<!-- Add or edit checklist items below. Keep this heading unchanged. -->
<!-- Optional style for behavior: When <trigger>, <system> <does response>. Example: When tkt gets an unknown id, it exits 1 and names the id. Docs and files stay free text. -->

- [ ]

## Test Plan
The commands or checks that prove the criteria work.
<!-- Add or edit test commands below. Keep this heading unchanged. -->

- [ ]

## QA
Edge cases and sign-off.
<!-- Add or edit QA items below. Keep this heading unchanged. -->

- [ ] Tested locally
EOF

  [[ -f "$tdir/plan.md" ]] || cat > "$tdir/plan.md" <<EOF
# Plan

<!-- Keep the Ticket line below unchanged. -->
Ticket: \`$id\`
<!-- Keep this doc under ~500 words — it is injected at every session start. -->

## Sign-off
<!-- Fill in: Tier: <tier> | Risk: <blast radius / key risks, one line> -->
<!-- Optional, append: | Gate model: <value> -- forces the sprint-close reviewer/evaluator onto that model, overriding the automatic Admin Reviewer and Evaluator defaults. Valid values (case-insensitive): a model id (e.g. haiku, sonnet, opus), or the literal "session" to force full session-model review. Omit entirely for automatic behavior -- there is no separate "auto" value; absence already means automatic. -->

- [ ] Plan approved — proceed to implementation

## Approach
<!-- Describe how you will implement this. Keep this heading unchanged. -->

## Files
<!-- List files to create or modify. -->

## Decisions
<!-- Record non-obvious tradeoffs and why. Answer each item under the ticket's ## Open questions here, or write "carried forward: <question>". Keep this heading unchanged. -->
EOF

  ensure_context_files "$root"

  if [[ ! -x "$root/scripts/test.sh" ]]; then
    echo "[sprint] WARNING: no scripts/test.sh found — test gate will not run at commit."
  fi

  _gate_agents_check "$root"
  canon_event sprint.started sprint "$(project_root)" "ticket=$id" ${GATE_AGENTS:+"gate_agents=$GATE_AGENTS"}
  cat <<EOF
Sprint started: $id
Ticket: $tdir/ticket.md

Agent next steps:
1. Read DECISIONS.md, HANDOFF.md, and ticket.md.
2. Fill in acceptance.md — add criteria and test-plan checklist items.
$(if grep -qiE '^[[:space:]]*[-*] \[x\] Plan approved' "$tdir/plan.md" 2>/dev/null; then
  echo "3. The plan in plan.md is already approved (its Sign-off is ticked): build it without waiting for another approval."   # t-6555: sent approved
else
  echo "3. Fill in plan.md — write the approach, then wait for explicit approval before coding."
fi)
EOF
  _unpromoted_line "$root"
  _recurrence_line "$root"
  _decisions_start_lines "$tdir/ticket.md" "$id"
}

# _recurrence_line <root> — t-70f2: one line per finding class that repeated across the project's last tickets (2 propose a rule, 3 a mechanical
# check), from `canon-go finding-classes --start`. Silent when nothing repeats, when this install's canon-go predates the command (an older
# board would serve on an unknown word, so --help is asked first), or on any error: a start never fails or waits on it.
_recurrence_line() {
  local b out
  b="$(board_has 'finding-classes [' 2>/dev/null)" || return 0
  out="$(cd "$1" && "$b" finding-classes --start --table "$(class_table)" 2>/dev/null </dev/null)" || return 0
  [[ -z "$out" ]] || printf '%s\n' "$out"
  return 0
}

# _unpromoted_line <root> — t-b360: one line when 5 or more rows of the project's LEARNINGS.md are still UNPROMOTED, so a pile of lessons is
# offered for promotion; nothing when there are fewer or no file. Read-only, never blocks, no canon-only path (a user project has the same file).
_unpromoted_line() {
  local f="$1/LEARNINGS.md" n
  [[ -f "$f" ]] || return 0
  # LC_ALL=C and no stderr: an unreadable file or a byte awk cannot decode (macOS awk, UTF-8 locale) must not abort the start under set -e
  n="$(LC_ALL=C awk '/\| UNPROMOTED \|[ \t\r]*$/ { n++ } END { print n + 0 }' "$f" 2>/dev/null)" || n=0
  [[ "$n" -ge 5 ]] && echo "$n UNPROMOTED learnings: /promote-learnings reviews them"
  return 0
}

# _findings_line <ticket dir> — t-b360: after a close, how the sprint's noticed and not-checked lines were routed (learnings.md's
# `## Noticed and not checked` bullets: `[t-xxxx]` a ticket, `[dismissed: why]`, `[ ]` left as a lesson). One line, nothing when there is
# no such section; read-only, and the close is already done, so it can never refuse.
_findings_line() {
  local f="$1/learnings.md"
  [[ -f "$f" ]] || return 0
  # same guard as _unpromoted_line: nothing here may change the exit status of a close that is already done
  LC_ALL=C awk '
    /^##[ \t]+Noticed and not checked[ \t\r]*$/ { on = 1; next }
    on && /^##[ \t]/ { on = 0 }
    on && /^[ \t]*[-*][ \t]+\[t-[a-z0-9]+\]/ { t++; n++; next }
    on && /^[ \t]*[-*][ \t]+\[dismissed:/ { d++; n++; next }
    on && /^[ \t]*[-*][ \t]+\[ \]/ { l++; n++ }
    END { if (n > 0) printf "Findings: %d noticed (%d routed to a ticket, %d dismissed, %d left as lessons)\n", n, t, d, l }
  ' "$f" 2>/dev/null || true
  return 0
}

# _gate_agents_check <root> — t-ff14: are canon's gate agents loaded in this Claude Code session? Claude Code loads agents
# once, from the folder the session started in (and the user's own agents folder), so a session started elsewhere, or
# before `skills.sh add` linked <project>/.claude/agents, closes without them and falls back. The session's transcript
# (<config>/projects/*/<CLAUDE_CODE_SESSION_ID>.jsonl) records that start folder as its first "cwd" and the start time
# as its first "timestamp" (the transcript's own folder follows the session's current folder, so it cannot be used).
# Warns, never blocks; silent outside Claude Code or when the transcript is not found (fails open, like the close check).
# Sets GATE_AGENTS to ok, missing, or empty when it could not tell.
_gate_agents_check() {
  GATE_AGENTS=""
  [[ -n "${CLAUDECODE:-}" && -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || return 0
  local root="$1" cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}" t start start_ts start_epoch ref why="" f fix=""
  # every lookup ends `|| true`: under set -e + pipefail an empty find/grep would end `sprint start` itself
  t="$(find "$cfg/projects/" -maxdepth 2 -name "$CLAUDE_CODE_SESSION_ID.jsonl" -type f 2>/dev/null | head -1 || true)"
  [[ -n "$t" ]] || return 0
  start="$(grep -m1 -o '"cwd":"[^"]*"' "$t" | sed 's/^"cwd":"//; s/"$//; s#\\\\#/#g' || true)"
  [[ -n "$start" ]] || return 0
  start_ts="$(grep -m1 -o '"timestamp":"[^"]*"' "$t" | sed 's/^"timestamp":"//; s/"$//; s/\.[0-9]*Z$/Z/' || true)"
  f=""
  for f in "$start/.claude/agents/canon-evaluator.md" "$cfg/agents/canon-evaluator.md"; do [[ -f "$f" ]] && break; f=""; done
  if [[ -z "$f" ]]; then
    why="it started in $start, where no canon-evaluator agent is found (nor in $cfg/agents)"
  elif [[ -n "$start_ts" ]]; then
    start_epoch="$(date -u -d "$start_ts" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$start_ts" +%s 2>/dev/null)" || start_epoch=""
    if [[ -n "$start_epoch" ]]; then
      ref="$(mktemp)"
      touch -t "$(date -r "$start_epoch" +%Y%m%d%H%M.%S 2>/dev/null || date -d "@$start_epoch" +%Y%m%d%H%M.%S)" "$ref" 2>/dev/null
      [[ -n "$(find "$(dirname "$f")" -maxdepth 0 -newer "$ref" 2>/dev/null || true)" ]] && why="canon's gate agents were added after it started"
      rm -f "$ref"
    fi
  fi
  if [[ -z "$why" ]]; then GATE_AGENTS=ok; return 0; fi
  GATE_AGENTS=missing
  # t-21f7: restart where this project's code is: the start folder when it is the project or one of its worktrees (same
  # git common dir, t-12f8), else the project. Both sides are git paths, so they compare as strings on Git Bash too.
  local dir="$root" common
  common="$(cd "$root" && cd "$(git rev-parse --git-common-dir 2>/dev/null)" && pwd -P || true)"
  [[ "$(cd "$start" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" && pwd -P || true)" == "$common" ]] && dir="$start"
  # t-74d8: in a worktree, link-worktree; `refresh` there can rewrite tracked files (AGENTS.md) on the sprint's branch
  if [[ ! -f "$dir/.claude/agents/canon-evaluator.md" ]]; then
    local gd gc; gd="$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"; gc="$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [[ -n "$gd" && "$gd" != "$gc" ]]; then fix=" (run 'skills.sh link-worktree $dir' first, so it links the agents)"
    else fix=" (run 'skills.sh refresh' there first, so it links the agents)"; fi
  fi
  echo "[sprint] WARNING: canon's gate agents are not loaded in this Claude Code session: $why."
  echo "  The close's reviewer and evaluator need them; without them it falls back to general-purpose agents."
  echo "  Fix: end this session and start Claude Code again in $dir$fix."
}

cmd_continue() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && { echo "Usage: sprint continue <ticket-id>" >&2; exit 1; }
  local id status tdir
  id="$("$TKT_BIN" show "$arg" 2>/dev/null | awk '/^ID:/{print $2}' || true)"
  [[ -z "$id" ]] && { echo "No ticket matches '$arg'." >&2; exit 1; }
  status="$("$TKT_BIN" show "$id" 2>/dev/null | awk '/^Status:/{print $2}' || true)"
  if [[ "$status" != "in_progress" ]]; then
    echo "$id is ${status:-unknown}, not in_progress. Use 'sprint start $id' to begin it." >&2
    exit 1
  fi
  tdir="$(ticket_dir_for "$id")"
  _gate_agents_check "$(project_root)"
  "$SCRIPT_DIR/work-beat" touch || true   # t-187e
  echo "Continuing sprint: $id"
  echo "Status: $status"
  echo "Ticket: $tdir/ticket.md"
  echo ""
  echo "Sprint files:"
  for f in ticket.md acceptance.md plan.md summary.md; do
    if [[ -f "$tdir/$f" ]]; then echo "  [ok]      $tdir/$f"; fi
  done
  cat <<EOF

Agent next steps:
1. Read DECISIONS.md, HANDOFF.md, and everything in $tdir/.
2. Find the first unchecked item in plan.md (approval) and acceptance.md.
3. Resume from there — do not restart orientation or re-ask for plan approval already recorded.
EOF
}

# cmd_import_issue <N> [--body-file F] [--force] — t-554c: in a cloud session, rebuilds the ticket a `tkt send-issue`
# issue carries and starts its sprint. `sprint start` keeps the imported acceptance.md and plan.md (it writes only
# missing ones), so an approved plan stays approved.
cmd_import_issue() {
  local id
  id="$("$TKT_BIN" import-issue --cloud "$@" | tail -1)" || exit 1   # t-b277: the cloud session's first step hides canon's own files
  [[ -n "$id" ]] || exit 1
  cmd_start "$id"
}

# cmd_recent [--strip-handoff] — t-2db7: what the main checkout's HANDOFF.md Recent activity block shows, for an agent in any
# checkout. --strip-handoff removes that block (before a git pull or merge by hand that git refuses because of it).
cmd_recent() {
  local main b
  main="$(main_checkout "$(project_root)")" || { echo "sprint recent: not in a git checkout" >&2; exit 1; }
  b="$(recent_board)" || { echo "sprint recent: this canon's board program has no 'recent'; run: canon update" >&2; exit 1; }
  case "${1:-}" in
    "") "$b" recent --project "$main" ;;
    --strip-handoff)
      [[ -f "$main/HANDOFF.md" && ! -L "$main/HANDOFF.md" ]] || { echo "sprint recent: no HANDOFF.md in $main" >&2; exit 1; }
      local tmp; tmp="$(mktemp "$main/.handoff.XXXXXX")" || exit 1
      if "$b" recent --strip < "$main/HANDOFF.md" > "$tmp"; then cat "$tmp" > "$main/HANDOFF.md"; rm -f "$tmp"; echo "Removed the Recent activity block from $main/HANDOFF.md"
      else rm -f "$tmp"; echo "sprint recent: could not read $main/HANDOFF.md" >&2; exit 1; fi ;;
    *) echo "Usage: sprint recent [--strip-handoff]" >&2; exit 1 ;;
  esac
}

cmd_current() {
  "$TKT_BIN" current
}

cmd_status() {
  local id tdir json=0
  [[ "${1:-}" == "--json" ]] && json=1
  local current_out current_rc
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  if [[ "$current_rc" -ne 0 ]]; then
    if [[ "$json" -eq 1 ]]; then echo '{"active":false}'; else echo "No active sprint."; fi
    exit 1
  fi
  id="$(awk '{print $1}' <<< "$current_out")"
  tdir="$(ticket_dir_for "$id")"
  if [[ "$json" -eq 1 ]]; then
    local f flags="" ticket_json
    ticket_json="$("$TKT_BIN" show "$id" --json)" # assigned first so a failure aborts with empty stdout, never half a document
    for f in ticket.md acceptance.md plan.md; do
      flags+="${flags:+,}\"$f\":$([[ -f "$tdir/$f" ]] && echo true || echo false)"
    done
    printf '{"active":true,"ticket":%s,"files":{%s}}\n' "$ticket_json" "$flags"
    return
  fi
  "$TKT_BIN" show "$id"
  echo ""
  echo "Sprint files:"
  for f in ticket.md acceptance.md plan.md; do
    if [[ -f "$tdir/$f" ]]; then
      echo "  [ok]      $tdir/$f"
    else
      echo "  [missing] $tdir/$f"
    fi
  done
}

_acceptance_section() {
  awk -v h="$1" '$0 ~ "^##[[:space:]]+"h"[[:space:]]*$" { f=1; next } /^##[[:space:]]/ { f=0 } f' "$2"
}

_gate_sprint_files() {
  local id="$1" tdir="$2" acceptance="$3" missing=0
  for f in "$tdir/ticket.md" "$acceptance" "$tdir/plan.md" "$tdir/summary.md"; do
    [[ ! -f "$f" ]] && echo "Missing required sprint file: $f" && missing=1
  done
  return $missing
}

_gate_acceptance_sections() {
  local id="$1" acceptance="$2" missing=0
  if ! _acceptance_section "Criteria" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Criteria has no checklist items."
    echo "Add done criteria to acceptance.md, then re-run."
    missing=1
  fi
  if ! _acceptance_section "Test Plan" "$acceptance" | grep -qE '^[[:space:]]*[-*] \[[ xX]\][[:space:]]+\S'; then
    echo "Sprint $id cannot close: acceptance.md ## Test Plan has no checklist items."
    echo "Add test commands to acceptance.md, then re-run."
    missing=1
  fi
  return $missing
}

_gate_wrapup_gates() {
  local id="$1" acceptance="$2"
  if ! grep -q "^## Wrapup Gates" "$acceptance"; then
    echo "Sprint $id cannot close: acceptance.md is missing ## Wrapup Gates section."
    echo "Run wrapup before closing."
    return 1
  fi

  local section data_rows
  section="$(_acceptance_section "Wrapup Gates" "$acceptance")"
  data_rows="$(printf '%s\n' "$section" | grep -E '^\|[[:space:]]*[a-zA-Z]' | grep -ivE '^\|[[:space:]]*gate[[:space:]]*\|')"

  if [[ -z "$data_rows" ]]; then
    echo "Sprint $id cannot close: ## Wrapup Gates table has no data rows."
    echo "Fill in the wrapup gates table before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | awk -F'|' '
    { r=$4; gsub(/^[[:space:]]+|[[:space:]]+$/, "", r)
      if (r == "" || r == "-" || r == "—") { exit 1 } }
  '; then
    echo "Sprint $id cannot close: ## Wrapup Gates has a row with empty or placeholder reason."
    echo "Add a reason for each gate before closing."
    return 1
  fi

  if ! printf '%s\n' "$data_rows" | grep -qE '^\|[^|]+\|[[:space:]]*ran[[:space:]]*\|'; then
    echo "Sprint $id cannot close: ## Wrapup Gates has no 'ran' rows — at least one gate must run."
    return 1
  fi
  # t-864c: a second evaluator that ran is recorded with the count of disagreements the person saw (sprint eval-compare's line)
  local tdir2 cmp n
  tdir2="$(dirname "$acceptance")"
  if [[ -f "$tdir2/eval-report-2.md" ]]; then
    cmp="$(_eval_compare "$tdir2")" || { echo "Sprint $id cannot close: sprint eval-compare $id cannot read the reports: $cmp."; return 1; }
    n="$(printf '%s\n' "$cmp" | sed -n 's/^Disagreements: //p')"
    if ! awk -v n="$n" '/^\|[[:space:]]*second-eval[[:space:]]*\|[[:space:]]*ran[[:space:]]*\|/ && match($0, "Disagreements: " n "([^0-9]|$)") { f = 1 } END { exit !f }' <<< "$data_rows"; then
      echo "Sprint $id cannot close: eval-report-2.md exists, so ## Wrapup Gates needs the row | second-eval | ran | … Disagreements: $n … | (from sprint eval-compare $id; show them to the user first). An eval-report-2.md left from an earlier run that this close did not dispatch: delete it."
      return 1
    fi
  fi
}

_gate_no_unchecked() {
  local id="$1" acceptance="$2"
  if grep -qE '^[[:space:]]*[-*] \[ \]' "$acceptance"; then
    echo "Sprint $id is not complete. Unchecked acceptance/test items remain:"
    grep -E '^[[:space:]]*[-*] \[ \]' "$acceptance" || true
    return 1
  fi
}

_gate_plan_signoff() {
  local id="$1" plan="$2"
  # Trivial-tier sprints skip the sign-off gate — anchored to the Tier: field
  # itself (line-start match), so "tier: trivial" appearing in free text
  # elsewhere in ## Sign-off (e.g. a Risk: one-liner discussing the decision)
  # can't accidentally trigger the skip.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  if ! grep -q "^## Sign-off" "$plan"; then
    echo "Sprint $id cannot close: plan.md is missing ## Sign-off section."
    echo "Add the Sign-off section and check the approval box before closing."
    return 1
  fi
  if _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[ \]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has unchecked items."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
  if ! _acceptance_section "Sign-off" "$plan" | grep -qE '^[[:space:]]*[-*] \[[xX]\]'; then
    echo "Sprint $id cannot close: plan.md ## Sign-off has no checked approval."
    echo "Check the approval box in plan.md before closing."
    return 1
  fi
  # t-0865: the box is pinned to ## Approach by `sprint approve`; a ticked box with no pin (approved before this) warns.
  local pinned now
  pinned="$(_acceptance_section "Sign-off" "$plan" | sed -n 's/^[[:space:]]*Approved:[[:space:]]*sha256:\([0-9a-f]*\).*/\1/p' | tail -1)"
  if [[ -z "$pinned" ]]; then
    echo "[sprint] WARNING: plan.md has no 'Approved: sha256:' pin, so Approach drift is unchecked; run sprint approve $id."
    return 0
  fi
  now="$(_approach_digest "$plan")"
  if [[ "$now" != "$pinned" ]]; then
    echo "Sprint $id cannot close: plan.md's Approach changed after approval: show the user the change, then run sprint approve $id."
    echo "Approved digest ${pinned:0:12}, now ${now:0:12} (compare ## Approach with the approved plan in git: git diff -- .tickets/$id/plan.md)."
    return 1
  fi
}

# _approach_digest <plan.md> — sha256 hex of ## Approach, trailing spaces trimmed (t-0865).
_approach_digest() {
  _acceptance_section "Approach" "$1" | sed 's/[[:space:]]*$//' \
    | { sha256sum 2>/dev/null || shasum -a 256; } | cut -d' ' -f1
}

# _pipeline_state <project root> — t-7e76: this project's resolved pipeline (canon's default plus canon-config/pipeline.yaml) in the one
# line the approve-time pin and the close compare: "<12 hex of the resolved order> off=<comma ids, or -> wrapup=<comma ids in run order>".
# Exit 0 and the line; exit 2 and the resolver's own one-line message (a locked node, a bad file); exit 3 and nothing when this install
# has no pipeline.sh (the gate then skips). tools/pipeline.sh is the one reader (t-00e0): nothing here parses the YAML.
_pipeline_state() {
  local root="$1" plain full rc=0 digest off wrapup
  [[ -x "$SCRIPT_DIR/pipeline.sh" ]] || return 3
  plain="$("$SCRIPT_DIR/pipeline.sh" resolve --project "$root" 2>&1)" || rc=$?
  if (( rc != 0 )); then printf '%s\n' "$plain"; return 2; fi
  full="$("$SCRIPT_DIR/pipeline.sh" resolve --full --project "$root" 2>&1)" || { printf '%s\n' "$full"; return 2; }
  digest="$(printf '%s\n' "$plain" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-12)"
  off="$(printf '%s\n' "$plain" | awk '$4 == "off" { printf "%s%s", (n++ ? "," : ""), $2 }')"
  wrapup="$(printf '%s\n' "$full" | awk -F'\t' '$6 == "wrapup" { printf "%s%s", (n++ ? "," : ""), $2 }')"
  printf '%s off=%s wrapup=%s\n' "$digest" "${off:--}" "${wrapup:--}"
}

PIPELINE_REMOVED_PHRASE="removed in this project's pipeline"
PIPELINE_OFF_NODES=""   # set by _gate_pipeline: the removed nodes of a close that passed it, for the events written after the close

# _gate_pipeline <id> <ticket dir> <acceptance.md> <project root> — t-7e76: sprint complete reads the project's pipeline. A node the
# project removed must be visible: its Wrapup Gates row (skipped, reason containing the phrase above) and a `Pipeline: removed <ids>` line
# in summary.md. The pipeline is pinned by `sprint approve` (plan.md Sign-off, `Pipeline:`); a close whose resolved pipeline differs is
# refused naming what changed, and a ticket approved before the pin only gets a notice. A project with no override has no removed node,
# so this prints nothing and refuses nothing. Locked nodes (the resolver refuses them), a malformed file and a malformed pin are refused.
_gate_pipeline() {
  local id="$1" tdir="$2" acceptance="$3" root="$4" state rc=0 off node problems="" pin pin_off pin_wrapup now_off now_wrapup changed="" n
  local -a offs
  PIPELINE_OFF_NODES=""
  state="$(_pipeline_state "$root")" || rc=$?
  case "$rc" in
    0) ;;
    3) return 0 ;;
    *) echo "Sprint $id cannot close: $state"
       echo "Fix canon-config/pipeline.yaml (or restore it); a locked node cannot be switched off."
       return 1 ;;
  esac
  off="${state#* off=}"; off="${off%% wrapup=*}"
  if [[ "$off" != "-" ]]; then
    IFS=, read -r -a offs <<< "$off"
    for node in "${offs[@]}"; do
      if ! _acceptance_section "Wrapup Gates" "$acceptance" | awk -F'|' -v n="$node" -v p="$PIPELINE_REMOVED_PHRASE" '
        { g = $2; s = $3; r = $4; gsub(/^[[:space:]]+|[[:space:]]+$/, "", g); gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
          if (g == n && s == "skipped" && index(r, p)) f = 1 }
        END { exit !f }'; then
        problems+="  - acceptance.md ## Wrapup Gates needs the row: | $node | skipped | $PIPELINE_REMOVED_PHRASE |"$'\n'
      fi
      if [[ ! -f "$tdir/summary.md" ]] || ! awk -v n="$node" '
        { sub(/\r$/, "") }
        /^Pipeline: removed/ { gsub(/[,()]/, " "); k = split($0, w, " "); for (i = 1; i <= k; i++) if (w[i] == n) f = 1 }
        END { exit !f }' "$tdir/summary.md"; then
        problems+="  - summary.md needs a line naming $node: Pipeline: removed $off (canon-config/pipeline.yaml)"$'\n'
      fi
    done
    if [[ -n "$problems" ]]; then
      echo "Sprint $id cannot close: this project's pipeline removes $off, and the close must show it."
      printf '%s' "$problems"
      return 1
    fi
  fi
  pin="$(_acceptance_section "Sign-off" "$tdir/plan.md" 2>/dev/null | sed -n 's/^[[:space:]]*Pipeline:[[:space:]]*sha256:\(.*\)$/\1/p' | sed 's/[[:space:]]*$//' | tail -1)"
  if [[ -z "$pin" ]]; then
    echo "[sprint] notice: plan.md has no 'Pipeline:' pin (approved before it), so pipeline drift is unchecked; run sprint approve $id to pin it."
  elif [[ ! "$pin" =~ ^[0-9a-f]{12}\ off=[a-z0-9,-]+\ wrapup=[a-z0-9,-]+$ ]]; then
    echo "Sprint $id cannot close: plan.md's 'Pipeline:' pin is malformed; show the user, then run sprint approve $id."
    return 1
  elif [[ "$pin" != "$state" ]]; then
    pin_off="${pin#* off=}"; pin_off="${pin_off%% wrapup=*}"; pin_wrapup="${pin##* wrapup=}"
    now_off="$off"; now_wrapup="${state##* wrapup=}"
    for n in $(printf '%s\n%s\n' "${pin_off//,/ }" "${now_off//,/ }" | tr ' ' '\n' | grep -v '^-$' | sort | uniq -u); do changed+="${changed:+, }$n"; done
    [[ "$pin_wrapup" == "$now_wrapup" ]] || changed+="${changed:+, }wrapup order"
    [[ -n "$changed" ]] || changed="the resolved order (a canon default or a node order changed)"
    echo "Sprint $id cannot close: the pipeline changed after approval ($changed)."
    echo "Restore canon-config/pipeline.yaml (or undo the canon update), or show the user the change and run sprint approve $id."
    return 1
  fi
  PIPELINE_OFF_NODES="$off"
}

# _signoff_tier <plan.md> — the word after "Tier:" in ## Sign-off (trivial, bugfix, normal, high-risk), or nothing.
_signoff_tier() {
  local t; t="$(_acceptance_section "Sign-off" "$1" 2>/dev/null | sed 's/\*//g' | tr 'A-Z' 'a-z' | sed -nE 's/^[[:space:]]*tier[[:space:]]*:[[:space:]]*(trivial|bugfix|normal|high-risk).*/\1/p' || true)"
  printf '%s' "${t%%$'\n'*}"
}

# _admin_stage_model <step> <agent> — Admin > Model tiers' pick for one step and agent, as --model takes it (canon-go stage-model, the
# registry's one reader: t-3425), or nothing (no pick, Off, or a board without the command). Never fails.
_admin_stage_model() {
  local b
  b="$(board_has 'stage-model <step>' 2>/dev/null)" || return 0
  "$b" stage-model "$1" "$2" "$SCRIPT_DIR/sprint-check-app/model-tiers.json" 2>/dev/null </dev/null || true
}

# _build_model_line <plan.md> — t-3425: the model the build runs on, after approval: the ticket's `Build model:` line, else Admin's Build
# pick for the agent (canon-go stage-model, the registry's one reader). In the Cockpit (COCKPIT_TICKET) the session switches to it when the
# turn ends; elsewhere the person types /model. Prints nothing when there is no Build model (the session keeps its model); never fails.
_build_model_line() {
  local plan="$1" agent="${COCKPIT_AGENT:-claude}" m="" src="the ticket's Build model line"
  if [[ "$agent" == pi ]]; then
    [[ -z "${COCKPIT_TICKET:-}" ]] || echo "Build model: Pi has no /model, so this session keeps its model."
    return 0
  fi
  m="$(signoff_model_resolve "$plan" build 2>/dev/null)" || m=""
  if [[ -z "$m" ]]; then m="$(_admin_stage_model build "$agent")"; src="Admin > Model tiers"; fi
  [[ -n "$m" ]] || return 0
  if [[ -n "${COCKPIT_TICKET:-}" ]]; then
    echo "This session switches to the Build model ($m, from $src) when this turn ends: end your turn now."
  else
    echo "Build model ($src): $m: switch with /model $m"
  fi
}

cmd_approve() {
  local id="${1:-}" root plan digest stamp tmp signoff pstate="" prc=0
  [[ -n "$id" ]] || { echo "Usage: sprint approve <ticket-id>" >&2; exit 1; }
  root="$(project_root)"
  plan="$root/.tickets/$id/plan.md"
  [[ -f "$plan" ]] || { echo "sprint approve: no plan.md for $id" >&2; exit 1; }
  signoff="$(_acceptance_section "Sign-off" "$plan")"
  grep -qE '^[[:space:]]*[-*] \[[ xX]\] Plan approved' <<< "$signoff" \
    || { echo "sprint approve: plan.md has no '- [ ] Plan approved' box under ## Sign-off" >&2; exit 1; }
  digest="$(_approach_digest "$plan")"
  # t-7e76: the project's pipeline is pinned with the plan; a pipeline the resolver refuses is not approved (nothing written)
  pstate="$(_pipeline_state "$root")" || prc=$?
  if (( prc == 2 )); then echo "sprint approve: $pstate" >&2; exit 1; fi
  (( prc == 0 )) || pstate=""
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  tmp="$(mktemp)"
  # Tick the first approval box, drop any old pins, and write the new ones right under the box.
  awk -v line="Approved: sha256:$digest $stamp" -v pline="${pstate:+Pipeline: sha256:$pstate}" '
    /^##[[:space:]]/ { insign = ($0 ~ /^##[[:space:]]+Sign-off[[:space:]]*$/) }
    insign && /^[[:space:]]*Approved:[[:space:]]*sha256:/ { next }
    insign && /^[[:space:]]*Pipeline:[[:space:]]*sha256:/ { next }
    insign && !done && /^[[:space:]]*[-*] \[[ xX]\] Plan approved/ { sub(/\[ \]/, "[x]"); print; print line; if (pline != "") print pline; done=1; next }
    { print }' "$plan" > "$tmp" && { wt_write_ok "$plan" || { rm -f "$tmp"; exit 1; }; } && cat "$tmp" > "$plan"   # t-f7e6
  rm -f "$tmp"
  echo "Approved $id: pinned ## Approach as sha256:${digest:0:12} at $stamp"
  _build_model_line "$plan"
  local _tier; _tier="$(_signoff_tier "$plan")"
  canon_event plan.approved sprint "$root" "ticket=$id" ${_tier:+"tier=$_tier"}   # t-2db7: the kind existed with no writer
  handoff_recent "$root"
  _handoff_mark "$(dirname "$plan")"   # t-10ac: what the Handoff narrative reads now, to notice at close that nobody refreshed it
  cap_headroom "$(worktree_root 2>/dev/null || echo "$root")" "$plan" sprint "$id" plan   # t-cc88: a capped file this plan lists that is nearly full (t-c990: and its event)
}

_gate_plan_content() {
  local id="$1" plan="$2"
  # Extract ## Approach section, strip HTML comments and blank lines
  local content
  content="$(_acceptance_section "Approach" "$plan" \
    | sed 's/<!--[^>]*-->//g' \
    | sed '/^[[:space:]]*$/d')"
  if [[ -z "$content" ]]; then
    echo "Sprint $id cannot close: plan.md ## Approach has no content."
    echo "Describe the implementation approach in plan.md, then re-run."
    return 1
  fi
}

_gate_visual_embed() {
  local id="$1"
  "$SCRIPT_DIR/validate-visuals.sh" "$id" "$2" "$3"
}

# _gate_dispatch_notice <evaluator|reviewer> <file> — the closing lines of every message about a gate report that is
# missing or cannot be verified. t-b2a9: a weak model read "eval-report.md is missing" as "create it" and hand-wrote the
# file, bypassing the gate; say who writes it and that it is never hand-made.
_gate_dispatch_notice() {
  local role="$1" file="$2" step=3
  [[ "$role" == reviewer ]] && step=2
  echo "$file is written ONLY by a fresh $role SUBAGENT: dispatch one (Agent tool, subagent_type \"canon-$role\"; skills/sprint/reference/complete.md step $step)."
  echo "Never create or edit $file yourself — a hand-made report is a bypassed gate."
}

# _gate_eval_report_exists <id> <tdir> — report file present, evaluator-run-id
# field present. Fails closed: missing report or field blocks close.
_gate_eval_report_exists() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if [[ ! -f "$report" ]]; then
    echo "Sprint $id cannot close: eval-report.md is missing."
    _gate_dispatch_notice evaluator eval-report.md
    echo "(Only if the work is genuinely trivial and none of SKILL.md's four not-trivial triggers applies: plan.md's Sign-off says Tier: trivial — complete.md step 3.)"
    return 1
  fi
  if ! grep -qE '^evaluator-run-id:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: eval-report.md is missing evaluator-run-id field."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_model <id> <tdir> — HARD RULE (t-072d): the report body must
# carry the templated `Model: <designation>` line so every close records which
# model graded it. Enforced here (inside _gate_eval_report, after the trivial-tier
# early return) so it never fires on a trivial sprint. Regressed silently across
# t-2c9e..t-3864 when subagents wrote free-form reports and dropped the line — the
# model still showed in the Wrapup Gates table (orchestrator-written), so nothing
# caught it. See eval.md's report template and shared-gate-protocol.md ## Inputs.
_gate_eval_report_model() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if ! grep -qE '^Model:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: eval-report.md is missing the 'Model:' line (HARD RULE)."
    echo "The evaluator must record the model it ran on, verbatim, per eval.md's report template (e.g. 'Model: claude-opus-4.8')."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_authentic <id> <tdir> — the evaluator-run-id must have a
# valid timestamp prefix and a matching entry in .claude/subagent-runs.jsonl
# within a ±60 min window. Fail closed, not open: a missing jsonl or
# unparseable run-id must block close, not silently skip verification — an
# unlogged/hand-written eval would otherwise satisfy this gate by just
# containing "pass:" in the verdict check that follows.
_gate_eval_report_authentic() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  local run_id run_epoch jsonl
  run_id="$(grep -E '^evaluator-run-id:[[:space:]]+\S' "$report" | head -1 | sed 's/^evaluator-run-id:[[:space:]]*//')"
  run_epoch="$(echo "$run_id" | cut -d'-' -f1)"
  jsonl="$(project_root)/.claude/subagent-runs.jsonl"
  if [[ ! -f "$jsonl" ]]; then
    echo "Sprint $id cannot close: .claude/subagent-runs.jsonl not found — cannot verify evaluator-run-id '$run_id' against a real subagent run."
    echo "After a real evaluator subagent run, log it with sprint subagent-log (it records a run that happened; it does not create one)."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  if [[ ! "$run_epoch" =~ ^[0-9]+$ ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no valid timestamp prefix. See eval.md step 1: generate it with 'date +%s'/'\$RANDOM', never uuidgen/PowerShell."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  # t-bdfb: some evaluators emit a JS Date.now() *millisecond* timestamp instead
  # of `date +%s` *seconds* (eval.md step 1). A seconds epoch is 10 digits (and
  # stays so until year 2286); a millisecond epoch is 13. Normalize a >=13-digit
  # prefix to seconds so the ±60 min match below still works. The run-id is a
  # correlation handle, not a security token (t-690a) — matched only by a time
  # window — so normalizing its units changes no authenticity property. Pure-bash
  # integer arithmetic, Git-Bash-safe (t-f04f). Force base-10 (10#) so a
  # pathological leading-zero prefix can't be misparsed as octal by $(( )) and
  # abort with an internal error instead of a clean fail-closed message.
  local run_len=${#run_epoch}
  run_epoch=$(( 10#$run_epoch ))
  if (( run_len >= 13 )); then
    run_epoch=$(( run_epoch / 1000 ))
  fi
  local matched=0 line ts entry_epoch diff malformed=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    ts="$(printf '%s' "$line" | grep -o '"ts"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/')"
    [[ -z "$ts" ]] && { malformed=$((malformed + 1)); continue; }
    [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || { malformed=$((malformed + 1)); continue; }
    entry_epoch="$(date -u -d "$ts" +%s 2>/dev/null || date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null)" || continue
    [[ "$entry_epoch" =~ ^[0-9]+$ ]] || continue
    diff=$(( entry_epoch - run_epoch ))
    (( diff < 0 )) && diff=$(( -diff ))
    if (( diff <= 3600 )); then
      matched=1
      break
    fi
  done < "$jsonl"
  if [[ "$matched" != "1" ]]; then
    echo "Sprint $id cannot close: evaluator-run-id '$run_id' has no matching subagent entry in .claude/subagent-runs.jsonl (±60 min window)."
    echo "The eval must be run as a real subagent invocation — inline writes are not accepted."
    _gate_dispatch_notice evaluator eval-report.md
    # t-c94f: entries without an ISO "ts" (e.g. an integer "timestamp" from a hand-written or
    # non-canon writer) are skipped above. Say so, or the closer sees only the generic line.
    if (( malformed > 0 )); then
      echo "Note: $malformed entr$([[ $malformed -eq 1 ]] && echo y || echo ies) in .claude/subagent-runs.jsonl ha$([[ $malformed -eq 1 ]] && echo s || echo ve) no ISO \"ts\" field (e.g. an integer \"timestamp\") and $([[ $malformed -eq 1 ]] && echo is || echo are) ignored."
      echo "After a real evaluator subagent run, log it with sprint subagent-log --agent-type evaluator (it records a run that happened; it does not create one) — do not hand-edit the file."
    fi
    return 1
  fi
}

# _transcript_has_all <file> <newline-separated fixed strings> — every non-empty string occurs in the file.
_transcript_has_all() {
  local f="$1" needle
  while IFS= read -r needle; do
    [[ -n "$needle" ]] || continue
    grep -qF -e "$needle" "$f" || return 1
  done <<< "$2"
  return 0
}

# _report_harness — t-4084: which harness's own record backs a gate report: claude (CLAUDECODE set, Claude Code's transcripts), else
# copilot (COPILOT_CLI=1, Copilot CLI's session record), else none. Claude Code wins when both are set.
_report_harness() {
  if [[ -n "${CLAUDECODE:-}" ]]; then echo claude
  elif [[ "${COPILOT_CLI:-}" == 1 ]]; then echo copilot
  else echo none; fi
}

# _copilot_report_bin — the board binary when it has copilot-report (t-4084), else nothing: an older one would take the word for a port.
_copilot_report_bin() {
  local board; board="$(board_bin)"
  case "$("$board" --help 2>/dev/null || true)" in *copilot-report*) printf '%s\n' "$board" ;; esac
}

# _gate_eval_report_copilot <id> <run-epoch> <needles> — t-4084: the close check under Copilot CLI. A real canon-evaluator task (never a
# general-purpose one: the session writes its prompt and it can write files) whose prompt names the ticket, finished from a minute before the run-id to an hour
# after it, must hold the run-id and every verdict-line prefix in its own record: every line its agentId produced (the commands that
# wrote the report, its messages) and its result, as the Claude Code check greps the whole transcript. A gate that could write
# (Copilot on macOS did) and one that only returned its report both pass. Fails
# OPEN with a Note when the board binary predates the helper or there is no session record (layout not recognised); CLOSED otherwise.
_gate_eval_report_copilot() {
  local id="$1" epoch="$2" needles="$3" bin chome rc=0 tmp
  chome="${COPILOT_HOME:-${HOME:-}/.copilot}"
  bin="$(_copilot_report_bin)"
  if [[ -z "$bin" ]]; then
    echo "Note: transcript check skipped (the installed board binary predates copilot-report; run 'canon update'): eval-report.md is not verified against Copilot's session record here."
    return 0
  fi
  tmp="$(mktemp)" || return 1
  "$bin" copilot-report --record --from "$((epoch - 60))" --to "$((epoch + 3600))" "$chome" canon-evaluator "$id" reference/eval.md "evaluator-run-id:" > "$tmp" 2>/dev/null || rc=$?
  # A COPILOT_HOME pointed at an empty folder must not skip the check: with no record there, the default home is checked (and binds when
  # it has one). Like the Claude Code check, this stops a model re-creating a report, not a user who forges a whole session record.
  if (( rc == 3 )) && [[ "$chome" != "${HOME:-}/.copilot" ]]; then
    chome="${HOME:-}/.copilot"; rc=0
    "$bin" copilot-report --record --from "$((epoch - 60))" --to "$((epoch + 3600))" "$chome" canon-evaluator "$id" reference/eval.md "evaluator-run-id:" > "$tmp" 2>/dev/null || rc=$?
  fi
  if (( rc == 3 )); then
    rm -f "$tmp"
    echo "Note: transcript check skipped (no Copilot session record under $chome/session-state, so the layout is not recognised): eval-report.md is not verified against a harness transcript here."
    return 0
  fi
  if (( rc == 0 )) && _transcript_has_all "$tmp" "$needles"; then rm -f "$tmp"; return 0; fi
  rm -f "$tmp"
  echo "Sprint $id cannot close: no canon-evaluator task result in Copilot's session record backs eval-report.md."
  echo "Looked in $chome/session-state/*/events.jsonl for a canon-evaluator task whose prompt names $id, finished from a minute before the run-id to an hour after it, whose result holds the run-id and every verdict line. A report no real evaluator returned (typed by hand or edited after) has none: dispatch the evaluator again, then 'sprint relay-report $id evaluator'."
  _gate_dispatch_notice evaluator eval-report.md
  return 1
}

# _gate_eval_report_transcript <id> <tdir> — t-0231: the report must be backed by the harness's own transcript of a real
# canon-evaluator dispatch. subagent-runs.jsonl cannot prove one (subagent-log.sh writes whatever --agent-id it is given,
# with empty session and transcript fields), but Claude Code keeps every subagent's transcript, which an agent cannot write:
#   <config>/projects/<slug>/<session>/subagents/agent-<id>.jsonl  +  agent-<id>.meta.json ("agentType": "canon-evaluator")
# The evaluator writes its report in one Bash call and prints its run-id, so the transcript holds the run-id, the ticket id
# (it works in .tickets/<id>) and the verdict line. Required, in one canon-evaluator transcript from ANY session or project
# (a sprint resumed in a new session must still verify) modified inside the run-id's window: the run-id, this ticket's id,
# and the report's verdict-line prefix (a hand-flipped fail: -> pass: no longer appears). It guards against a weak model
# re-creating the report, not against someone who unsets CLAUDECODE. Fails OPEN, with a Note, where the check cannot be
# made: not under Claude Code (Copilot, pi, Codex), or a config root with no subagent transcripts ever (layout unrecognised,
# e.g. a Windows install not yet confirmed). Fails CLOSED once Claude Code and its layout are recognised.
_gate_eval_report_transcript() {
  local id="$1" tdir="$2"
  local report="$tdir/eval-report.md"   # a separate `local`: under bash 3.2 + set -u one word cannot use the previous word's value
  local cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}"
  local harness; harness="$(_report_harness)"   # t-4084: Copilot CLI's session record backs the report as Claude Code's transcripts do
  if [[ "$harness" == none ]]; then
    echo "Note: transcript check skipped (not running under Claude Code or Copilot CLI): eval-report.md is not verified against a harness transcript here."
    return 0
  fi
  local d recognised=0
  if [[ "$harness" == claude ]]; then
    for d in "$cfg"/projects/*/*/subagents; do
      [[ -d "$d" ]] && { recognised=1; break; }
    done
    if (( ! recognised )); then
      echo "Note: transcript check skipped (no Claude Code subagent transcripts under $cfg/projects, so the layout is not recognised): eval-report.md is not verified against a harness transcript here."
      return 0
    fi
  fi
  local run_id run_epoch run_len now start_min end_min
  run_id="$(grep -E '^evaluator-run-id:[[:space:]]+\S' "$report" | head -1 | sed 's/^evaluator-run-id:[[:space:]]*//; s/[[:space:]]*$//')"
  run_epoch="${run_id%%-*}"
  [[ "$run_epoch" =~ ^[0-9]+$ ]] || return 0   # _gate_eval_report_authentic already blocked a run-id with no timestamp prefix
  run_len=${#run_epoch}
  run_epoch=$(( 10#$run_epoch ))
  (( run_len >= 13 )) && run_epoch=$(( run_epoch / 1000 ))
  now="$(date +%s)"
  # window: from a minute before the run-id to an hour after it (find -mmin counts minutes AGO)
  start_min=$(( (now - run_epoch + 60) / 60 + 1 ))
  end_min=$(( (now - run_epoch - 3600) / 60 ))
  # EVERY verdict line must be backed, not just the first: the verdict gate accepts any `^pass:` line, so a `pass:` line appended
  # under a genuine `fail:` would otherwise ride on it. A short `pass:` line verifies nothing (bare `pass:` is a substring of every
  # evaluator transcript: the eval.md template reads `pass: <one sentence>`), so it is refused; a short `fail:` line cannot
  # pass the verdict gate by itself and is not checked here.
  local vline vprefix prefixes=""
  while IFS= read -r vline; do
    [[ -n "$vline" ]] || continue
    vprefix="$(printf '%s' "$vline" | LC_ALL=C sed -E 's/[^ -~].*$//; s/["\\].*$//' | cut -c1-60)"
    if (( ${#vprefix} < 8 )); then
      [[ "$vline" == pass:* ]] || continue
      echo "Sprint $id cannot close: eval-report.md's verdict line is too short to verify against a transcript (it should read 'pass: <one sentence>')."
      _gate_dispatch_notice evaluator eval-report.md
      return 1
    fi
    prefixes="$prefixes$vprefix"$'\n'
  done < <(grep -E '^(pass|fail):' "$report" | tr -d '\r')
  local needles="$run_id"$'\n'"$id"$'\n'"$prefixes"
  # Copilot: the ticket id is matched in the task's prompt by copilot-report; the result itself must hold the run-id and the verdicts
  if [[ "$harness" == copilot ]]; then _gate_eval_report_copilot "$id" "$run_epoch" "$run_id"$'\n'"$prefixes"; return; fi
  local f meta found=0
  local -a find_args=("$cfg/projects/" -path '*/subagents/agent-*.jsonl' -type f -mmin "-$start_min")
  (( end_min > 0 )) && find_args+=(! -mmin "-$end_min")
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    meta="${f%.jsonl}.meta.json"
    [[ -f "$meta" ]] || continue
    if ! grep -qE '"agentType"[[:space:]]*:[[:space:]]*"canon-evaluator"' "$meta"; then
      # The documented fallback (complete.md step 3) dispatches the evaluator as `Plan` when canon's agent files are not installed
      # (an unrefreshed project, Codex/Pi): accept it only when the transcript shows the evaluator protocol it was told to follow.
      # A canon-reviewer, a general-purpose agent, or a Plan agent doing something else still does not count.
      grep -qE '"agentType"[[:space:]]*:[[:space:]]*"Plan"' "$meta" && grep -qF -e "reference/eval.md" "$f" || continue
    fi
    _transcript_has_all "$f" "$needles" || continue
    found=1
    break
  done < <(find "${find_args[@]}" 2>/dev/null)
  if (( ! found )); then
    echo "Sprint $id cannot close: no canon-evaluator transcript backs evaluator-run-id '$run_id'."
    echo "Looked in $cfg/projects/*/*/subagents for a canon-evaluator transcript (or a Plan one that shows reference/eval.md), modified from a minute before the run-id to an hour after it, that contains the run-id, this ticket's id and the report's verdict line. A report no real evaluator run wrote — typed by hand, edited after the run, or copied from another ticket — has none. (Claude Code deletes old subagent transcripts after a while: for a long-finished evaluator run, dispatch the evaluator again.)"
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_verdict <id> <tdir> — verdict must be pass:, or
# eval_override: true plus a dated waiver in acceptance.md (see
# _eval_override_has_dated_waiver's own header comment for why this check
# stays coarse rather than mechanically re-deriving per-item coverage).
_gate_eval_report_verdict() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  if ! grep -qE '^pass:' "$report"; then
    local ticket_file="$tdir/ticket.md" override
    override="$(get_field "$ticket_file" eval_override 2>/dev/null)"
    if [[ "$override" == "true" ]]; then
      if _eval_override_has_dated_waiver "$tdir/acceptance.md"; then
        echo "Sprint $id: eval-report.md verdict is not pass, but eval_override: true is set and acceptance.md has a dated waiver on record — allowing close. Per-item waiver coverage was confirmed at the human close-gate (complete.md steps 4-5), not re-derived mechanically here (t-c0e6: per-item correlation between eval-report.md and acceptance.md cannot be made sound — see DECISIONS.md)." >&2
        return 0
      fi
      echo "Sprint $id cannot close: eval_override: true is set, but acceptance.md has no dated waiver on record." >&2
      return 1
    fi
    echo "Sprint $id cannot close: eval-report.md verdict is not pass."
    grep -E '^(pass|fail):' "$report" | head -1 || echo "(no verdict line found)"
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _gate_eval_report_consistency <id> <tdir> — structural self-consistency backstop
# (t-eabb). Makes `not-run` a first-class, non-coercible verdict: a `pass:` verdict
# must not be contradicted by the report's own status tables. If any criterion or
# test-plan row is graded `not-run` (a load-bearing check that could NOT execute) or
# `partial` (incomplete), eval.md's verdict rule requires the verdict line to be
# `fail:` — a pass cannot stand while a check's result is unknown or incomplete. This
# catches the accidental coercion where an honest `not-run`/`partial` row sits under a
# `pass:` verdict; it does not claim to defeat deliberate forgery (an evaluator could
# omit the row) — honest path easy, dishonest path loud (t-277d/t-6098). Structural
# only: the report's own verdict token vs its own status tokens, never a semantic
# re-derivation of the work (t-c0e6). Runs only on the `pass:` path — a non-pass
# verdict is already handled by _gate_eval_report_verdict (block, or the eval_override
# dated-waiver path, which has no `pass:` line), so this never double-blocks the
# waiver. Pure-bash grep, Git-Bash/CRLF-safe: the status token is matched pipe-bounded
# mid-line so a trailing \r never breaks it, and no python3/uuidgen/PowerShell is used
# (t-f04f). `| pass / fail / partial |` template placeholders do NOT match — the cell
# must be whitespace + a single token + whitespace.
_gate_eval_report_consistency() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md"
  grep -qE '^pass:' "$report" || return 0
  if grep -qE '\|[[:space:]]*(not-run|partial)[[:space:]]*\|' "$report"; then
    echo "Sprint $id cannot close: eval-report.md verdict is 'pass:' but a status row is graded 'not-run' or 'partial'."
    echo "Per eval.md's verdict rule, any not-run (a check that could not execute) or partial forces the verdict to 'fail:' — a pass cannot stand while a check's result is unknown or incomplete."
    grep -nE '\|[[:space:]]*(not-run|partial)[[:space:]]*\|' "$report" | head -3
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
}

# _canon_setup_edit_only: tools/ticket-root.sh (t-e9aa: one owner, shared with evidence.sh)

# _gate_eval_report_fresh <id> <tdir> — t-1b74: the report must record the commit the evaluator graded (graded-head:,
# eval.md step 8), and no tracked file outside the late-doc/artifact paths below may differ from it. Without this a code change made
# after the binding verdict closes on stale evidence. The evaluator attests the commit (it is what that fresh run read), so this guards
# a forgotten re-grade, not a lying evaluator (same stance as _gate_eval_report_consistency). Fails closed on a missing, ambiguous or
# non-commit value; skipped where git cannot be asked (no repository or no commit yet). eval_override does not bypass it: the override
# covers a failing verdict, not stale evidence. Untracked files are ignored: a tree always has some, and sprint files are committed
# before grading (complete.md step 1). The paths below are written after grading by design (complete.md steps 6-8), or are dist/ from
# older checkouts (the post-commit hook commits nothing now, t-9383); anything else an agent touches after grading is stale.
# The audit log's path has one owner: MERGE_SAFE_AUDIT_LOG in tools/ticket-root.sh (t-75f5), which merge-pr's late_docs_delta also uses,
# there with an append-only rule; this list is built from it.
_gate_eval_report_fresh() {
  local id="$1" tdir="$2" report="$tdir/eval-report.md" heads graded changed n shown f
  local late_re="^(\\.tickets/|$MERGE_SAFE_LATE_ALT|$MERGE_SAFE_CLOSE_ALT|PROMOTED\\.md\$|AGENTS\\.md\$|(.+/)?CLAUDE\\.md\$|${MERGE_SAFE_AUDIT_LOG//./\\.}\$|dist/)"
  local wroot proot rel
  # The caller's OWN worktree, not project_root (which maps a linked worktree back to the main checkout): the graded commit and the
  # sprint's changes live in the worktree the sprint ran in. project_root only locates the project subtree inside its repository.
  wroot="$(worktree_root)"
  git -C "$wroot" rev-parse --verify -q HEAD >/dev/null 2>&1 || return 0
  proot="$(cd "$(project_root)" && pwd -P)"
  # The project's path inside its repository, asked of git itself: comparing `pwd -P` with --show-toplevel never matches on Windows
  # (/tmp/x vs C:/.../x), which built a bogus pathspec and passed every stale edit (t-7301).
  rel="$(git -C "$proot" rev-parse --show-prefix 2>/dev/null)" || rel=""
  rel="${rel%/}"
  heads="$(sed -n 's/^graded-head:[[:space:]]*//p' "$report" | tr -d '\r' | sort -u)"
  if [[ -z "$heads" ]]; then
    echo "Sprint $id cannot close: eval-report.md is missing graded-head: (the commit the evaluator graded, eval.md step 8)."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  if [[ "$(printf '%s\n' "$heads" | wc -l | tr -d ' ')" -gt 1 ]]; then
    echo "Sprint $id cannot close: eval-report.md has more than one graded-head value, so the graded commit is ambiguous."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  graded="$heads"
  if [[ ! "$graded" =~ ^[0-9a-f]{40,64}$ ]] || ! git -C "$wroot" cat-file -e "${graded}^{commit}" 2>/dev/null; then
    echo "Sprint $id cannot close: eval-report.md graded-head '$graded' is not a commit in this repository."
    _gate_dispatch_notice evaluator eval-report.md
    return 1
  fi
  # --no-renames: a rename's old path must count; quotepath off: non-ASCII paths come back verbatim so the allow-list matches them.
  if [[ -n "$rel" ]]; then
    changed="$(git -C "$wroot" -c core.quotepath=off diff --no-renames --name-only --relative="$rel" "$graded" -- "$rel" 2>/dev/null | grep -vE "$late_re" || true)"
  else
    changed="$(git -C "$wroot" -c core.quotepath=off diff --no-renames --name-only "$graded" -- . 2>/dev/null | grep -vE "$late_re" || true)"
  fi
  # canon's own setup edit to the project's .gitignore/.gitattributes is not a change after grading (t-52f0); exact lines only.
  for f in .gitignore .gitattributes; do
    if [[ $'\n'"$changed"$'\n' == *$'\n'"$f"$'\n'* ]] && _canon_setup_edit_only "$wroot" "$graded" "${rel:+$rel/}$f"; then
      changed="$(printf '%s\n' "$changed" | grep -vxF "$f" || true)"
    fi
  done
  [[ -n "$changed" ]] || return 0
  n="$(printf '%s\n' "$changed" | wc -l | tr -d ' ')"
  shown="$(printf '%s\n' "$changed" | sed -n '1,5p' | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
  echo "Sprint $id cannot close: tracked files changed after the evaluator graded (graded-head ${graded:0:7}; $n file(s): $shown)."
  echo "The verdict does not cover a change made after it: re-dispatch a fresh evaluator (complete.md step 3). Do not edit graded-head to match."
  _gate_dispatch_notice evaluator eval-report.md
  return 1
}

# _gate_reject <id> <ticket dir> <role> <reason> — a gate.rejected event (t-8854) for a refusal just printed. Observer-only.
_gate_reject() {
  canon_event gate.rejected sprint "$(dirname "$(dirname "$2")")" "ticket=$1" "role=$3" "reason=$4"
}

# _gate_integrity <id> <ticket dir> — t-2af0: refuse the close when this install came from a release and a gate file or gate prompt
# no longer has that release's hash (a changed gate could grade its own sprint). Only `sprint-check integrity --gate` exit 3 blocks:
# the saved list is re-checked against integrity.txt first (--online; only an unreachable network falls back to the saved copy); a board without the command, no list, offline, a main install or a git checkout off the tag all pass. No override flag.
_gate_integrity() {
  local id="$1" tdir="$2" b h out rc=0
  b="$SCRIPT_DIR/../$(board_rel_path)"   # this install's own board, never SPRINT_CHECK_BIN: a caller must not choose who answers
  h="$("$b" --help 2>/dev/null)" || h=""
  case "$h" in *"integrity [--json]"*) ;; *) return 0 ;; esac
  out="$("$b" integrity --gate --online 2>&1)" || rc=$?
  if [[ "$rc" -ne 3 ]]; then printf '%s\n' "${out%%$'\n'*}"; return 0; fi   # one line in every state that does not block
  echo "Sprint $id cannot close: a gate file or gate prompt in this canon install differs from the release it came from."
  printf '%s\n' "$out"
  echo "The gates grade this sprint, so they must be the released ones. Put the files back with the command shown, then run sprint complete again."
  _gate_reject "$id" "$tdir" sprint integrity
  return 1
}

# The project's (or, in a worktree sprint, the worktree's) HANDOFF.md: a worktree sprint fills its own copy.
# t-8bd8: a land worktree's close docs belong in the main checkout, so its notices read the main checkout's HANDOFF.md
_handoff_file() {
  local r m; r="$(worktree_root 2>/dev/null)" || r="$(project_root)"
  if _is_land_worktree "$r" && m="$(land_main_root "$r")"; then r="$m"; fi
  echo "$r/HANDOFF.md"
}
# 0 when HANDOFF.md has a Current Focus section with no text (comment lines and blanks do not count); 1 otherwise, also with no file or section.
_handoff_focus_empty() {
  [[ -f "$1" ]] || return 1
  awk 'BEGIN { has = 0; txt = 0 } /^##[ \t]+Current Focus[ \t\r]*$/ { has = 1; inf = 1; next } inf && /^##[ \t]/ { inf = 0 } inf && /[^ \t\r]/ && !/^[ \t]*<!--/ { txt = 1 } END { exit !(has && !txt) }' "$1"
}
# A checksum of the narrative between the handoff markers; nothing when the file or its markers are missing.
_handoff_sum() {
  local f; f="$(_handoff_file)"
  [[ -f "$f" ]] && grep -q 'canon:handoff:BEGIN' "$f" || return 0
  awk '/<!-- canon:handoff:BEGIN -->/ { p = 1; next } /<!-- canon:handoff:END -->/ { p = 0 } p' "$f" | tr -d '\r' | cksum | awk '{ print $1 "-" $2 }'
}
# t-10ac: what the Handoff narrative read when the plan was approved, kept beside the ticket (nothing when there is no narrative).
_handoff_mark() {
  local hs; hs="$(_handoff_sum)"
  [[ -z "$hs" ]] || ! wt_write_ok "$1/.cockpit-handoff-at-approve" || printf '%s\n' "$hs" > "$1/.cockpit-handoff-at-approve" 2>/dev/null || true   # t-f7e6 (evaluator)
  return 0
}
# _notice_handoff_focus — t-eecb: one line, never a refusal, when this project's HANDOFF.md has a Current Focus section with no text:
# the wrapup step (skills/wrapup/SKILL.md) tells the agent to refresh it, and nothing checked that a close did. Nothing when the file or
# the section is missing, or the section has text. Always returns 0.
_notice_handoff_focus() {
  if _handoff_focus_empty "$(_handoff_file)"; then
    echo "HANDOFF.md: Current Focus is empty; the wrapup step \"refresh HANDOFF.md\" fills it (this never blocks the close)"
  fi
  return 0
}
# _notice_handoff_stale <ticket dir> — t-10ac: one line, never a refusal, when the Handoff narrative is byte-for-byte what it was when the
# plan was approved: the agent wrote "plan not approved yet" at the start and never refreshed it (seen on a Windows close). Silent when no
# mark was taken (an older sprint), when the narrative has no markers, or when Current Focus is empty (that notice speaks). Always returns 0.
_notice_handoff_stale() {
  local mark now; mark="$(cat "$1/.cockpit-handoff-at-approve" 2>/dev/null)" || return 0
  [[ -n "$mark" ]] || return 0
  _handoff_focus_empty "$(_handoff_file)" && return 0
  now="$(_handoff_sum)"
  if [[ -n "$now" && "$now" == "$mark" ]]; then
    echo "HANDOFF.md: the narrative has not changed since this plan was approved; the wrapup step \"refresh HANDOFF.md\" brings Current Focus, In Progress and Next Steps up to date (this never blocks the close)"
  fi
  return 0
}

# _gate_caps <id> <ticket dir> — t-c990: every tools/caps.tsv row with a project path, measured before the evaluator (check-evidence)
# and again at the close. A row over its cap prints its line and writes budget.exceeded (stage close); the close refuses only when this
# branch changed that file (git diff from gate_base, the merge-base with origin/<default branch>, uncommitted and untracked included), so an old HANDOFF.md or a
# LEARNINGS.md at its cap cannot stop an unrelated close; the learnings row never refuses (learnings-sweep never blocks on it, and its
# row is still uncommitted at the close). Measured in the worktree being closed. No baseline, an older board: no refusal.
_gate_caps() {
  local id="$1" tdir="$2" root wroot b table base changed="" nobase="" name path out rc err refuse=0 line
  root="$(project_root)"
  wroot="$(worktree_root 2>/dev/null)" || wroot="$root"   # a linked worktree's own files and branch, not the main checkout's
  b="$(cap_board)" || return 0
  table="$(cap_table)"
  if base="$(gate_base "$wroot")"; then   # t-99d2: the default branch, not origin/main
    changed="$( { git -C "$wroot" diff --name-only "$base"; git -C "$wroot" ls-files --others --exclude-standard; } 2>/dev/null || true)"
  else nobase="$base"; fi   # gate_base printed why
  err="$(mktemp)" || return 0
  while IFS=$'\t' read -r name path; do
    rc=0; out="$(cd "$wroot" && "$b" caps --json --table "$table" "$name" </dev/null 2>"$err")" || rc=$?
    if [[ "$rc" -eq 2 ]]; then echo "$path: cap not measured: $(head -1 "$err")"; continue; fi
    cap_read "$out" || continue   # not present here
    [[ "$CAP_OVER" == true ]] || continue
    line="$path: $CAP_USED of $CAP_LIMIT $CAP_UNIT, over by $((CAP_USED - CAP_LIMIT))"
    canon_event budget.exceeded sprint "$root" "ticket=$id" "cap=$CAP_NAME" "used=$CAP_USED" "limit=$CAP_LIMIT" "unit=$CAP_UNIT" "stage=close"
    if [[ "$CAP_NAME" == learnings ]]; then   # learnings-sweep never blocks on it: an UNPROMOTED row must stay visible
      echo "$line: learnings-sweep keeps pending rows, so this never blocks a close; a promotion pass is due"
    elif [[ -z "$nobase" ]] && grep -qxF -- "$path" <<< "$changed"; then
      echo "$line: this branch changed it; make room in it before closing (lower nothing in tools/caps.tsv)"; refuse=1
    else
      echo "$line: not changed by this branch${nobase:+ ($nobase)}, so the close goes on"
    fi
  done < <(awk -F'\t' '!/^#/ && NF == 5 && $2 != "-" { print $1 "\t" $2 }' "$table")
  rm -f "$err"
  if (( refuse )); then
    echo "Sprint $id cannot close: a capped file this branch changed is over its cap (tools/caps.tsv)."
    _gate_reject "$id" "$tdir" sprint cap_exceeded
    return 1
  fi
  return 0
}

_gate_eval_report() {
  local id="$1" tdir="$2"
  local plan="$tdir/plan.md"
  # Trivial-tier sprints skip the evaluator — same field-anchored check as
  # _gate_plan_signoff, so this can't be skipped by a stray "tier: trivial"
  # mention in free text elsewhere in plan.md.
  if _acceptance_section "Sign-off" "$plan" 2>/dev/null | sed 's/\*//g' | grep -qiE '^[[:space:]]*tier[[:space:]]*:[[:space:]]*trivial\b'; then
    return 0
  fi
  _gate_eval_report_exists      "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator missing_report; return 1; }
  _gate_eval_report_authentic   "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator unverified_run; return 1; }
  _gate_eval_report_transcript  "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator missing_transcript; return 1; }
  _gate_eval_report_verdict     "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator verdict_not_pass; return 1; }
  _gate_eval_report_consistency "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator report_inconsistent; return 1; }
  _gate_eval_report_model       "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator report_model; return 1; }
  _gate_eval_report_fresh       "$id" "$tdir" || { _gate_reject "$id" "$tdir" evaluator graded_head_stale; return 1; }
}

# _gate_review_notes_model <id> <tdir> — HARD RULE (t-072d): if the advisory
# reviewer ran, its report must record the model too. Fires ONLY when
# review-notes.md exists, so reviewer-skipped tiers (bugfix/demo/trivial, which
# write no review-notes.md) are unaffected — no tier detection needed here.
_gate_review_notes_model() {
  local id="$1" tdir="$2" report="$tdir/review-notes.md"
  [[ -f "$report" ]] || return 0
  if ! grep -qE '^Model:[[:space:]]+\S' "$report"; then
    echo "Sprint $id cannot close: review-notes.md is missing the 'Model:' line (HARD RULE)."
    echo "The reviewer must record the model it ran on, verbatim, per review.md's report template (e.g. 'Model: claude-opus-4.8')."
    _gate_dispatch_notice reviewer review-notes.md
    return 1
  fi
}

# Concern labels the reviewer must show a pass for (t-de16). One owner: review.md's report
# template lists the same seven, and tests/doc-mirror-parity.sh fails if they drift.
REVIEW_CONCERNS=("Correctness" "Guards that cannot fail" "Security and trust boundaries" "Error handling" "Visual regression" "Portability" "Hygiene")
# The list before t-0ca2: a report that completes it still passes, so a closed ticket's review-notes.md stays valid.
REVIEW_CONCERNS_OLD=("Scope creep" "Visual regression" "Dead code" "Unnecessary complexity" "Standards violations")
# Triage buckets every finding is sorted into (t-f13a); the verdict is YES exactly when Act On is none. Same one owner
# and parity check as REVIEW_CONCERNS.
REVIEW_BUCKETS=("Act On" "Consider" "Noted" "Dismissed")

# _review_concern_problems <report> <label>... — one "  - <problem>" line per label with no line, or a `none` line that says
# nothing checked; the same rule for either concern list.
_review_concern_problems() {
  local report="$1" label vals val lower; shift
  for label in "$@"; do
    vals="$(grep -E "^[[:space:]]*[-*]?[[:space:]]*${label}:" "$report" | sed -E "s/^[[:space:]]*[-*]?[[:space:]]*${label}:[[:space:]]*//; s/\r$//")" || true
    if ! printf '%s' "$vals" | grep -q '[^[:space:]]'; then
      echo "  - no line for the \"$label\" concern"
      continue
    fi
    while IFS= read -r val; do
      [[ -n "${val//[[:space:]]/}" ]] || continue
      lower="$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]')"
      if [[ "$lower" =~ ^none([^[:alnum:]_]|$) ]] && { ! [[ "$lower" =~ checked ]] || ! [[ "$val" =~ [^[:space:]]+:[0-9]+ ]]; }; then
        echo "  - the \"$label\" \`none\` line must say what was checked and cite a file:line"
      fi
    done <<< "$vals"
  done
}

# _review_notes_shape_problems <report> — t-de16, t-c38e: print one "  - <problem>" line per shape problem of a
# review-notes.md, nothing when it is well formed: a `Changed files:` line with at least one path, and one line per concern
# that is a finding or `none — checked <what>, <file:line>`. Rejects the bare "No findings. / YES" report (live defect t-294b:
# two runs wrote the same 111 bytes, one over an EMPTY diff). This checks shape, not truthfulness — a false
# `none — checked x.js:3` still passes. The one owner of the rule: `sprint complete` and `sprint check-review-notes` both call it.
_review_notes_shape_problems() {
  local report="$1" cf label vals val lower
  cf="$(grep -m1 -E '^Changed files:' "$report" | sed -E 's/^Changed files:[[:space:]]*//; s/\r$//')" || true
  lower="$(printf '%s' "$cf" | tr '[:upper:]' '[:lower:]')"
  if [[ -z "$cf" ]]; then
    echo '  - no `Changed files:` line'
  elif [[ "$lower" =~ ^(none|n/a|na|empty|-)([^[:alnum:]_./-]|$) ]] || ! [[ "$cf" =~ [[:alnum:]_-]+[./][[:alnum:]_.-]+ ]]; then
    echo '  - `Changed files:` lists no path (an empty diff usually means a wrong base ref)'
  fi
  # A report passes when it completes the current list or the old one (t-0ca2); otherwise it is judged by the list it
  # started: the old one only when it has an old-only label and no current-only one, else the current one.
  local cur old has_old=0 has_new=0
  cur="$(_review_concern_problems "$report" "${REVIEW_CONCERNS[@]}")"
  old="$(_review_concern_problems "$report" "${REVIEW_CONCERNS_OLD[@]}")"
  if [[ -n "$cur" && -n "$old" ]]; then
    for label in "${REVIEW_CONCERNS[@]}"; do
      case " ${REVIEW_CONCERNS_OLD[*]} " in *" $label "*) continue ;; esac
      grep -qE "^[[:space:]]*[-*]?[[:space:]]*${label}:" "$report" && has_new=1
    done
    for label in "${REVIEW_CONCERNS_OLD[@]}"; do
      case " ${REVIEW_CONCERNS[*]} " in *" $label "*) continue ;; esac
      grep -qE "^[[:space:]]*[-*]?[[:space:]]*${label}:" "$report" && has_old=1
    done
    if [[ "$has_old" -eq 1 && "$has_new" -eq 0 ]]; then printf '%s\n' "$old"; else printf '%s\n' "$cur"; fi
  fi
  for label in "${REVIEW_BUCKETS[@]}"; do
    grep -qE "^[[:space:]]*[-*]?[[:space:]]*${label}:[[:space:]]*[^[:space:]]" "$report" || echo "  - no line for the \"$label\" triage bucket"
  done
  # The verdict (first word under `## Verdict`, bold stripped) must match Act On: YES exactly when every Act On line is `none`.
  local verdict act
  verdict="$(awk '/^##[[:space:]]+Verdict/ { f=1; next } f && /[^[:space:]]/ { sub(/\r$/, ""); gsub(/\*/, ""); print toupper($1); exit }' "$report")"
  act="$(grep -E "^[[:space:]]*[-*]?[[:space:]]*Act On:[[:space:]]*[^[:space:]]" "$report" | sed -E 's/^[[:space:]]*[-*]?[[:space:]]*Act On:[[:space:]]*//; s/\r$//' | tr '[:upper:]' '[:lower:]')" || true
  if [[ -n "$act" ]]; then
    if grep -qvE '^none([^[:alnum:]_]|$)' <<< "$act"; then
      [[ "$verdict" != YES ]] || echo '  - the verdict is YES but `Act On:` lists a finding (YES means `Act On: none`)'
    else
      [[ "$verdict" != NO ]] || echo '  - the verdict is NO but `Act On: none` (NO means at least one Act On finding)'
    fi
  fi
  return 0
}

# _gate_review_notes_shape <id> <tdir> — t-de16: a review-notes.md that exists must SHOW its passes
# (_review_notes_shape_problems). Fires only when the file exists, like _gate_review_notes_model, so reviewer-skipped
# tiers are unaffected.
_gate_review_notes_shape() {
  local id="$1" tdir="$2" report problems
  report="$tdir/review-notes.md"
  [[ -f "$report" ]] || return 0
  problems="$(_review_notes_shape_problems "$report")"
  if [[ -n "$problems" ]]; then
    echo "Sprint $id cannot close: review-notes.md does not show the reviewer's passes (t-de16):"
    printf '%s\n' "$problems"
    echo "Re-dispatch the reviewer per review.md's report template: 'Changed files:' with paths, then one line per concern — a finding, or 'none — checked <what>, <file:line>' — then one '## Triage' line per bucket, with a verdict that matches 'Act On'."
    _gate_dispatch_notice reviewer review-notes.md
    return 1
  fi
}

# eval_override (t-c0e6) is deliberately coarse: it checks only that a human set the
# flag and that acceptance.md records at least one dated waiver — it does NOT try to
# mechanically re-derive which specific eval-report.md items that waiver covers.
#
# A per-item mechanical check was built and abandoned across five rounds of live
# adversarial review (see DECISIONS.md): text-matching between eval-report.md's
# "verbatim" criterion text and its acceptance.md bullet cannot be made sound (loose
# matching collides across bullets; strict matching breaks on real evaluator output);
# position-based correlation (report row N = acceptance.md's Nth bullet) then failed
# the same way — nested bullets and malformed tables drift positions without tripping
# a row-count guard, and even a pipe-safe row-count guard can't detect an evaluator
# merging/splitting rows while preserving the total count. Every version shipped
# failed OPEN, never closed. There is no third correlation key.
#
# `eval_override` is human-only to set (no tkt command writes it) — a human is always
# in the loop when it's used, so per-item "is THIS failing item actually waived" is
# verified by that human at complete.md's steps 4-5 close-gate, not re-derived here.
# Mirrors t-d8a1's precedent: no CLI gate is bypass-proof; the win is making the
# override explicit, dated, and greppable — not building an unfoolable verifier.
_eval_override_has_dated_waiver() {
  local acceptance="$1"
  [[ -f "$acceptance" ]] || return 1
  grep -qi 'waived' "$acceptance" && grep -iE 'waived' "$acceptance" | grep -qE '[0-9]{4}-[0-9]{2}-[0-9]{2}'
}

cmd_complete() {
  local id tdir acceptance want="${1:-}"
  local current_out current_rc strays
  # t-597f: a gate's relative write made a .tickets/ in this land worktree; every reader here now sees it instead of the ticket
  if strays="$(stray_tickets)"; then
    echo "Sprint cannot close here: a .tickets/ in this worktree hides the ticket (a gate wrote a relative path):" >&2
    printf '%s\n' "$strays" | sed 's/^/  /' >&2
    echo "  move each file into $(_worktree_main_tickets "$(worktree_root)")/<id>/, remove $(worktree_root)/.tickets, then run sprint complete again" >&2
    exit 1
  fi
  local lwt ldocs lrep; lwt="$(worktree_root)"
  # t-edda: a land worktree whose .tickets/ pattern Git Bash converted reads the PR's copy of the ticket: stop and say how to repair it
  if lrep="$(land_sparse_repair "$lwt")"; then printf 'Sprint cannot close here: %s\n' "$lrep" >&2; exit 1; fi
  # t-8bd8: the close docs (the DECISIONS.md row, the learnings row, a HANDOFF note) of a land close belong in the main checkout
  if ldocs="$(land_close_docs "$lwt")" && [[ -n "$ldocs" ]]; then
    echo "Sprint cannot close here: this land worktree has close docs that belong in the main checkout, $(land_main_root "$lwt"):" >&2
    printf '%s\n' "$ldocs" | sed 's/^/  /' >&2
    echo "  move each change into the main checkout's copy, undo it here (git checkout -- <file>, or delete a new one), then run sprint complete again" >&2
    exit 1
  fi
  set +e; current_out="$("$TKT_BIN" current 2>&1)"; current_rc=$?; set -e
  if [[ "$current_rc" -gt 1 ]]; then echo "$current_out" >&2; exit "$current_rc"; fi
  # t-788f: a named ticket that is not the active sprint closes only by the manual-after-merge path (a Manual cloud ticket merged here);
  # before, the argument was ignored and the active sprint closed instead.
  if [[ -n "$want" ]]; then
    [[ "$want" =~ ^t-[a-z0-9]{4}$ ]] || { echo "Usage: sprint complete [<ticket-id>]" >&2; exit 1; }
    if [[ "$current_rc" -ne 0 || "$(awk '{print $1}' <<< "$current_out")" != "$want" ]]; then
      _complete_manual_merged "$want" "$([[ "$current_rc" -eq 0 ]] && awk '{print $1}' <<< "$current_out")"
      return
    fi
  fi
  if [[ "$current_rc" -ne 0 ]]; then echo "No active sprint."; exit 1; fi
  id="$(awk '{print $1}' <<< "$current_out")"

  tdir="$(ticket_dir_for "$id")"
  acceptance="$tdir/acceptance.md"

  _gate_integrity           "$id" "$tdir"                || exit 1
  _gate_caps                "$id" "$tdir"                || exit 1
  _gate_manual              "$id" "$tdir"                || { _gate_reject "$id" "$tdir" sprint manual_qa; exit 1; }
  _gate_sprint_files        "$id" "$tdir" "$acceptance"  || exit 1
  _gate_acceptance_sections "$id" "$acceptance"          || exit 1
  _gate_wrapup_gates        "$id" "$acceptance"          || exit 1
  _notice_handoff_focus
  _notice_handoff_stale "$tdir"
  _gate_no_unchecked        "$id" "$acceptance"          || exit 1
  _gate_plan_content        "$id" "$tdir/plan.md"        || exit 1
  _gate_visual_embed        "$id" "$tdir/plan.md" "$acceptance" || exit 1
  _gate_plan_signoff        "$id" "$tdir/plan.md"        || exit 1
  _gate_pipeline            "$id" "$tdir" "$acceptance" "$(project_root)" || { _gate_reject "$id" "$tdir" sprint pipeline; exit 1; }
  _gate_eval_report         "$id" "$tdir"                || exit 1
  _gate_review_notes_model  "$id" "$tdir"                || { _gate_reject "$id" "$tdir" reviewer review_model; exit 1; }
  _gate_review_notes_shape  "$id" "$tdir"                || { _gate_reject "$id" "$tdir" reviewer review_shape; exit 1; }

  TKT_SPRINT_GATE_PASSED=1 "$TKT_BIN" close "$id"
  canon_event sprint.completed sprint "$(project_root)" "ticket=$id"
  cmd_token_spend --ticket "$id" --record 2>/dev/null || true   # t-7e26: the cost line; never fails a close
  # t-4c09: the audit line for the close: the plan's tier (the word after "Tier:" in the Sign-off), when it names one
  local _tier; _tier="$(_signoff_tier "$tdir/plan.md")"
  _close_hint "$id" "$(project_root)" "$_tier"   # t-bc1e: why a slow close was slow; advisory
  canon_event close.confirmed sprint "$(project_root)" "ticket=$id" ${_tier:+"tier=$_tier"}
  # t-7e76: a node this project's pipeline removed leaves one event each (the declared wrapup.gate_finished, result=removed)
  if [[ -n "$PIPELINE_OFF_NODES" && "$PIPELINE_OFF_NODES" != "-" ]]; then
    local _po _pn; IFS=, read -r -a _po <<< "$PIPELINE_OFF_NODES"
    for _pn in "${_po[@]}"; do canon_event wrapup.gate_finished sprint "$(project_root)" "ticket=$id" "gate=$_pn" "result=removed"; done
  fi
  handoff_recent "$(project_root)"   # t-2db7: the main checkout's HANDOFF.md Recent activity
  echo "Sprint completed: $id"
  _findings_line "$tdir"
  _decisions_row_length_line "$id"
  # t-8f48, t-2906: in a linked worktree, the step after the close is Check & merge.
  local gd common f
  if gd="$(git rev-parse --absolute-git-dir 2>/dev/null)" && common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    && [[ "$gd" != "$common" ]]; then
    # t-ba62: the sprint's record, untracked here, exists nowhere else and makes tkt worktree-reset refuse. Warn only.
    while IFS= read -r f; do
      [[ -n "$f" ]] && echo "warning: $f is untracked in this worktree: commit it with the close (complete-checklist step 10), or tkt worktree-reset will refuse."
    done < <(git -C "$(worktree_root)" ls-files --others --exclude-standard -- DECISIONS.md HANDOFF.md LEARNINGS.md 2>/dev/null || true)
    [[ "$(git symbolic-ref -q --short HEAD)" == land/* ]] \
      || echo "Next: Check & merge on the board's card (or tkt merge $id) merges this worktree's branch into the main checkout's branch, after its tests."   # t-2906; a tkt land worktree ends with `tkt land <id> --finish`
  fi

  # t-2fb6: shrink old closed tickets' evidence/ (never this one: it is younger than the cut-off). The close already
  # happened, so a compact failure only warns.
  local compact_out compact_rc=0
  compact_out="$("$TKT_BIN" compact 2>&1)" || compact_rc=$?
  printf '%s\n' "$compact_out" | grep -E '^compact: (total|WARNING|ERROR)' || true
  if (( compact_rc != 0 )); then
    echo "warning: tkt compact exited $compact_rc; the close stands. Run 'tkt compact --dry-run' to see why."
  fi
  return 0
}

# _manual_merged_problem <id> <tdir> — t-788f: why <id> cannot take the manual-after-merge close, or nothing when it can. The shape: a Manual
# ticket sent with --manual-after-merge, its cloud copy closed (the full gate set ran there, Manual off, t-e790), merged here, and left
# open for the person's test. merged: is also written by github-status's poll and `tkt merged`, which never compare the graded head, so the
# merge commit's PR head (its second parent) is checked again here: graded-head plus merge-safe late docs only, as merge-pr requires.
_manual_merged_problem() {
  local id="$1" tdir="$2" f="$2/ticket.md" m graded heads root ph out rc=0
  [[ -f "$f" ]] || { echo "no ticket.md"; return; }
  [[ "$(get_field "$f" status)" == open ]] || { echo "its status is $(get_field "$f" status), not open"; return; }
  [[ "$(get_field "$f" manual)" == true ]] || { echo "it is not a Manual ticket (manual: true)"; return; }
  [[ "$(get_field "$f" cloud_status)" == closed ]] || { echo "its cloud copy did not close (cloud_status: $(get_field "$f" cloud_status))"; return; }
  m="$(get_field "$f" merged)"
  [[ -n "$m" ]] || { echo "it is not merged yet (Check & merge, or tkt merge-pr $id)"; return; }
  root="$(project_root)"
  [[ "$m" =~ ^[0-9a-f]{7,40}$ ]] && git -C "$root" cat-file -e "$m^{commit}" 2>/dev/null \
    || { echo "merged: '$m' is not a merge commit in this repository (pull the default branch first)"; return; }
  # the person tests what this checkout holds: the merge must be in it, or the test is of older code
  git -C "$root" merge-base --is-ancestor "$m" HEAD 2>/dev/null \
    || { echo "merged: ${m:0:7} is not in this checkout's HEAD (pull the default branch, test again, then close)"; return; }
  ph="$(git -C "$root" rev-parse -q --verify "$m^2" 2>/dev/null)" \
    || { echo "merged: ${m:0:7} has no PR head to check (a squash or rebase merge): close it with the full gates instead"; return; }
  [[ -f "$tdir/eval-report.md" ]] || { echo "there is no eval-report.md (Import results)"; return; }
  grep -qE '^pass:' "$tdir/eval-report.md" || { echo "eval-report.md has no pass: verdict line"; return; }
  heads="$(sed -n 's/^graded-head:[[:space:]]*//p' "$tdir/eval-report.md" | tr -d '\r' | sort -u)"
  graded="${heads%%$'\n'*}"
  [[ -n "$graded" && "$heads" == "$graded" && "$graded" =~ ^[0-9a-f]{7,40}$ ]] || { echo "eval-report.md has no single graded-head"; return; }
  out="$(late_docs_delta "$root" "$graded" "$ph" "$id" 2>&1)" || rc=$?
  (( rc == 0 )) || { echo "the merged PR head ${ph:0:7} is not the graded ${graded:0:7} plus late docs only: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)"; return; }
  [[ -f "$tdir/acceptance.md" ]] || { echo "there is no acceptance.md"; return; }   # evaluator: no file must not pass the unchecked-items check
  wt_write_ok "$tdir/acceptance.md" \
    || { echo "acceptance.md cannot be written here (a link), so its [manual] criteria cannot be ticked"; return; }
  if awk 'tolower($0) ~ /^[[:space:]]*[-*] \[ \]/ && tolower($0) !~ /\[manual\]/ { f = 1 } END { exit !f }' "$tdir/acceptance.md" 2>/dev/null; then
    echo "acceptance.md has unchecked items other than [manual] criteria"; return
  fi
  _manual_qa_state "$id"
  [[ "$MQA_STATE" == fresh && "$MQA_PASS" -gt 0 ]] || { echo "the person's test is not recorded (manual-qa.md is ${MQA_STATE}${MQA_MSG:+: $MQA_MSG}$([[ "$MQA_STATE" == fresh ]] && echo ', with no pass step')): sprint manual-qa $id --by \"<name>\" --step \"<what>|pass\""; return; }
}

# _complete_manual_merged <id> [<active id>] — t-788f: the close of a Manual cloud ticket merged here. One local gate, the person's test
# (manual-qa.md fresh, all steps pass): the cloud ran the full close on this code and the merge check above proves it is the graded code.
# Ticks the [manual] criteria citing manual-qa.md, closes the ticket and records the close (tier manual-merged). A miss writes nothing.
_complete_manual_merged() {
  local id="$1" active="${2:-}" tdir why acc tmp day
  tdir="$(ticket_dir_for "$id")"
  why="$(_manual_merged_problem "$id" "$tdir")"
  if [[ -n "$why" ]]; then
    if [[ -n "$active" ]]; then echo "Sprint $id cannot close: it is not the active sprint ($active), and it cannot take the manual-after-merge close: $why."
    else echo "No active sprint, and $id cannot take the manual-after-merge close: $why."; fi
    exit 1
  fi
  _manual_qa_state "$id"   # the check above ran in a subshell: read the test's state here for the closing line
  acc="$tdir/acceptance.md"; day="$(date -u +%Y-%m-%d)"
  if [[ -f "$acc" ]]; then   # writable: checked above
    tmp="$(mktemp "$tdir/.acceptance.XXXXXX")"
    awk -v d="$day" 'tolower($0) ~ /\[manual\]/ && match($0, /^[[:space:]]*[-*] \[ \]/) { sub(/\[ \]/, "[x]"); $0 = $0 " — manual-qa.md " d } { print }' "$acc" > "$tmp" \
      && cat "$tmp" > "$acc"; rm -f "$tmp"
  fi
  TKT_SPRINT_GATE_PASSED=1 "$TKT_BIN" close "$id"
  canon_event sprint.completed sprint "$(project_root)" "ticket=$id"
  canon_event close.confirmed sprint "$(project_root)" "ticket=$id" "tier=manual-merged"
  handoff_recent "$(project_root)"
  echo "Sprint completed: $id (manual-after-merge: the cloud's gates on the graded code, and your test of the merged code here: $MQA_PASS pass)"
  # t-8990: a project that tracks .tickets/ gets the close recorded and pushed on the default branch, the one merge-pr merges into;
  # checked out on any other branch, record_ticket_commit refuses (never the checked-out branch: that would publish a feature branch)
  local rroot rbase; rroot="$(project_root)"; rbase="$(_default_branch "$rroot" || true)"
  RECORDED=false; [[ -z "$rbase" ]] || record_ticket_commit "$rroot" "$id" "$rbase" "chore: record $id close"
  $RECORDED || echo "Next: commit .tickets/$id and push (the board's Commit and push), so the close is on origin too."
}

# cmd_check_review_notes <id> — t-c38e: the close gate's review-notes.md shape check, run on demand (read-only). The
# reviewer runs it before returning and the orchestrator right after the dispatch, so a malformed report is rewritten at
# once instead of being refused at `sprint complete`.
cmd_check_review_notes() {
  local id="${1:-}"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local report problems
  report="$(ticket_dir_for "$id")/review-notes.md"
  [[ -f "$report" ]] || { echo "review-notes.md: not found for $id ($report)" >&2; exit 1; }
  problems="$(_review_notes_shape_problems "$report")"
  if [[ -n "$problems" ]]; then
    echo "review-notes.md: shape refused — the same check sprint complete runs (t-de16):"
    printf '%s\n' "$problems"
    echo "Fix the report per review.md's template: 'Changed files:' with paths, then one line per concern — a finding, or 'none — checked <what>, <path>:<line>' (the word 'checked' and a path:line on that same line) — then one '## Triage' line per bucket (Act On, Consider, Noted, Dismissed), with YES exactly when 'Act On: none'."
    _gate_reject "$id" "$(dirname "$report")" reviewer review_shape
    exit 1
  fi
  echo "review-notes.md: shape ok"
}

# --- manual QA (t-aa24) --------------------------------------------------------------------------------------------------
# The evaluator learns about evidence from `evidence.sh check`, which reads only *.log builder logs: a user's manual testing had no recorded
# place, so it reached the evaluator only when the session agent remembered to say so (ToDo-Demo t-32ah: three evaluator runs). The record is
# .tickets/<id>/evidence/manual-qa.md, written by `sprint manual-qa` (a fixed header the pre-flight can check for freshness), listed by
# `sprint check-evidence`, and read by the evaluator (eval.md step 5b). A criterion tagged [manual] in acceptance.md needs it before the dispatch.

# _mqa_dir <id> — the ticket folder every manual-QA helper and the pre-flight read: CANON_TICKETS_DIR when set (a clone's stamp points it at the
# sprint's folder), else the project's .tickets/: one rule, so the writer, the [manual] criteria and the record never look in different places.
_mqa_dir() { echo "${CANON_TICKETS_DIR:-$(tickets_dir)}/$1"; }

# _mqa_clean <text> <max> — one line of printable text: control characters become a space, | becomes /, trimmed, cut at <max>.
_mqa_clean() {
  local t
  t="$(printf '%s' "$1" | LC_ALL=C tr '\000-\037\177' ' ' | LC_ALL=C tr '|' '/' | sed 's/^ *//; s/ *$//')"   # tr pads a short second set with its last character: one character each
  printf '%s' "${t:0:$2}"
}

# cmd_manual_qa <id> --by "<who>" --step "<what>|pass|fail|n/a" [--step ...] — writes .tickets/<id>/evidence/manual-qa.md (replacing it).
cmd_manual_qa() {
  local usage='usage: sprint manual-qa <ticket-id> --by "<who>" --step "<what>|pass" [--step "<what>|fail|n/a" ...]'
  local id="${1:-}" by="" raw what res n=0 pass=0 fail=0 tdir edir target tmp root sha when mline row
  local -a rows=()
  [[ -n "$id" ]] || { echo "$usage" >&2; exit 1; }
  shift
  [[ "$id" =~ ^t-[a-z0-9]{4}$ ]] || { echo "sprint manual-qa: the ticket id must look like t-abcd" >&2; exit 1; }
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --by) [[ $# -ge 2 ]] || { echo "sprint manual-qa: --by needs a name" >&2; exit 1; }; by="$2"; shift 2 ;;
      --step)
        [[ $# -ge 2 ]] || { echo "sprint manual-qa: --step needs \"<what>|pass\"" >&2; exit 1; }
        raw="$2"; shift 2
        [[ "$raw" == *"|"* ]] || { echo "sprint manual-qa: a step is \"<what>|pass\", \"<what>|fail\" or \"<what>|n/a\" (no | in: ${raw:0:60})" >&2; exit 1; }
        res="$(printf '%s' "${raw##*|}" | tr 'A-Z' 'a-z' | sed 's/^ *//; s/ *$//')"
        case "$res" in pass|fail|n/a) ;; *) echo "sprint manual-qa: a step's result is pass, fail or n/a, not '${res:0:20}'" >&2; exit 1 ;; esac
        what="$(_mqa_clean "${raw%|*}" 200)"
        [[ -n "$what" ]] || { echo "sprint manual-qa: a step needs a description before the |" >&2; exit 1; }
        n=$((n + 1))
        (( n <= 60 )) || { echo "sprint manual-qa: at most 60 steps (group them)" >&2; exit 1; }
        [[ "$res" == pass ]] && pass=$((pass + 1)); [[ "$res" == fail ]] && fail=$((fail + 1))
        rows+=("| $what | $res |") ;;
      *) echo "sprint manual-qa: unknown argument: ${1:0:40}" >&2; echo "$usage" >&2; exit 1 ;;
    esac
  done
  by="$(_mqa_clean "$by" 80)"
  [[ -n "$by" ]] || { echo "sprint manual-qa: --by \"<who tested>\" is required" >&2; exit 1; }
  (( n > 0 )) || { echo "sprint manual-qa: at least one --step is required: what was tested by hand, and its result" >&2; exit 1; }
  tdir="$(_mqa_dir "$id")"
  [[ -d "$tdir" && ! -L "$tdir" ]] || { echo "sprint manual-qa: no ticket folder for $id here" >&2; exit 1; }
  edir="$tdir/evidence"
  [[ ! -L "$edir" ]] || { echo "sprint manual-qa: $edir is a symlink: refused" >&2; exit 1; }
  target="$edir/manual-qa.md"
  [[ ! -L "$target" && ( ! -e "$target" || -f "$target" ) ]] || { echo "sprint manual-qa: $target is not a plain file: refused" >&2; exit 1; }
  wt_write_ok "$target" "$edir/.manual-qa.$$" || exit 1   # t-f7e6: the folders above the ticket folder too
  root="$(worktree_root 2>/dev/null)" || root="$(project_root)"
  sha="$(git -C "$root" rev-parse HEAD 2>/dev/null)" || sha=unknown
  when="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  mline="$(machine_line 2>/dev/null)" && [[ -n "$mline" ]] || mline="$(uname -srm 2>/dev/null)" || mline=unknown
  mline="$(_mqa_clean "$mline" 120)"
  mkdir -p "$edir" || { echo "sprint manual-qa: could not create $edir" >&2; exit 1; }
  tmp="$edir/.manual-qa.$$"
  { printf '# Manual QA: %s\nHEAD %s %s\nBy: %s on %s\n\n| Step | Result |\n|---|---|\n' "$id" "$sha" "$when" "$by" "$mline"
    for row in "${rows[@]}"; do printf '%s\n' "$row"; done; } > "$tmp" || { rm -f "$tmp"; echo "sprint manual-qa: could not write $tmp" >&2; exit 1; }
  mv -f "$tmp" "$target" || { rm -f "$tmp"; echo "sprint manual-qa: could not replace $target" >&2; exit 1; }
  echo "manual-qa: wrote .tickets/$id/evidence/manual-qa.md ($n steps: $pass pass, $fail fail, $((n - pass - fail)) n/a) at HEAD ${sha:0:7}"
  # t-985c: the Sprint progress card's record that the person's check is in (it clears a manual_qa refusal); fail if any step failed
  canon_event manual_qa.recorded sprint "$(dirname "$(dirname "$tdir")")" "ticket=$id" "result=$( (( fail > 0 )) && echo fail || echo pass)" || true
}

# _manual_qa_state <id> — sets MQA_STATE to absent | fresh | stale | failing | bad and MQA_MSG to the detail. Fresh follows evidence.sh check's rule for logs:
# recorded at the graded commit, or at an ancestor with no tracked change since (the ticket folder excluded).
_manual_qa_state() {
  local id="$1" f head l n=0 fails=0 pass=0 in_t=0 sha who root
  MQA_STATE=absent; MQA_MSG=""; MQA_PASS=0
  f="$(_mqa_dir "$id")/evidence/manual-qa.md"
  [[ -e "$f" || -L "$f" ]] || return 0
  if [[ -L "$f" || ! -f "$f" ]]; then MQA_STATE=bad; MQA_MSG="it is a symlink or not a plain file"; return 0; fi
  head="$(head -c 65536 -- "$f" | LC_ALL=C tr -d '\000\r')"
  l="$(printf '%s\n' "$head" | sed -n '1p')"; [[ "$l" == "# Manual QA: $id" ]] || { MQA_STATE=bad; MQA_MSG="line 1 is not '# Manual QA: $id'"; return 0; }
  l="$(printf '%s\n' "$head" | sed -n '2p')"
  [[ "$l" =~ ^HEAD\ ([0-9a-f]{7,40}|unknown)\ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$ ]] || { MQA_STATE=bad; MQA_MSG="line 2 is not 'HEAD <sha> <UTC time>'"; return 0; }
  sha="${BASH_REMATCH[1]}"
  l="$(printf '%s\n' "$head" | sed -n '3p')"
  [[ "$l" =~ ^By:\ (.+)\ on\ (.+)$ ]] || { MQA_STATE=bad; MQA_MSG="line 3 is not 'By: <who> on <machine>'"; return 0; }
  who="$(printf '%s' "${BASH_REMATCH[1]}" | LC_ALL=C tr -c ' -~' '?' | cut -c1-80)"   # echoed into the evaluator's prompt: printable ASCII, bounded
  while IFS= read -r l; do
    if [[ "$l" == '|---|---|' ]]; then in_t=1; continue; fi
    (( in_t )) || continue
    [[ -n "$l" ]] || continue
    if [[ "$l" =~ ^\|\ .+\ \|\ (pass|fail|n/a)\ \|$ ]]; then
      n=$((n + 1)); [[ "${BASH_REMATCH[1]}" == fail ]] && fails=$((fails + 1)); [[ "${BASH_REMATCH[1]}" == pass ]] && pass=$((pass + 1))
    else MQA_STATE=bad; MQA_MSG="a table row is not '| <what> | pass|fail|n/a |'"; return 0; fi
  done <<< "$(printf '%s\n' "$head" | sed -n '4,$p')"
  (( n > 0 )) || { MQA_STATE=bad; MQA_MSG="no step rows"; return 0; }
  if (( fails > 0 )); then MQA_STATE=failing; MQA_MSG="$fails failing step(s) recorded by $who"; return 0; fi
  root="$(worktree_root 2>/dev/null)" || root="$(project_root)"
  # the rule evidence.sh check applies to a log: the recorded commit is the graded one or an ancestor with no tracked change since, in the working
  # tree too. "unknown" (written before the first commit) proves nothing once the project has commits; without git there is nothing to compare.
  if git -C "$root" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    local neutral=() p why=""   # the evidence-neutral paths (HANDOFF, LEARNINGS, .tickets...) are evidence.sh's, never a copy here
    while IFS= read -r p; do [[ -n "$p" ]] && neutral+=("$p"); done < <("$(dirname "${BASH_SOURCE[0]}")/evidence.sh" neutral 2>/dev/null)
    if (( ${#neutral[@]} == 0 )); then neutral=(':(exclude).tickets'); fi
    if [[ "$sha" == unknown ]]; then why="its commit is unknown"
    elif ! git -C "$root" cat-file -e "$sha^{commit}" 2>/dev/null; then why="its commit is not in this repository"
    elif ! git -C "$root" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then why="its commit is not an ancestor of HEAD"
    # t-e9aa: canon's own setup lines in a repo-root .gitignore/.gitattributes are not a change (canon_drop_setup_edits, ticket-root.sh)
    elif [[ -n "$(git -C "$root" -c core.quotepath=off diff --no-renames --name-only "$sha" HEAD -- . "${neutral[@]}" 2>/dev/null | canon_drop_setup_edits "$root" "$sha" HEAD)" ]]; then why="tracked files changed since"
    elif [[ -n "$(git -C "$root" -c core.quotepath=off diff --no-renames --name-only HEAD -- . "${neutral[@]}" 2>/dev/null | canon_drop_setup_edits "$root" HEAD)" ]]; then why="tracked files are modified in the working tree"; fi
    if [[ -n "$why" ]]; then MQA_STATE=stale; MQA_MSG="recorded at ${sha:0:7} by $who; $why"; return 0; fi
  fi
  MQA_PASS="$pass"
  MQA_STATE=fresh; MQA_MSG="HEAD ${sha:0:7} = graded, by $who, $n steps: $pass pass"
}

# _manual_criteria <id> — one line per criterion under `## Criteria` whose text starts with [manual]: "<number>\t<text>" (numbered among all criteria).
_manual_criteria() {
  # the same section and bullet forms `sprint complete` accepts (_acceptance_section, _gate_acceptance_sections); one owner (t-e790): ticket-root.sh
  manual_criteria "$(_mqa_dir "$1")/acceptance.md" numbered
}

# _manual_list <script text> <NAME> — the words of the bash array `NAME=( ... )` (one line or several), one per line.
_manual_list() {
  printf '%s\n' "$1" | awk -v n="$2" 'index($0, n "=(") == 1 { f = 1; sub(/^[A-Z_]+=\(/, "") } f { e = ($0 ~ /\)/); sub(/\).*$/, ""); gsub(/[[:space:]]+/, "\n"); if ($0 != "") print; if (e) f = 0 }'
}

# _manual_mode_refusal <id> — t-51c6: why a `manual: true` ticket may not close on the user's testing; prints nothing when it may. The user's testing
# replaces the reviewer, the mutation sweep and the full-suite stamp, so work whose own gates matter keeps the full close: a high-risk plan, and in
# canon's own checkout any diff against the base that touches a gate file or gate prompt (the lists are scripts/integrity-list.sh's: one owner, read
# from its text, never copied). If the base cannot be derived there, it refuses: it fails closed.
_manual_mode_refusal() {
  local id="$1" tdir root il base paths p changed
  tdir="$(_mqa_dir "$id")"
  [[ "$(_signoff_tier "$tdir/plan.md")" == high-risk ]] && { echo "the plan's Tier is high-risk"; return 0; }   # the one tier parser (_signoff_tier)
  root="$(worktree_root 2>/dev/null)" || root="$(project_root)"; il="$root/scripts/integrity-list.sh"
  # canon's own checkout is decided by the BASE having the list, not the working tree: deleting or renaming the list file must not turn the check off
  local why=""; base="$(gate_base "$root")" || { why="$base"; base=""; }   # t-99d2
  if [[ -z "$base" ]]; then
    [[ -f "$il" ]] || return 0   # a project that is not canon, with no remote to compare against
    echo "this is canon's own checkout and the base cannot be found to check for gate-file changes ($why)"; return 0
  fi
  git -C "$root" cat-file -e "$base:scripts/integrity-list.sh" 2>/dev/null || return 0   # the base has no gate list: not canon's checkout
  # the lists come from the BASE's copy, so editing the list cannot hide a gate file; a change to the list file is itself refused
  local gf gp lists
  lists="$(git -C "$root" show "$base:scripts/integrity-list.sh" 2>/dev/null)" || { echo "the gate-file lists cannot be read from $base:scripts/integrity-list.sh"; return 0; }
  gf="$(_manual_list "$lists" GATE_FILES)"; gp="$(_manual_list "$lists" GATE_PROMPTS)"
  if [[ -z "$gf" || -z "$gp" ]]; then echo "the gate-file lists could not be read from scripts/integrity-list.sh (GATE_FILES or GATE_PROMPTS is empty)"; return 0; fi
  changed="$(git -C "$root" diff --name-only --no-renames "$base" -- 2>&1; git -C "$root" ls-files --others --exclude-standard 2>&1)" || true
  if grep -q '^fatal:\|^error:' <<< "$changed"; then echo "git could not list the changes against $base"; return 0; fi
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    if grep -qxF -- "$p" <<< "$changed"; then echo "it changes a gate file or gate prompt ($p)"; return 0; fi
  done <<< "$gf"$'\n'"$gp"$'\nscripts/integrity-list.sh'
  return 0
}

# _gate_manual <id> <ticket dir> — t-51c6: a `manual: true` ticket closes only on the user's recorded testing, so the close itself checks what the
# pre-flight checks (the pre-flight is protocol text; this is the CLI floor): Manual mode allowed for this work, and a fresh record with a pass.
_gate_manual() {
  local id="$1" tdir="$2" why
  [[ "$(get_field "$tdir/ticket.md" manual 2>/dev/null)" == true ]] || return 0
  why="$(_manual_mode_refusal "$id")"
  if [[ -n "$why" ]]; then
    echo "Sprint $id cannot close: Manual mode is refused: $why. Use the full close ('tkt manual $id off'), which keeps every gate."
    return 1
  fi
  _manual_qa_state "$id"
  if [[ "$MQA_STATE" != fresh || "$MQA_PASS" -eq 0 ]]; then
    echo "Sprint $id cannot close: it is a Manual ticket (manual: true) and the user's testing is not recorded (manual-qa.md is ${MQA_STATE}${MQA_MSG:+: $MQA_MSG}$( [[ "$MQA_STATE" == fresh ]] && echo ': no step passed' ))."
    echo "Ask the user what they tested and what they saw, then record it: sprint manual-qa $id --by \"<name>\" --step \"<what>|pass\" [--step ...]"
    return 1
  fi
}

# _is_sweep_log <log> — t-2ce8: 0 when the log's stamped command (line 2, `evidence.sh stamp`'s %q-quoted argv) is the mutation sweep
# program itself, never a wrapper (bash -c, env, echo) that names it later. The sweep is non-binding (complete.md step 3), so its stale
# log is a note, not a reason to re-sweep: reruns after a commit cost 20 h in 30 days. Judged from the file, never from check's text.
_is_sweep_log() {
  local l2
  [[ -f "$1" && ! -L "$1" ]] || return 1
  l2="$(head -c 16384 -- "$1" | LC_ALL=C tr -d '\000' | sed -n '2p' | tr -d '\r')" || return 1
  local py="pyth""on3"   # the interpreter's name as data: this matches a stamped command line, it runs nothing (no-python-windows-paths)
  [[ "$l2" =~ ^\$\ (mutant-sweep|(\./)?tools/mutant-sweep|/[^\ ]*/tools/mutant-sweep|$py\ ((\./)?tools/|/[^\ ]*/tools/)mutant-sweep\.py)(\ |$) ]]
}

# cmd_check_evidence <id> — t-a3d7: the pre-flight complete.md step 3 runs before dispatching the evaluator. Reads `evidence.sh check`
# (the one owner of what fresh/covered mean) at HEAD and refuses unless every top-level evidence log is `fresh` with exit 0 or
# `covered`; logs kept for history or produced off-tree belong in a subfolder of evidence/, which check never scans. Read-only.
# Exit 0 ok, 1 refused (each log named with how to fix it), 2 usage or a failed check.
cmd_check_evidence() {
  local id="${1:-}" out line bad=0 n=0 edir f name
  [[ "$id" =~ ^t-[a-z0-9]{4}$ ]] || { echo "usage: sprint check-evidence <ticket-id>" >&2; exit 2; }
  _gate_caps "$id" "$(ticket_dir_for "$id")" || exit 1   # t-c990: a cap miss is found before the evaluator, not by a cloud close
  local manual_on=0 why
  if [[ "$(get_field "$(_mqa_dir "$id")/ticket.md" manual 2>/dev/null)" == true ]]; then
    manual_on=1; why="$(_manual_mode_refusal "$id")"
    if [[ -n "$why" ]]; then
      echo "check-evidence: Manual mode is refused: $why. Use the full close ('tkt manual $id off'), which keeps every gate."
      _gate_reject "$id" "$(_mqa_dir "$id")" evaluator manual_refused
      exit 1
    fi
  fi
  out="$("$SCRIPT_DIR/evidence.sh" check "$id" 2>&1)" || { echo "check-evidence: evidence.sh check failed: $out" >&2; exit 2; }
  # A log name `evidence.sh stamp` can never write (a space, `;`, a control character) could carry a fake `exit=0` inside the
  # line check prints for it, so such a name is refused outright; every name left then holds no space, and the matches below are exact.
  edir="${CANON_TICKETS_DIR:-$(tickets_dir)}/$id/evidence"
  for f in "$edir"/*.log; do
    [[ -e "$f" || -L "$f" ]] || continue   # no evidence folder, or no log in it: the glob stays literal
    name="${f##*/}"
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9._-]*\.log$ ]]; then
      bad=$((bad + 1)); n=$((n + 1))
      echo "  REFUSE  $(printf '%s' "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' '?'): a name sprint evidence stamp never writes; rename it, or move it into a subfolder"
    fi
  done
  # t-aa24: the user's manual-QA record (not a log: evidence.sh check never lists it) and the criteria tagged [manual] that need it
  local mcrit mq=0 mbad=0 mnum mtxt
  mcrit="$(_manual_criteria "$id")"; _manual_qa_state "$id"
  case "$MQA_STATE" in
    fresh)
      n=$((n + 1)); mq=1
      if (( manual_on && MQA_PASS == 0 )); then bad=$((bad + 1)); mbad=1; echo "  REFUSE  manual-qa.md failing: a Manual ticket needs at least one step that passed ($MQA_MSG)"
      else echo "  ok      manual-qa.md ($MQA_MSG)"; fi ;;
    stale|failing|bad) n=$((n + 1)); mq=1; bad=$((bad + 1)); mbad=1; echo "  REFUSE  manual-qa.md $MQA_STATE: $MQA_MSG" ;;
    absent)
      if (( manual_on )); then
        n=$((n + 1)); bad=$((bad + 1)); mbad=1
        echo "  REFUSE  manual-qa.md missing: $id is a Manual ticket (manual: true): waiting for your test"
      fi
      if [[ -n "$mcrit" ]]; then
        while IFS=$'\t' read -r mnum mtxt; do
          n=$((n + 1)); bad=$((bad + 1)); mbad=1
          echo "  REFUSE  manual-qa.md missing: criterion $mnum is tagged [manual] ($(printf '%s' "$mtxt" | LC_ALL=C tr -c 'A-Za-z0-9._ /=:+,()-' '?'))"
        done <<< "$mcrit"
      fi ;;
  esac
  if [[ -z "$out" ]] && (( ! bad )) && (( ! mq )); then
    echo "check-evidence: no stamped logs in .tickets/$id/evidence/ (nothing to reuse: the evaluator runs every check itself)"
    exit 0
  fi
  if [[ -n "$out" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[a-z]+\ ([^\ ]+)\  ]] && [[ ! "${BASH_REMATCH[1]}" =~ ^[a-z0-9][a-z0-9._-]*\.log$ ]] && continue   # refused above by name
    n=$((n + 1))
    if [[ "$line" =~ ^fresh\ [a-z0-9][a-z0-9._-]*\.log\ exit=0\ \( || "$line" =~ ^covered\ [a-z0-9][a-z0-9._-]*\.log\ exit=[0-9?]+\ \( ]]; then echo "  ok      $line"
    elif [[ "$line" =~ ^stale\ ([a-z0-9][a-z0-9._-]*\.log)\ exit=0\ \( ]] && _is_sweep_log "$edir/${BASH_REMATCH[1]}"; then
      echo "  note    $line (non-binding sweep from an older commit: not re-stamped, not reused)"   # t-2ce8
    elif (( manual_on )); then echo "  note    $line (not required: a Manual ticket closes on the user's testing)"
    else bad=$((bad + 1)); echo "  REFUSE  $line"; fi
  done <<< "$out"
  fi
  if (( bad )); then
    echo "check-evidence: $bad of $n log(s) would fail or mislead the evaluator; do not dispatch it yet."
    echo "  stale      re-stamp at HEAD (sprint evidence stamp, from a plain clone for the full suite)"
    echo "  exit=N     fix the failure and re-stamp; for a full board spec failing only on new flakes, list them, then stamp"
    echo "             \`node tests/board-spec-guard.js <the run's --out dir>/board-spec-*-run*.json\` at HEAD (the run log becomes covered)"
    echo "  unstamped  stamp it, or move a history or off-tree log into a subfolder of evidence/ (never scanned)"
    if (( mbad )); then
      echo "  manual-qa  ask the user what they tested by hand and what they saw, then record it: sprint manual-qa $id --by \"<name>\" --step \"<what>|pass\" [--step ...]"
      echo "             (stale: the code changed after they tested: ask them to re-test; failing: fix the work, or record the corrected result)"
    fi
    _gate_reject "$id" "$(dirname "$edir")" evaluator "$( (( mbad )) && echo manual_qa || echo stale_evidence )"
    exit 1
  fi
  echo "check-evidence: ok ($n log(s) fresh with exit 0 or covered$( (( mq )) && echo ", plus the user's manual QA" ))"
}

# cmd_relay_report <id> [evaluator|reviewer] — t-ff14: a read-only `Plan` fallback gate cannot write its report, and the main
# session must not type one (Claude Code's auto mode refuses that as a bypassed gate). This copies the report, byte for
# byte, from the harness's own transcript of the newest matching dispatch (Plan, or the canon agent itself) into its file:
# the transcript's SubagentHandback message (else last text) from `evaluator-run-id:` / `# Review Notes` on. The close
# check still verifies the evaluator's report against that same transcript. Refuses when no transcript holds it.
cmd_relay_report() {
  local id="${1:-}" role="${2:-evaluator}" tdir cfg marker proto agents dest f meta report found=""
  [[ -n "$id" ]] || { echo "Usage: sprint relay-report <id> [evaluator|evaluator2|reviewer]" >&2; exit 1; }
  local second=""   # t-864c: only the second evaluator's dispatch names .tickets/<id>/eval-report-2.md (eval.md names the file without a path)
  case "$role" in
    evaluator) marker="evaluator-run-id:" proto="reference/eval.md" agents="canon-evaluator|Plan" dest="eval-report.md" ;;
    evaluator2) marker="evaluator-run-id:" proto="reference/eval.md" agents="canon-evaluator|Plan" dest="eval-report-2.md" ;;
    reviewer)  marker="# Review Notes"    proto="reference/review.md" agents="canon-reviewer|Plan" dest="review-notes.md" ;;
    *) echo "Usage: sprint relay-report <id> [evaluator|evaluator2|reviewer]" >&2; exit 1 ;;
  esac
  tdir="$(ticket_dir_for "$id")"
  [[ -d "$tdir" ]] || { echo "relay-report: no ticket folder for $id" >&2; exit 1; }
  if [[ "$(_report_harness)" == copilot ]]; then _relay_report_copilot "$id" "$role" "$tdir" "$proto" "$marker" "$dest"; return; fi
  cfg="${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}"
  # An older board binary takes an unknown first word for a port and would start serving: ask --help first (board_helper_bin).
  local board; board="$(board_bin)"
  case "$("$board" --help 2>/dev/null || true)" in
    *transcript-report*) ;;
    *) echo "relay-report: the installed board binary predates relay-report; run 'canon update' (or build the board), then retry" >&2; exit 1 ;;
  esac
  # newest first, within the last 3 hours: the dispatch just finished
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    meta="${f%.jsonl}.meta.json"
    [[ -f "$meta" ]] && grep -qE "\"agentType\"[[:space:]]*:[[:space:]]*\"($agents)\"" "$meta" || continue
    grep -qF -e "$proto" "$f" && grep -qF -e "$id" "$f" || continue
    second=no; grep -qF -e ".tickets/$id/eval-report-2.md" "$f" && second=yes
    case "$role" in evaluator) [[ $second == no ]] || continue ;; evaluator2) [[ $second == yes ]] || continue ;; esac   # never one in place of the other
    report="$("$board" transcript-report "$f" "$marker" 2>/dev/null)" || continue
    found="$f"; break
  done < <(find "$cfg/projects/" -path '*/subagents/agent-*.jsonl' -type f -mmin -180 -exec ls -t {} + 2>/dev/null)
  if [[ -z "$found" ]]; then
    echo "relay-report: no $role transcript for $id (a Plan or canon-$role dispatch in the last 3 hours that read $proto and returned a report starting '$marker'). Dispatch the $role again." >&2
    exit 1
  fi
  wt_write_ok "$tdir/$dest" || exit 1   # t-f7e6
  printf '%s\n' "$report" > "$tdir/$dest"
  echo "relay-report: wrote $tdir/$dest from $found ($(sed -nE 's/.*"agentType"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "${found%.jsonl}.meta.json" | head -1))"
}

# _relay_report_copilot <id> <role> <tdir> <protocol> <marker> <dest> — t-4084: relay-report under Copilot CLI. A Copilot gate has no write
# tool, so it returns its report as its final message; Copilot keeps that message in its session record, and this copies it byte for
# byte (board binary copilot-report: the canon gate's own task result, never the main session's text). Refuses when none matches.
_relay_report_copilot() {
  local id="$1" role="$2" tdir="$3" proto="$4" marker="$5" dest="$6" bin chome agent report rc=0
  local -a extra=()
  chome="${COPILOT_HOME:-${HOME:-}/.copilot}"
  case "$role" in reviewer) agent=canon-reviewer ;; evaluator2) agent=canon-evaluator; extra=(--second) ;; *) agent=canon-evaluator ;; esac
  bin="$(_copilot_report_bin)"
  [[ -n "$bin" ]] || { echo "relay-report: the installed board binary predates copilot-report; run 'canon update' (or build the board), then retry" >&2; exit 1; }
  report="$("$bin" copilot-report ${extra[@]+"${extra[@]}"} "$chome" "$agent" "$id" "$proto" "$marker" 2>/dev/null)" || rc=$?
  if (( rc != 0 )); then
    echo "relay-report: no $role result for $id in Copilot's session record ($chome/session-state/*/events.jsonl): a $agent task in the last 3 hours whose prompt names $id and whose whole result has a line starting '$marker'. Dispatch the $role again." >&2
    exit 1
  fi
  wt_write_ok "$tdir/$dest" || exit 1   # t-f7e6
  printf '%s\n' "$report" > "$tdir/$dest"
  echo "relay-report: wrote $tdir/$dest from Copilot's session record ($agent)"
}

# _signoff_option <plan.md> <label> — t-864c: the lowercased value of a `| <Label>: <value>` segment of the Sign-off Tier line (the label in
# either case, its words separated by spaces), or nothing.
_signoff_option() {
  _acceptance_section "Sign-off" "$1" 2>/dev/null | sed 's/\*//g' | LC_ALL=C awk -v lab="$2" '
    tolower($0) ~ /^[[:space:]]*tier[[:space:]]*:/ {
      n = split($0, seg, "|")
      for (i = 2; i <= n; i++) {
        s = seg[i]; sub(/^[[:space:]]+/, "", s); k = s; sub(/[[:space:]]*:.*$/, "", k)
        if (tolower(k) == tolower(lab) && index(s, ":")) { v = substr(s, index(s, ":") + 1); gsub(/[[:space:]]/, "", v); print tolower(v); exit }
      }
      exit
    }' || true
}

# _gate_agent — the Model tiers agent of this session (t-c723): COCKPIT_AGENT in the Cockpit, else copilot when Copilot CLI ran us (it sets
# COPILOT_CLI=1 for its subprocesses, changelog 0.0.421), else claude.
_gate_agent() {
  if [[ -n "${COCKPIT_AGENT:-}" ]]; then echo "$COCKPIT_AGENT"
  elif [[ "${COPILOT_CLI:-}" == 1 ]]; then echo copilot
  else echo claude; fi
}

# sprint gate-model <id> <reviewer|evaluator|speccheck> — t-c723: the model to dispatch that gate with, resolved by canon so the agent
# does not have to (a Copilot session that skipped complete.md's lookup ran its gates on the agent file's floor). One line, exit 0:
#   model: <id> (Admin <Role> default, <agent>)
#   ticket rule: <why> — complete.md "Model tier for gates"   (a Gate model: line, or a Lite evaluator: the agent applies that rule)
#   none: omit model (<why>)                                    (the agent file's floor)
# The fail-safes are complete.md's: a Haiku evaluator pick and a Claude pick with no Agent-tool alias are omitted; the spec checker
# gets the reviewer pick when the registry has no speccheck default (the loader fills it, as Admin shows); pi has no pick.
cmd_gate_model() {
  local id="${1:-}" role="${2:-}" tdir plan agent m label
  [[ -n "$id" && "$role" =~ ^(reviewer|evaluator|speccheck)$ ]] || { echo "Usage: sprint gate-model <ticket-id> <reviewer|evaluator|speccheck>" >&2; exit 1; }
  tdir="$(ticket_dir_for "$id")"; plan="$tdir/plan.md"
  [[ -f "$plan" ]] || { echo "Sprint $id: plan.md not found." >&2; exit 1; }
  case "$role" in reviewer) label=Reviewer ;; evaluator) label=Evaluator ;; *) label="Spec check" ;; esac
  if [[ -n "$(signoff_model_parse "$plan" gate 2>/dev/null)" ]]; then
    echo "ticket rule: the ticket's Gate model line — complete.md \"Model tier for gates\""; return 0
  fi
  if [[ "$role" == evaluator && "$(get_field "$tdir/ticket.md" demo 2>/dev/null)" == true ]]; then
    echo "ticket rule: Lite (demo: true) evaluator — complete.md \"Model tier for gates\""; return 0
  fi
  agent="$(_gate_agent)"
  [[ "$agent" == claude || "$agent" == copilot ]] || { echo "none: omit model ($agent has no Model tiers pick)"; return 0; }
  m="$(_admin_stage_model "$role" "$agent")"
  [[ -n "$m" ]] || { echo "none: omit model (no Admin $label default for $agent)"; return 0; }
  if [[ "$role" == evaluator && "$(printf '%s' "$m" | tr 'A-Z' 'a-z')" == *haiku* ]]; then
    echo "none: omit model (Admin's Evaluator pick $m is a Haiku model; the binding evaluator never runs on Haiku outside Lite)"; return 0
  fi
  if [[ "$agent" == claude && ! "$m" =~ ^(fable|opus|sonnet|haiku)$ ]]; then
    echo "none: omit model (Admin's $label pick $m has no alias the Agent tool takes)"; return 0
  fi
  echo "model: $m (Admin $label default, $agent)"
}

# sprint second-eval <id> — t-864c: the model the second evaluator runs on, or `skip: <reason>` (always exit 0). It needs Admin's Second
# eval pick for the agent (Off by default); it runs on a high-risk ticket unless the Sign-off says `Second eval: off`, and on any ticket
# whose Sign-off says `Second eval: on`. A ticket's Gate model never sets it (the point is another model).
cmd_second_eval() {
  local id="${1:-}" tdir plan agent="${COCKPIT_AGENT:-claude}" m sel
  [[ -n "$id" ]] || { echo "Usage: sprint second-eval <ticket-id>" >&2; exit 1; }
  tdir="$(ticket_dir_for "$id")"; plan="$tdir/plan.md"
  [[ -f "$plan" ]] || { echo "Sprint $id: plan.md not found." >&2; exit 1; }
  [[ "$agent" == claude || "$agent" == copilot ]] || { echo "skip: $agent has no Second eval step"; return 0; }
  m="$(_admin_stage_model evaluator2 "$agent")"
  [[ -n "$m" ]] || { echo "skip: no Second eval model in Admin for $agent"; return 0; }
  sel="$(_signoff_option "$plan" "second eval")"
  [[ -z "$sel" || "$sel" == on || "$sel" == off ]] || echo "sprint second-eval: ignoring 'Second eval: $sel' on $id's Sign-off (on or off)" >&2
  [[ "$sel" != off ]] || { echo "skip: Second eval: off on this ticket"; return 0; }
  # the binding evaluator already ran on this model when the ticket's Gate model set it: a second run on it is no second opinion
  [[ "$(signoff_model_resolve "$plan" gate 2>/dev/null)" != "$m" ]] || { echo "skip: the ticket's Gate model already put the binding evaluator on $m"; return 0; }
  if [[ "$sel" != on && "$(_signoff_tier "$plan")" != high-risk ]]; then echo "skip: not high-risk (add | Second eval: on to run it)"; return 0; fi
  echo "$m"
}

# _eval_rows <report> — "<section>\t<first cell>\t<status>" for each data row of ## Criteria and ## Test Plan (the eval.md table shape).
_eval_rows() {
  LC_ALL=C awk '
    /^## / { sec = ($0 ~ /^## Criteria[[:space:]]*$/) ? "Criteria" : ($0 ~ /^## Test Plan[[:space:]]*$/) ? "Test Plan" : ""; next }
    sec != "" && /^\|/ {
      # a `\|` and a `|` inside a backtick span are cell text, not separators (eval.md quotes code in its cells): hide them before the split
      line = ""; inb = 0
      for (i = 1; i <= length($0); i++) { ch = substr($0, i, 1)
        if (ch == "\\" && substr($0, i + 1, 1) == "|") { line = line "\001"; i++; continue }
        if (ch == "`") inb = !inb
        line = line ((ch == "|" && inb) ? "\001" : ch) }
      n = split(line, c, "|"); if (n < 4) next
      k = c[2]; st = c[3]; gsub(/\001/, "|", k); gsub(/^[[:space:]]+|[[:space:]]+$/, "", k); gsub(/[*_`]/, "", st); gsub(/^[[:space:]]+|[[:space:]]+$/, "", st)
      if (k == "" || k ~ /^-+$/ || tolower(k) == "criterion" || tolower(k) == "item") next
      split(tolower(st), w, /[^a-z-]/); print sec "\t" k "\t" w[1]
    }' "$1"
}

# _eval_compare <tdir> — prints the differing rows and the `Disagreements: <n>` line; returns 2 when a report is missing or has no rows.
_eval_compare() {
  local tdir="$1" a b ra rb
  a="$tdir/eval-report.md"; b="$tdir/eval-report-2.md"
  [[ -f "$a" ]] || { echo "eval-report.md not found"; return 2; }
  [[ -f "$b" ]] || { echo "eval-report-2.md not found"; return 2; }
  ra="$(_eval_rows "$a")"; rb="$(_eval_rows "$b")"
  [[ -n "$ra" ]] || { echo "eval-report.md has no Criteria or Test Plan rows"; return 2; }
  [[ -n "$rb" ]] || { echo "eval-report-2.md has no Criteria or Test Plan rows"; return 2; }
  { printf '%s\n' "$ra" | sed 's/^/A\t/'; printf '%s\n' "$rb" | sed 's/^/B\t/'; } | LC_ALL=C awk -F'\t' '
    function cut(x) { gsub(/[\001-\037\177]/, "?", x); return length(x) > 100 ? substr(x, 1, 100) "..." : x }
    { key = $2 "\t" $3; if (!(key in seen)) { seen[key] = 1; order[++n] = key }; if ($1 == "A") A[key] = $4; else B[key] = $4 }
    END {
      d = 0
      for (i = 1; i <= n; i++) { k = order[i]; split(k, p, "\t")
        if (!(k in A)) { print p[1] ": " cut(p[2]) ": only in eval-report-2.md (" B[k] ")"; d++ }
        else if (!(k in B)) { print p[1] ": " cut(p[2]) ": only in eval-report.md (" A[k] ")"; d++ }
        else if (A[k] != B[k]) { print p[1] ": " cut(p[2]) ": binding " A[k] ", second " B[k]; d++ }
      }
      print "Disagreements: " d
    }'
}

# sprint eval-compare <id> — t-864c: the binding evaluator's grades beside the second evaluator's, row by row (matched by the verbatim
# first cell). Never a close gate: the person decides on each difference. Exit 0 when both reports parse, 1 when one is missing or empty.
cmd_eval_compare() {
  local id="${1:-}" tdir out rc=0 n m
  [[ -n "$id" ]] || { echo "Usage: sprint eval-compare <ticket-id>" >&2; exit 1; }
  tdir="$(ticket_dir_for "$id")"
  out="$(_eval_compare "$tdir")" || rc=$?
  if (( rc )); then echo "Sprint $id: $out." >&2; exit 1; fi
  printf '%s\n' "$out"
  n="$(printf '%s\n' "$out" | sed -n 's/^Disagreements: //p')"
  m="$(awk 'sub(/^Model:[[:space:]]*/, "") { printf "%s", $0; exit }' "$tdir/eval-report-2.md" | tr -d '\r' | LC_ALL=C tr -c 'A-Za-z0-9._:/ ()-' '?' | cut -c1-80)"
  canon_event eval.compared sprint "$(project_root)" "ticket=$id" "model=$m" "disagreements=$n"
}

# cmd_eval_verdict <id> — records the evaluator's outcome into ticket.md's
# eval_fail_count field: increments on a fail (or missing/malformed verdict),
# resets to 0 on pass. Called explicitly by the agent right after reading
# eval-report.md (complete.md step 3), the same pattern as subagent-log.sh's
# explicit post-dispatch call — not a hook, so it works whether or not the
# orchestrating agent goes on to invoke `sprint complete` itself. Prints the
# resulting count and a retry-budget-exhausted notice at 3, but never blocks
# on its own — _gate_eval_report_verdict (cmd_complete) is the actual close gate.
# t-c723: a report with no `pass:`/`fail:` line but a verdict in another shape (`verdict: pass —`, `**pass:**`, `## pass`) is refused
# (exit 1) naming the line it needs, and the count is left alone: the grade may be right, only its line is wrong.
cmd_eval_verdict() {
  local id="${1:-}"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local tdir report ticket_file
  tdir="$(ticket_dir_for "$id")"
  report="$tdir/eval-report.md"
  ticket_file="$tdir/ticket.md"
  [[ -f "$report" ]] || { echo "Sprint $id: eval-report.md not found." >&2; exit 1; }
  [[ -f "$ticket_file" ]] || { echo "Sprint $id: ticket.md not found." >&2; exit 1; }
  # t-6be7: a worktree that holds its own .tickets/ copy wins over main's, so a stale failing report there counted a failure main never had.
  # Which copy is read is unchanged (t-fff4 item 3); the difference is said, naming both, never chosen silently.
  local wt main_tickets
  wt="$(worktree_root 2>/dev/null)" || wt=""
  main_tickets="$(_worktree_main_tickets "$wt" 2>/dev/null)" || main_tickets=""
  if [[ -n "$main_tickets" && ! "$main_tickets/$id" -ef "$tdir" && -f "$main_tickets/$id/eval-report.md" ]] && ! cmp -s "$report" "$main_tickets/$id/eval-report.md"; then
    echo "Sprint $id: eval-report.md differs between this worktree ($report) and the main checkout ($main_tickets/$id/eval-report.md); recording into this worktree's copy." >&2
  fi

  local current new
  current="$(get_field "$ticket_file" eval_fail_count 2>/dev/null)"
  [[ -z "$current" ]] && current=0

  if ! grep -qE '^(pass|fail):' "$report" \
    && grep -qiE '^[#*_ ]*(verdict[*_ ]*:[*_ ]*)?[*_]*(pass|fail)[*_ ]*([:—–-]|$)' "$report"; then
    echo "Sprint $id: eval-report.md has a verdict line in the wrong shape; it must start the line with \`pass: <one-line summary>\` or \`fail: <one-line summary>\` (no \`verdict:\`, bold or heading). eval_fail_count is unchanged: ask the evaluator to fix that line." >&2
    exit 1
  fi
  if grep -qE '^pass:' "$report"; then
    new=0
  else
    new=$((current + 1))
  fi

  set_or_add_field "$ticket_file" eval_fail_count "$new"
  echo "$id: eval_fail_count=$new"
  if (( new >= 3 )); then
    echo "Sprint $id: evaluator has failed $new times in a row — retry budget exhausted. Diagnose the root cause outside the automated loop, or set eval_override: true with a dated waiver to close anyway." >&2
  fi
}

# --- suggest-tier: propose-only structural bugfix-tier classifier (t-b6a3) ---
# Reads the diff ONLY (never plan prose — t-8c24) and PROPOSES a tier; writes
# nothing. The human/agent still hand-writes `Tier: bugfix` in plan.md ## Sign-off.
# Mirrors complete.md's model-tier posture: merge-base EXIT STATUS decides, not
# empty diff output (t-f04f); allowlist, not denylist — any doubt -> normal.

# test source file — allowed as the covering test
_st_is_test() {
  local p="$1" b="${1##*/}"
  case "$p" in
    tests/*|test/*|spec/*|*/tests/*|*/test/*|*/spec/*|__tests__/*|*/__tests__/*) return 0 ;;
  esac
  case "$b" in
    *.test.*|*.spec.*|*_test.*|test_*.*|*Test.*|*Tests.*|*_spec.rb) return 0 ;;
  esac
  return 1
}

# build / test-infrastructure file (not-trivial trigger 2)
_st_is_infra() {
  local p="$1" b="${1##*/}"
  case "$p" in
    scripts/*|*/scripts/*) return 0 ;;
  esac
  case "$b" in
    package.json|package-lock.json|yarn.lock|pnpm-lock.yaml|tsconfig.json|tsconfig.*.json|jest.config.*|vitest.config.*|babel.config.*|.babelrc|.eslintrc*|.prettierrc*|Makefile|makefile|GNUmakefile|*.mk|CMakeLists.txt|go.mod|go.sum|Cargo.toml|Cargo.lock|requirements.txt|setup.py|setup.cfg|pyproject.toml|tox.ini|pom.xml|build.gradle|build.gradle.kts|Gemfile|Gemfile.lock) return 0 ;;
  esac
  return 1
}

# hook / pipeline / post-commit file (not-trivial trigger 3)
_st_is_hookpipe() {
  local p="$1" b="${1##*/}"
  case "$p" in
    .github/workflows/*|.github/actions/*|.circleci/*|hooks/*|*/hooks/*|.git/hooks/*) return 0 ;;
  esac
  case "$b" in
    .gitlab-ci.yml|Jenkinsfile|.travis.yml|azure-pipelines.yml|azure-pipelines.yaml|*pre-commit*|*post-commit*|*pre-push*|commit-msg) return 0 ;;
  esac
  return 1
}

_st_emit() {
  # _st_emit <tier> <reason>
  echo "suggested tier: $1"
  echo "reason: $2"
  echo 'note: propose-only — this suggests, it does not apply. The agent/human still writes `Tier: bugfix` in plan.md ## Sign-off if it applies.'
  echo 'caveat: only the structural shape is checked here. Whether the covering test asserts an independent invariant (not a re-derivation of the code) is a judgment owned by the binding evaluator (and eventually the t-5220 mutation-test), never verified mechanically.'
}

# cmd_suggest_tier [<id>] [--base-ref <ref>] — structural, propose-only.
# <id> is accepted for interface parity with the ticket's proposed name but is
# not required (the diff is repo-relative, not ticket-scoped).
cmd_suggest_tier() {
  local base="" id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base-ref) base="${2:-}"; shift 2 || { echo "Error: --base-ref requires a value" >&2; exit 1; } ;;
      --base-ref=*) base="${1#*=}"; shift ;;
      -h|--help) echo "Usage: sprint suggest-tier [<id>] [--base-ref <ref>]"; return 0 ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *) id="$1"; shift ;;
    esac
  done
  : "${id:-}"  # accepted, intentionally unused for classification

  # Base ref: explicit override, else gate_base (t-99d2: the default branch). Decide on
  # EXIT STATUS, not empty output (t-f04f) — a failed substitution can leave the
  # outer git diff running against a different, non-empty baseline.
  if [[ -z "$base" ]]; then
    if ! base="$(gate_base .)"; then
      _st_emit normal "no git baseline ($base)"
      return 0
    fi
  fi

  local diff_out
  if ! diff_out="$(git diff --name-status "$base" HEAD 2>/dev/null)"; then
    _st_emit normal "could not compute diff against base ref '$base'"
    return 0
  fi
  if [[ -z "$diff_out" ]]; then
    _st_emit normal "empty diff against '$base' — nothing to classify"
    return 0
  fi

  local logic_count=0 logic_file="" test_seen=""
  local status path rest
  while IFS=$'\t' read -r status path rest; do
    [[ -z "$status" ]] && continue
    # renames/copies report old<TAB>new — the surviving path is in $rest
    case "$status" in
      R*|C*) path="${rest:-$path}" ;;
    esac
    [[ -z "$path" ]] && continue

    if _st_is_hookpipe "$path"; then
      _st_emit normal "not-trivial trigger: hook/pipeline/post-commit change ($path)"; return 0
    fi
    if _st_is_infra "$path"; then
      _st_emit normal "not-trivial trigger: test/build-infrastructure wiring ($path)"; return 0
    fi
    if _st_is_test "$path"; then
      test_seen="$path"; continue
    fi
    # non-test, non-infra, non-hook = logic file
    if [[ "${status:0:1}" == "A" ]]; then
      _st_emit normal "not-trivial trigger: new file beyond the test ($path added)"; return 0
    fi
    logic_count=$((logic_count + 1))
    logic_file="$path"
  done <<< "$diff_out"

  if (( logic_count == 1 )); then
    local why="single logic file ($logic_file)"
    [[ -n "$test_seen" ]] && why="$why + covering test ($test_seen)"
    why="$why; none of the four not-trivial triggers present"
    _st_emit bugfix "$why"
  elif (( logic_count == 0 )); then
    _st_emit normal "no non-test logic file changed — nothing a bugfix would fix"
  else
    _st_emit normal "not-trivial trigger: coordinated multi-file intent ($logic_count non-test logic files changed)"
  fi
}

# cmd_gate_cost [--last N] — t-5ef3: one screen of close-gate cost from .claude/subagent-runs.jsonl. Only rows that
# carry `tokens` (subagent-log.sh --tokens …) count; older rows have no numbers and are skipped, not read as zero.
# Groups the last N measured runs by gate type × tier × model (t-3a14; `-` when the row has none). Read-only; plain awk (no python, for Git Bash).
cmd_gate_cost() {
  local last=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --last) last="${2:-}"; shift 2 || { echo "Error: --last requires a value" >&2; exit 1; } ;;
      -h|--help) echo "Usage: sprint gate-cost [--last N]"; return 0 ;;
      *) echo "Error: unknown argument: $1" >&2; exit 1 ;;
    esac
  done
  [[ "$last" =~ ^[1-9][0-9]*$ ]] || { echo "Error: --last must be a positive whole number" >&2; exit 1; }
  local jsonl
  jsonl="$(project_root)/.claude/subagent-runs.jsonl"
  [[ -f "$jsonl" ]] || { echo "No gate runs logged: $jsonl not found."; return 0; }
  awk -v last="$last" '
    function field(name,   m) {
      if (match($0, "\"" name "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"")) { m = substr($0, RSTART, RLENGTH); sub(/^[^:]*:[[:space:]]*"/, "", m); sub(/"$/, "", m); return m }
      if (match($0, "\"" name "\"[[:space:]]*:[[:space:]]*[0-9.]+")) { m = substr($0, RSTART, RLENGTH); sub(/^[^:]*:[[:space:]]*/, "", m); return m }
      return ""
    }
    function median(list,   a, n, i, j, t) {
      n = split(list, a, " ")
      for (i = 2; i <= n; i++) { t = a[i] + 0; for (j = i - 1; j >= 1 && a[j] + 0 > t; j--) a[j + 1] = a[j]; a[j + 1] = t }
      return (n % 2) ? a[(n + 1) / 2] + 0 : (a[n / 2] + a[n / 2 + 1]) / 2
    }
    { tok = field("tokens"); if (tok == "") next
      id = field("agent_id")   # t-7c89: one run per agent id; a later measured row replaces the earlier one in place
      if (id != "" && (id in at)) k = at[id]; else { k = ++n; if (id != "") at[id] = k }
      T[k] = tok; M[k] = field("minutes"); O[k] = field("outcome")
      ty = field("agent_type"); ti = field("tier"); mo = field("model")
      if (ti ~ /^high/) ti = "high-risk"   # t-63a7: rows logged before the tier was named high-risk
      G[k] = (ty == "" ? "-" : ty) "\t" (ti == "" ? "-" : ti) "\t" (mo == "" ? "-" : mo) }
    END {
      if (n == 0) { print "No measured gate runs yet: log them with sprint subagent-log --tokens N --minutes M --tool-uses K."; exit }
      start = (n > last) ? n - last + 1 : 1
      for (i = start; i <= n; i++) {
        g = G[i]; if (!(g in C)) order[++ng] = g
        C[g]++; TL[g] = TL[g] " " T[i]; if (T[i] + 0 > TW[g]) TW[g] = T[i] + 0
        if (M[i] != "") { MC[g]++; ML[g] = ML[g] " " M[i]; if (M[i] + 0 > MW[g]) MW[g] = M[i] + 0 }
        if (O[i] == "fail" || O[i] == "budget") F[g]++
      }
      printf "Close-gate cost, last %d measured run(s):\n", n - start + 1
      printf "%-10s %-9s %-18s %4s %10s %10s %8s %9s %11s\n", "gate", "tier", "model", "runs", "tok-med", "tok-worst", "min-med", "min-worst", "fail/budget"
      for (k = 1; k <= ng; k++) {
        g = order[k]; split(g, p, "\t")
        mm = MC[g] ? sprintf("%.1f", median(ML[g])) : "-"; mw = MC[g] ? sprintf("%.1f", MW[g]) : "-"
        printf "%-10s %-9s %-18s %4d %10d %10d %8s %9s %10d%%\n", p[1], p[2], p[3], C[g], median(TL[g]), TW[g], mm, mw, int(100 * F[g] / C[g] + 0.5)
      }
    }' "$jsonl"
}

# Prints each event file named on stdin, gunzipping the rotated ones.
_token_spend_events() {
  local f
  while IFS= read -r f; do
    if [[ "$f" == *.gz ]]; then gzip -dc "$f" 2>/dev/null || true; else cat "$f"; fi
  done
}

# _token_spend_bin — the board binary when it has token-spend (t-0829), else nothing: an older one would take the word for a port.
_token_spend_bin() {
  local board; board="$(board_bin)"
  case "$("$board" --help 2>/dev/null || true)" in *token-spend*) printf '%s\n' "$board" ;; esac
}

# cmd_token_spend [--last N] [--ticket <id> [--record]] — t-63a7, t-0829: where a closed sprint's tokens went, by phase and by gate run.
# The board binary computes it (internal/board/tokenspend.go) from the events, plan.md and the harnesses' own session records, read-only;
# --record (sprint complete's call) writes the sprint.cost and gate.cost events and prints the `cost:` line. This only hands it the
# project root and the checkout's worktrees (a turn belongs to the longest of these its cwd starts with). An older board binary has no
# token-spend: one line says so, and the close goes on.
cmd_token_spend() {
  local bin root p a
  for a in "$@"; do
    [[ "$a" == -h || "$a" == --help ]] && { echo "Usage: sprint token-spend [--last N] [--ticket <id> [--record]]"; return 0; }
  done
  bin="$(_token_spend_bin)"
  if [[ -z "$bin" ]]; then
    echo "token-spend: the installed board binary predates it, so no token cost is shown or recorded: run 'canon update'."
    return 0
  fi
  root="$(cd "$(project_root)" && pwd -P)"   # physical, as the events record it (canon_event)
  local -a wt=()
  while IFS= read -r p; do [[ -n "$p" && "$p" != "$root" ]] && wt+=(--worktree "$p"); done \
    < <(git -C "$root" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  "$bin" token-spend --project "$root" ${wt[@]+"${wt[@]}"} "$@"
}

# _close_hint <id> <root> <tier> — t-bc1e: one advisory line saying why a close was slow, read from the activity log ($CANON_HOME/events, the
# newest 7 day files): from this ticket's last close.started to its sprint.completed. It prints only when the close passed its tier's
# target (high-risk 60 min, every other tier 30; CANON_CLOSE_TARGET_HIGH / _NORMAL), a stamp ran more than once, or a gate was rejected:
#   close: [<N> min (<tier> target <T>): ]<name> stamped <n>x[ (<f> failed)], <role> refused <n>x (<reason>), <role> <n> run(s)
# Gate events must name this project; evidence.stamped may come from a scratch clone (its project is the clone), so it is matched by
# ticket alone. A malformed line is skipped; no log or no close.started prints nothing; it never fails the close. (The gates' token
# ratio was the first idea and was dropped: 2-10x on nearly every close, 1.4x on the 3 h t-eeb5 one.)
_close_hint() {
  local id="$1" root tier="${3:-}" evdir f hi lo target
  root="$(cd "$2" 2>/dev/null && pwd -P)" || return 0   # events carry the physical path (canon_event's pwd -P); a symlinked checkout must match it
  evdir="${CANON_HOME:-${HOME:-}/.canon}/events"
  [[ -d "$evdir" ]] || return 0   # an unreadable folder globs to nothing
  local -a evfiles=()
  for f in "$evdir"/*.jsonl "$evdir"/*.jsonl.gz; do [[ -f "$f" && -r "$f" ]] && evfiles+=("$f"); done
  [[ ${#evfiles[@]} -gt 0 ]] || return 0
  hi="${CANON_CLOSE_TARGET_HIGH:-60}"; lo="${CANON_CLOSE_TARGET_NORMAL:-30}"
  [[ "$hi" =~ ^[1-9][0-9]{0,4}$ ]] || hi=60; [[ "$lo" =~ ^[1-9][0-9]{0,4}$ ]] || lo=30
  if [[ "$tier" == high-risk ]]; then target="$hi"; else target="$lo"; fi
  printf '%s\n' "${evfiles[@]}" | sort | tail -n 7 | _token_spend_events | CH_ROOT="$root" LC_ALL=C awk -v id="$id" -v tier="${tier:-normal}" -v target="$target" "$canon_awk_pkey"'
    function field(name,   m) { if (!match($0, "\"" name "\":\"[^\"]*\"")) return ""; m = substr($0, RSTART, RLENGTH); sub(/^[^:]*:"/, "", m); sub(/"$/, "", m); return m }
    function days(y, m, d) { if (m <= 2) { y--; m += 12 }; return 365 * y + int(y / 4) - int(y / 100) + int(y / 400) + int((153 * (m - 3) + 2) / 5) + d }
    function secs(ts) { if (ts !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}/) return -1
      return days(substr(ts, 1, 4) + 0, substr(ts, 6, 2) + 0, substr(ts, 9, 2) + 0) * 86400 + substr(ts, 12, 2) * 3600 + substr(ts, 15, 2) * 60 + substr(ts, 18, 2) }
    function clean(v) { gsub(/[^A-Za-z0-9._-]/, "?", v); return v }
    BEGIN { root = pkey(ENVIRON["CH_ROOT"]) }
    index($0, "\"ticket\":\"" id "\"") == 0 { next }   # a malformed line has no kind or ts: skipped below
    {
      k = field("kind"); t = secs(field("ts")); if (k == "" || t < 0) next
      mine = (pkey(field("project")) == root)
      if (k == "close.started" && mine) { start = t; split("", SN); split("", SF); split("", RJ); split("", GR); nn = nr = ng = 0; end = -1; next }
      if (start == "") next
      if (k == "evidence.stamped") { n = clean(field("name")); if (n == "") next; if (!(n in SN)) ON[++nn] = n; SN[n]++; if (field("exit") != "0") SF[n]++ }
      else if (!mine) next
      else if (k == "gate.rejected") { r = clean(field("role")) " refused" SUBSEP clean(field("reason")); if (!(r in RJ)) OR[++nr] = r; RJ[r]++ }
      else if (k == "gate.started") { g = clean(field("role")); if (g == "" || g == "speccheck") next; if (!(g in GR)) OG[++ng] = g; GR[g]++ }
      else if (k == "sprint.completed") end = t
    }
    END {
      if (start == "" || end < start) exit
      min = int((end - start) / 60); out = ""; show = 0
      if (min > target) { out = min " min (" tier " target " target "): "; show = 1 }
      sep = ""
      for (i = 1; i <= nn; i++) { n = ON[i]; if (SN[n] < 2) continue; show = 1; out = out sep n " stamped " SN[n] "x" (SF[n] ? " (" SF[n] " failed)" : ""); sep = ", " }
      for (i = 1; i <= nr; i++) { split(OR[i], P, SUBSEP); show = 1; out = out sep P[1] " " RJ[OR[i]] "x (" P[2] ")"; sep = ", " }
      if (!show) exit
      for (i = 1; i <= ng; i++) { g = OG[i]; out = out sep g " " GR[g] " run" (GR[g] > 1 ? "s" : ""); sep = ", " }
      sub(/: $/, "", out); print "close: " out
    }' 2>/dev/null || true
  return 0
}


# ---------------------------------------------------------------------------------------------------------------------------------------
# sprint decisions (t-79bf): DECISIONS.md is read by what applies, never whole, and pruned on write by commands, not hand edits.
#   related <path|t-xxxx>... [--limit N | --all]   the table rows that name any of them (read-only)
#   archive <row-id> --by <t-xxxx>                  move one whole row, byte for byte, to DECISIONS-archive.md
#   mark <row-id> <YYYY-MM-DD> "<fragment>"         append `superseded-by: <date> (<fragment>)` to one row's Reason cell, in place
# A row is a table line `| YYYY-MM-DD | ... |`; its id is an 8-hex hash of the line (a line number moves when a row is added on top).
# Section entries (`## date`) are not rows: they are left alone. awk runs under LC_ALL=C so a byte is a character and an odd byte cannot abort it.
_DEC_LIB='
function hid(s,   i, h) { h = 5381; for (i = 1; i <= length(s); i++) h = (h * 33 + ORD[substr(s, i, 1)]) % 2147483648; return sprintf("%08x", h) }
function isrow(l) { return l ~ /^\| [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] \|/ }
BEGIN { for (i = 1; i < 256; i++) ORD[sprintf("%c", i)] = i }'

_dec_files() { DEC_FILE="$(project_root)/DECISIONS.md"; DEC_ARCHIVE="$(project_root)/DECISIONS-archive.md"; }

# _dec_related <limit|all> <token>... : the related lines (id, date, the rule's first 160 characters); tokens are matched as written, and a path
# also by its basename when that has 3 or more characters. Prints nothing when none match. Returns 0 whatever it finds.
_dec_related() {
  local limit="$1"; shift
  _dec_files
  [[ -f "$DEC_FILE" && -r "$DEC_FILE" ]] || return 0
  local toks=() t b
  for t in "$@"; do
    [[ -n "$t" && ${#t} -ge 3 ]] || continue
    toks+=("$t")
    if [[ "$t" == */* ]]; then b="${t##*/}"; [[ ${#b} -ge 3 && "$b" == *.* && "$b" != "$t" ]] && toks+=("$b"); fi
  done
  [[ ${#toks[@]} -gt 0 ]] || return 0
  # the tokens go through the environment: awk -v would eat a backslash and cannot hold a newline
  DEC_TOKS="$(printf '%s\n' "${toks[@]}")" LC_ALL=C awk -v limit="$limit" "$_DEC_LIB"'
    BEGIN { n = split(ENVIRON["DEC_TOKS"], T, "\n") }
    isrow($0) {
      hit = 0
      for (k = 1; k <= n; k++) if (T[k] != "" && index($0, T[k])) { hit = 1; break }
      if (!hit) next
      total++
      if (limit != "all" && total > limit + 0) next
      d = substr($0, 3, 10); r = substr($0, 16, 400); gsub(/[\001-\037\177]/, " ", r); gsub(/\*\*/, "", r); gsub(/ +/, " ", r)
      r = substr(r, 1, 160)
      printf "%s  %s  %s%s\n", hid($0), d, r, (index($0, "superseded-by:") ? "  [fragment superseded]" : "")
    }
    END { if (limit != "all" && total > limit + 0) printf "... and %d more rows name them: sprint decisions related <the same> --all\n", total - limit }
  ' "$DEC_FILE" 2>/dev/null || true
  return 0
}

cmd_decisions() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    related)
      local limit=12 args=() a
      while [[ $# -gt 0 ]]; do
        a="$1"; shift
        case "$a" in
          --all) limit=all ;;
          --limit) limit="${1:-}"; shift || true; [[ "$limit" =~ ^[0-9]+$ && "$limit" -ge 1 ]] || { echo "sprint decisions related: --limit needs a number" >&2; exit 2; } ;;
          -*) echo "sprint decisions related: unknown option $a" >&2; exit 2 ;;
          *) args+=("$a") ;;
        esac
      done
      [[ ${#args[@]} -gt 0 ]] || { echo "usage: sprint decisions related <path|t-xxxx>... [--limit N | --all]" >&2; exit 2; }
      _dec_files
      [[ -f "$DEC_FILE" ]] || { echo "No DECISIONS.md in this project."; return 0; }
      local out; out="$(_dec_related "$limit" "${args[@]}")"
      if [[ -n "$out" ]]; then printf '%s\n' "$out"; else echo "No DECISIONS.md row names ${args[*]}."; fi
      ;;
    archive|mark) _dec_rewrite "$sub" "$@" ;;
    *) echo "usage: sprint decisions related <path|t-xxxx>... [--limit N | --all] | archive <row-id> --by <t-xxxx> | mark <row-id> <YYYY-MM-DD> \"<fragment>\"" >&2; exit 2 ;;
  esac
}

# _dec_rewrite archive|mark ...: the two commands that change DECISIONS.md. Every refusal happens before anything is written; the new files are built
# beside the old ones, their line counts are checked, and only then renamed, the archive first (a failure after that leaves a duplicate, never a loss).
_dec_rewrite() {
  local mode="$1"; shift
  local id="${1:-}" by="" date="" frag=""
  shift || true
  [[ "$id" =~ ^[0-9a-f]{8}$ ]] || { echo "sprint decisions $mode: the first argument is an 8-hex row id (from: sprint decisions related <path>)" >&2; exit 2; }
  if [[ "$mode" == archive ]]; then
    [[ "${1:-}" == --by && "${2:-}" =~ ^t-[a-z0-9]{4}$ ]] || { echo "sprint decisions archive: say which ticket's decision supersedes it: --by <t-xxxx>" >&2; exit 2; }
    by="$2"
  else
    date="${1:-}"; frag="${2:-}"
    [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "sprint decisions mark: the second argument is the retiring decision's date, YYYY-MM-DD" >&2; exit 2; }
    [[ -n "$frag" && "$frag" != *"|"* && "$frag" != *$'\n'* && "$frag" != *$'\r'* ]] || { echo "sprint decisions mark: name the retired fragment in one line without a |" >&2; exit 2; }
  fi
  _dec_files
  [[ -f "$DEC_FILE" && -r "$DEC_FILE" && ! -L "$DEC_FILE" ]] || { echo "sprint decisions $mode: no readable DECISIONS.md here (a symbolic link is refused)" >&2; exit 2; }
  [[ -z "$(tail -c1 "$DEC_FILE")" ]] || { echo "sprint decisions $mode: DECISIONS.md does not end with a newline; add one first, nothing was changed" >&2; exit 2; }
  [[ ! -e "$DEC_ARCHIVE" || ( -f "$DEC_ARCHIVE" && ! -L "$DEC_ARCHIVE" ) ]] || { echo "sprint decisions $mode: DECISIONS-archive.md is not a regular file; refused" >&2; exit 2; }
  local hits row
  hits="$(LC_ALL=C awk -v id="$id" "$_DEC_LIB"' isrow($0) && hid($0) == id { n++; ln = NR } END { print n + 0, ln + 0 }' "$DEC_FILE")"
  case "${hits%% *}" in
    0) echo "sprint decisions $mode: no DECISIONS.md row has the id $id" >&2; exit 2 ;;
    1) ;;
    *) echo "sprint decisions $mode: the id $id matches ${hits%% *} rows; nothing was changed" >&2; exit 2 ;;
  esac
  local ln="${hits##* }" dir tmpd tmpa="" before after
  dir="$(dirname "$DEC_FILE")"
  before="$(wc -l < "$DEC_FILE" | tr -d ' ')"
  row="$(LC_ALL=C awk -v ln="$ln" 'NR == ln { print; exit }' "$DEC_FILE")"
  if [[ "$mode" == mark ]]; then
    [[ "$row" != *"superseded-by: $date ($frag)"* ]] || { echo "sprint decisions mark: that row already carries superseded-by: $date ($frag)" >&2; exit 2; }
    tmpd="$(mktemp "$dir/.decisions.XXXXXX")"; cp -p "$DEC_FILE" "$tmpd"   # the copy keeps the file's mode; the awk below rewrites its content
    DEC_ADD="superseded-by: $date ($frag)" LC_ALL=C awk -v ln="$ln" '
      NR == ln { cr = ($0 ~ /\r$/) ? "\r" : ""; l = $0; sub(/\r$/, "", l); sub(/[ \t]*\|[ \t]*$/, "", l); printf "%s %s |%s\n", l, ENVIRON["DEC_ADD"], cr; next }
      { print }' "$DEC_FILE" > "$tmpd"
    after="$(wc -l < "$tmpd" | tr -d ' ')"
    [[ "$after" == "$before" ]] || { rm -f "$tmpd"; echo "sprint decisions mark: refusing, the rewrite changed the line count ($before -> $after); nothing was changed" >&2; exit 1; }
    mv -f "$tmpd" "$DEC_FILE" || { rm -f "$tmpd"; echo "sprint decisions mark: could not replace DECISIONS.md; nothing was changed" >&2; exit 1; }
    echo "marked $id: superseded-by: $date ($frag)"
    return 0
  fi
  # archive: the whole row, byte for byte, to the end of the archive's table
  tmpd="$(mktemp "$dir/.decisions.XXXXXX")"; cp -p "$DEC_FILE" "$tmpd"; tmpa="$(mktemp "$dir/.decisions-archive.XXXXXX")"
  if [[ -f "$DEC_ARCHIVE" ]]; then cp -p "$DEC_ARCHIVE" "$tmpa"; [[ ! -s "$tmpa" || -z "$(tail -c1 "$tmpa")" ]] || printf '\n' >> "$tmpa"
  else chmod 644 "$tmpa"; printf '# Decisions — Archive\n\nRows moved out of `DECISIONS.md` by `sprint decisions archive`, byte for byte.\n\n| Date | Decision | Reason |\n|---|---|---|\n' > "$tmpa"; fi
  local abefore; abefore="$(wc -l < "$tmpa" | tr -d ' ')"
  printf '%s\n' "$row" >> "$tmpa"
  LC_ALL=C awk -v ln="$ln" 'NR != ln { print }' "$DEC_FILE" > "$tmpd"
  after="$(wc -l < "$tmpd" | tr -d ' ')"
  [[ "$after" == $((before - 1)) && "$(wc -l < "$tmpa" | tr -d ' ')" == $((abefore + 1)) ]] || { rm -f "$tmpd" "$tmpa"; echo "sprint decisions archive: refusing, the line counts do not add up; nothing was changed" >&2; exit 1; }
  mv -f "$tmpa" "$DEC_ARCHIVE" || { rm -f "$tmpd" "$tmpa"; echo "sprint decisions archive: could not write DECISIONS-archive.md; nothing was changed" >&2; exit 1; }
  mv -f "$tmpd" "$DEC_FILE" || { rm -f "$tmpd"; echo "sprint decisions archive: the row is in DECISIONS-archive.md but could not be removed from DECISIONS.md; remove it by hand" >&2; exit 1; }
  local shown; shown="$(printf '%s' "${row:15:100}" | LC_ALL=C tr '\001-\037\177' ' ' | LC_ALL=C sed 's/\*\*//g')"
  echo "archived $id (by $by): $shown"
}

# _decisions_row_length_line <ticket id> — t-79bf: after a close, one line for a row whose rule starts with the closing ticket's id and is over 600
# characters (a row is the rule, its falsifier and the ticket id, about 400; the reasoning lives in the ticket's plan.md and research.md). Read-only,
# prints nothing otherwise, and cannot change the exit status of a close that is already done.
_decisions_row_length_line() {
  local id="$1"
  _dec_files
  [[ -f "$DEC_FILE" && -r "$DEC_FILE" ]] || return 0
  LC_ALL=C awk -v id="$id" "$_DEC_LIB"'
    isrow($0) && index($0, "`" id "`") && index($0, "`" id "`") < 30 && length($0) > 600 {
      if (++n <= 3) printf "DECISIONS.md: the row for %s is %d characters; keep a row to its rule, its falsifier and the ticket id (about 400), and the reasoning in plan.md\n", id, length($0)
    }' "$DEC_FILE" 2>/dev/null || true
  return 0
}

# _decisions_start_lines <ticket.md> <own id> — t-79bf: the rows that name the files and tickets this ticket names, at most 8, so a start reads what
# applies instead of a 700 KB file. Nothing when none match; read-only.
_decisions_start_lines() {
  local tmd="$1" own="$2" toks out
  [[ -f "$tmd" && -r "$tmd" ]] || return 0
  toks="$(LC_ALL=C tr -c 'A-Za-z0-9_./-' '\n' < "$tmd" 2>/dev/null | LC_ALL=C sed -e 's/[.]*$//' | LC_ALL=C awk -v own="$own" '
    /^(plan|ticket|acceptance|research|summary|DECISIONS|HANDOFF|LEARNINGS|CHANGELOG|README|AGENTS|CLAUDE|SKILL)\.md$/ { next }   # named by nearly every row: they would fill the cap
    /^t-[a-z0-9][a-z0-9][a-z0-9][a-z0-9]$/ { if ($0 != own && !seen[$0]++ && ++n <= 12) print; next }
    /\.(sh|go|js|css|html|md|json|py|tsv|yml)$/ && length($0) >= 6 && !seen[$0]++ && ++n <= 12 { print; next }
    /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.\/-]+$/ && length($0) >= 6 && !seen[$0]++ && ++n <= 12 { print }   # a path with no known extension: tools/sprint
  ' 2>/dev/null)" || toks=""
  [[ -n "$toks" ]] || return 0
  local arr=() line; while IFS= read -r line; do [[ -n "$line" ]] && arr+=("$line"); done <<<"$toks"
  [[ ${#arr[@]} -gt 0 ]] || return 0
  out="$(_dec_related 8 "${arr[@]}")"
  [[ -n "$out" ]] || return 0
  printf 'Related decisions (read these, not the whole DECISIONS.md; more: sprint decisions related <path> --all):\n%s\n' "$out"
  return 0
}

