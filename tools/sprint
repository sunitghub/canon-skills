The CLI owns deterministic workflow state. The agent still owns orientation,
gray-area resolution, impact analysis, implementation, review, and test judgment.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  # t-96f1: the close's .sh tools skip the project check: each script resolves its own folder, so the output stays the script's.
  case "$cmd" in help|--help|-h|gate-snapshot|evidence|subagent-log|pre-gate-check|base-ref) ;; *) require_project_folder sprint ;; esac   # t-b2ff

  case "$cmd" in
    start) cmd_start "$@" ;;
    import-issue) cmd_import_issue "$@" ;;
    continue) cmd_continue "$@" ;;
    current) cmd_current ;;
    status) cmd_status "$@" ;;
    approve) cmd_approve "$@" ;;
    recent) cmd_recent "$@" ;;
    complete) cmd_complete "$@" ;;
    suggest-tier) cmd_suggest_tier "$@" ;;
    eval-verdict) cmd_eval_verdict "$@" ;;
    gate-model) cmd_gate_model "$@" ;;
    second-eval) cmd_second_eval "$@" ;;
    eval-compare) cmd_eval_compare "$@" ;;
    relay-report) cmd_relay_report "$@" ;;
    check-review-notes) cmd_check_review_notes "$@" ;;
    check-evidence) cmd_check_evidence "$@" ;;
    close-hint)
      [[ "${1:-}" =~ ^t-[a-z0-9]{4}$ ]] || { echo "usage: sprint close-hint <ticket-id>" >&2; exit 2; }
      _close_hint "$1" "$(project_root)" "$(_signoff_tier "$(ticket_dir_for "$1")/plan.md" 2>/dev/null)" ;;
    manual-qa) cmd_manual_qa "$@" ;;
    gate-cost) cmd_gate_cost "$@" ;;
    token-spend) cmd_token_spend "$@" ;;
    decisions) cmd_decisions "$@" ;;
    # t-96f1: run through sprint so PowerShell reaches them via sprint.cmd (it opens a bare .sh by file association)
    gate-snapshot|evidence|subagent-log|pre-gate-check) exec bash "$SCRIPT_DIR/$cmd.sh" "$@" ;;
    base-ref) gate_base "$(worktree_root 2>/dev/null || pwd)" ;;   # t-99d2: the gates' diff base (merge-base with origin/<default branch>)
    help|--help|-h) cmd_help ;;
    *) echo "Unknown command: $cmd" >&2; cmd_help; exit 1 ;;
  esac
}

main "$@"
