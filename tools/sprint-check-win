#!/usr/bin/env bash
# sprint-check-win — run the Go sprint-check server from the source tree

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v go >/dev/null 2>&1; then
  echo "Error: Go is required to run sprint-check-win from source." >&2
  exit 1
fi

[[ -d "$ROOT/tools/canon-go/cmd" ]] || { echo "Error: this install does not carry the Go source (the end-user zip leaves it out); clone the repository to run sprint-check-win from source." >&2; exit 1; }
cd "$ROOT/tools/canon-go"   # the module; the board still roots at the checkout, as when it ran from $ROOT (t-8020)
SPRINT_CHECK_ROOT="${SPRINT_CHECK_ROOT:-$ROOT}" exec go run ./cmd/sprint-check "$@"
