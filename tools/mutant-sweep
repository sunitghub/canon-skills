#!/usr/bin/env bash
# mutant-sweep launcher (t-a5f6): finds a working Python 3 and runs mutant-sweep.py with it. A machine without one (no python3,
# only Windows' Store alias that prints an install prompt, a Python 2, or a probe that hangs) gets a clean skip, exit 3, instead of
# a shebang error, so mutation-test is recorded `skipped | no python3` and the close goes on. `--check` runs only the probe.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

probe() {   # probe <interpreter>: 0 when it runs Python 3 within 5 s (stdin closed; a probe still running is killed by its PID)
  local pid n=0
  "$1" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' </dev/null >/dev/null 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if (( ++n > 50 )); then kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 1; fi
    sleep 0.1
  done
  wait "$pid"
}

PY=""
for cand in python3 python; do
  if probe "$cand"; then PY="$cand"; break; fi
done
if [[ -z "$PY" ]]; then
  echo "mutant-sweep: skipped — no working python3 (record: mutation-test | skipped | no python3)" >&2
  exit 3
fi
if [[ "${1:-}" == "--check" ]]; then exit 0; fi
exec "$PY" "$DIR/mutant-sweep.py" "$@"
