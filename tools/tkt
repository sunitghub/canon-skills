#!/usr/bin/env bash
# tkt — minimal ticket system bundled with canon
# Tickets are stored in .tickets/<id>/ticket.md. Legacy .tickets/<id>.md
# files remain readable.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/ticket-root.sh"
source "$SCRIPT_DIR/frontmatter-lib.sh"

VERSION="1.0.0"

# cap_with_more <max> <item...>
# Sets _cap_result (array, truncated to <max>) and _cap_more (count truncated
# away, 0 if none) — a bash-3.2-compatible way to return two values (no
# namerefs; those are bash 4.3+ only, and this codebase must support macOS's
# system bash 3.2). Assumes <item...> is already in the desired display order
# (e.g. most-recent-first) — this only truncates, never re-sorts.
cap_with_more() {
  local max="$1"; shift
  local total=$#
  if (( total > max )); then
    _cap_result=("${@:1:$max}")
    _cap_more=$(( total - max ))
  else
    _cap_result=("$@")
    _cap_more=0
  fi
}

active_file() {
  local dir
  dir="$(ensure_tickets_dir)"
  echo "$dir/ACTIVE"
}

ensure_tickets_dir() {
  local dir
  dir="$(tickets_dir)"
  mkdir -p "$dir"
  # t-2f53: seed a .tickets/.gitignore (if absent) so canon's own per-machine
  # runtime files never get tracked in projects that DO track .tickets/. In
  # canon's own repo .tickets/ is gitignored wholesale, so this is a harmless
  # no-op here. Non-destructive: git ignore never untracks already-committed
  # files (those need a one-time `git rm --cached` — see docs/setup.md). Never
  # clobber a user's existing .tickets/.gitignore.
  if [[ ! -e "$dir/.gitignore" ]]; then
    cat > "$dir/.gitignore" <<'EOF'
# canon runtime files — per-machine session state, never commit (t-2f53)
.cockpit-*
ACTIVE
EOF
  fi
  echo "$dir"
}

gen_id() {
  local suffix
  suffix="$(od -An -N2 -tx1 /dev/urandom | tr -d '[:space:]')"
  echo "t-$suffix"
}

ticket_files() {
  local dir="$1"
  {
    find "$dir" -mindepth 2 -maxdepth 2 -name "ticket.md" -type f 2>/dev/null
    find "$dir" -maxdepth 1 -name "*.md" -type f 2>/dev/null \
      ! -name "*-blueprint.md" \
      ! -name "*-acceptance.md" \
      ! -name "*-plan.md" \
      ! -name "*-decisions.md" \
      ! -name "*-qa.md" \
      ! -name "*-notes.md"
  } | sort
}

# Find ticket file by partial or full ID match
find_ticket() {
  local query="$1"
  local dir
  dir="$(tickets_dir)"
  [[ ! -d "$dir" ]] && { echo "Error: no .tickets directory found" >&2; exit 1; }

  local matches=()
  while IFS= read -r file; do
    local file_id
    file_id="$(get_field "$file" id)"
    [[ "$file_id" == *"$query"* ]] && matches+=("$file")
  done < <(ticket_files "$dir")

  case ${#matches[@]} in
    0) echo "Error: no ticket matching '$query'" >&2; exit 1 ;;
    1) echo "${matches[0]}" ;;
    *) echo "Error: ambiguous ID '$query' — ${#matches[@]} matches" >&2; exit 1 ;;
  esac
}

get_title() {
  local title
  title="$(awk '/^---$/{fm++} fm==2 && /^# /{sub(/^# /,""); print; exit}' "$1")"
  if [[ -n "$title" ]]; then
    echo "$title"
  else
    title="$(get_field "$1" title)"
    if [[ -n "$title" ]]; then
      echo "$title"
    elif [[ "$(basename "$1")" == "ticket.md" ]]; then
      basename "$(dirname "$1")"
    else
      basename "$1" .md
    fi
  fi
}

set_active() {
  local id="$1" file
  file="$(active_file)"
  printf "%s\n" "$id" > "$file"
}

clear_active_if() {
  local id="$1" file current
  file="$(active_file)"
  [[ -f "$file" ]] || return 0
  current="$(tr -d '[:space:]' < "$file")"
  # t-01a4: a bare `[[ cond ]] && cmd` as the LAST statement in a function
  # returns 1 (the [[ ]] test's own exit status) whenever cond is false —
  # under set -e that silently aborts the whole calling script. Latent since
  # this file's introduction: only ever manifested once two tickets could be
  # in_progress at once (ACTIVE names one, this call closes the other) —
  # never reproducible before this ticket made that state possible.
  if [[ "$current" == "$id" ]]; then
    rm -f "$file"
  fi
  return 0
}

# _normalize_path <path> — symlink-resolved absolute form, matching the
# daemon's Go EvalSymlinks intent, so a bash-written binding compares equal
# to one the daemon wrote. Falls back to the raw value if the path is gone.
_normalize_path() {
  (cd "$1" 2>/dev/null && pwd -P) || echo "$1"
}

# _ticket_cwd_binding <ticket-file> — the worktree a ticket is bound to
# (t-01a4): reads its sibling .cockpit-cwd (daemon or cmd_start-written),
# defaulting to the main checkout when absent — a ticket never explicitly
# bound to a worktree is implicitly bound to the shared main checkout, same
# as the daemon's own resolveSpawnCwd default. A legacy flat <id>.md file (no
# per-ticket directory) has nowhere to keep a binding — treat as main
# checkout too, never as a shared binding across every flat ticket.
_ticket_cwd_binding() {
  local file="$1" tdir cwd
  if [[ "$(basename "$file")" == "ticket.md" ]]; then
    tdir="$(dirname "$file")"
    if [[ -f "$tdir/.cockpit-cwd" ]]; then
      cwd="$(tr -d '[:space:]' < "$tdir/.cockpit-cwd")"
      [[ -n "$cwd" ]] && { _normalize_path "$cwd"; return; }
    fi
  fi
  _normalize_path "$(project_root)"
}

# current_id (t-01a4): resolves the ticket in_progress in the CALLER's own
# worktree, not repo-wide — multiple tickets may legitimately be in_progress
# at once, one per worktree, each independently resolvable from its own cwd.
current_id() {
  local dir file id matches=() my_wt
  dir="$(tickets_dir)"
  my_wt="$(worktree_root)"

  # No ACTIVE fast path (t-01a4, removed after a real bug found in testing):
  # trusting ACTIVE as an early-return let a genuine same-worktree double
  # in_progress anomaly go undetected — ACTIVE named the first ticket, its
  # binding matched, and current_id() returned immediately without ever
  # reaching the full scan that would have caught the second one. The scan
  # below is cheap regardless of ticket count; always run it. ACTIVE is still
  # written by tkt start/close for informational/back-compat purposes only.

  [[ -d "$dir" ]] || return 1
  while IFS= read -r file; do
    [[ "$(get_field "$file" status)" == "in_progress" ]] || continue
    [[ "$(_ticket_cwd_binding "$file")" == "$my_wt" ]] || continue
    matches+=("$(get_field "$file" id)")
  done < <(ticket_files "$dir")

  case ${#matches[@]} in
    1) echo "${matches[0]}" ;;
    0) return 1 ;;
    # A genuine anomaly, not a normal multi-worktree state: this worktree's
    # OWN gate should never let two tickets bind to it at once.
    *) echo "Error: multiple in-progress tickets bound to this worktree; run 'tkt start <id>' to set ACTIVE" >&2; return 2 ;;
  esac
}

# t-b0c9: the body a new ticket starts with when no description is given. The same text lives in the board's
# TYPE_TEMPLATES (static/board-core.js), server.py and sprint-check-go (they run where this script cannot be called);
# tests/ticket-skeleton.sh keeps the four identical. The hints are HTML comments, which the board does not render.
ticket_skeleton() {
  if [[ "$1" == bug ]]; then
    printf '%s\n' "## Problem" "<!-- What is broken, and for whom? -->" "" "## Expected" "<!-- What should happen. -->" "" \
      "## Actual" "<!-- What happens instead, and the steps to see it. -->" ""
  else
    printf '%s\n' "## Problem" "<!-- What is wrong or missing, and for whom? -->" ""
  fi
  printf '%s\n' "## Outcome" "<!-- What is true when this is done? -->" "" "## Constraints" "<!-- Limits the solution must respect. -->" "" \
    "## Open questions" "<!-- Anything to decide before planning. The plan answers or carries forward each one. -->"
}

cmd_create() {
  local title="" type="task" priority="2" description="" skills="" described=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--type)        type="$2";        shift 2 ;;
      -p|--priority)    priority="$2";    shift 2 ;;
      -d|--description) description="$2"; described=1; shift 2 ;;
      -s|--skills)      skills="$2";      shift 2 ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$title" ]] && title="$1"; shift ;;
    esac
  done

  [[ -z "$title" ]] && { echo "Error: title required" >&2; exit 1; }

  # t-354b: maintenance skills (csv) — allowlisted to the three repo-hygiene
  # skills, order-preserving dedupe (parity with server.py/sprint-check-go).
  local skills_line="" picked=() _s _parts=()
  if [[ -n "$skills" ]]; then
    IFS=',' read -ra _parts <<< "$skills"   # split on comma; IFS restored after
    for _s in ${_parts[@]+"${_parts[@]}"}; do
      _s="$(printf '%s' "$_s" | tr -d '[:space:]')"
      case "$_s" in
        context-check|context-doctor|dead-code-cleanup)
          [[ " ${picked[*]-} " == *" $_s "* ]] || picked+=("$_s") ;;
      esac
    done
    if [[ ${#picked[@]} -gt 0 ]]; then
      local _joined; printf -v _joined '%s,' "${picked[@]}"; _joined="${_joined%,}"
      skills_line="skills: $_joined"
    fi
  fi

  local dir id ticket_dir file created
  dir="$(ensure_tickets_dir)"

  while true; do
    id="$(gen_id)"
    ticket_dir="$dir/$id"
    file="$ticket_dir/ticket.md"
    [[ ! -e "$ticket_dir" && ! -f "$dir/$id.md" ]] && break
  done

  mkdir -p "$ticket_dir"
  created="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  {
    printf -- "---\n"
    printf "id: %s\n" "$id"
    printf "status: open\n"
    printf "created: %s\n" "$created"
    printf "type: %s\n" "$type"
    printf "priority: %s\n" "$priority"
    [[ -n "$skills_line" ]] && printf "%s\n" "$skills_line"
    printf "eval_override: false\n"
    printf "eval_fail_count: 0\n"
    printf -- "---\n"
    printf "# %s\n" "$title"
    # -d is kept exactly as given (even empty); without it the ticket starts from the skeleton (t-b0c9)
    [[ -z "$described" ]] && description="$(ticket_skeleton "$type")"
    [[ -n "$description" ]] && printf "\n%s\n" "$description"
  } > "$file"

  echo "$id"
}

cmd_set_status() {
  local id="${1:-}" new_status="$2"
  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }
  local file
  file="$(find_ticket "$id")"
  set_field "$file" status "$new_status"
  id="$(get_field "$file" id)"
  # CLI close marker (t-dec8): the pre-commit hook distinguishes a legitimate CLI close
  # from a hand-edited `status: closed` by a co-added `closed:` line in the same ticket.md
  # diff. Write it when closing, clear it on every other transition so a reopened/started
  # ticket carries no stale marker (and a later hand-edit close is still caught).
  if [[ "$new_status" == "closed" ]]; then
    set_or_add_field "$file" closed "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  else
    remove_field "$file" closed
  fi
  if [[ "$new_status" == "in_progress" ]]; then
    set_active "$id"
    # t-01a4 (fixed after a real gap found in review): record which worktree
    # this ticket is bound to, same path/format the cockpit daemon uses. Live
    # here, not just in sprint's cmd_start, so bare `tkt start` (no sprint,
    # no daemon) also binds correctly — sprint's own cmd_start calls this via
    # `tkt start`, so it needs no separate write of its own. Never overwrite
    # an existing binding; skip for a legacy flat <id>.md ticket (no per-id
    # dir to hold a binding, same guard as _ticket_cwd_binding's read side).
    if [[ "$(basename "$file")" == "ticket.md" ]]; then
      local tdir="$(dirname "$file")"
      [[ -f "$tdir/.cockpit-cwd" ]] || printf '%s\n' "$(worktree_root)" > "$tdir/.cockpit-cwd"
    fi
  else
    clear_active_if "$id"
  fi
  printf "%s: %s\n" "$id" "$new_status"
}

cmd_ci() {
  local id="${1:-}" value="${2:-on}"
  [[ -z "$id" ]] && { echo "Usage: tkt ci <id> [on|off]" >&2; exit 1; }
  case "$value" in
    on|true)   value=true ;;
    off|false) value=false ;;
    *) echo "Error: value must be 'on' or 'off'" >&2; exit 1 ;;
  esac

  local file
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"

  set_or_add_field "$file" ci "$value"

  printf "%s: ci=%s\n" "$id" "$value"
  if [[ "$value" == "true" ]]; then
    local tdir root
    tdir="$(dirname "$file")"
    root="$(project_root)"
    if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$root" add -f "$tdir/"
      if ! git -C "$root" diff --cached --quiet -- "$tdir/"; then
        git -C "$root" commit -q -m "chore: commit $id docs for CI eligibility" -- "$tdir/"
        echo "Committed $id's docs so CI can read them." >&2
      fi
    fi
  fi
}

cmd_gate() {
  local id="${1:-}" value="${2:-}"
  [[ -z "$id" ]] && { echo "Usage: tkt gate <id> [eval|full]" >&2; exit 1; }

  local file
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"

  # No value → print the current mode (absent frontmatter line = full).
  if [[ -z "$value" ]]; then
    local cur
    cur="$(get_field "$file" gate)"
    printf "%s: gate=%s\n" "$id" "${cur:-full}"
    return 0
  fi

  case "$value" in
    eval)
      # eval-only headless gate: sprint-headless-eval instead of the full pipeline.
      set_or_add_field "$file" gate eval
      ;;
    full)
      # full is the default, represented by the ABSENCE of the line (mirrors ci).
      remove_field "$file" gate
      ;;
    *) echo "Error: mode must be 'eval' or 'full'" >&2; exit 1 ;;
  esac

  printf "%s: gate=%s\n" "$id" "$value"
}

cmd_demo() {
  local id="${1:-}" value="${2:-}"
  [[ -z "$id" ]] && { echo "Usage: tkt demo <id> [on|off]" >&2; exit 1; }

  local file
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"

  # No value → print the current state (absent frontmatter line = false).
  if [[ -z "$value" ]]; then
    local cur
    cur="$(get_field "$file" demo)"
    printf "%s: demo=%s\n" "$id" "${cur:-false}"
    return 0
  fi

  case "$value" in
    on|true)   value=true ;;
    off|false) value=false ;;
    *) echo "Error: value must be 'on' or 'off'" >&2; exit 1 ;;
  esac

  if [[ "$value" == "true" ]]; then
    # demo mode: sprint complete runs the reduced close-path (security-review +
    # binding evaluator, forced Haiku) — see skills/sprint/reference/complete.md.
    set_or_add_field "$file" demo true
  else
    # false is the default, represented by the ABSENCE of the line (mirrors ci/gate).
    remove_field "$file" demo
  fi

  printf "%s: demo=%s\n" "$id" "$value"
}

cmd_close() {
  local id="" no_sprint=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-sprint) no_sprint=true; shift ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$id" ]] && id="$1"; shift ;;
    esac
  done

  [[ -z "$id" ]] && { echo "Error: ticket ID required" >&2; exit 1; }

  local file
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"

  if [[ "${TKT_SPRINT_GATE_PASSED:-}" != "1" && "$no_sprint" != true ]]; then
    local tdir
    tdir="$(tickets_dir)/$id"
    if [[ -f "$tdir/acceptance.md" || -f "$tdir/plan.md" ]]; then
      echo "Error: $id has sprint docs in $tdir." >&2
      echo "Close it with 'sprint complete', which validates acceptance criteria and plan sign-off first." >&2
      echo "To force-close without those checks, run: tkt close $id --no-sprint" >&2
      exit 1
    else
      echo "Error: $id has no sprint docs." >&2
      echo "If this needs review, run 'sprint start $id' first." >&2
      echo "If this is a genuine doc-less/backlog ticket, run: tkt close $id --no-sprint" >&2
      exit 1
    fi
  fi

  cmd_set_status "$id" closed
}

# json_str <value> — print <value> as a quoted JSON string (no newline). Pure awk so it runs on Git Bash with no
# jq/Python. The value goes in on stdin, one awk record per line, because `awk -v` would interpret backslash
# escapes and an environment variable is capped near 32 KB on Windows. The trailing "\n" printf adds keeps a value that
# itself ends in a newline intact. LC_ALL=C makes awk walk bytes: UTF-8 passes through untouched and only
# U+0000-U+001F, `"` and `\` are rewritten.
json_str() {
  printf '%s\n' "$1" | LC_ALL=C awk 'BEGIN {
    for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
    esc["\b"] = "\\b"; esc["\t"] = "\\t"; esc["\f"] = "\\f"; esc["\r"] = "\\r"
    out = "\""
  }
  {
    if (NR > 1) out = out "\\n"
    n = length($0); buf = ""
    for (k = 1; k <= n; k++) {
      c = substr($0, k, 1)
      if (c == "\\") buf = buf "\\\\"
      else if (c == "\"") buf = buf "\\\""
      else if (c in esc) buf = buf esc[c]
      else buf = buf c
    }
    out = out buf
  }
  END { printf "%s\"", out }'
}

# json_num <value> [fallback] — a bare JSON number when <value> is digits, else <fallback> (default: a JSON string).
# Number fields pass a fallback (`null`, `0`) so a malformed ticket never turns a number into a string.
json_num() {
  if [[ "$1" =~ ^[0-9]+$ ]]; then printf '%s' "$1"
  elif [[ $# -ge 2 ]]; then printf '%s' "$2"
  else json_str "$1"; fi
}

# ticket_body <file> — the text below the frontmatter, without `# ` heading lines (the title).
ticket_body() { awk '/^---$/{fm++; next} fm>=2 && !/^# /{print}' "$1"; }

cmd_ls() {
  local status_filter="" json=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status=*) status_filter="${1#--status=}"; shift ;;
      --status)   status_filter="$2"; shift 2 ;;
      --json)     json=1; shift ;;
      *)          shift ;;
    esac
  done

  local dir
  dir="$(tickets_dir)"
  [[ ! -d "$dir" ]] && { if [[ $json -eq 1 ]]; then echo "[]"; else echo "No tickets found."; fi; return; }

  local found=0 items=""
  while IFS= read -r file; do
    local id status type priority title
    id="$(get_field "$file" id)"
    status="$(get_field "$file" status)"
    [[ -z "$status_filter" && "$status" == "archived" ]] && continue
    [[ -n "$status_filter" && "$status" != "$status_filter" ]] && continue
    type="$(get_field "$file" type)"
    priority="$(get_field "$file" priority)"
    title="$(get_title "$file")"
    if [[ $json -eq 1 ]]; then
      items+="${items:+,}{\"id\":$(json_str "$id"),\"status\":$(json_str "$status"),\"type\":$(json_str "$type"),\"priority\":$(json_num "$priority" null),\"title\":$(json_str "$title")}"
    else
      printf "%-10s  %-12s  %-8s  p%s  %s\n" "$id" "$status" "$type" "$priority" "$title"
    fi
    (( found++ )) || true
  done < <(ticket_files "$dir")

  if [[ $json -eq 1 ]]; then
    printf '[%s]\n' "$items"
  elif [[ $found -eq 0 ]]; then
    echo "No tickets${status_filter:+ with status '$status_filter'}."
  fi
}

cmd_show() {
  local query="" json=0 a
  for a in "$@"; do
    if [[ "$a" == "--json" ]]; then json=1; elif [[ -z "$query" ]]; then query="$a"; fi
  done
  [[ -z "$query" ]] && { echo "Usage: tkt show <id> [--json]" >&2; exit 1; }
  local file
  file="$(find_ticket "$query")"

  if [[ $json -eq 1 ]]; then
    local body ov dm
    body="$(ticket_body "$file")"
    body="${body#"${body%%[!$'\n']*}"}" # the blank line after the title is layout, not content
    ov="$(get_field "$file" eval_override)"; dm="$(get_field "$file" demo)"
    printf '{"id":%s,"status":%s,"type":%s,"priority":%s,"created":%s,"title":%s,"body":%s,"eval_override":%s,"eval_fail_count":%s,"demo":%s}\n' \
      "$(json_str "$(get_field "$file" id)")" "$(json_str "$(get_field "$file" status)")" "$(json_str "$(get_field "$file" type)")" \
      "$(json_num "$(get_field "$file" priority)" null)" "$(json_str "$(get_field "$file" created)")" "$(json_str "$(get_title "$file")")" \
      "$(json_str "$body")" "$([[ "$ov" == true ]] && echo true || echo false)" "$(json_num "$(get_field "$file" eval_fail_count)" 0)" \
      "$([[ "$dm" == true ]] && echo true || echo false)"
    return
  fi

  printf "ID:       %s\n" "$(get_field "$file" id)"
  printf "Status:   %s\n" "$(get_field "$file" status)"
  printf "Type:     %s\n" "$(get_field "$file" type)"
  printf "Priority: %s\n" "$(get_field "$file" priority)"
  printf "Created:  %s\n" "$(get_field "$file" created)"
  printf "Title:    %s\n" "$(get_title "$file")"

  local body
  body="$(ticket_body "$file")"
  if [[ -n "$body" ]]; then
    printf "\n%s\n" "$body"
  fi
}

cmd_current() {
  local id rc file
  set +e
  id="$(current_id)"
  rc=$?
  set -e
  if [[ "$rc" -eq 1 ]]; then
    echo "No active ticket."
    return 1
  elif [[ "$rc" -ne 0 ]]; then
    return "$rc"
  fi
  file="$(find_ticket "$id")"
  printf "%s  %s  %s\n" "$id" "$(get_field "$file" status)" "$(get_title "$file")"
}

# _why_resolve_target <target> — resolves a bare filename to a tracked path via
# basename fallback when the exact path has no history. Sets _why_resolved_target
# on success (return 0). On an early-exit case (ambiguous candidates, or no
# history at all) prints the user-facing message directly — never via command
# substitution, which would swallow it instead of showing it — and returns 1.
# Same dynamic-scoping idiom as cap_with_more's _cap_result/_cap_more: the
# caller declares the var local first, this function (called directly, not
# via "$(...)") assigns into that same scope.
_why_resolve_target() {
  local target="$1"
  local query_target="$target"
  local log_subjects
  log_subjects="$(git log --follow --format="%s" -- "$query_target" 2>/dev/null)"
  if [[ -z "$log_subjects" ]]; then
    local basename
    basename="$(basename -- "$target")"
    local -a candidates=()
    if [[ -n "$basename" && "$basename" != "." ]]; then
      while IFS= read -r cand; do
        [[ -z "$cand" ]] && continue
        [[ "$(basename -- "$cand")" == "$basename" ]] && candidates+=("$cand")
      done < <(git log --all --name-only --format= 2>/dev/null | sort -u)
    fi
    if [[ ${#candidates[@]} -eq 1 ]]; then
      query_target="${candidates[0]}"
      log_subjects="$(git log --follow --format="%s" -- "$query_target" 2>/dev/null)"
    elif [[ ${#candidates[@]} -gt 1 ]]; then
      # Rank by commit count — most-changed file is most likely the intended target
      local best="" best_count=0
      for cand in "${candidates[@]}"; do
        local n
        n="$(git log --oneline -- "$cand" 2>/dev/null | wc -l | tr -d ' ')"
        if [[ "$n" -gt "$best_count" ]]; then
          best_count="$n"
          best="$cand"
        fi
      done
      query_target="$best"
      log_subjects="$(git log --follow --format="%s" -- "$query_target" 2>/dev/null)"
      # Show resolved path + alternatives
      echo "→ $query_target"
      local alts=()
      for cand in "${candidates[@]}"; do
        [[ "$cand" != "$best" ]] && alts+=("$cand")
      done
      if [[ ${#alts[@]} -gt 0 ]]; then
        local joined
        joined="$(printf '%s, ' "${alts[@]:0:5}")"
        echo "  Also in: ${joined%, }"
      fi
    fi
  fi
  if [[ -z "$log_subjects" ]]; then
    echo "No git history found for: $target"
    return 1
  fi
  _why_resolved_target="$query_target"
}

# _why_match_ids <query_target> <tickets_dir> — extracts ticket IDs from git
# log subjects for the resolved target, falling back to keyword matching
# against ticket titles when no t-xxxx IDs appear. Sets _why_ids (array,
# possibly empty), same dynamic-scoping idiom as above.
_why_match_ids() {
  local query_target="$1" dir="$2"
  local log_subjects
  log_subjects="$(git log --follow --format="%s" -- "$query_target" 2>/dev/null)"

  # ${_why_ids[*]+"${_why_ids[*]}"} guards against bash 3.2's (macOS system
  # bash) "unbound variable" error on an empty array under `set -u`.
  add_unique_id() { [[ " ${_why_ids[*]+"${_why_ids[*]}"} " != *" $1 "* ]] && _why_ids+=("$1") || true; }

  # Primary: extract t-xxxx IDs from commit subjects
  _why_ids=()
  local id
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    add_unique_id "$id"
  done < <(echo "$log_subjects" | tr -cs 'a-zA-Z0-9-' '\n' | grep -E '^t-[a-z0-9]{4}$' || true)

  # Keyword fallback: match commit words against ticket titles
  if [[ ${#_why_ids[@]} -eq 0 && -d "$dir" ]]; then
    local keywords
    keywords="$(echo "$log_subjects" \
      | tr '[:upper:]' '[:lower:]' \
      | grep -oE '[a-z]{5,}' \
      | grep -vxE 'update|change|refact|clean|minor|patch|revert|merge|commit|sprint|feature|implement' \
      | sort -u | head -8)"
    if [[ -n "$keywords" ]]; then
      while IFS= read -r tfile; do
        local title kw
        title="$(get_title "$tfile" | tr '[:upper:]' '[:lower:]')"
        while IFS= read -r kw; do
          [[ -z "$kw" ]] && continue
          if [[ "$title" == *"$kw"* ]]; then
            local match_id
            match_id="$(get_field "$tfile" id)"
            [[ -n "$match_id" ]] && add_unique_id "$match_id"
            break
          fi
        done <<< "$keywords"
      done < <(ticket_files "$dir")
    fi
  fi
}

# _why_print_results <id...> — prints capped, formatted results (most-recent-
# first order preserved; cap_with_more only truncates, never re-sorts).
_why_print_results() {
  local -a ids=("$@")
  local _cap_result=() _cap_more=0
  cap_with_more 10 "${ids[@]+"${ids[@]}"}"

  local id
  for id in "${_cap_result[@]+"${_cap_result[@]}"}"; do
    local tfile
    tfile="$(find_ticket "$id" 2>/dev/null)" || continue
    local status title
    status="$(get_field "$tfile" status)"
    title="$(get_title "$tfile")"
    printf "%-10s  %-14s  %s\n" "$id" "[$status]" "$title"

    # One-line excerpt from ## Decisions in plan.md
    local tdir plan_file decision
    tdir="$(dirname "$tfile")"
    plan_file="$tdir/plan.md"
    if [[ -f "$plan_file" ]]; then
      decision="$(awk '/^## Decisions/{f=1;next} f && /^### /{sub(/^### /,""); print; exit}' "$plan_file")"
      [[ -n "$decision" ]] && printf "  → %s\n" "$decision"
    fi
  done

  (( _cap_more > 0 )) && echo "+$_cap_more more, older" || true
}

cmd_why() {
  local target="${1:-}"
  [[ -z "$target" ]] && { echo "Usage: tkt why <file>" >&2; exit 1; }

  local dir
  dir="$(tickets_dir)"

  local _why_resolved_target=""
  _why_resolve_target "$target" || return 0
  local query_target="$_why_resolved_target"

  local _why_ids=()
  _why_match_ids "$query_target" "$dir"

  if [[ ${#_why_ids[@]} -eq 0 ]]; then
    echo "No tickets found for: $target"
    return 0
  fi

  _why_print_results "${_why_ids[@]}"
}

cmd_learn() {
  local id="" force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$id" ]] && id="$1"; shift ;;
    esac
  done
  [[ -z "$id" ]] && { echo "Usage: tkt learn <id> [--force]" >&2; exit 1; }

  local file tdir title
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"
  tdir="$(dirname "$file")"
  title="$(get_title "$file")"

  local summary="$tdir/summary.md"
  local evalr="$tdir/eval-report.md"
  local out="$tdir/learnings.md"

  # Deviations = plan-vs-actual rows whose status is NOT "delivered".
  # Rows look like: | <item> | delivered|waived|deferred|partial | <notes> |
  # \r in the trim class keeps this correct on a CRLF summary.md (Windows).
  local deviations="" dev_items=""
  if [[ -f "$summary" ]]; then
    deviations="$(awk -F'|' '
      NF>=4 {
        item=$2; status=$3; notes=$4;
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", item);
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", status);
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", notes);
        low=tolower(status);
        if (low=="waived" || low=="deferred" || low=="partial")
          printf "- **%s** — _%s_%s\n", item, status, (notes!="" ? ": " notes : "");
      }
    ' "$summary")"
    dev_items="$(awk -F'|' '
      NF>=4 {
        item=$2; status=$3;
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", item);
        gsub(/^[ \t\r]+|[ \t\r]+$/, "", status);
        low=tolower(status);
        if (low=="waived" || low=="deferred" || low=="partial") print item;
      }
    ' "$summary")"
  fi

  # Evaluator findings = the ## Findings section, unless it is "No findings."
  local findings=""
  if [[ -f "$evalr" ]]; then
    findings="$(awk '
      /^##[[:space:]]+Findings[[:space:]]*$/ { infind=1; next }
      infind && /^##[[:space:]]/ { infind=0 }
      infind { print }
    ' "$evalr" | sed -e 's/\r$//' -e '/./,$!d')"
    if printf '%s' "$findings" | grep -qiE '^[[:space:]]*no findings\.?[[:space:]]*$'; then
      findings=""
    fi
  fi

  # Reviewer findings = every non-blank line under review-notes.md's "## Findings…" heading (the heading
  # may carry a suffix, e.g. "## Findings (advisory)"), except a bare "No findings." line. The reviewer is
  # advisory, so the evaluator can pass while a real defect (fixed mid-sprint) lives only here (t-13b3).
  # review.md's own template asks for one finding per line with no bullet marker, so any line shape counts.
  # review-notes.md is absent on bugfix/demo/trivial closes — optional. Each line is capped, and the count
  # is bounded, so a huge report can't bloat the candidate; the full text stays in review-notes.md.
  local revn="$tdir/review-notes.md" rfindings="" rverdict=""
  if [[ -f "$revn" ]]; then
    rfindings="$(awk '
      /^##[[:space:]]+Findings/ { infind=1; next }
      infind && /^##[[:space:]]/ { infind=0 }
      infind {
        sub(/\r$/, "")
        if ($0 !~ /[^[:space:]]/) next
        if (tolower($0) ~ /^[[:space:]]*[-*]?[[:space:]]*no findings\.?[[:space:]]*$/) next
        # per-concern lines from review.md (t-de16): "<Concern>: none — checked …" is a pass, not a finding.
        if (tolower($0) ~ /^[[:space:]]*[-*]?[[:space:]]*[a-z ]+:[[:space:]]*none([[:space:]]|$)/) next
        if (++n > 40) { if (n == 41) print "… (more findings in review-notes.md)"; next }
        print (length($0) > 400 ? substr($0, 1, 400) " … (see review-notes.md)" : $0)
      }
    ' "$revn")"
    rverdict="$(awk '
      /^##[[:space:]]+Verdict/ {
        rest=$0; sub(/^##[[:space:]]+Verdict[[:space:]]*[:—-]*[[:space:]]*/, "", rest); sub(/\r$/, "", rest)
        if (rest ~ /[^[:space:]]/) { print rest; exit }
        inv=1; next
      }
      inv && /^##[[:space:]]/ { inv=0 }
      inv { sub(/\r$/, ""); if ($0 ~ /[^[:space:]]/) { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit } }
    ' "$revn")"
  fi

  if [[ -z "$deviations" && -z "$findings" && -z "$rfindings" ]]; then
    echo "$id: clean sprint — no non-delivered rows in summary.md and no evaluator or reviewer findings; nothing to distill."
    echo "(No learnings candidate written.)"
    return 0
  fi

  if [[ -f "$out" && "$force" != true ]]; then
    echo "Error: $out already exists — it may hold a reviewer's edits." >&2
    echo "Re-run with --force to regenerate (discards the current file)." >&2
    exit 1
  fi

  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  {
    printf -- "---\n"
    printf "ticket: %s\n" "$id"
    printf "generated: %s\n" "$now"
    printf "status: UNPROMOTED\n"
    printf -- "---\n"
    printf "# Learnings candidate — %s: %s\n\n" "$id" "$title"
    printf "> **UNPROMOTED.** Generated by \`tkt learn\` from this sprint's close artifacts.\n"
    printf "> A reviewer **without** this sprint's implementation history promotes any keeper into\n"
    printf "> the project's durable store — in canon: \`critique/canon-learnings.md\`, \`standards/\`,\n"
    printf "> or (rarely — it's always-loaded context, so reserve it for something that must apply\n"
    printf "> on every session) \`CLAUDE.md\`/\`AGENTS.md\`; in a consumer project: its own \`PROMOTED.md\`.\n"
    printf "> The sprint author must not self-promote.\n"
    printf "> Delete this file if nothing here is worth keeping; \`tkt learn %s --force\` regenerates it.\n\n" "$id"

    printf "## Deviations (plan vs actual)\n\n"
    if [[ -n "$deviations" ]]; then printf "%s\n\n" "$deviations"; else printf "_none_\n\n"; fi

    printf "## Evaluator findings\n\n"
    if [[ -n "$findings" ]]; then printf "%s\n\n" "$findings"; else printf "_none_\n\n"; fi

    printf "## Reviewer findings\n\n"
    if [[ -n "$rfindings" ]]; then
      printf "Advisory reviewer verdict: %s. Full text in \`review-notes.md\`.\n\n%s\n\n" "${rverdict:-unknown}" "$rfindings"
    else
      printf "_none_\n\n"
    fi

    printf "## Candidate lessons\n"
    printf "<!-- One durable lesson per kept item; a non-builder fills in and promotes these. -->\n"
    while IFS= read -r it; do
      [[ -n "$it" ]] && printf -- "- [ ] Lesson from: %s\n" "$it"
    done <<< "$dev_items"
    [[ -n "$findings" ]] && printf -- "- [ ] Lesson from the evaluator findings above\n"
    [[ -n "$rfindings" ]] && printf -- "- [ ] Lesson from the reviewer findings above\n"
    printf -- "- [ ] (other)\n"
  } > "$out"

  echo "$id: wrote UNPROMOTED learnings candidate → $out"
  echo "Promote keepers into the durable store from a fresh context — not this sprint's author."
}

# cmd_compact [--older-than DAYS] [--dry-run] — t-2fb6: shrinks old closed tickets' evidence/. .tickets/ is copied by every
# board-spec run, scratch copy and evaluator clone, and is gitignored, so only the raw board-spec JSON reports are deleted
# (nothing reads them once a ticket is closed); every other file is packed into evidence.tgz, removed only after the archive
# lists exactly what was packed. A file cited by path stays loose, so docs, board-embedded images and code comments still resolve.
_compact_path_re='[^][[:space:]()<>"`|;'"'"']+'   # keeps * ? { } , so a glob or brace cite is matched whole
_compact_mb() { awk -v b="$1" 'BEGIN{printf "%.1f", b/1048576}'; }
_compact_bytes() {   # _compact_bytes <dir> <list>: total size of the listed files, relative to <dir>
  [[ -s "$2" ]] || { echo 0; return; }
  (cd "$1" && tr '\n' '\0' < "$2" | xargs -0 cat | wc -c | tr -d ' ')
}

cmd_compact() {
  local days=14 dry=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --older-than) days="${2:-}"; shift 2 || { echo "Error: --older-than needs a number of days" >&2; exit 1; } ;;
      --dry-run)    dry=true; shift ;;
      *)            echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ "$days" =~ ^[0-9]+$ ]] || { echo "Error: --older-than needs a number of days, got: $days" >&2; exit 1; }

  local dir root tmp
  dir="$(tickets_dir)"
  [[ -d "$dir" ]] || { echo "compact: total: no .tickets/ folder, nothing to do"; return 0; }
  root="$(dirname "$dir")"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/tkt-compact.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: $tmp is local and gone by the time tkt exits
  trap "rm -rf '$tmp'" EXIT

  # Paths cited from outside a ticket: open and in_progress tickets' docs, and tracked repo files. A git error is not
  # "nothing cited": stop before touching anything.
  local f st
  : > "$tmp/global"
  for f in "$dir"/*/ticket.md; do
    [[ -f "$f" ]] || continue
    st="$(get_field "$f" status)"
    [[ "$st" == open || "$st" == in_progress ]] || continue
    cat "$(dirname "$f")"/*.md >> "$tmp/global" 2>/dev/null || true
  done
  if git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local rc=0
    git -C "$root" grep -h -o -I -E "[A-Za-z0-9_-]+/evidence/$_compact_path_re" >> "$tmp/global" || rc=$?
    if (( rc > 1 )); then echo "compact: ERROR: git grep failed (exit $rc); nothing compacted" >&2; exit 2; fi
  fi

  local label="compact"; $dry && label="compact (dry run)"
  local n=0 failed=0 tdel=0 tpack=0 tbefore=0 tafter=0 t id del pack kept b_del b_pack b_after
  for t in "$dir"/*/; do
    t="${t%/}"; id="$(basename "$t")"
    [[ -L "$t" || ! -f "$t/ticket.md" ]] && continue
    st="$(get_field "$t/ticket.md" status)"
    [[ "$st" == closed || "$st" == cancelled ]] || continue
    [[ -d "$t/evidence" && ! -L "$t/evidence" && ! -e "$t/evidence.tgz" ]] || continue
    [[ -n "$(find "$t/ticket.md" -mmin +$(( days * 1440 )))" ]] || continue

    # Cited paths, relative to evidence/: "<id>/evidence/..." anywhere above, or "evidence/..." in this ticket's own docs.
    { grep -o -E "(^|[^A-Za-z0-9_-])$id/evidence/$_compact_path_re" "$tmp/global" | sed "s#^.*$id/evidence/##" || true
      cat "$t"/*.md 2>/dev/null | grep -o -E "evidence/$_compact_path_re" | sed 's#^evidence/##' || true
    } | sed -e 's/[.:,]*$//' -e 's#/*$##' | sort -u > "$tmp/cited"
    # Regular files only (find never follows a symlink); a name with a newline is left alone.
    (cd "$t" && find evidence -type f ! -name "$(printf '*\n*')") | sed 's#^evidence/##' | sort > "$tmp/all"
    # A cite is a file, a folder (everything under it stays), or a glob/brace pattern (* ? {a,b}) matched like the shell.
    awk 'function glob2re(g,   r, i, ch, br) {
           r = "^"; br = 0
           for (i = 1; i <= length(g); i++) {
             ch = substr(g, i, 1)
             if (ch == "*") r = r "[^/]*"; else if (ch == "?") r = r "[^/]"
             else if (ch == "{") { r = r "("; br++ } else if (ch == "}" && br) { r = r ")"; br-- }
             else if (ch == "," && br) r = r "|"
             else if (index(".+()|^$[]\\", ch)) r = r "\\" ch; else r = r ch
           }
           return r "(/|$)"
         }
         FILENAME==ARGV[1]{ if ($0 ~ /[*?{]/) re[glob2re($0)]=1; else c[$0]=1; next }
         { keep=0; for (p in c) if ($0==p || index($0, p "/")==1) keep=1
           for (p in re) if ($0 ~ p) keep=1
           if (keep) print > "'"$tmp/kept"'"
           else if ($0 ~ /(^|\/)board-spec-[^\/]*-run[^\/]*\.json$/) print > "'"$tmp/del"'"
           else print > "'"$tmp/pack"'" }' "$tmp/cited" "$tmp/all"
    for f in kept del pack; do touch "$tmp/$f"; sed -i.bak 's#^#evidence/#' "$tmp/$f"; done
    del="$(grep -c . "$tmp/del" || true)"; pack="$(grep -c . "$tmp/pack" || true)"; kept="$(grep -c . "$tmp/kept" || true)"
    if (( del + pack == 0 )); then rm -f "$tmp"/{kept,del,pack}{,.bak}; continue; fi
    b_del="$(_compact_bytes "$t" "$tmp/del")"; b_pack="$(_compact_bytes "$t" "$tmp/pack")"; b_after=0

    if (( pack > 0 )); then
      if $dry; then
        b_after="$(cd "$t" && tr '\n' '\0' < "$tmp/pack" | tar -czf - --null -T - | wc -c | tr -d ' ')"
      elif (cd "$t" && tr '\n' '\0' < "$tmp/pack" | tar -czf evidence.tgz.tmp --null -T - 2>"$tmp/err") \
           && (cd "$t" && tar -tzf evidence.tgz.tmp | sort) | cmp -s - <(sort "$tmp/pack") \
           && mv "$t/evidence.tgz.tmp" "$t/evidence.tgz"; then
        b_after="$(wc -c < "$t/evidence.tgz" | tr -d ' ')"
        (cd "$t" && tr '\n' '\0' < "$tmp/pack" | xargs -0 rm -f) \
          || { echo "compact: WARNING: $id: archive written, but some packed files could not be removed" >&2; failed=$((failed + 1)); }
      else
        rm -f "$t/evidence.tgz.tmp"
        echo "compact: WARNING: $id: packing failed, every file kept loose: $(head -1 "$tmp/err" 2>/dev/null)" >&2
        failed=$((failed + 1)); pack=0; b_pack=0
      fi
    fi
    if ! $dry && (( del > 0 )) && ! (cd "$t" && tr '\n' '\0' < "$tmp/del" | xargs -0 rm -f); then
      echo "compact: WARNING: $id: could not delete the board-spec JSON reports" >&2; failed=$((failed + 1))
    fi
    $dry || find "$t/evidence" -depth -type d -empty -delete 2>/dev/null || true

    echo "$label: $id: deleted $del board-spec JSON ($(_compact_mb "$b_del") MB), packed $pack files ($(_compact_mb "$b_pack") MB → $(_compact_mb "$b_after") MB)$( (( kept > 0 )) && echo ", kept $kept cited")"
    n=$((n + 1)); tdel=$((tdel + del)); tpack=$((tpack + pack))
    tbefore=$((tbefore + b_del + b_pack)); tafter=$((tafter + b_after))
    rm -f "$tmp"/{kept,del,pack}{,.bak}
  done

  echo "$label: total: $n tickets older than $days days, deleted $tdel files, packed $tpack files: $(_compact_mb "$tbefore") MB → $(_compact_mb "$tafter") MB (saved $(_compact_mb $((tbefore - tafter))) MB)"
  (( n > 0 )) && echo "$label: restore one: tar -xzf .tickets/<id>/evidence.tgz -C .tickets/<id>"
  if (( failed > 0 )); then echo "compact: WARNING: $failed steps failed (see above; their files were kept)" >&2; return 1; fi
  return 0
}

# cmd_send_issue <id> [--dry-run] [--public] — t-a059: posts a ticket as an issue on origin's GitHub repo, laid out in the
# ticket's own sections, for a Claude cloud session to work on ("Work on Issue#N"). Only origin, never a named repo;
# a public repo needs --public (ticket docs carry paths, notes and decisions); ticket.md changes only after gh succeeds.
_si_section() {   # _si_section <file> <heading>: the lines under "## <heading>" up to the next "## ", comments dropped, trimmed
  [[ -f "$1" ]] || return 0
  awk -v h="## $2" '$0 == h || index($0, h " ") == 1 { f = 1; next } f && /^## / { exit } f && /^<!--/ { next } f { print }' "$1" \
    | awk 'NF { started = 1 } started { buf = buf $0 "\n"; if (NF) { printf "%s", buf; buf = "" } }'
}
# acceptance.md's one-line section prompts, as `sprint start` writes them (tools/sprint cmd_start); everything else stays.
_si_drop_prompts() { grep -vxE 'The checklist of behavior that must be true before the sprint can close\.|The commands or checks that prove the criteria work\.|Edge cases and sign-off\.' | awk 'NF { s = 1 } s' || true; }
_si_or_none() { if [[ -n "$1" ]]; then printf '%s\n' "$1"; else printf '(none yet)\n'; fi; }

_gh_origin_repo() {   # _gh_origin_repo <root> <label>: prints origin's GitHub owner/repo, or explains why not (exit 1)
  local url
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || { echo "$2: this project has no git remote named origin" >&2; return 1; }
  if [[ "$url" =~ ^(https://github\.com/|git@github\.com:|ssh://git@github\.com/)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[2]%.git}"
  else
    echo "$2: origin is not a GitHub repo ($url)" >&2; return 1
  fi
}

# _repo_visibility <repo>: PUBLIC or PRIVATE, from gh when it can answer, else from an anonymous request (a public repo
# answers 200, a private one 404). Prints nothing when neither can tell.
_repo_visibility() {
  local v
  if command -v gh >/dev/null 2>&1 && v="$(gh repo view "$1" --json visibility --jq .visibility 2>/dev/null)" && [[ -n "$v" ]]; then
    printf '%s\n' "$v"; return 0
  fi
  case "$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://github.com/$1" 2>/dev/null)" in
    200) echo PUBLIC ;; 404) echo PRIVATE ;;
  esac
}

# _safe_ticket_path <tickets dir> <path>: refuse a path that is, or goes through, a symlink (t-554c). A cloned repo can
# commit .tickets/<id>/plan.md as a link to a workflow or a dotfile; importing issue text through it would write there.
_safe_ticket_path() {
  local base="$1" p="$2"
  while [[ "$p" == "$base"/* ]]; do
    [[ -L "$p" ]] && { echo "refusing to write through a symlink: ${p#"$base"/}" >&2; return 1; }
    p="$(dirname "$p")"
  done
  return 0
}

cmd_send_issue() {
  local id="" dry=false public=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=true; shift ;;
      --public)  public=true; shift ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$id" ]] && id="$1"; shift ;;
    esac
  done
  [[ -z "$id" ]] && { echo "Usage: tkt send-issue <id> [--dry-run] [--public]" >&2; exit 1; }

  local file tdir title
  file="$(find_ticket "$id")"
  id="$(get_field "$file" id)"
  tdir="$(dirname "$file")"
  title="$(get_title "$file")"
  local sent; sent="$(get_field "$file" github)"
  [[ -n "$sent" ]] && { echo "send-issue: $id was already sent: $sent" >&2; exit 1; }

  local root repo
  root="$(dirname "$(tickets_dir)")"
  repo="$(_gh_origin_repo "$root" send-issue)" || exit 1
  command -v gh >/dev/null 2>&1 || { echo "send-issue: needs the GitHub CLI: install gh, then run: gh auth login" >&2; exit 1; }
  local vis
  vis="$(gh repo view "$repo" --json visibility --jq .visibility 2>&1)" || { echo "send-issue: gh could not read $repo: $vis" >&2; echo "  If you are signed out, run: gh auth login" >&2; exit 1; }
  if [[ "$vis" == PUBLIC ]] && ! $public; then
    echo "send-issue: $repo is PUBLIC: anyone could read this ticket's problem, plan and notes." >&2
    echo "  Send it anyway with: tkt send-issue $id --public" >&2; exit 1
  fi

  local acc="$tdir/acceptance.md" plan="$tdir/plan.md" res="$tdir/research.md"
  # _si_all <file> [prompts]: every "## " section of <file>, with its own heading, as the board's tree lists it, tables
  # and prose included. With "prompts", acceptance.md's template prompt lines are dropped. Empty sections are dropped.
  _si_all() {
    [[ -f "$1" ]] || return 0
    local h c
    while IFS= read -r h; do
      c="$(_si_section "$1" "$h")"; [[ "${2:-}" == prompts ]] && c="$(printf '%s\n' "$c" | _si_drop_prompts)"
      [[ -n "$c" ]] && printf '## %s\n%s\n\n' "$h" "$c"
    done < <(sed -n 's/^## //p' "$1" | tr -d '\r')
    return 0
  }
  local asecs psecs rbody
  asecs="$(_si_all "$acc" prompts)"; psecs="$(_si_all "$plan")"
  _si_section "$acc" Criteria | _si_drop_prompts | grep -q '^[[:space:]]*- ' || echo "send-issue: warning: $id has no acceptance criteria; the agent will write its own" >&2
  rbody=""; [[ -f "$res" ]] && rbody="$(awk 'NR == 1 && /^# / { next } { print }' "$res" | awk 'NF { s = 1 } s')"

  local body; body="$(mktemp "${TMPDIR:-/tmp}/tkt-issue.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: $body is local
  trap "rm -f '$body'" EXIT
  # The same tree as the ticket on the board, every section with the board's heading (t-554c reads it back by these headings).
  {
    printf '**%s** · %s · P%s · %s\n\n' "$id" "$(get_field "$file" type)" "$(get_field "$file" priority)" "$title"
    # Only the title line is skipped: ticket_body drops every "# " line, which would eat a shell comment in a code block.
    printf '# Description\n'; _si_or_none "$(awk '/^---$/ && fm < 2 { fm++; next } fm >= 2 && !t && /^# / { t = 1; next } fm >= 2 { print }' "$file" | awk 'NF { s = 1 } s')"
    printf '\n# Acceptance\n'; _si_or_none "$asecs"
    printf '\n# Plan\n'; _si_or_none "$psecs"
    printf '\n# Research\n'; _si_or_none "$rbody"
    printf '\n# Working on this\n'
    printf 'This repository uses canon. Run `sprint import-issue <this issue number>` to rebuild .tickets/%s/ from the\n' "$id"
    printf 'sections above and start the sprint (if gh cannot read this issue, save its text to a file and add\n'
    printf '`--body-file <file>`). Open the PR with "Fixes #<this issue number>", and when the sprint closes run\n'
    printf '`tkt export %s` and push nothing else for it: export prints where the ticket went.\n' "$id"
    printf '\n<!-- canon:ticket %s -->\n' "$id"
  } > "$body"

  if $dry; then
    printf 'repo: %s (%s)\ntitle: %s: %s\nlabel: canon\n--- body ---\n' "$repo" "$vis" "$id" "$title"
    cat "$body"
    printf -- '--- dry run: nothing was created ---\n'
    return 0
  fi

  local out n
  gh label create canon --repo "$repo" --color 6C5CF7 --description "A canon ticket" --force >/dev/null 2>&1 \
    || echo "send-issue: warning: could not create the canon label; sending without it" >&2
  local labels=(--label canon); gh label list --repo "$repo" --search canon --json name --jq '.[].name' 2>/dev/null | grep -qx canon || labels=()
  local url
  out="$(gh issue create --repo "$repo" --title "$id: $title" "${labels[@]}" --body-file "$body" 2>&1)" \
    || { echo "send-issue: gh issue create failed; $id was not changed: $out" >&2; exit 1; }
  url="$(printf '%s\n' "$out" | grep -Eo 'https://github\.com/[^ ]+/issues/[0-9]+' | tail -1)"
  n="${url##*/}"
  if [[ -z "$url" || ! "$n" =~ ^[0-9]+$ ]]; then
    echo "send-issue: the issue was created but its number could not be read from: $out" >&2
    echo "  Add 'github: $repo#<number>' to $file by hand." >&2; exit 1
  fi
  set_or_add_field "$file" github "$repo#$n"
  printf 'Sent %s as %s\nIn a Claude cloud session on %s, type: Work on Issue#%s\n' "$id" "$url" "$repo" "$n"
}

# cmd_import_issue <N> [--body-file F] [--force] — t-554c: rebuilds .tickets/<id>/ from a `tkt send-issue` body (the
# board's tree: # Description, # Acceptance, # Plan, # Research), so a cloud session works the same ticket. Prints the id
# last (sprint import-issue starts it). An existing ticket.md is kept; another differing file is refused without --force.
cmd_import_issue() {
  local n="" bodyf="" force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --body-file) bodyf="${2:-}"; shift 2 || { echo "Error: --body-file needs a file" >&2; exit 1; } ;;
      --force)     force=true; shift ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$n" ]] && n="${1#\#}"; shift ;;
    esac
  done
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "Usage: tkt import-issue <issue number> [--body-file <file>] [--force]" >&2; exit 1; }
  local root repo="" dir; dir="$(ensure_tickets_dir)"; root="$(dirname "$dir")"
  repo="$(_gh_origin_repo "$root" import-issue 2>/dev/null)" || repo=""
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/tkt-import.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: $tmp is local
  trap "rm -rf '$tmp'" EXIT
  if [[ -n "$bodyf" ]]; then
    tr -d '\r' < "$bodyf" > "$tmp/body" || { echo "import-issue: cannot read $bodyf" >&2; exit 1; }
  else
    [[ -n "$repo" ]] || { echo "import-issue: origin is not a GitHub repo; use --body-file <file>" >&2; exit 1; }
    local err; err="$(gh issue view "$n" --repo "$repo" --json body --jq .body 2>&1 > "$tmp/body")" \
      || { echo "import-issue: gh could not read issue #$n on $repo: $err" >&2; echo "  Save the issue's text to a file and add --body-file <file>." >&2; exit 1; }
  fi
  local id hdr type pri title
  id="$(sed -n 's/^<!-- canon:ticket \(t-[a-z0-9]*\) -->$/\1/p' "$tmp/body" | tail -1)"
  [[ -n "$id" ]] || { echo "import-issue: issue #$n has no canon:ticket marker; it was not made by tkt send-issue" >&2; exit 1; }
  hdr="$(grep -m1 "^\*\*$id\*\* · " "$tmp/body" || true)"
  type="$(awk -F' · ' '{print $2}' <<< "$hdr")"; pri="$(awk -F' · ' '{sub(/^P/, "", $3); print $3}' <<< "$hdr")"
  title="$(awk -F' · ' '{ t = $4; for (i = 5; i <= NF; i++) t = t " · " $i; print t }' <<< "$hdr")"
  [[ -n "$title" ]] || title="$id"
  # Split the body into its "# " parts; "(none yet)" means the part was empty.
  # A "# " line inside a fenced code block (a shell comment) is content, not a part.
  awk -v d="$tmp" '/^```/ { fence = !fence } !fence && /^# / { name = substr($0, 3); f = d "/part-" name; printf "" > f; next } name != "" && !/^<!-- canon:ticket / { print >> f }' "$tmp/body"
  part() { local f="$tmp/part-$1"; [[ -f "$f" ]] || return 0; awk 'NF { s = 1 } s' "$f" | awk '{ a[NR] = $0 } END { while (NR && a[NR] == "") NR--; for (i = 1; i <= NR; i++) print a[i] }' | grep -vx '(none yet)' || true; }
  local tdir="$dir/$id"
  _safe_ticket_path "$dir" "$tdir/ticket.md" || exit 1
  local f; for f in acceptance.md plan.md research.md; do _safe_ticket_path "$dir" "$tdir/$f" || exit 1; done
  mkdir -p "$tdir"
  local desc acc plan res; desc="$(part Description)"; acc="$(part Acceptance)"; plan="$(part Plan)"; res="$(part Research)"
  [[ -n "$acc" ]] && printf '# Acceptance\n\n<!-- Keep the Ticket line below unchanged. -->\nTicket: `%s`\n\n%s\n' "$id" "$acc" > "$tmp/acceptance.md"
  [[ -n "$plan" ]] && printf '# Plan\n\n<!-- Keep the Ticket line below unchanged. -->\nTicket: `%s`\n\n%s\n' "$id" "$plan" > "$tmp/plan.md"
  [[ -n "$res" ]] && printf '# Research: %s\n\n%s\n' "$id" "$res" > "$tmp/research.md"
  local bad=""
  for f in acceptance.md plan.md research.md; do
    [[ -f "$tmp/$f" && -f "$tdir/$f" ]] && ! cmp -s "$tmp/$f" "$tdir/$f" && bad="$bad $f"
  done
  if [[ -n "$bad" ]] && ! $force; then
    echo "import-issue: .tickets/$id/ already has different:$bad. Re-run with --force to replace them." >&2; exit 1
  fi
  for f in acceptance.md plan.md research.md; do [[ -f "$tmp/$f" ]] && cp "$tmp/$f" "$tdir/$f"; done
  if [[ ! -f "$tdir/ticket.md" ]]; then
    {
      printf -- '---\nid: %s\nstatus: open\ncreated: %s\ntype: %s\npriority: %s\neval_override: false\neval_fail_count: 0\n' \
        "$id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${type:-task}" "${pri:-2}"
      [[ -n "$repo" ]] && printf 'github: %s#%s\n' "$repo" "$n"
      printf -- '---\n# %s\n' "$title"
      [[ -n "$desc" ]] && printf '\n%s\n' "$desc"
    } > "$tdir/ticket.md"
  elif [[ -n "$repo" && -z "$(get_field "$tdir/ticket.md" github)" ]]; then
    set_or_add_field "$tdir/ticket.md" github "$repo#$n"
  fi
  echo "import-issue: rebuilt .tickets/$id/ from issue #$n" >&2
  printf '%s\n' "$id"
}

# cmd_export <id> — t-554c: at the close of a cloud sprint, sends .tickets/<id>/ back. A tracked .tickets/ rides in the PR;
# an ignored one (canon's own) goes to the branch canon-results/<id>, built from a temporary index so the checkout and
# the real index are never touched, holding only that folder.
cmd_export() {
  local id="" public=false
  while [[ $# -gt 0 ]]; do
    case "$1" in --public) public=true; shift ;; -*) echo "Unknown option: $1" >&2; exit 1 ;; *) [[ -z "$id" ]] && id="$1"; shift ;; esac
  done
  [[ -z "$id" ]] && { echo "Usage: tkt export <id> [--public]" >&2; exit 1; }
  local file tdir root rel; file="$(find_ticket "$id")"; id="$(get_field "$file" id)"; tdir="$(dirname "$file")"
  root="$(git -C "$tdir" rev-parse --show-toplevel)" || exit 1
  rel=".tickets/$id"
  if ! git -C "$root" check-ignore -q "$rel/ticket.md"; then
    echo "export: .tickets/ is tracked here, so $rel/ goes back with the PR: commit it on the PR branch."; return 0
  fi
  # The folder holds notes and evidence logs: like send-issue, a public repo needs --public.
  local repo vis=""; repo="$(_gh_origin_repo "$root" export 2>/dev/null)" && vis="$(_repo_visibility "$repo")"
  if [[ "$vis" != PRIVATE ]] && ! $public; then
    if [[ "$vis" == PUBLIC ]]; then echo "export: $repo is PUBLIC: anyone could read this ticket's notes and evidence on canon-results/$id." >&2
    else echo "export: could not tell whether origin is public (it is not on GitHub, or gh and github.com did not answer)." >&2; fi
    echo "  Push it anyway with: tkt export $id --public" >&2; exit 1
  fi
  local idx; idx="$(mktemp "${TMPDIR:-/tmp}/tkt-export-idx.XXXXXX")"; rm -f "$idx"
  # shellcheck disable=SC2064  # expand now: $idx is local
  trap "rm -f '$idx'" EXIT
  local tree commit
  (cd "$root" && find "$rel" -type f ! -name '.cockpit-*' -print0 | GIT_INDEX_FILE="$idx" xargs -0 git add -f --) || { echo "export: could not stage $rel" >&2; exit 1; }
  tree="$(cd "$root" && GIT_INDEX_FILE="$idx" git write-tree)" || exit 1
  commit="$(git -C "$root" commit-tree "$tree" -m "canon results: $id")" || exit 1
  git -C "$root" push --force origin "$commit:refs/heads/canon-results/$id" >&2 || { echo "export: push to origin failed" >&2; exit 1; }
  echo "export: pushed $rel/ to canon-results/$id. On your machine: tkt import-results $id"
}

# cmd_import_results <id> [--pr N] — t-554c: brings a cloud sprint's .tickets/<id>/ back from canon-results/<id>. Files
# arrive byte-for-byte; a differing local file is kept in .before-import/; the close already happened in the cloud, so
# this only reports it. The remote branch is deleted only after the files are written.
cmd_import_results() {
  local id="" pr=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pr) pr="${2:-}"; shift 2 || { echo "Error: --pr needs a number" >&2; exit 1; } ;;
      -*) echo "Unknown option: $1" >&2; exit 1 ;;
      *)  [[ -z "$id" ]] && id="$1"; shift ;;
    esac
  done
  [[ -n "$id" ]] || { echo "Usage: tkt import-results <id> [--pr N]" >&2; exit 1; }
  [[ "$id" =~ ^t-[a-z0-9]+$ ]] || { echo "import-results: not a ticket id: $id" >&2; exit 1; }
  local dir root rel tdir; dir="$(ensure_tickets_dir)"; root="$(dirname "$dir")"; rel=".tickets/$id"; tdir="$dir/$id"
  git -C "$root" fetch -q origin "refs/heads/canon-results/$id" 2>/dev/null \
    || { echo "import-results: origin has no branch canon-results/$id (did the cloud session run tkt export $id?)" >&2; exit 1; }
  local head; head="$(git -C "$root" rev-parse FETCH_HEAD)"
  local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/tkt-results.XXXXXX")"
  # shellcheck disable=SC2064  # expand now: $tmp is local
  trap "rm -rf '$tmp'" EXIT
  git -C "$root" archive "$head" "$rel" | tar -x -C "$tmp" || { echo "import-results: could not read canon-results/$id" >&2; exit 1; }
  [[ -f "$tmp/$rel/ticket.md" ]] || { echo "import-results: canon-results/$id has no $rel/ticket.md" >&2; exit 1; }
  local gh_line=""; [[ -f "$tdir/ticket.md" ]] && gh_line="$(get_field "$tdir/ticket.md" github)"
  local f n=0 kept=0
  mkdir -p "$tdir"
  while IFS= read -r -d '' f; do
    f="${f#"$tmp/$rel/"}"
    _safe_ticket_path "$dir" "$tdir/$f" && _safe_ticket_path "$dir" "$tdir/.before-import/$f" || exit 1
    if [[ -f "$tdir/$f" ]] && ! cmp -s "$tmp/$rel/$f" "$tdir/$f"; then
      mkdir -p "$(dirname "$tdir/.before-import/$f")" && cp -p "$tdir/$f" "$tdir/.before-import/$f" || { echo "import-results: could not back up $f; nothing more written" >&2; exit 1; }
      kept=$((kept + 1))
    fi
    mkdir -p "$(dirname "$tdir/$f")" && cp -p "$tmp/$rel/$f" "$tdir/$f" || { echo "import-results: could not write $f" >&2; exit 1; }
    n=$((n + 1))
  done < <(find "$tmp/$rel" -type f -print0)
  [[ -n "$gh_line" && -z "$(get_field "$tdir/ticket.md" github)" ]] && set_or_add_field "$tdir/ticket.md" github "$gh_line"
  local st verdict graded rc=0
  st="$(get_field "$tdir/ticket.md" status)"
  verdict="$(grep -m1 -E '^(pass|fail):' "$tdir/eval-report.md" 2>/dev/null | cut -d: -f1 || true)"
  graded="$(sed -n 's/^graded-head: *\([0-9a-f]\{7,40\}\).*/\1/p' "$tdir/eval-report.md" 2>/dev/null | head -1)"
  echo "import-results: $n files into $rel/ ($kept local files kept in $rel/.before-import/)"
  echo "  status: ${st:-unknown}$([[ "$st" == closed ]] || echo '  (expected closed: the cloud sprint did not finish)')"
  echo "  evaluator: ${verdict:-no eval-report.md}  graded-head: ${graded:-none}"
  if [[ -n "$pr" ]]; then
    local prh; prh="$(cd "$root" && gh pr view "$pr" --json headRefOid --jq .headRefOid 2>&1)" || { echo "import-results: gh could not read PR #$pr: $prh" >&2; rc=1; }
    if [[ $rc == 0 && -n "$graded" && "$prh" == "$graded"* ]]; then echo "  PR #$pr head $prh: matches graded-head"
    elif [[ $rc == 0 ]]; then echo "  PR #$pr head $prh does NOT match graded-head ${graded:-none}: the evaluator graded other code" >&2; rc=1; fi
  fi
  git -C "$root" push -q origin --delete "canon-results/$id" 2>/dev/null || echo "  note: could not delete canon-results/$id on origin; delete it by hand" >&2
  echo "  Add its LEARNINGS.md row locally (learnings-sweep for $id) if it wrote learnings.md."
  return "$rc"
}

cmd_help() {
  cat <<'EOF'
tkt — minimal ticket system

Usage: tkt <command> [args]

Commands:
  create [title] [options]  Create ticket, prints ID
    -d, --description       Description text
    -t, --type              Type (bug|feature|task|epic|chore) [default: task]
    -p, --priority          Priority 0-4, 0=highest [default: 2]
  start <id>                Set status to in_progress and mark ACTIVE
  close <id> [--no-sprint]  Set status to closed and clear ACTIVE if matched.
                            Refuses by default — use 'sprint complete' if the
                            ticket has sprint docs, or pass --no-sprint to
                            force-close a doc-less/backlog ticket directly.
  archive <id>              Set status to archived (hidden from board columns, searchable)
  ci <id> [on|off]          Mark ticket CI-eligible (headless grading); [default: on]
                            Reminds to 'git add -f' the ticket's docs — gitignored
                            by default inside canon's own repo; a consumer project
                            may have no such .gitignore entry at all, in which case
                            this is a harmless no-op.
  gate <id> [eval|full]     Headless gate mode for the CI run button: 'eval' runs
                            sprint-headless-eval (evaluator only), 'full' (default)
                            runs the full sprint-headless pipeline. No arg prints
                            the current mode. Only meaningful when ci is on.
  demo <id> [on|off]        Mark ticket for the demo close-path: 'sprint complete'
                            runs security-review + the binding evaluator only
                            (forced Haiku), skipping the advisory reviewer + rest
                            of wrapup. No arg prints the current state; off (default)
                            removes the line. Never drops below the evaluator.
  current                   Show active ticket
  reopen <id>               Set status to open
  ls [--status=X] [--json]  List tickets (unfiltered by default); --json: array of
                            {id,status,type,priority,title}
  show <id> [--json]        Display ticket details; --json: one object {id,status,type,
                            priority,created,title,body,eval_override,eval_fail_count,demo}
  why <file>                Show tickets whose commits touched a file
  learn <id> [--force]      Distill a closed sprint's summary.md deviations +
                            eval-report.md and review-notes.md findings into an UNPROMOTED candidate at
                            .tickets/<id>/learnings.md. Proposes, never promotes — a
                            non-builder moves keepers into the durable store. Writes
                            nothing for a clean sprint; refuses to overwrite an
                            existing candidate without --force.
  compact [--older-than DAYS] [--dry-run]
                            Shrink evidence/ of closed or cancelled tickets whose
                            ticket.md is older than DAYS (default 14): delete raw
                            board-spec JSON reports, pack the rest into evidence.tgz.
                            Files cited by path stay loose. sprint complete runs it.
  send-issue <id> [--dry-run] [--public]
                            Post the ticket as an issue on origin's GitHub repo, laid
                            out like the board (Description, Acceptance, Plan, Research), for a
                            Claude cloud session ("Work on Issue#N"). Records github:.
  import-issue <N> [--body-file F] [--force]
                            Rebuild .tickets/<id>/ from a send-issue body (used by
                            sprint import-issue in the cloud session).
  export <id> [--public]    Send a cloud sprint's .tickets/<id>/ back: with the PR
                            when .tickets/ is tracked, else to canon-results/<id>.
  import-results <id> [--pr N]
                            Bring canon-results/<id> back (local edits kept in
                            .before-import/), report status, verdict, graded-head.

New tickets are stored in .tickets/<id>/ticket.md
ACTIVE ticket is stored in .tickets/ACTIVE
Supports partial ID matching (e.g., 'tkt show 8ms' matches 't-8ms5')
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    create)         cmd_create "$@" ;;
    start)          cmd_set_status "${1:-}" in_progress ;;
    close)          cmd_close "$@" ;;
    archive)        cmd_set_status "${1:-}" archived ;;
    ci)             cmd_ci "$@" ;;
    gate)           cmd_gate "$@" ;;
    demo)           cmd_demo "$@" ;;
    current)        cmd_current ;;
    reopen)         cmd_set_status "${1:-}" open ;;
    ls|list)        cmd_ls "$@" ;;
    show)           cmd_show "$@" ;;
    why)            cmd_why "$@" ;;
    learn)          cmd_learn "$@" ;;
    compact)        cmd_compact "$@" ;;
    send-issue)     cmd_send_issue "$@" ;;
    import-issue)   cmd_import_issue "$@" ;;
    export)         cmd_export "$@" ;;
    import-results) cmd_import_results "$@" ;;
    help|--help|-h) cmd_help ;;
    --version|-v)   echo "tkt $VERSION" ;;
    *)              echo "Unknown command: $cmd" >&2; cmd_help; exit 1 ;;
  esac
}

main "$@"
