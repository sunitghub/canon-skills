#!/usr/bin/env bash
# sprint-headless — CI-callable entry point that grades an already-open PR/diff
# against a ci:true ticket's plan.md/acceptance.md, headlessly via `claude -p`.
#
# Usage: sprint-headless <ticket-id> --base-ref <ref>
#        (or set GITHUB_BASE_REF instead of --base-ref)
#
# Runs exactly three gates (reviewer, evaluator, security-review) via a single
# `claude -p` dispatch that internally spawns each as an Agent subagent. Never
# writes code — the change under review already exists. See t-c368's plan.md
# for the full design and the spike that verified this invocation contract.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/ticket-root.sh"
source "$SCRIPT_DIR/gate-cache.sh"
source "$SCRIPT_DIR/gate-model.sh"

ID="${1:-}"
[[ -z "$ID" || "$ID" == --* ]] && { echo "Usage: sprint-headless <ticket-id> --base-ref <ref> [--cache|--no-cache]" >&2; exit 1; }
shift

# Strict format check before $ID is used in any path or embedded in the prompt
# text sent to claude -p — closes both a path-traversal vector and a
# prompt-injection vector at the one point both would have to pass through.
[[ "$ID" =~ ^t-[a-z0-9]{4}$ ]] || { echo "Error: '$ID' is not a valid ticket ID (expected t-[a-z0-9]{4})." >&2; exit 1; }

BASE_REF="${GITHUB_BASE_REF:-}"
CACHE_FLAG=-1   # -1 = unset (fall back to env), 1 = --cache, 0 = --no-cache
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base-ref) BASE_REF="${2:-}"; shift 2 ;;
    --cache) CACHE_FLAG=1; shift ;;
    --no-cache) CACHE_FLAG=0; shift ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# Caching is opt-in (see gate-cache.sh): explicit --cache/--no-cache wins, else
# CANON_GATE_CACHE=1 enables it. Default (nothing set) = off, fully fresh grading.
if [[ "$CACHE_FLAG" -eq 1 ]]; then
  CACHE_ON=1
elif [[ "$CACHE_FLAG" -eq 0 ]]; then
  CACHE_ON=0
elif [[ "${CANON_GATE_CACHE:-}" == "1" ]]; then
  CACHE_ON=1
else
  CACHE_ON=0
fi

# Base ref precedence: explicit --base-ref > $GITHUB_BASE_REF > default origin/main
# (then main) — same rule as sprint-headless-eval. CI always passes its base
# explicitly, so the default only helps local runs; error only if none resolves.
if [[ -z "$BASE_REF" ]]; then
  if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
    BASE_REF="origin/main"
  elif git rev-parse --verify --quiet main >/dev/null 2>&1; then
    BASE_REF="main"
  else
    echo "Error: no --base-ref/\$GITHUB_BASE_REF given and could not resolve a default base ref (origin/main or main). Pass --base-ref explicitly." >&2
    exit 1
  fi
fi

# Same rationale as $ID above — a git ref name is far more permissive than a
# ticket ID, so this only rejects the common, safe shape (branch/tag names,
# short/full SHAs); reject anything with shell metacharacters or whitespace
# before it reaches the prompt text, rather than trusting git's own (looser)
# ref-name rules as the sole boundary.
[[ "$BASE_REF" =~ ^[A-Za-z0-9._/-]+$ ]] || { echo "Error: '$BASE_REF' is not a valid base ref (expected branch/tag name or SHA — letters, digits, '.', '_', '/', '-' only)." >&2; exit 1; }

ROOT="$(project_root)"
TDIR="$(tickets_dir)/$ID"
TICKET_FILE="$TDIR/ticket.md"
PLAN_FILE="$TDIR/plan.md"
ACCEPTANCE_FILE="$TDIR/acceptance.md"

[[ -f "$TICKET_FILE" ]] || { echo "Error: no ticket found at $TICKET_FILE" >&2; exit 1; }

CI_FLAG="$(awk -v f=ci 'BEGIN{fm=0} /^---$/{fm++; next} fm==1 && match($0, "^" f ": "){print substr($0, RSTART+RLENGTH); exit}' "$TICKET_FILE")"
if [[ "$CI_FLAG" != "true" ]]; then
  echo "Error: $ID is not CI-eligible (ci: true not set). Run: tkt ci $ID on" >&2
  exit 1
fi

if ! git -C "$ROOT" ls-files --error-unmatch "$PLAN_FILE" "$ACCEPTANCE_FILE" >/dev/null 2>&1; then
  echo "Error: $ID's plan.md/acceptance.md aren't committed. Run: git add -f $TDIR/ && git commit" >&2
  exit 1
fi

if ! grep -q '^\s*-\s*\[x\]\s*Plan approved' "$PLAN_FILE"; then
  echo "Error: $ID's plan.md has no checked 'Plan approved' box — headless mode requires the durable human sign-off to already be recorded." >&2
  exit 1
fi

# Read the workflow tier from the committed plan.md ## Sign-off. `Tier: bugfix` is the
# eval-only tier: headless skips the advisory reviewer but keeps the binding evaluator +
# security-review (mirrors interactive complete.md). Anchored to the Tier: field *within*
# ## Sign-off — not the `type:` frontmatter (the orthogonal job type) and not the Risk:
# free text. Headless trusts the committed tier: a wrong `Tier: bugfix` only skips the
# advisory reviewer; the binding gates always run.
TIER="$(awk '
  /^##[[:space:]]+Sign-off[[:space:]]*$/ { in_so=1; next }
  in_so && /^##[[:space:]]/ { exit }
  in_so && /^[[:space:]]*[Tt]ier[[:space:]]*:/ {
    s=$0
    sub(/^[[:space:]]*[Tt]ier[[:space:]]*:[[:space:]]*/, "", s)
    sub(/[[:space:]]*\|.*$/, "", s)
    gsub(/[[:space:]]/, "", s)
    print tolower(s); exit
  }
' "$PLAN_FILE")"
BUGFIX=0
[[ "$TIER" == "bugfix" ]] && BUGFIX=1

# Read `Gate model:` from the same committed ## Sign-off line (the field the
# interactive `sprint complete` already honors — see complete.md's "Model tier
# for gates"). Wiring it here makes the Plan's model choice apply to headless CI
# too, closing the interactive-vs-headless gap. `session` (or an absent field)
# means "no override" → claude's default. Any other value is passed as --model.
# Resolution lives in gate-model.sh — the cockpit daemon needs the same answer
# in Go (t-842b), so there is one bash owner rather than a copy per caller.
MODEL="$(gate_model_resolve "$PLAN_FILE")" || exit 1
MODEL_ARGS=()
[[ -n "$MODEL" ]] && MODEL_ARGS=(--model "$MODEL")

# Resolve the skills-doc path prefix and subagent-log.sh location for the
# repo this script is running in — canon's own repo (top-level skills/) or a
# consumer project (skills.sh add's .claude/skills/ symlink to $SKILLS_ROOT/skills).
# Fail closed before ever dispatching to claude -p if neither layout is found.
if [[ -d "$ROOT/skills/sprint" ]]; then
  SKILLS_PREFIX="skills"
  SUBAGENT_LOG="./tools/subagent-log.sh"
  SUBAGENT_LOG_ALLOW="Bash(./tools/subagent-log.sh:*)"
elif [[ -d "$ROOT/.claude/skills/sprint" ]]; then
  SKILLS_PREFIX=".claude/skills"
  SUBAGENT_LOG="$SCRIPT_DIR/subagent-log.sh"
  SUBAGENT_LOG_ALLOW="Bash($SCRIPT_DIR/subagent-log.sh:*)"
else
  echo "Error: no sprint/wrapup skill docs found at either '$ROOT/skills/sprint' (canon repo) or '$ROOT/.claude/skills/sprint' (consumer project). Run 'skills.sh add sprint' first." >&2
  exit 1
fi

REVIEWER_START="@@@CANON_HEADLESS_REPORT:reviewer@@@"
REVIEWER_END="@@@CANON_HEADLESS_REPORT:/reviewer@@@"
EVALUATOR_START="@@@CANON_HEADLESS_REPORT:evaluator@@@"
EVALUATOR_END="@@@CANON_HEADLESS_REPORT:/evaluator@@@"

# Gate set, relay blocks, and verdict rule vary by tier. bugfix (eval-only) skips
# the advisory reviewer and keeps the binding evaluator + security-review; every
# other tier runs all three. Non-bugfix text is unchanged from the original prompt.
if [[ "$BUGFIX" -eq 1 ]]; then
  GATE_INSTRUCTIONS="This is a Tier: bugfix ticket — the eval-only tier — so the advisory reviewer gate is intentionally SKIPPED; the binding evaluator still runs. Dispatch exactly two fresh Agent subagents, subagent_type: \"Plan\" for each, one at a time:
1. Evaluator — instruct it to read $SKILLS_PREFIX/sprint/reference/eval.md and follow its protocol for ticket $ID, with Base ref: $BASE_REF as an explicit input (do not let it infer via git merge-base). Its own Bash write will be refused (dontAsk denies it) — per eval.md's own fallback, it will include its full report verbatim in its response text. It returns pass or fail.
2. Security-review — instruct it to read $SKILLS_PREFIX/wrapup/gates/security-review.md and follow its protocol, with Base ref: $BASE_REF as an explicit input. Ask it to report HIGH/MEDIUM findings, if any, in its final response text (this gate has no dedicated report file)."
  RELAY_INSTRUCTIONS="You cannot write files yourself either. Instead, relay the evaluator's full report text VERBATIM (byte-for-byte, not summarized, not paraphrased) in your own final response, wrapped in these exact delimiter lines on their own line with nothing else on them:

$EVALUATOR_START
<evaluator's full report text, verbatim>
$EVALUATOR_END"
  LOG_TYPES="<evaluator|security-review>"
  VERDICT_RULE="Verdict is PASS only if: evaluator verdict is pass, and security-review found no HIGH-confidence findings. Any fail or HIGH finding makes the overall verdict FAIL. (The advisory reviewer is skipped for the Tier: bugfix eval-only tier.)"
else
  GATE_INSTRUCTIONS="Dispatch exactly three fresh Agent subagents, subagent_type: \"Plan\" for each, one at a time:
1. Reviewer — instruct it to read $SKILLS_PREFIX/sprint/reference/review.md and follow its protocol for ticket $ID, with Base ref: $BASE_REF as an explicit input (do not let it infer via git merge-base). Its own Bash write will be refused (dontAsk denies it) — per review.md's own fallback, it will include its full report verbatim in its response text. It returns YES or NO.
2. Evaluator — instruct it to read $SKILLS_PREFIX/sprint/reference/eval.md and follow its protocol for ticket $ID, with Base ref: $BASE_REF as an explicit input. Same write-refusal fallback — it will include its full report verbatim in its response text. It returns pass or fail.
3. Security-review — instruct it to read $SKILLS_PREFIX/wrapup/gates/security-review.md and follow its protocol, with Base ref: $BASE_REF as an explicit input. Ask it to report HIGH/MEDIUM findings, if any, in its final response text (this gate has no dedicated report file, in headless or interactive mode)."
  RELAY_INSTRUCTIONS="You cannot write files yourself either. Instead, relay each of the reviewer's and evaluator's full report text VERBATIM (byte-for-byte, not summarized, not paraphrased) in your own final response, each wrapped in these exact delimiter lines on their own line with nothing else on them:

$REVIEWER_START
<reviewer's full report text, verbatim>
$REVIEWER_END

$EVALUATOR_START
<evaluator's full report text, verbatim>
$EVALUATOR_END"
  LOG_TYPES="<reviewer|evaluator|security-review>"
  VERDICT_RULE="Verdict is PASS only if: reviewer verdict is YES, evaluator verdict is pass, and security-review found no HIGH-confidence findings. Any NO, fail, or HIGH finding makes the overall verdict FAIL."
fi

PROMPT="You are the orchestrator for a headless CI grading run of ticket $ID in this repo. The code change under review already exists as the diff between $BASE_REF and HEAD — you never write or edit code yourself.

$GATE_INSTRUCTIONS

After each subagent completes, run: $SUBAGENT_LOG --agent-id <the agent id from that dispatch> --agent-type $LOG_TYPES

$RELAY_INSTRUCTIONS

Then output a summary covering all verdicts, then end your response with exactly one line, nothing after it:
HEADLESS_VERDICT: PASS
or
HEADLESS_VERDICT: FAIL

$VERDICT_RULE"

# --- Cache lookup (opt-in) ---
# Gate-set differs by tier, so it is part of the key. Criteria text = the
# committed acceptance.md + plan.md (editing either invalidates). Keyed on the
# exact diff content too, so a stale entry can never be hit. Loud + auditable.
if [[ "$BUGFIX" -eq 1 ]]; then GATESET="evaluator+security"; else GATESET="reviewer+evaluator+security"; fi
CACHE_KEY=""
CACHE_HIT=0
if [[ "$CACHE_ON" -eq 1 ]]; then
  CACHE_CRITERIA="$(cat "$ACCEPTANCE_FILE" "$PLAN_FILE")"
  CACHE_KEY="$(gate_cache_key "$ROOT" "$BASE_REF" "$CACHE_CRITERIA" "$MODEL" "$GATESET")"
  gate_cache_has "$ROOT" "$CACHE_KEY" && CACHE_HIT=1
fi

if [[ "$CACHE_HIT" -eq 1 ]]; then
  gate_cache_banner "$ROOT" "$CACHE_KEY"
  RESULT_TEXT="$(gate_cache_get "$ROOT" "$CACHE_KEY")"
else
  set +e
  RESULT_JSON="$(cd "$ROOT" && claude -p "$PROMPT" \
    --output-format json \
    --permission-mode dontAsk \
    ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} \
    --allowedTools "Agent" "Bash(git diff:*)" "Bash(git log:*)" "Bash(git show:*)" "Bash(git status:*)" "$SUBAGENT_LOG_ALLOW" "Read" "Grep" "Glob" "LS")"
  INVOKE_STATUS=$?
  set -e

  if [[ "$INVOKE_STATUS" -ne 0 ]]; then
    echo "Error: claude -p invocation failed (exit $INVOKE_STATUS). Hard-failing." >&2
    echo "$RESULT_JSON" >&2
    exit 1
  fi

  # On Windows, python3 isn't bundled with Git for Windows — use the committed
  # Go binary instead when running there and present; every other platform
  # (and Windows with the binary absent, e.g. an older checkout) keeps using
  # python3 unchanged. Never try to exec the Windows PE binary on macOS/Linux —
  # it would just fail with "cannot execute binary file".
  IS_WINDOWS=0
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) IS_WINDOWS=1 ;;
  esac
  JSON_HELPER="$SCRIPT_DIR/sprint-headless-json-win.exe"

  if [[ "$IS_WINDOWS" -eq 1 && -f "$JSON_HELPER" ]]; then
    PARSED="$(echo "$RESULT_JSON" | "$JSON_HELPER")"
  elif command -v python3 >/dev/null 2>&1; then
    PARSED="$(echo "$RESULT_JSON" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("PARSE_ERROR\t\t")
    sys.exit(0)
is_error = d.get("is_error", True)
session_id = d.get("session_id", "unknown")
result = d.get("result", "").replace(chr(10), chr(2))
print(str(is_error) + chr(9) + str(session_id) + chr(9) + result)
')"
  else
    echo "Error: python3 is required to parse claude -p's output (on Windows, $JSON_HELPER is used instead if present — it wasn't found). Hard-failing." >&2
    exit 1
  fi
  IS_ERROR="$(echo "$PARSED" | cut -f1)"
  SESSION_ID="$(echo "$PARSED" | cut -f2)"
  RESULT_TEXT="$(echo "$PARSED" | cut -f3- | tr '\002' '\n')"

  "$SCRIPT_DIR/subagent-log.sh" --agent-id "headless-$SESSION_ID" --agent-type headless-orchestrator 2>/dev/null || true

  if [[ "$IS_ERROR" != "False" ]]; then
    echo "Error: claude -p reported an error (is_error=$IS_ERROR). Hard-failing." >&2
    echo "$RESULT_JSON" >&2
    exit 1
  fi
fi

# --- Persist to cache on a MISS (both PASS and FAIL are cached) ---
if [[ "$CACHE_ON" -eq 1 && "$CACHE_HIT" -eq 0 ]]; then
  if echo "$RESULT_TEXT" | grep -q '^HEADLESS_VERDICT: PASS$'; then CACHE_VERDICT=PASS
  elif echo "$RESULT_TEXT" | grep -q '^HEADLESS_VERDICT: FAIL$'; then CACHE_VERDICT=FAIL
  else CACHE_VERDICT=""; fi
  if [[ -n "$CACHE_VERDICT" ]]; then
    printf '%s' "$RESULT_TEXT" | gate_cache_put "$ROOT" "$CACHE_KEY" "$CACHE_VERDICT" "${SESSION_ID:-unknown}" "$MODEL" "$GATESET"
  fi
fi

echo "$RESULT_TEXT"

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  printf '%s\n' "$RESULT_TEXT" >> "$GITHUB_STEP_SUMMARY"
fi

# Extract one delimited section from $RESULT_TEXT. Prints the content between
# the start/end marker lines (exclusive) and exits 0 on success; exits 1 with
# nothing printed if either marker is missing or out of order — persistence
# is fail-open by design (t-1bea): a bad/missing marker never blocks the run
# or corrupts an existing file, it just means that one file doesn't get written.
extract_report() {
  local tag="$1"
  # Plain-text delimiter search on already-unescaped $RESULT_TEXT — no real
  # JSON parsing, so this is portable to awk without the escaping risk that
  # keeps the is_error/session_id/result parse above on python3/Go.
  awk -v start="@@@CANON_HEADLESS_REPORT:${tag}@@@" -v end="@@@CANON_HEADLESS_REPORT:/${tag}@@@" '
    $0 == end {
      if (started) { found_end = 1 }
      exit
    }
    started { n++; buf[n] = $0; next }
    $0 == start { started = 1 }
    END {
      if (!started || !found_end) exit 1
      first = 1; last = n
      while (first <= last && buf[first] == "") first++
      while (last >= first && buf[last] == "") last--
      if (first > last) { print ""; exit }
      for (i = first; i <= last; i++) print buf[i]
    }
  ' <<< "$RESULT_TEXT"
}

# In bugfix mode the reviewer is intentionally not dispatched, so there is no
# reviewer block to extract — skip it (a missing block here is expected, not a warning).
if [[ "$BUGFIX" -eq 0 ]]; then
  if REVIEW_CONTENT="$(extract_report reviewer)"; then
    printf '%s' "$REVIEW_CONTENT" > "$TDIR/review-notes.md"
  else
    echo "Warning: could not extract the reviewer's report from headless output — review-notes.md not persisted." >&2
  fi
fi

if EVAL_CONTENT="$(extract_report evaluator)"; then
  printf '%s' "$EVAL_CONTENT" > "$TDIR/eval-report.md"
else
  echo "Warning: could not extract the evaluator's report from headless output — eval-report.md not persisted." >&2
fi

if echo "$RESULT_TEXT" | grep -q '^HEADLESS_VERDICT: PASS$'; then
  exit 0
elif echo "$RESULT_TEXT" | grep -q '^HEADLESS_VERDICT: FAIL$'; then
  exit 1
else
  echo "Error: no HEADLESS_VERDICT line found in output. Hard-failing (ambiguous result)." >&2
  exit 1
fi
