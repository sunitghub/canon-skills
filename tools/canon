#!/usr/bin/env bash
# canon — the single-window Canon Cockpit shell (t-9917, Phase 1; renamed from its old name in t-03a8).
# Launch ONCE; it opens the Cockpit landing (registered projects). A second
# launch does NOT start a second server — it just opens the already-running
# window's URL (single-instance on a fixed port).
#
# Unlike `sprint-check` (one board per project, per cwd), canon is
# project-agnostic: it serves the shell + the project registry, and you open
# projects from within it. See tools/canon-go/internal/board/main.go registry*.

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real file location.
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
# shellcheck source=cockpit-launch-lib.sh
source "$SCRIPT_DIR/cockpit-launch-lib.sh"
source "$SCRIPT_DIR/ticket-root.sh"   # t-b2ff: folder_guard_reason, require_project_folder

usage() {
  cat <<'EOF'
canon — the single-window Canon Cockpit shell

Usage:
  canon                    Open the Cockpit (registered projects); single-instance
  canon <port>             Use a specific port (default 8899)
  canon status [--json]    Board and daemon state, version, sessions by state
  canon sessions [--json]  Every live agent session across projects
  canon stop [--force]     Stop the cockpit daemon and the board (--force ends live sessions)
  canon restart [--force]  Restart the cockpit daemon (--force ends live sessions)
  canon wait <id> --until <state>[,<state>...] [--timeout MS] [--project PATH] [--json]
                           Block until a session (ticket or scratch id) is in a state:
                           needs-you, working, done, idle, or exited. Exit 0 when
                           reached, 1 on timeout, 2 on bad input or no board.
  canon update             Move this canon install to the latest verified release (checked
                           against the published manifest; it refuses, changing nothing, if
                           that cannot be done, or if the install has uncommitted changes or
                           local commits, or while its Cockpit runs: canon stop first; a new
                           release goes into its own folder and a failed one leaves the
                           running version untouched), then run `skills.sh refresh` on every project
                           registered in the Cockpit. An install that follows main (see --to
                           main) fast-forwards main instead. A Windows install without git
                           (the one-line installer) is updated by re-running that installer.
  canon update --to <vX.Y.Z|latest|main>
                           Install that release now (the way back from a bad update; the next
                           plain update moves to the latest again), the latest release, or
                           main: the development version (the newest changes, not yet
                           released), which a plain update keeps following until `--to latest`.
  canon uninstall [--dry-run] [--yes] [--keep-data] [--force]
                           Remove canon from this machine: shows a plan, asks, stops the daemon,
                           cleans every registered project, deletes the Cockpit data (unless
                           --keep-data) and the install folder (a dirty or unpushed git clone is
                           never deleted), and on Windows the user PATH entry. --dry-run changes
                           nothing; with no terminal and no --yes it only prints the plan.
  canon log verify         Check the activity log (~/.canon/events) against its day seals: one
                           line per day, intact, broken, missing or unsealed; exit 1 if any day is
                           broken or missing. A seal shows a day was not changed after it was
                           sealed, not who wrote it.
  canon log seal           Seal every closed day not sealed yet (the daemon and the first event of
                           each day do this too).
  canon completion <bash|zsh|powershell>
                           Print a completion script. bash: eval "$(canon completion bash)"
                           in ~/.bashrc; zsh: eval "$(canon completion zsh)" in ~/.zshrc
                           (after compinit); PowerShell: canon completion powershell |
                           Out-String | Invoke-Expression in $PROFILE
  canon --version          Print the installed canon version
  canon --help             Show this help

Launch once and work from within it. A second launch focuses the running
window instead of starting a second server. Set CANON_COCKPIT_PORT to change
the default port. status/sessions/stop/restart talk to the running board and
never need or print a session token.
EOF
}

# Refresh every project registered in the Cockpit; exit 1 if any refresh failed.
refresh_projects() {
  local registry="${CANON_HOME:-$HOME/.canon}/cockpit/projects.json"
  [ -f "$registry" ] || { echo "No Cockpit projects registered — nothing to refresh."; exit 0; }
  local failed=0 raw p outfile rc; outfile="$(mktemp)"
  # The board writes this file: pull each "path" string and undo JSON escaping (\\, \", \/).
  while IFS= read -r raw; do
    p="${raw#*\"path\"}"; p="${p#*\"}"; p="${p%\"}"
    p="${p//\\\"/\"}"; p="${p//\\\//\/}"; p="${p//\\\\/\\}"
    [ -n "$p" ] || continue
    if [ ! -d "$p" ]; then echo "  skipped (folder missing): $p"; continue; fi
    # SKILLS_SH_NO_TTY: a bulk refresh must not stop to ask each project the permission-rule questions.
    # Output goes to a file, not $(...): a command substitution waits for every process holding its pipe, so a
    # background process left by skills.sh would hang the update. stdin is closed for the same reason.
    # A static line, not animated dots: a background loop forking beside skills.sh deadlocked Git Bash on
    # Windows ARM64 (live: the refresh froze after 5 dots). Each project takes ~10s there.
    [ -t 1 ] && printf '  refreshing %s (please wait)...\n' "$p"
    SKILLS_SH_NO_TTY=1 "$SCRIPT_DIR/skills.sh" refresh "$p" >"$outfile" 2>&1 </dev/null && rc=0 || rc=$?
    if [ "$rc" = 0 ]; then echo "  refreshed: $p"
    elif grep -q "No canon skills registered" "$outfile"; then echo "  skipped (no skills installed): $p"
    else echo "  refresh FAILED: $p (run: skills.sh refresh \"$p\")"; echo "    $(tail -n 1 "$outfile")"; failed=1; fi
  done < <(grep -oE '"path"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' "$registry")
  rm -f "$outfile"
  exit "$failed"
}

# A folder with no .git is a zip install. On Windows the one-line installer updates it in place (it keeps
# cockpit\); exec hands over to PowerShell first so the running script is never overwritten under bash.
update_without_git() {
  local repo="$1" to="${2:-}" url="https://raw.githubusercontent.com/sunitghub/canon-skills/main/install.ps1" setref=""
  # t-30fc: `to` was validated (latest, main or vN.N.N) by update_cmd; the installer reads it from CANON_REF and fetches that tag's zip.
  [ -z "$to" ] || setref="\$env:CANON_REF='$to'; "
  if _is_windows && [ "$repo" = "$(cygpath -u "$USERPROFILE\\.canon" 2>/dev/null)" ]; then
    echo "Updating canon by re-running the installer..."
    # </dev/null: with the console's stdin inherited, the nested canon.cmd -> bash refresh hung (live-reproduced).
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \
      "${setref}irm $url | iex; if (\$? -and -not \$global:CanonInstallFailed) { Write-Host '==> Refreshing your projects (this can take a moment)'; & '$(cygpath -w "$SCRIPT_DIR/canon.cmd")' update --refresh-only }" </dev/null
  fi
  if _is_windows; then
    echo "canon update: $repo isn't the installer's folder (%USERPROFILE%\\.canon) — re-run the installer to update the copy there." >&2
  else
    echo "canon update: $repo isn't a git clone — reinstall with: curl -fsSL https://raw.githubusercontent.com/sunitghub/canon-skills/main/install.sh | bash" >&2
  fi
  exit 1
}

# t-d744: what an install on the main track is told, in plain words. install.ps1 prints the same two lines (it downloads the zip and
# never runs canon update, so it keeps its own copy); install.sh runs canon update and leaves the notice to it (t-bb84).
# tests/doc-update-behavior.sh checks both. With a label, the first line is `canon version`'s own.
main_track_note() {
  if [ -n "${1:-}" ]; then echo "$1 (development version, following main)"
  else echo "You're on the development version (main): the newest changes, before they're released and without a release's verification."; fi
  echo "For the latest release instead, run: canon update --to latest"
}

# t-50f7: the folder that holds this install's data and its .canon-track marker. In the versioned layout this script runs from
# <home>/packages/<name>/tools (SCRIPT_DIR is physical), so the home is two levels above the package; a clone is its own home. A folder
# named packages is the layout only when the home has its current link (as every other detector requires), or for the fresh install's
# bootstrap clone (packages/.boot.*), which runs before current exists: a developer clone at <any>/packages/<x> stays a clone.
install_home() {
  local r h; r="$(cd "$SCRIPT_DIR/.." && pwd)"; h="$(dirname "$(dirname "$r")")"
  if [ "$(basename "$(dirname "$r")")" = packages ] && { [ -L "$h/current" ] || case "$(basename "$r")" in .boot.*) true ;; *) false ;; esac; }; then
    printf '%s\n' "$h"
  else printf '%s\n' "$r"; fi
}

# t-50f7: the first refusal of an update in the layout and of the move into it (pkg-lib.sh sourced): it never stops or restarts anything.
refuse_while_cockpit_runs() {
  local running; running="$(pkg_running "$1")"
  if [ -n "$running" ]; then
    echo "canon update: this install's Cockpit is running ($running). Run 'canon stop', then run canon update again. Nothing was changed." >&2; exit 1
  fi
}

# t-50f7: a single-tree install (the clone at the canon home that install.sh made before the versioned layout) moves into it: every entry but
# the data goes into packages/<name> (the release tag it is on, or main), current points there, and <home>/tools becomes a link to
# current/tools so a PATH line naming <home>/tools keeps working. The data stays in place, byte for byte. The entries are renamed, never
# rewritten, so this running script keeps reading the same file; the run ends by exec'ing current's canon to re-point every registered
# project. Any failed step moves everything back and exits 1.
migrate_to_packages() {
  local home="$1" name="$2" to="$3" pk="$1/packages" stage="" e n made_pk=0 why=""
  # shellcheck source=pkg-lib.sh
  source "$SCRIPT_DIR/pkg-lib.sh"
  refuse_while_cockpit_runs "$home"
  pkg_lock "$home" || { echo "canon update: $PKG_ERR. Nothing was changed." >&2; exit 1; }
  trap 'pkg_unlock' EXIT
  if [ -e "$pk" ] || [ -e "$home/current" ] || [ -L "$home/current" ]; then
    echo "canon update: $home already has packages/ or current but is not in the versioned layout; move them aside and run this again. Nothing was changed." >&2; exit 1
  fi
  echo "Moving canon in $home into the versioned layout (packages/$name, current); your data stays where it is..."
  _migrate_back() {
    [ ! -L "$home/tools" ] || rm -f -- "$home/tools"
    [ ! -L "$home/current" ] || rm -f -- "$home/current"
    [ -z "$stage" ] || [ -d "$stage" ] || stage="$pk/$name"
    # everything in the stage goes back, not a list of what was moved: an interrupt runs this after the mv in flight has finished
    if [ -n "$stage" ]; then
      for e in "$stage"/* "$stage"/.[!.]* "$stage"/..?*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        mv -- "$e" "$home/" || echo "canon update: could not move $e back into $home" >&2
      done
    fi
    [ -z "$stage" ] || rmdir -- "$stage" 2>/dev/null || true
    [ "$made_pk" = 0 ] || rmdir -- "$pk" 2>/dev/null || true
    trap - INT TERM HUP
    echo "canon update: could not move $home into the versioned layout ($why); everything was moved back. Nothing was changed." >&2
    exit 1
  }
  # an interrupt (Ctrl+C, a closed terminal, a TERM) mid-move puts everything back too; bash runs it once the current mv has finished
  trap 'why="interrupted"; _migrate_back' INT TERM HUP
  mkdir -- "$pk" && made_pk=1 || { why="could not create $pk"; _migrate_back; }
  stage="$(mktemp -d "$pk/.tmp-migrate.XXXXXX")" || { stage=""; why="could not create a temp folder in $pk"; _migrate_back; }
  for e in "$home"/* "$home"/.[!.]* "$home"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    n="$(basename "$e")"
    case "$n" in packages|.update.lock) continue ;; esac
    ! pkg_is_data "$n" || continue
    mv -- "$e" "$stage/" || { why="could not move $n"; _migrate_back; }
  done
  mv -- "$stage" "$pk/$name" || { why="could not rename the new package"; _migrate_back; }
  stage="$pk/$name"
  pkg_flip "$home" "$name" 1 || { why="$PKG_ERR"; _migrate_back; }
  pkg_compat_tools "$home" || { why="could not link $home/tools"; _migrate_back; }
  trap - INT TERM HUP
  echo "canon is now in $home/packages/$name; $home/current points at it, and $home/tools leads there for an existing PATH line."
  [ -z "$to" ] || [ "$to" = "$name" ] || echo "To move to $to, run: canon update --to $to"
  pkg_unlock; trap - EXIT
  exec bash "$home/current/tools/canon" update --refresh-only
}

# t-50f7: update an install in the versioned layout (tools/pkg-lib.sh). A release becomes a new package from its verified zip and `current`
# flips to it; a release already in packages/ is a repoint (no download); main is a git clone in packages/main, pulled in place. The running
# package is never written, and a failure at any step leaves `current` where it was. It refuses while this install's Cockpit runs: it never
# stops or restarts anything. Ends by handing the project refresh to the package `current` now names (exec), so it never returns.
update_packages() {
  local home="$1" repo="$2" to="$3" marker="$1/.canon-track" cur hint="" msg
  # shellcheck source=pkg-lib.sh
  source "$SCRIPT_DIR/pkg-lib.sh"
  refuse_while_cockpit_runs "$home"
  pkg_lock "$home" || { echo "canon update: $PKG_ERR. Nothing was changed." >&2; exit 1; }
  trap 'pkg_unlock' EXIT
  [ -z "$PKG_NOTE" ] || echo "canon update: $PKG_NOTE."
  pkg_sweep "$home"
  cur="$(pkg_current "$home")" || cur=""
  if [ -z "$to" ]; then
    if [ "$({ tr -d '[:space:]' < "$marker"; } 2>/dev/null)" = main ]; then to=main; else to=latest; fi
  fi
  if [ "$to" = main ]; then
    local m="$home/packages/main" before="" after url branch dirty
    if [ -d "$m" ]; then
      # [ -e .git ], not git -C: a home inside another repository (a dotfiles home) would answer for it
      [ -e "$m/.git" ] || { echo "canon update: $m isn't a git clone. Nothing was changed." >&2; exit 1; }
      dirty="$(git -C "$m" status --porcelain)"
      if [ -n "$dirty" ]; then
        echo "canon update: $m has uncommitted changes — commit or stash them first. Nothing was changed." >&2
        printf '%s\n' "$dirty" | sed -n '1,10s/^/  /p' >&2
        exit 1
      fi
      branch="$(git -C "$m" rev-parse --abbrev-ref HEAD)"
      [ "$branch" = main ] || { echo "canon update: $m is on '$branch', not main — switch to main first. Nothing was changed." >&2; exit 1; }
      before="$(git -C "$m" rev-parse --short HEAD)"
      git -C "$m" pull --ff-only --quiet || { echo "canon update: $m can't fast-forward (local commits, or no upstream). Nothing was changed." >&2; exit 1; }
    else
      # the remote this code came from when it is a clone (the installer's bootstrap clone), else the published repository
      url=""; [ ! -e "$repo/.git" ] || url="$(git -C "$repo" remote get-url origin 2>/dev/null)" || url=""
      [ -n "$url" ] || url="${CANON_REPO:-https://github.com/sunitghub/canon-skills.git}"
      local t; t="$(mkdir -p "$home/packages" && mktemp -d "$home/packages/.tmp-main.XXXXXX")" || { echo "canon update: could not create a temp folder in $home/packages. Nothing was changed." >&2; exit 1; }
      if ! git clone -q --depth 1 -- "$url" "$t" || ! mv -- "$t" "$m"; then
        rm -rf -- "$t"; echo "canon update: could not clone main from $url. Nothing was changed." >&2; exit 1
      fi
    fi
    after="$(git -C "$m" rev-parse --short HEAD)"
    bash "$m/tools/fetch-daemon.sh" --quiet || echo "canon update: a prebuilt binary is missing or stale (see above); the Cockpit needs it." >&2
    pkg_flip "$home" main || { echo "canon update: $PKG_ERR. current still points at ${cur:-nothing}." >&2; exit 1; }
    printf 'main\n' > "$marker" 2>/dev/null || true
    if [ "$cur" = main ] && [ "$before" = "$after" ]; then echo "canon is up to date ($after)."
    elif [ "$cur" = main ]; then echo "canon updated $before..$after."
    else echo "canon now follows main ($after)."; fi
    main_track_note
  else
    if [ "$to" = latest ]; then
      local lf; lf="$(bash "$SCRIPT_DIR/release-manifest.sh" --latest)" \
        || { echo "canon update: Nothing was changed. 'canon update --to main' follows main and needs no manifest." >&2; exit 1; }
      read -r to _ <<<"$lf"
      hint=" 'canon update --to main' follows main and needs no manifest."
    fi
    if [ -d "$home/packages/$to" ]; then
      # a package is renamed into place only when complete and verified, so one that is there is a repoint: nothing is downloaded
      [ -f "$home/packages/$to/tools/canon" ] || { echo "canon update: $home/packages/$to is not a complete package; remove it and run this again. Nothing was changed." >&2; exit 1; }
      if [ "$cur" = "$to" ]; then msg="canon is up to date ($to, verified against the published manifest)."
      else msg="canon is now on $to (already installed; nothing was downloaded)."; fi
    else
      # t-34f1: a release is installed only if the published manifest lists it; the zip must hash to the manifest's value
      local mf zipsha
      mf="$(bash "$SCRIPT_DIR/release-manifest.sh" "$to")" || { echo "canon update: Nothing was changed.$hint" >&2; exit 1; }
      read -r zipsha _ <<<"$mf"
      echo "Downloading canon $to..."
      pkg_install "$home" "$to" "$zipsha" || { echo "canon update: $PKG_ERR. Nothing was changed.$hint" >&2; exit 1; }
      msg="canon is now on $to, verified against the published manifest."
    fi
    pkg_flip "$home" "$to" || { echo "canon update: $PKG_ERR. current still points at ${cur:-nothing}." >&2; exit 1; }
    rm -f "$marker"
    echo "$msg"
  fi
  pkg_compat_tools "$home" || echo "canon update: could not create the link $home/tools -> current/tools; use $home/current/tools instead." >&2
  pkg_prune "$home" "$cur"
  pkg_unlock; trap - EXIT
  # the refresh runs the new package's code (its skills.sh), not this one's
  exec bash "$home/current/tools/canon" update --refresh-only
}

# t-e3d2: update the canon install, then refresh every Cockpit project. The install is often
# also a development checkout, so anything but a clean fast-forward on main is refused —
# never merged or stashed.
# --refresh-only is internal: the Windows zip update hands over to PowerShell (the installer cannot overwrite this
# running script), which then calls it to do just the project refresh. It is deliberately left out of --help.
update_cmd() {
  local refresh_only=0 to="" re='^v[0-9]+\.[0-9]+\.[0-9]+$'
  [[ "${1:-}" == --refresh-only ]] && { refresh_only=1; shift; }
  # t-30fc: --to installs a release tag (or main). The value reaches git arguments and an installer URL.
  # t-65c9: a plain update follows the latest verified release; `--to main` is the opt-in development track, remembered in .canon-track.
  if [[ "${1:-}" == --to ]]; then
    [[ $# -eq 2 && "$refresh_only" = 0 ]] || { echo "canon update: --to takes latest, main or a release tag like v0.3.0" >&2; exit 2; }
    to="$2"; shift 2
    [[ "$to" == main || "$to" == latest || "$to" =~ $re ]] || { echo "canon update: --to takes latest, main or a release tag like v0.3.0 (got '$to')" >&2; exit 2; }
  fi
  [[ $# -eq 0 ]] || { echo "canon update takes no arguments (except --refresh-only, --to <ref>)" >&2; exit 2; }
  local repo; repo="$(cd "$SCRIPT_DIR/.." && pwd)"
  if [ "$refresh_only" = 1 ]; then refresh_projects; fi
  local home; home="$(install_home)"
  if [ "$home" != "$repo" ]; then update_packages "$home" "$repo" "$to"; fi
  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    update_without_git "$repo" "$to"
  fi
  local dirty; dirty="$(git -C "$repo" status --porcelain)"
  if [ -n "$dirty" ]; then
    echo "canon update: $repo has uncommitted changes — commit or stash them first. Nothing was changed." >&2
    printf '%s\n' "$dirty" | sed -n '1,10s/^/  /p' >&2
    exit 1
  fi
  local branch before after pinned="" marker="$repo/.canon-track" track=release legacy=0 was_on="" hint=""
  if [ "$({ tr -d '[:space:]' < "$marker"; } 2>/dev/null)" = main ]; then track=main; fi
  branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
  if [ "$branch" = HEAD ]; then   # detached: an install on a release tag (t-30fc)
    if pinned="$(git -C "$repo" describe --tags --exact-match HEAD 2>/dev/null)"; then was_on="$pinned"
    else
      # not on a tag: checking anything out would leave any commit made here reachable only from the reflog (review of t-65c9)
      pinned="$(git -C "$repo" rev-parse --short HEAD)"
      if [ -z "$to" ]; then   # an explicit --to is the user's choice to leave it; a plain update must not decide that
        echo "canon update: $repo is on a detached commit ($pinned) that is not a release tag; its commits would be left behind. Check out main or a release first (git switch main), or run 'canon update --to <vX.Y.Z|latest|main>' to leave it on purpose. Nothing was changed." >&2; exit 1
      fi
    fi
  elif [ "$branch" != main ]; then
    echo "canon update: $repo is on '$branch', not main — switch to main first. Nothing was changed." >&2; exit 1
  fi
  # t-50f7: the clone at the canon home (what install.sh made before the versioned layout), on a release tag or following main, clean and with
  # no work only it holds, moves into the layout. A clone anywhere else, or one with local work, is a developer's and keeps working as one.
  if ! _is_windows && [ "$repo" = "$(cd "${CANON_HOME:-$HOME/.canon}" 2>/dev/null && pwd -P)" ] \
    && { [ -n "$was_on" ] || { [ "$branch" = main ] && [ "$track" = main ]; }; } \
    && [ -z "$(git -C "$repo" rev-list -n 1 --branches --not --remotes 2>/dev/null)" ] \
    && ! git -C "$repo" rev-parse -q --verify refs/stash >/dev/null 2>&1 \
    && [ "$(git -C "$repo" worktree list --porcelain 2>/dev/null | grep -c '^worktree ')" = 1 ]; then
    if [ -n "$was_on" ]; then migrate_to_packages "$repo" "$was_on" "$to"; else migrate_to_packages "$repo" main "$to"; fi
  fi
  # What to install: an explicit --to wins; otherwise the remembered track (release unless the user chose main).
  if [ -z "$to" ]; then
    if [ "$track" = main ]; then to=main; else to=latest; fi
    # an install that is on branch main with no marker was made before releases were the default: it moves to the latest release (t-65c9)
    if [ "$to" = latest ] && [ "$branch" = main ]; then legacy=1; fi
  fi
  if [ "$to" != main ] && [ "$branch" = main ]; then
    # moving a main checkout to a release must not strand local commits
    local ahead; ahead="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null)" || ahead="$(git -C "$repo" rev-list --count origin/main..HEAD 2>/dev/null)" || ahead=0
    if [ "${ahead:-0}" != 0 ]; then
      echo "canon update: $repo has $ahead local commit(s) on main that a release would leave behind. Run 'canon update --to main' to keep following main. Nothing was changed." >&2; exit 1
    fi
  fi
  if [ "$to" = latest ]; then
    # t-65c9: the newest release in the published manifest, verified below like any --to <tag>; unreachable or unreadable refuses, changing nothing.
    local lf; lf="$(bash "$SCRIPT_DIR/release-manifest.sh" --latest)" \
      || { echo "canon update: Nothing was changed. 'canon update --to main' follows main and needs no manifest." >&2; exit 1; }
    read -r to _ <<<"$lf"
    hint=" 'canon update --to main' follows main and needs no manifest."
  fi
  if [ -n "$to" ] && [ "$to" != main ]; then
    # t-34f1: a release is installed only if the published manifest (getcanon.dev, a different write path from this repo) lists it, and the
    # tag's commit is the one the manifest names. The manifest is read first so a refusal fetches nothing; release-manifest.sh says why.
    local mf mf_commit fetched=0 have
    mf="$(bash "$SCRIPT_DIR/release-manifest.sh" "$to")" || { echo "canon update: Nothing was changed.$hint" >&2; exit 1; }
    read -r _ mf_commit <<<"$mf"
    if ! git -C "$repo" rev-parse -q --verify "refs/tags/$to^{commit}" >/dev/null 2>&1; then
      # a depth-1 clone has no tags: ask for just this one
      git -C "$repo" fetch -q --depth 1 origin "refs/tags/$to:refs/tags/$to" \
        || { echo "canon update: release $to was not found on origin (or the fetch failed, see above). Nothing was changed.$hint" >&2; exit 1; }
      fetched=1
    fi
    have="$(git -C "$repo" rev-parse "refs/tags/$to^{commit}")"
    if [ "$have" != "$mf_commit" ]; then
      [ "$fetched" = 0 ] || git -C "$repo" tag -d "$to" >/dev/null 2>&1
      echo "canon update: release $to is at $have but the published manifest says $mf_commit; refusing to install it. Nothing was changed. If $to is a stale tag of yours, remove it (git tag -d $to) and run this again.$hint" >&2; exit 1
    fi
  fi
  before="$(git -C "$repo" rev-parse --short HEAD)"
  # t-9383: the Windows exes are no longer committed, so a pull from the commit that dropped them deletes the old ones.
  # Keep them aside until the fetch has put verified ones back, so a failed fetch never leaves the install without a board or daemon.
  local bak=""
  if _is_windows; then bak="$(mktemp -d "${TMPDIR:-/tmp}/canon-update-bak.XXXXXX")"; cp -p "$SCRIPT_DIR"/*-win.exe "$bak/" 2>/dev/null || true; fi
  if [ -n "$to" ] && [ "$to" != main ]; then
    if ! git -C "$repo" -c advice.detachedHead=false checkout -q --detach "refs/tags/$to"; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: could not check out $to. Nothing was changed." >&2; exit 1
    fi
  else
    if [ -n "$pinned" ] && ! git -C "$repo" checkout -q main; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: could not switch back to main. Nothing was changed." >&2; exit 1
    fi
    if ! git -C "$repo" pull --ff-only --quiet; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: $repo can't fast-forward (local commits, or no upstream). Nothing was changed." >&2; exit 1
    fi
  fi
  after="$(git -C "$repo" rev-parse --short HEAD)"
  if [ -n "$to" ] && [ "$to" != main ]; then
    rm -f "$marker"
    if [ "$was_on" = "$to" ]; then echo "canon is up to date ($to, verified against the published manifest)."
    else echo "canon is now on $to ($after), verified against the published manifest."; fi
    if [ "$legacy" = 1 ]; then echo "This install was following main. canon now follows verified releases by default; to follow main again: canon update --to main"; fi
  else
    printf 'main\n' > "$marker" 2>/dev/null || true
    if [ "$before" = "$after" ]; then echo "canon is up to date ($after)."; else echo "canon updated $before..$after."; fi
    main_track_note
  fi
  bash "$SCRIPT_DIR/fetch-daemon.sh" --quiet || echo "canon update: a prebuilt binary is missing or stale (see above); the Cockpit needs it." >&2
  if [ -n "$bak" ]; then
    local f
    for f in "$bak"/*-win.exe; do
      [ -e "$f" ] || continue
      if [ ! -e "$SCRIPT_DIR/$(basename "$f")" ]; then
        cp -p "$f" "$SCRIPT_DIR/" && echo "canon update: kept your previous $(basename "$f") (the fetch did not replace it)." >&2
      fi
    done
    rm -rf "$bak"
  fi
  # t-9383: on Windows the board and the daemon exe are required (install.ps1 fails the same way): an update that leaves one missing is not a success.
  if _is_windows; then
    local missing="" n
    for n in cockpit-daemon-win.exe sprint-check-win.exe; do [ -f "$SCRIPT_DIR/$n" ] || missing="$missing $n"; done
    if [ -n "$missing" ]; then
      echo "canon update: these programs are missing and could not be fetched:$missing. Check your internet connection and run canon update again; canon cannot start without them." >&2
      exit 1
    fi
  fi
  refresh_projects
}

completion_bash() {
  cat <<'COMP'
_canon() {
  local cur prev w
  cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[COMP_CWORD-1]}"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "status sessions stop restart wait update uninstall log completion version help" -- "$cur")); return
  fi
  case "$prev" in
    --until) COMPREPLY=($(compgen -W "needs-you working done idle exited" -- "$cur")); return ;;
    --project) COMPREPLY=($(compgen -d -- "$cur")); return ;;
    --timeout) COMPREPLY=(); return ;;
  esac
  case "${COMP_WORDS[1]}" in
    status|sessions) w="--json" ;;
    stop|restart) w="--force" ;;
    wait) w="--until --timeout --project --json" ;;
    completion) w="bash zsh powershell" ;;
    log) w="verify seal" ;;
    uninstall) w="--dry-run --yes --keep-data --force" ;;
    *) w="" ;;
  esac
  COMPREPLY=($(compgen -W "$w" -- "$cur"))
}
complete -F _canon canon
COMP
}

completion_powershell() {
  cat <<'COMP'
Register-ArgumentCompleter -Native -CommandName canon, canon.cmd -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $el = @($commandAst.CommandElements | ForEach-Object { $_.ToString() })
  $n = $el.Count
  $pos = if ($wordToComplete) { $n - 1 } else { $n }
  $prev = if ($pos -ge 1) { $el[$pos - 1] } else { '' }
  $sub = if ($n -ge 2 -and $pos -gt 1) { $el[1] } else { '' }
  $cands = if ($pos -eq 1) { 'status','sessions','stop','restart','wait','update','uninstall','log','completion','version','help' }
    elseif ($prev -eq '--until') { 'needs-you','working','done','idle','exited' }
    else { switch ($sub) {
      'status' { '--json' } 'sessions' { '--json' } 'stop' { '--force' } 'restart' { '--force' }
      'wait' { '--until','--timeout','--project','--json' } 'completion' { 'bash','zsh','powershell' } 'log' { 'verify','seal' } 'uninstall' { '--dry-run','--yes','--keep-data','--force' }
      default { @() } } }
  $cands | Where-Object { $_ -like "$wordToComplete*" } |
    ForEach-Object { [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_) }
}
COMP
}

completion_cmd() {
  case "${1:-}" in
    bash) completion_bash ;;
    zsh) echo 'autoload -U +X bashcompinit && bashcompinit'; completion_bash ;;
    powershell) completion_powershell ;;
    *) echo "canon completion: choose bash, zsh or powershell" >&2; exit 2 ;;
  esac
}

# t-3137: the activity log's seals. An older board takes an unknown first word for a port and would serve, so ask --help first.
log_cmd() {
  local b h; b="$(board_bin)"; h="$("$b" --help 2>/dev/null)" || h=""
  case "$h" in *"log verify"*) ;; *) echo "canon log: the board binary ($b) is older than this command; run canon update." >&2; exit 1 ;; esac
  exec "$b" log "$@"
}

# t-180d: poll the board for one session's state (it answers with the state word, so no
# JSON parsing here) until it's one of the wanted ones. Exit 0 reached, 1 timeout, 2 usage.
wait_cmd() {
  local id="${1:-}"; shift || true
  local until="" timeout="" root="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --until) until="${2:-}"; shift 2 || { echo "canon wait: --until needs a value" >&2; exit 2; } ;;
      --timeout) timeout="${2:-}"; shift 2 || { echo "canon wait: --timeout needs a value" >&2; exit 2; } ;;
      --project) root="${2:-}"; shift 2 || { echo "canon wait: --project needs a path" >&2; exit 2; } ;;
      --json) json=1; shift ;;
      *) echo "canon wait: unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [[ "$id" =~ ^[ts]-[a-z0-9]{4}$ ]] || { echo "canon wait: expected a ticket or scratch id (t-xxxx or s-xxxx), got '$id'" >&2; exit 2; }
  [[ -n "$until" ]] || { echo "canon wait: --until <state> is required" >&2; exit 2; }
  local st
  for st in ${until//,/ }; do
    case "$st" in needs-you|working|done|idle|exited) ;; *) echo "canon wait: unknown state '$st' (needs-you, working, done, idle, exited)" >&2; exit 2 ;; esac
  done
  [[ -z "$timeout" || "$timeout" =~ ^[0-9]+$ ]] || { echo "canon wait: --timeout is milliseconds, got '$timeout'" >&2; exit 2; }
  local port="${CANON_COCKPIT_PORT:-8899}"
  local base="http://127.0.0.1:$port"
  curl -s -o /dev/null --max-time 3 "$base/api/version" || { echo "Canon isn't running on port $port — start it with: canon" >&2; exit 2; }
  local q=(--data-urlencode "id=$id")
  [[ -n "$root" ]] && q+=(--data-urlencode "root=$root")
  local start=$SECONDS now
  while :; do
    if ! now="$(curl -sfG --max-time 10 "${q[@]}" --data format=state "$base/api/cockpit-sessions")"; then
      echo "The board on port $port doesn't support 'canon wait' (it predates it, or failed) — restart it: close its window, then run canon." >&2
      exit 2
    fi
    if [[ ",$until," == *",$now,"* ]]; then
      if [[ "$json" -eq 0 ]]; then echo "$now"
      elif [[ "$now" == exited ]]; then printf '{"ticket": "%s", "state": "exited"}\n' "$id"
      else
        local row; row="$(curl -sfG --max-time 10 "${q[@]}" "$base/api/cockpit-sessions")" || row="[]"
        [[ "$row" == \[\{*\}\] && "$row" != *'},{'* && "$row" != *'}, {'* ]] && row="${row:1:${#row}-2}"
        printf '%s\n' "$row"
      fi
      exit 0
    fi
    if [[ -n "$timeout" ]] && (( (SECONDS - start) * 1000 >= timeout )); then
      echo "canon wait: timed out after ${timeout}ms — $id is $now" >&2
      exit 1
    fi
    sleep 1
  done
}

# canon stop ends the board too, once the daemon is down: the same verified stop canon uninstall uses (tools/cockpit-stop-lib.sh), so only a
# board that belongs to THIS install is signalled; any other listener on the port is left alone and named.
stop_board() {
  INSTALL="$(cd "$SCRIPT_DIR/.." && pwd -P)"; PORT="$1"
  board_up() { curl -s -o /dev/null --max-time 3 "http://127.0.0.1:$PORT/api/version" 2>/dev/null; }
  # shellcheck source=platform-lib.sh
  source "$SCRIPT_DIR/platform-lib.sh"
  # shellcheck source=cockpit-stop-lib.sh
  source "$SCRIPT_DIR/cockpit-stop-lib.sh"
  probe_board
  case "$BOARD_STATUS" in
    ours)
      if stop_verified "$BOARD_PID" board; then echo "Canon stopped: the Cockpit daemon and the board."
      else echo "Cockpit daemon stopped, but the board (pid $BOARD_PID) did not exit within ${CANON_STOP_WAIT}s; Ctrl+C in the terminal running canon (or close its window) stops it." >&2; exit 1; fi ;;
    none) echo "Cockpit daemon stopped. The board had already ended." ;;
    *) echo "Cockpit daemon stopped. The board on port $PORT is not this install's, or cannot be identified, so it was left running; Ctrl+C in the terminal running canon (or close its window) stops it." ;;
  esac
}

# t-03a8: the read and control subcommands go through the running board's own API — it
# renders the text (?format=text), so this stays curl-only: no Python, no jq (a Git-only
# Windows machine has neither).
board_cmd() {
  local cmd="$1"; shift
  local json=0 force=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --force) force=1 ;;
      *) echo "Unknown option for canon $cmd: $a" >&2; exit 1 ;;
    esac
  done
  local port="${CANON_COCKPIT_PORT:-8899}"
  local base="http://127.0.0.1:$port"
  if ! curl -s -o /dev/null --max-time 3 "$base/api/version"; then
    case "$cmd" in
      stop) echo "Canon isn't running on port $port — nothing to stop."; exit 0 ;;
      *) echo "Canon isn't running on port $port — start it with: canon" >&2; exit 1 ;;
    esac
  fi
  case "$cmd" in
    status|sessions)
      local route="/api/cockpit-status"
      [[ "$cmd" == sessions ]] && route="/api/cockpit-sessions"
      [[ "$json" -eq 1 ]] || route="$route?format=text"
      local out
      # --fail: a board started before this command existed answers 404 here; say so, don't print its error page.
      if ! out="$(curl -sf --max-time 10 "$base$route")"; then
        echo "The board on port $port doesn't support 'canon $cmd' (it predates it, or failed) — restart it: close its window, then run canon." >&2
        exit 1
      fi
      printf '%s\n' "${out%$'\n'}"
      ;;
    stop|restart)
      local out
      out="$(curl -s --max-time 60 -X POST -H 'Content-Type: application/json' \
        -d "{\"force\": $([[ "$force" -eq 1 ]] && echo true || echo false)}" "$base/api/cockpit-$cmd")"
      if grep -qE '"busy": ?true' <<<"$out"; then
        local n; n="$(sed -nE 's/.*"sessions": ?([0-9]+).*/\1/p' <<<"$out")"
        echo "$n session(s) running — canon $cmd --force ends them (Save & End them first to keep their state)." >&2
        exit 1
      fi
      if [[ "$cmd" == stop ]]; then
        if grep -qE '"running": ?true' <<<"$out"; then echo "The daemon is still running — try: canon stop --force" >&2; exit 1; fi
        stop_board "$port"
      else
        if grep -qE '"restarted": ?true' <<<"$out"; then echo "Cockpit daemon restarted."
        else echo "The daemon did not restart: $out" >&2; exit 1; fi
      fi
      ;;
  esac
}

main() {
  case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
    version|--version|-V)
      v="canon $({ tr -d '[:space:]' < "$SCRIPT_DIR/../VERSION"; } 2>/dev/null || echo unknown)"
      # t-65c9: say so when this install follows main; the release track is the default and needs no note
      if [ "$({ tr -d '[:space:]' < "$(install_home)/.canon-track"; } 2>/dev/null)" = main ]; then main_track_note "$v"; else echo "$v"; fi
      exit 0 ;;
    status|sessions|stop|restart) board_cmd "$@"; exit 0 ;;
    wait) shift; wait_cmd "$@"; exit $? ;;       # t-b2ff: a subcommand never falls through to the start path and its folder guard
    update) shift; update_cmd "$@"; exit $? ;;
    uninstall) shift; exec bash "$SCRIPT_DIR/canon-uninstall.sh" "$@" ;;
    log) shift; log_cmd "$@" ;;
    completion) shift; completion_cmd "$@"; exit 0 ;;
    "") : ;;
    [0-9]*) PORT_ARG="$1" ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac

  require_project_folder canon   # t-b2ff: not from a system folder, a drive root or the home folder (before anything is fetched or started)
  local port="${PORT_ARG:-${CANON_COCKPIT_PORT:-8899}}"
  local url="http://127.0.0.1:$port/cockpit"

  # Single-instance: if something is already serving that port, assume it's the
  # Cockpit and just open its URL — never start a second server.
  if _port_in_use "$port"; then
    echo "Canon Cockpit already running on port $port — opening it." >&2
    open_browser "$url"
    exit 0
  fi

  # t-60f7/t-9383: the binaries are gitignored release assets. On Windows fetch a missing one here (never building); on
  # macOS/Linux start_cockpit_server fetches the board and the daemon at every start (t-15d8).
  if _is_windows && [[ ! -f "$SCRIPT_DIR/cockpit-daemon-win.exe" || ! -f "$SCRIPT_DIR/sprint-check-win.exe" ]]; then
    CANON_FETCH_NO_BUILD=1 bash "$SCRIPT_DIR/fetch-daemon.sh" --quiet >&2 || echo "canon: a prebuilt binary is missing; agent sessions or the board may not start until it is fetched (canon update)." >&2
  fi

  start_cockpit_server "$port" || exit 1
  trap 'kill "$SERVER_PID" 2>/dev/null; exit 0' INT TERM EXIT
  local up=0
  wait_for_board "$port" "$SERVER_PID" || up=$?
  case "$up" in
    0) ;;
    1) trap - INT TERM EXIT; echo "canon: the board exited before it was ready (its output is above)." >&2; exit 1 ;;
    *) trap - INT TERM EXIT; kill "$SERVER_PID" 2>/dev/null || true
       echo "canon: the board did not answer on port $port within $(_board_wait_secs)s." >&2; exit 1 ;;
  esac
  open_browser "$url"
  wait "$SERVER_PID"
}

main "$@"
