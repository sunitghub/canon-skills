#!/usr/bin/env bash
# canon — the single-window Canon Cockpit shell (t-9917, Phase 1; renamed from its old name in t-03a8).
# Launch ONCE; it opens the Cockpit landing (registered projects). A second
# launch does NOT start a second server — it just opens the already-running
# window's URL (single-instance on a fixed port).
#
# Unlike `sprint-check` (one board per project, per cwd), canon is
# project-agnostic: it serves the shell + the project registry, and you open
# projects from within it. See tools/sprint-check-app/server.py registry_*.

set -euo pipefail

# Resolve symlinks so SCRIPT_DIR points to the real file location.
_SOURCE="${BASH_SOURCE[0]}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
SERVER="$SCRIPT_DIR/sprint-check-app/server.py"
# shellcheck source=cockpit-launch-lib.sh
source "$SCRIPT_DIR/cockpit-launch-lib.sh"

usage() {
  cat <<'EOF'
canon — the single-window Canon Cockpit shell

Usage:
  canon                    Open the Cockpit (registered projects); single-instance
  canon <port>             Use a specific port (default 8899)
  canon status [--json]    Board and daemon state, version, sessions by state
  canon sessions [--json]  Every live agent session across projects
  canon stop [--force]     Stop the cockpit daemon (--force ends live sessions)
  canon restart [--force]  Restart the cockpit daemon (--force ends live sessions)
  canon wait <id> --until <state>[,<state>...] [--timeout MS] [--project PATH] [--json]
                           Block until a session (ticket or scratch id) is in a state:
                           needs-you, working, done, idle, or exited. Exit 0 when
                           reached, 1 on timeout, 2 on bad input or no board.
  canon update             Fast-forward this canon install (refuses if it has uncommitted
                           changes, isn't on main, or can't fast-forward), then run
                           `skills.sh refresh` on every project registered in the Cockpit
                           A Windows install without git (the one-line installer) is updated by
                           re-running that installer.
  canon update --to <vX.Y.Z|main>
                           Pin this install to a release tag (the way back from a bad update),
                           or return it to main. Plain `canon update` refuses while pinned.
  canon uninstall [--dry-run] [--yes] [--keep-data] [--force]
                           Remove canon from this machine: shows a plan, asks, stops the daemon,
                           cleans every registered project, deletes the Cockpit data (unless
                           --keep-data) and the install folder (a dirty or unpushed git clone is
                           never deleted), and on Windows the user PATH entry. --dry-run changes
                           nothing; with no terminal and no --yes it only prints the plan.
  canon completion <bash|zsh|powershell>
                           Print a completion script. bash: eval "$(canon completion bash)"
                           in ~/.bashrc; zsh: eval "$(canon completion zsh)" in ~/.zshrc
                           (after compinit); PowerShell: canon completion powershell |
                           Out-String | Invoke-Expression in $PROFILE
  canon --version          Print the installed canon version
  canon --help             Show this help

Launch once and work from within it. A second launch focuses the running
window instead of starting a second server. Set CANON_COCKPIT_PORT to change
the default port. status/sessions/stop/restart talk to the running board and
never need or print a session token.
EOF
}

# Refresh every project registered in the Cockpit; exit 1 if any refresh failed.
refresh_projects() {
  local registry="${CANON_HOME:-$HOME/.canon}/cockpit/projects.json"
  [ -f "$registry" ] || { echo "No Cockpit projects registered — nothing to refresh."; exit 0; }
  local failed=0 raw p outfile rc; outfile="$(mktemp)"
  # The board writes this file: pull each "path" string and undo JSON escaping (\\, \", \/).
  while IFS= read -r raw; do
    p="${raw#*\"path\"}"; p="${p#*\"}"; p="${p%\"}"
    p="${p//\\\"/\"}"; p="${p//\\\//\/}"; p="${p//\\\\/\\}"
    [ -n "$p" ] || continue
    if [ ! -d "$p" ]; then echo "  skipped (folder missing): $p"; continue; fi
    # SKILLS_SH_NO_TTY: a bulk refresh must not stop to ask each project the permission-rule questions.
    # Output goes to a file, not $(...): a command substitution waits for every process holding its pipe, so a
    # background process left by skills.sh would hang the update. stdin is closed for the same reason.
    # A static line, not animated dots: a background loop forking beside skills.sh deadlocked Git Bash on
    # Windows ARM64 (live: the refresh froze after 5 dots). Each project takes ~10s there.
    [ -t 1 ] && printf '  refreshing %s (please wait)...\n' "$p"
    SKILLS_SH_NO_TTY=1 "$SCRIPT_DIR/skills.sh" refresh "$p" >"$outfile" 2>&1 </dev/null && rc=0 || rc=$?
    if [ "$rc" = 0 ]; then echo "  refreshed: $p"
    elif grep -q "No canon skills registered" "$outfile"; then echo "  skipped (no skills installed): $p"
    else echo "  refresh FAILED: $p (run: skills.sh refresh \"$p\")"; echo "    $(tail -n 1 "$outfile")"; failed=1; fi
  done < <(grep -oE '"path"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' "$registry")
  rm -f "$outfile"
  exit "$failed"
}

# A folder with no .git is a zip install. On Windows the one-line installer updates it in place (it keeps
# cockpit\); exec hands over to PowerShell first so the running script is never overwritten under bash.
update_without_git() {
  local repo="$1" to="${2:-}" url="https://raw.githubusercontent.com/sunitghub/canon-skills/main/install.ps1" setref=""
  # t-30fc: `to` was validated (main or vN.N.N) by update_cmd; the installer reads it from CANON_REF and fetches that tag's zip.
  [ -z "$to" ] || setref="\$env:CANON_REF='$to'; "
  if _is_windows && [ "$repo" = "$(cygpath -u "$USERPROFILE\\.canon" 2>/dev/null)" ]; then
    echo "Updating canon by re-running the installer..."
    # </dev/null: with the console's stdin inherited, the nested canon.cmd -> bash refresh hung (live-reproduced).
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \
      "${setref}irm $url | iex; if (\$? -and -not \$global:CanonInstallFailed) { Write-Host '==> Refreshing your projects (this can take a moment)'; & '$(cygpath -w "$SCRIPT_DIR/canon.cmd")' update --refresh-only }" </dev/null
  fi
  if _is_windows; then
    echo "canon update: $repo isn't the installer's folder (%USERPROFILE%\\.canon) — re-run the installer to update the copy there." >&2
  else
    echo "canon update: $repo isn't a git clone — reinstall with: curl -fsSL https://raw.githubusercontent.com/sunitghub/canon-skills/main/install.sh | bash" >&2
  fi
  exit 1
}

# t-e3d2: update the canon install, then refresh every Cockpit project. The install is often
# also a development checkout, so anything but a clean fast-forward on main is refused —
# never merged or stashed.
# --refresh-only is internal: the Windows zip update hands over to PowerShell (the installer cannot overwrite this
# running script), which then calls it to do just the project refresh. It is deliberately left out of --help.
update_cmd() {
  local refresh_only=0 to="" re='^v[0-9]+\.[0-9]+\.[0-9]+$'
  [[ "${1:-}" == --refresh-only ]] && { refresh_only=1; shift; }
  # t-30fc: --to pins the install to a release tag, or (main) returns it. The value reaches git arguments and an installer URL.
  if [[ "${1:-}" == --to ]]; then
    [[ $# -eq 2 && "$refresh_only" = 0 ]] || { echo "canon update: --to takes main or a release tag like v0.3.0" >&2; exit 2; }
    to="$2"; shift 2
    [[ "$to" == main || "$to" =~ $re ]] || { echo "canon update: --to takes main or a release tag like v0.3.0 (got '$to')" >&2; exit 2; }
  fi
  [[ $# -eq 0 ]] || { echo "canon update takes no arguments (except --refresh-only, --to <ref>)" >&2; exit 2; }
  local repo; repo="$(cd "$SCRIPT_DIR/.." && pwd)"
  if [ "$refresh_only" = 1 ]; then refresh_projects; fi
  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    update_without_git "$repo" "$to"
  fi
  local dirty; dirty="$(git -C "$repo" status --porcelain)"
  if [ -n "$dirty" ]; then
    echo "canon update: $repo has uncommitted changes — commit or stash them first. Nothing was changed." >&2
    printf '%s\n' "$dirty" | head -10 | sed 's/^/  /' >&2
    exit 1
  fi
  local branch before after pinned=""
  branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
  if [ "$branch" = HEAD ]; then   # detached: an install pinned to a release tag (t-30fc)
    pinned="$(git -C "$repo" describe --tags --exact-match HEAD 2>/dev/null)" || pinned="$(git -C "$repo" rev-parse --short HEAD)"
    if [ -z "$to" ]; then
      echo "canon update: $repo is pinned to $pinned — run 'canon update --to main' to follow main again. Nothing was changed." >&2; exit 1
    fi
  elif [ "$branch" != main ]; then
    echo "canon update: $repo is on '$branch', not main — switch to main first. Nothing was changed." >&2; exit 1
  fi
  if [ -n "$to" ] && [ "$to" != main ]; then
    # t-34f1: a release is installed only if the published manifest (getcanon.dev, a different write path from this repo) lists it, and the
    # tag's commit is the one the manifest names. The manifest is read first so a refusal fetches nothing; release-manifest.sh says why.
    local mf mf_commit fetched=0 have
    mf="$(bash "$SCRIPT_DIR/release-manifest.sh" "$to")" || { echo "canon update: Nothing was changed." >&2; exit 1; }
    read -r _ mf_commit <<<"$mf"
    if ! git -C "$repo" rev-parse -q --verify "refs/tags/$to^{commit}" >/dev/null 2>&1; then
      # a depth-1 clone has no tags: ask for just this one
      git -C "$repo" fetch -q --depth 1 origin "refs/tags/$to:refs/tags/$to" \
        || { echo "canon update: release $to was not found on origin (or the fetch failed, see above). Nothing was changed." >&2; exit 1; }
      fetched=1
    fi
    have="$(git -C "$repo" rev-parse "refs/tags/$to^{commit}")"
    if [ "$have" != "$mf_commit" ]; then
      [ "$fetched" = 0 ] || git -C "$repo" tag -d "$to" >/dev/null 2>&1
      echo "canon update: release $to is at $have but the published manifest says $mf_commit; refusing to install it. Nothing was changed." >&2; exit 1
    fi
  fi
  before="$(git -C "$repo" rev-parse --short HEAD)"
  # t-9383: the Windows exes are no longer committed, so a pull from the commit that dropped them deletes the old ones.
  # Keep them aside until the fetch has put verified ones back, so a failed fetch never leaves the install without a board or daemon.
  local bak=""
  if _is_windows; then bak="$(mktemp -d "${TMPDIR:-/tmp}/canon-update-bak.XXXXXX")"; cp -p "$SCRIPT_DIR"/*-win.exe "$bak/" 2>/dev/null || true; fi
  if [ -n "$to" ] && [ "$to" != main ]; then
    if ! git -C "$repo" -c advice.detachedHead=false checkout -q --detach "refs/tags/$to"; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: could not check out $to. Nothing was changed." >&2; exit 1
    fi
  else
    if [ -n "$pinned" ] && ! git -C "$repo" checkout -q main; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: could not switch back to main. Nothing was changed." >&2; exit 1
    fi
    if ! git -C "$repo" pull --ff-only --quiet; then
      [ -z "$bak" ] || rm -rf "$bak"
      echo "canon update: $repo can't fast-forward (local commits, or no upstream). Nothing was changed." >&2; exit 1
    fi
  fi
  after="$(git -C "$repo" rev-parse --short HEAD)"
  if [ -n "$to" ] && [ "$to" != main ]; then echo "canon pinned to $to ($after), verified against the published manifest. Run 'canon update --to main' to follow main again."
  else
    if [ "$before" = "$after" ]; then echo "canon is up to date ($after)."; else echo "canon updated $before..$after."; fi
    echo "Note: main moves with every change and is not checksum-verified; 'canon update --to vX.Y.Z' installs a verified release."
  fi
  bash "$SCRIPT_DIR/fetch-daemon.sh" --quiet || echo "canon update: a prebuilt binary is missing or stale (see above); the Cockpit needs it." >&2
  if [ -n "$bak" ]; then
    local f
    for f in "$bak"/*-win.exe; do
      [ -e "$f" ] || continue
      if [ ! -e "$SCRIPT_DIR/$(basename "$f")" ]; then
        cp -p "$f" "$SCRIPT_DIR/" && echo "canon update: kept your previous $(basename "$f") (the fetch did not replace it)." >&2
      fi
    done
    rm -rf "$bak"
  fi
  # t-9383: on Windows the board and the daemon exe are required (install.ps1 fails the same way): an update that leaves one missing is not a success.
  if _is_windows; then
    local missing="" n
    for n in cockpit-daemon-win.exe sprint-check-win.exe; do [ -f "$SCRIPT_DIR/$n" ] || missing="$missing $n"; done
    if [ -n "$missing" ]; then
      echo "canon update: these programs are missing and could not be fetched:$missing. Check your internet connection and run canon update again; canon cannot start without them." >&2
      exit 1
    fi
  fi
  refresh_projects
}

completion_bash() {
  cat <<'COMP'
_canon() {
  local cur prev w
  cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[COMP_CWORD-1]}"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "status sessions stop restart wait update uninstall completion version help" -- "$cur")); return
  fi
  case "$prev" in
    --until) COMPREPLY=($(compgen -W "needs-you working done idle exited" -- "$cur")); return ;;
    --project) COMPREPLY=($(compgen -d -- "$cur")); return ;;
    --timeout) COMPREPLY=(); return ;;
  esac
  case "${COMP_WORDS[1]}" in
    status|sessions) w="--json" ;;
    stop|restart) w="--force" ;;
    wait) w="--until --timeout --project --json" ;;
    completion) w="bash zsh powershell" ;;
    uninstall) w="--dry-run --yes --keep-data --force" ;;
    *) w="" ;;
  esac
  COMPREPLY=($(compgen -W "$w" -- "$cur"))
}
complete -F _canon canon
COMP
}

completion_powershell() {
  cat <<'COMP'
Register-ArgumentCompleter -Native -CommandName canon, canon.cmd -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $el = @($commandAst.CommandElements | ForEach-Object { $_.ToString() })
  $n = $el.Count
  $pos = if ($wordToComplete) { $n - 1 } else { $n }
  $prev = if ($pos -ge 1) { $el[$pos - 1] } else { '' }
  $sub = if ($n -ge 2 -and $pos -gt 1) { $el[1] } else { '' }
  $cands = if ($pos -eq 1) { 'status','sessions','stop','restart','wait','update','uninstall','completion','version','help' }
    elseif ($prev -eq '--until') { 'needs-you','working','done','idle','exited' }
    else { switch ($sub) {
      'status' { '--json' } 'sessions' { '--json' } 'stop' { '--force' } 'restart' { '--force' }
      'wait' { '--until','--timeout','--project','--json' } 'completion' { 'bash','zsh','powershell' } 'uninstall' { '--dry-run','--yes','--keep-data','--force' }
      default { @() } } }
  $cands | Where-Object { $_ -like "$wordToComplete*" } |
    ForEach-Object { [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_) }
}
COMP
}

completion_cmd() {
  case "${1:-}" in
    bash) completion_bash ;;
    zsh) echo 'autoload -U +X bashcompinit && bashcompinit'; completion_bash ;;
    powershell) completion_powershell ;;
    *) echo "canon completion: choose bash, zsh or powershell" >&2; exit 2 ;;
  esac
}

# t-180d: poll the board for one session's state (it answers with the state word, so no
# JSON parsing here) until it's one of the wanted ones. Exit 0 reached, 1 timeout, 2 usage.
wait_cmd() {
  local id="${1:-}"; shift || true
  local until="" timeout="" root="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --until) until="${2:-}"; shift 2 || { echo "canon wait: --until needs a value" >&2; exit 2; } ;;
      --timeout) timeout="${2:-}"; shift 2 || { echo "canon wait: --timeout needs a value" >&2; exit 2; } ;;
      --project) root="${2:-}"; shift 2 || { echo "canon wait: --project needs a path" >&2; exit 2; } ;;
      --json) json=1; shift ;;
      *) echo "canon wait: unknown option: $1" >&2; exit 2 ;;
    esac
  done
  [[ "$id" =~ ^[ts]-[a-z0-9]{4}$ ]] || { echo "canon wait: expected a ticket or scratch id (t-xxxx or s-xxxx), got '$id'" >&2; exit 2; }
  [[ -n "$until" ]] || { echo "canon wait: --until <state> is required" >&2; exit 2; }
  local st
  for st in ${until//,/ }; do
    case "$st" in needs-you|working|done|idle|exited) ;; *) echo "canon wait: unknown state '$st' (needs-you, working, done, idle, exited)" >&2; exit 2 ;; esac
  done
  [[ -z "$timeout" || "$timeout" =~ ^[0-9]+$ ]] || { echo "canon wait: --timeout is milliseconds, got '$timeout'" >&2; exit 2; }
  local port="${CANON_COCKPIT_PORT:-8899}"
  local base="http://127.0.0.1:$port"
  curl -s -o /dev/null --max-time 3 "$base/api/version" || { echo "Canon isn't running on port $port — start it with: canon" >&2; exit 2; }
  local q=(--data-urlencode "id=$id")
  [[ -n "$root" ]] && q+=(--data-urlencode "root=$root")
  local start=$SECONDS now
  while :; do
    if ! now="$(curl -sfG --max-time 10 "${q[@]}" --data format=state "$base/api/cockpit-sessions")"; then
      echo "The board on port $port doesn't support 'canon wait' (it predates it, or failed) — restart it: close its window, then run canon." >&2
      exit 2
    fi
    if [[ ",$until," == *",$now,"* ]]; then
      if [[ "$json" -eq 0 ]]; then echo "$now"
      elif [[ "$now" == exited ]]; then printf '{"ticket": "%s", "state": "exited"}\n' "$id"
      else
        local row; row="$(curl -sfG --max-time 10 "${q[@]}" "$base/api/cockpit-sessions")" || row="[]"
        [[ "$row" == \[\{*\}\] && "$row" != *'},{'* && "$row" != *'}, {'* ]] && row="${row:1:${#row}-2}"
        printf '%s\n' "$row"
      fi
      exit 0
    fi
    if [[ -n "$timeout" ]] && (( (SECONDS - start) * 1000 >= timeout )); then
      echo "canon wait: timed out after ${timeout}ms — $id is $now" >&2
      exit 1
    fi
    sleep 1
  done
}

# t-03a8: the read and control subcommands go through the running board's own API — it
# renders the text (?format=text), so this stays curl-only: no Python, no jq (a Git-only
# Windows machine has neither).
board_cmd() {
  local cmd="$1"; shift
  local json=0 force=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --force) force=1 ;;
      *) echo "Unknown option for canon $cmd: $a" >&2; exit 1 ;;
    esac
  done
  local port="${CANON_COCKPIT_PORT:-8899}"
  local base="http://127.0.0.1:$port"
  if ! curl -s -o /dev/null --max-time 3 "$base/api/version"; then
    case "$cmd" in
      stop) echo "Canon isn't running on port $port — nothing to stop."; exit 0 ;;
      *) echo "Canon isn't running on port $port — start it with: canon" >&2; exit 1 ;;
    esac
  fi
  case "$cmd" in
    status|sessions)
      local route="/api/cockpit-status"
      [[ "$cmd" == sessions ]] && route="/api/cockpit-sessions"
      [[ "$json" -eq 1 ]] || route="$route?format=text"
      local out
      # --fail: a board started before this command existed answers 404 here; say so, don't print its error page.
      if ! out="$(curl -sf --max-time 10 "$base$route")"; then
        echo "The board on port $port doesn't support 'canon $cmd' (it predates it, or failed) — restart it: close its window, then run canon." >&2
        exit 1
      fi
      printf '%s\n' "${out%$'\n'}"
      ;;
    stop|restart)
      local out
      out="$(curl -s --max-time 60 -X POST -H 'Content-Type: application/json' \
        -d "{\"force\": $([[ "$force" -eq 1 ]] && echo true || echo false)}" "$base/api/cockpit-$cmd")"
      if grep -qE '"busy": ?true' <<<"$out"; then
        local n; n="$(sed -nE 's/.*"sessions": ?([0-9]+).*/\1/p' <<<"$out")"
        echo "$n session(s) running — canon $cmd --force ends them (Save & End them first to keep their state)." >&2
        exit 1
      fi
      if [[ "$cmd" == stop ]]; then
        if grep -qE '"running": ?true' <<<"$out"; then echo "The daemon is still running — try: canon stop --force" >&2; exit 1; fi
        echo "Cockpit daemon stopped. The board is still running; Ctrl+C in the terminal running canon (or close its window) stops it."
      else
        if grep -qE '"restarted": ?true' <<<"$out"; then echo "Cockpit daemon restarted."
        else echo "The daemon did not restart: $out" >&2; exit 1; fi
      fi
      ;;
  esac
}

main() {
  case "${1:-}" in
    help|--help|-h) usage; exit 0 ;;
    version|--version|-V) echo "canon $({ tr -d '[:space:]' < "$SCRIPT_DIR/../VERSION"; } 2>/dev/null || echo unknown)"; exit 0 ;;
    status|sessions|stop|restart) board_cmd "$@"; exit 0 ;;
    wait) shift; wait_cmd "$@" ;;
    update) shift; update_cmd "$@" ;;
    uninstall) shift; exec bash "$SCRIPT_DIR/canon-uninstall.sh" "$@" ;;
    completion) shift; completion_cmd "$@"; exit 0 ;;
    "") : ;;
    [0-9]*) PORT_ARG="$1" ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac

  local port="${PORT_ARG:-${CANON_COCKPIT_PORT:-8899}}"
  local url="http://127.0.0.1:$port/cockpit"

  # Single-instance: if something is already serving that port, assume it's the
  # Cockpit and just open its URL — never start a second server.
  if _port_in_use "$port"; then
    echo "Canon Cockpit already running on port $port — opening it." >&2
    open_browser "$url"
    exit 0
  fi

  # t-60f7: a clone has no daemon binary until it is fetched; try once, never block the board on it
  # The unix daemon is gitignored, and (t-9383) so are the Windows exes: fetch whatever is missing, never block the board on it.
  if _is_windows; then
    if [[ ! -f "$SCRIPT_DIR/cockpit-daemon-win.exe" || ! -f "$SCRIPT_DIR/sprint-check-win.exe" ]]; then
      CANON_FETCH_NO_BUILD=1 bash "$SCRIPT_DIR/fetch-daemon.sh" --quiet >&2 || echo "canon: a prebuilt binary is missing; agent sessions or the board may not start until it is fetched (canon update)." >&2
    fi
  elif [[ ! -x "$SCRIPT_DIR/cockpit-daemon/cockpit-daemon" && -z "${COCKPIT_DAEMON_BIN:-}" ]]; then
    CANON_FETCH_NO_BUILD=1 bash "$SCRIPT_DIR/fetch-daemon.sh" --quiet >&2 || echo "canon: starting without the daemon; agent sessions will not start until it is fetched (canon update)." >&2
  fi

  if [[ ! -f "$SERVER" ]]; then
    echo "Error: server.py not found at $SERVER" >&2
    exit 1
  fi

  start_cockpit_server "$port" || exit 1
  trap 'kill "$SERVER_PID" 2>/dev/null; exit 0' INT TERM EXIT
  local up=0
  wait_for_board "$port" "$SERVER_PID" || up=$?
  case "$up" in
    0) ;;
    1) trap - INT TERM EXIT; echo "canon: the board exited before it was ready (its output is above)." >&2; exit 1 ;;
    *) trap - INT TERM EXIT; kill "$SERVER_PID" 2>/dev/null || true
       echo "canon: the board did not answer on port $port within $(_board_wait_secs)s." >&2; exit 1 ;;
  esac
  open_browser "$url"
  wait "$SERVER_PID"
}

main "$@"
