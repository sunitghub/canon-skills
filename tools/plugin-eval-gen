#!/usr/bin/env bash
# plugin-eval-gen — build a throwaway plugin for `claude plugin eval` from a
# skill's evals/evals.json (the source of truth; the output is generated,
# never edited). Canon itself has no plugin manifest, so the skill is copied
# into a generated plugin dir instead of adding one to the repo root.
#
# Usage: plugin-eval-gen <skill> [--plugin-dir <dir>] [--write] [--keep-memory]
#   --plugin-dir <dir>  generated plugin dir (default: .canon-cache/plugin-eval,
#                       relative to the canon root)
#   --write        grant Write/Edit/Bash to each case (pair with
#                  `claude plugin eval --allow-tools Write Edit Bash`)
#   --keep-memory  keep expectations that mention memory (default: dropped —
#                  the eval sandbox denies writes to the memory directory)
#
# Layout: <dir>/.claude-plugin/plugin.json, <dir>/skills/<skill>/ (SKILL.md and
# support files, no evals/), and per case <dir>/evals/<skill>-<id>/{prompt.md,
# graders/criteria.md,graders/skill-fired.md}. case_type boundary/over-caution/self-check get no
# skill-fired grader: those cases may legitimately not invoke the skill.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

skill="" out=".canon-cache/plugin-eval" tools="Read, Glob, Grep, Skill" keep_memory=0
while [ $# -gt 0 ]; do
  case "$1" in
    --plugin-dir) out="${2:?--plugin-dir needs a directory}"; shift 2 ;;
    --write) tools="Read, Glob, Grep, Skill, Write, Edit, Bash"; shift ;;
    --keep-memory) keep_memory=1; shift ;;
    -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "plugin-eval-gen: unknown option $1" >&2; exit 2 ;;
    *) skill="$1"; shift ;;
  esac
done
[ -n "$skill" ] || { echo "Usage: plugin-eval-gen <skill> [--plugin-dir <dir>] [--write] [--keep-memory]" >&2; exit 2; }

[[ "$skill" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "plugin-eval-gen: skill name must match [a-z0-9][a-z0-9-]*" >&2; exit 2; }

src="$ROOT/skills/$skill/evals/evals.json"
[ -f "$src" ] || { echo "plugin-eval-gen: $src not found" >&2; exit 1; }
case "$out" in /*|*..*) echo "plugin-eval-gen: --plugin-dir must be a relative path without '..'" >&2; exit 2 ;; esac

plugin="$ROOT/$out"
mkdir -p "$plugin/.claude-plugin" "$plugin/evals"
echo '{"name":"canon-eval","version":"0.0.0","description":"generated by tools/plugin-eval-gen"}' > "$plugin/.claude-plugin/plugin.json"
rm -rf "$plugin/skills/$skill" "$plugin/evals/$skill"-*
mkdir -p "$plugin/skills"
cp -R "$ROOT/skills/$skill" "$plugin/skills/$skill"
rm -rf "$plugin/skills/$skill/evals"

count=$(jq '.evals | length' "$src")
for ((i = 0; i < count; i++)); do
  id=$(jq -r ".evals[$i].id" "$src")
  ctype=$(jq -r ".evals[$i].case_type" "$src")
  dir="$plugin/evals/$skill-$id"
  mkdir -p "$dir/graders"

  # A leading "/<skill>" scored 0 in both arms (capture-1) and stripping it left a bare
  # statement the skill had nothing to act on (capture-3), so name the skill in plain text.
  prompt=$(jq -r ".evals[$i].prompt | sub(\"^/$skill +\"; \"Use the $skill skill: \")" "$src")
  printf -- '---\nmax_turns: 10\nallowed_tools: [%s]\n---\n\n%s\n' "$tools" "$prompt" > "$dir/prompt.md"

  filter='.'
  [ "$keep_memory" -eq 1 ] || filter='map(select(test("memory"; "i") | not))'
  rubric=$(jq -r ".evals[$i].expectations | $filter | map(\"- \" + .) | join(\"\\n\")" "$src")
  # expected_output is prose that can restate dropped memory expectations, so only
  # include it when memory expectations are kept.
  expected=""
  [ "$keep_memory" -eq 0 ] || expected="Expected: $(jq -r ".evals[$i].expected_output" "$src")"$'\n\n'
  ignore=""
  [ "$keep_memory" -eq 1 ] || ignore=$'Ignore any mention of a failed or skipped memory save.\n\n'
  printf -- '---\ntype: llm\n---\n\n%s%sPASS if the response satisfies all of:\n%s\nFAIL otherwise.\n' \
    "$expected" "$ignore" "$rubric" > "$dir/graders/criteria.md"

  rm -f "$dir/graders/skill-fired.md"
  case "$ctype" in
    boundary|over-caution|self-check) ;;
    *) printf -- "---\ntype: tool_used\ntool: Skill\ninput_match: '\"skill\"\\\\s*:\\\\s*\"(?:[\\\\w-]+:)?%s\"'\n---\n" \
         "$skill" > "$dir/graders/skill-fired.md" ;;
  esac
done
echo "plugin-eval-gen: wrote $count case(s) for $skill in $out/"
echo "run: claude plugin eval $out --trust-plugin --allow-tools Write Edit Bash   # tools flag only with --write"
